# env.nu
#
# Installed by:
# version = "0.104.1"
#
# Previously, environment variables were typically configured in `env.nu`.
# In general, most configuration can and should be performed in `config.nu`
# or one of the autoload directories.
#
# This file is generated for backwards compatibility for now.
# It is loaded before config.nu and login.nu
#
# See https://www.nushell.sh/book/configuration.html
#
# Also see `help config env` for more options.
#
# You can remove these comments if you want or leave
# them for future reference.

# Path management
use std/util "path add"
path add "~/.cargo/bin"
path add "~/.local/bin"
path add "~/.pixi/bin"
path add "~/.pixi/bin"

# Setup programs

## Setup Starship Prompt
if (which starship | is-not-empty) {
  starship init nu | save -f ~/.cache/starship/init.nu
} else {
  cargo binstall starship
  mkdir ~/.cache/starship
  starship init nu | save -f ~/.cache/starship/init.nu
}

## Setup Atuin History Search
if (which atuin | is-not-empty) {
  atuin init nu --disable-up-arrow | save -f ~/.local/share/atuin/init.nu
} else {
  cargo binstall atuin
  atuin import auto
  mkdir ~/.local/share/atuin/
  atuin init nu --disable-up-arrow | save -f ~/.local/share/atuin/init.nu
}

## Setup zoxide
if (which zoxide | is-not-empty) {
  zoxide init nushell --cmd Z | save -f ~/.config/nushell/zoxide.nu
} else {
  cargo binstall zoxide
  zoxide init nushell --cmd Z | save -f ~/.config/nushell/zoxide.nu
}

## Setup pixi completion

let pixi_completion_path = $"($nu.data-dir)/vendor/autoload/pixi-completions.nu"
if (not ((which pixi).path | is-empty)) {
  if (not ($pixi_completion_path | path exists)) {
    print "Saving pixi completion to ($pixi_completion_path)"
    mkdir $"($nu.data-dir)/vendor/autoload"
    pixi completion --shell nushell | save -f $pixi_completion_path
  } else {
    # print "Pixi completion already exists at ($pixi_completion_path)"
  }
} else {
  print "Pixi not found, skipping completion setup."
}

## TODO(rg): Make these conditional and templated!
# Tex
path add "~/.local/share/texlive-20250325/bin/x86_64-linux"
# Check if manpath and infopath are there
$env.MANPATH = $"($env.HOME)/.local/share/texlive-20250325/texmf-dist/doc/man"
$env.INFOPATH = $"($env.HOME)/.local/share/texlive-20250325/texmf-dist/doc/info"

# Wayland QT woes
$env.QT_QPA_PLATFORM = "xcb"

