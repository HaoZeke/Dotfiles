#######################################
#         Pacman                      #
#######################################

# Pacman - https://wiki.archlinux.org/index.php/Pacman_Tips
alias pacupg = sudo pacman -Syu
alias pacin = sudo pacman -S
alias paclean = sudo pacman -Sc
alias pacins = sudo pacman -U
alias paclr = sudo pacman -Scc
alias pacre = sudo pacman -R
alias pacrem = sudo pacman -Rns
alias pacrep = pacman -Si
alias pacreps = pacman -Ss
alias pacloc = pacman -Qi
alias paclocs = pacman -Qs
alias pacinsd = sudo pacman -S --asdeps
alias pacmir = sudo pacman -Syy
alias paclsorphans = sudo pacman -Qdt
alias pacfileupg = sudo pacman -Fy
alias pacfiles = pacman -F
alias pacls = pacman -Ql
alias pacown = pacman -Qo
alias pacupd = sudo pacman -Sy
alias pacmanallkeys = sudo pacman-key --refresh-keys

# Remove orphaned packages. `pacman -Qtdq` provides the list of packages.
alias pacrmorphans = sudo pacman -Rs (pacman -Qtdq | lines)

# List details for all explicitly installed packages.
export def paclist [] {
    pacman -Qqe | lines | each { |pkg_name|
        ^pacman -Qs --color=auto $"^($pkg_name)$"
    }
}

# Receive and sign PGP keys for pacman.
export def pacmansignkeys [...keys: string] {
    for key in $keys {
        sudo pacman-key --recv-keys $key
        sudo pacman-key --lsign-key $key
        "trust\n3\n" | sudo gpg --homedir /etc/pacman.d/gnupg --no-permission-warning --command-fd 0 --edit-key $key
    }
}

# Open the archlinux.org page for a given package
export def pacweb [
    package: string # The package to look up.
] {
    let infos = (pacman -Si $package | lines | str trim)
    if ($infos | is-empty) {
        error make { msg: $"Package '($package)' not found." }
        return
    }

    let repo = (
        $infos | where $it starts-with "Repo"
        | first
        | split column ":"
        | get column2
        | str trim
        | first
    )
    let arch = (
        $infos | where $it starts-with "Architecture"
        | first
        | split column ":"
        | get column2
        | str trim
        | first
    )

    if not ($repo | is-empty) and not ($arch | is-empty) {
        let url = $"https://archlinux.org/packages/($repo)/($arch)/($package)/"
        print $"Opening: ($url)"
        ^xdg-open $url | ignore # Use ^ to run external command and ignore output
    } else {
        error make { msg: "Could not determine repository or architecture."}
    }
}

