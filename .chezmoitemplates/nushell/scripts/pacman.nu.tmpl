# Check Arch Linux PGP Keyring before System Upgrade to prevent failure.
export def upgrade [] {
    sudo pacman -Sy

    print ":: Checking Arch Linux PGP Keyring..."
    let installed_ver = (sudo pacman -Qi archlinux-keyring | lines | where $it starts-with "Version" | first | split column ":" | get column2 | str trim)
    let current_ver = (sudo pacman -Si archlinux-keyring | lines | where $it starts-with "Version" | first | split column ":" | get column2 | str trim)

    if $installed_ver != $current_ver {
        print " Arch Linux PGP Keyring is out of date."
        print " Updating before full system upgrade."
        sudo pacman -S --needed --noconfirm archlinux-keyring
    } else {
        print " Arch Linux PGP Keyring is up to date."
    }

    print ":: Proceeding with full system upgrade."
    if (which yay | is-not-empty) {
        yay -Su
    } else if (which trizen | is-not-empty) {
        trizen -Su
    } else if (which pacaur | is-not-empty) {
        pacaur -Su
    } else if (which aura | is-not-empty) {
        sudo aura -Su
    } else {
        sudo pacman -Su
    }
}
