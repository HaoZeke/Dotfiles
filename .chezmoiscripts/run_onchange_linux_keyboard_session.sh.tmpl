#!/usr/bin/env bash
{{- if and (eq .chezmoi.os "linux") (ne .display_manager "none") }}
# Keep sway-session-bound units off default.target. With linger, a stale
# kanshi/foot-server enablement there BindsTo=sway-session.target and
# starts kanata at the greetd greeter while vconsole is already colemak.
set -euo pipefail

if ! command -v systemctl >/dev/null 2>&1; then
    exit 0
fi

fix_sway_session_wants() {
    local unit="$1"
    if systemctl --user is-enabled "$unit" >/dev/null 2>&1; then
        systemctl --user disable "$unit" >/dev/null 2>&1 || true
    fi
    systemctl --user enable "$unit" >/dev/null 2>&1 || true
}

for unit in kanata.service rg-kanata-watchdog.service kanshi.service foot-server.service; do
    fix_sway_session_wants "$unit"
done

systemctl --user daemon-reload >/dev/null 2>&1 || true
{{- end }}