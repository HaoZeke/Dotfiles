#!/usr/bin/env bash
{{- if eq .chezmoi.os "linux" }}
# Install /etc memory/zram/oomd tuning under sudo and reload affected units.
# chezmoi re-runs this when the rendered script changes; per-file `cmp -s`
# guards mean unchanged content skips the sudo write.

set -euo pipefail

write_if_diff() {
    local dst="$1" content="$2"
    local tmp
    tmp=$(mktemp)
    printf '%s' "$content" >"$tmp"
    if ! sudo test -f "$dst" || ! sudo cmp -s "$tmp" "$dst"; then
        echo "chezmoi: updating $dst"
        sudo install -D -m 0644 -o root -g root "$tmp" "$dst"
        rm -f "$tmp"
        return 0
    fi
    rm -f "$tmp"
    return 1
}

SYSCTL_CONTENT='# Managed by chezmoi (.chezmoiscripts/run_onchange_linux_memory_tuning.sh.tmpl)
#
# Tuned for a zram-equipped Rust/Linux workstation. Anchored on:
#   * /dev/zram0 at prio 100, zstd compression (see zram-generator.conf)
#   * systemd-oomd managing user-.slice via PSI (see oomd.conf.d + user-.slice.d)
#
# High swappiness is correct here: swap runs at RAM-latency through zram,
# so idle anon memory should page freely while page cache stays resident
# for target/*.rlib and source trees.
vm.swappiness = 100
vm.page-cluster = 0
vm.vfs_cache_pressure = 100
vm.watermark_scale_factor = 50
vm.compaction_proactiveness = 0
vm.min_free_kbytes = 262144

# Dirty-page accounting. Defaults (20/10) let 6 GiB of dirty pages pile
# up on a 30 GiB box before the kernel starts flushing, producing
# multi-second I/O write storms every time the ratio trips. Lowering
# both and shortening the expire window makes writeback small and
# continuous instead of large and spiky.
vm.dirty_ratio = 10
vm.dirty_background_ratio = 5
vm.dirty_expire_centisecs = 3000
vm.dirty_writeback_centisecs = 1500
'

ZRAM_CONTENT='# Managed by chezmoi (.chezmoiscripts/run_onchange_linux_memory_tuning.sh.tmpl)
[zram0]
zram-size = ram / 2
compression-algorithm = zstd
swap-priority = 100
fs-type = swap
'

OOMD_CONF_CONTENT='# Managed by chezmoi (.chezmoiscripts/run_onchange_linux_memory_tuning.sh.tmpl)
# Fire PSI-based kills after 20s of sustained memory pressure instead of
# the 30s default. Pairs with ManagedOOMMemoryPressureLimit on user-.slice.
[OOM]
DefaultMemoryPressureDurationSec=20s
'

USER_SLICE_OOMD_CONTENT='# Managed by chezmoi (.chezmoiscripts/run_onchange_linux_memory_tuning.sh.tmpl)
# Enable systemd-oomd PSI-based kills on every user-UID.slice. Kills the
# largest process inside the user session when memory-pressure stall
# averages exceed 50% for the duration configured in oomd.conf.d.
[Slice]
ManagedOOMMemoryPressure=kill
ManagedOOMMemoryPressureLimit=50%
'

# Ensure zram-generator on Arch hosts.
if command -v pacman >/dev/null 2>&1 \
   && ! pacman -Qi zram-generator >/dev/null 2>&1; then
    echo "chezmoi: installing zram-generator"
    sudo pacman -S --noconfirm --needed zram-generator
fi

SYSCTL_CHANGED=0
ZRAM_CHANGED=0
OOMD_CHANGED=0
write_if_diff /etc/sysctl.d/99-memory.conf                     "$SYSCTL_CONTENT"         && SYSCTL_CHANGED=1 || true
write_if_diff /etc/systemd/zram-generator.conf                 "$ZRAM_CONTENT"           && ZRAM_CHANGED=1   || true
write_if_diff /etc/systemd/oomd.conf.d/aggressive.conf         "$OOMD_CONF_CONTENT"      && OOMD_CHANGED=1   || true
write_if_diff /etc/systemd/system/user-.slice.d/50-oomd.conf   "$USER_SLICE_OOMD_CONTENT" && OOMD_CHANGED=1   || true

if [ "$SYSCTL_CHANGED" = "1" ]; then
    sudo sysctl --system >/dev/null
fi

if [ "$ZRAM_CHANGED" = "1" ]; then
    sudo systemctl daemon-reload
    sudo systemctl restart systemd-zram-setup@zram0.service || true
fi

# Always make sure systemd-oomd is up; restart if its config moved.
if ! sudo systemctl is-enabled systemd-oomd >/dev/null 2>&1; then
    sudo systemctl enable systemd-oomd >/dev/null
fi
if [ "$OOMD_CHANGED" = "1" ]; then
    sudo systemctl daemon-reload
    sudo systemctl restart systemd-oomd
elif ! systemctl is-active systemd-oomd >/dev/null 2>&1; then
    sudo systemctl start systemd-oomd
fi

# Reload user manager so rust-analyzer.slice (deployed to
# ~/.config/systemd/user/) is picked up for the next shim launch.
systemctl --user daemon-reload 2>/dev/null || true
{{- end }}
