#!/usr/bin/env bash
{{- if and (eq .chezmoi.os "linux") (ne .display_manager "none") }}
# Rebuild rg-wob-bridge whenever its chezmoi-managed Rust source changes.
# hash: {{ output "bash" "-lc" (printf "cat %q %q | sha256sum | cut -d' ' -f1" (printf "%s/dot_local/share/rg-wob-bridge-src/Cargo.toml" .chezmoi.sourceDir) (printf "%s/dot_local/share/rg-wob-bridge-src/main.rs" .chezmoi.sourceDir)) | trim }}

set -euo pipefail

SRC="$HOME/.local/share/rg-wob-bridge-src"

if [ ! -d "$SRC" ]; then
    echo "chezmoi: rg-wob-bridge source missing at $SRC; skipping install." >&2
    exit 0
fi

if ! command -v cargo >/dev/null 2>&1; then
    echo "chezmoi: cargo not found; skipping rg-wob-bridge build." >&2
    exit 0
fi

export CARGO_BUILD_JOBS=4

echo "chezmoi: installing rg-wob-bridge via cargo install ..."
cargo install --path "$SRC" --root "$HOME/.local" --force --locked

# Wire the sway-session notification + overlay services to autostart. Use plain
# enable (never --now): apply must not block on a graphical session or a busy
# user manager. They start via sway-session.target on the next login/reload.
if command -v systemctl >/dev/null 2>&1; then
    systemctl --user enable dunst.service wob.service >/dev/null 2>&1 || true
fi
{{- end }}
