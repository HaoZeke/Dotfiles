#!/usr/bin/env bash
{{- if and (eq .chezmoi.os "linux") (ne .display_manager "none") }}
# Rebuild rg-desktop-help whenever its chezmoi-managed Rust source changes.
# hash: {{ output "bash" "-lc" (printf "cat %q %q | sha256sum | cut -d' ' -f1" (printf "%s/dot_local/share/rg-desktop-help-src/Cargo.toml" .chezmoi.sourceDir) (printf "%s/dot_local/share/rg-desktop-help-src/main.rs" .chezmoi.sourceDir)) | trim }}

set -euo pipefail

SRC="$HOME/.local/share/rg-desktop-help-src"

if [ ! -d "$SRC" ]; then
    echo "chezmoi: rg-desktop-help source missing at $SRC; skipping install." >&2
    exit 0
fi

if ! command -v cargo >/dev/null 2>&1; then
    echo "chezmoi: cargo not found; skipping rg-desktop-help build." >&2
    exit 0
fi

export CARGO_BUILD_JOBS=4

echo "chezmoi: installing rg-desktop-help via cargo install ..."
cargo install --path "$SRC" --root "$HOME/.local" --force --locked
{{- end }}
