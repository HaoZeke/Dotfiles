#!/usr/bin/env bash
{{- if and (eq .chezmoi.os "linux") (ne .display_manager "none") }}
# Install (or refresh) the rg-theme binary from its source repo at
# ~/Git/Github/Tools/rg-theme.  Runs on content change of this script
# and whenever the source tree's HEAD commit changes -- triggered via
# the HEAD stamp baked into the comment below.
#
# HEAD stamp (updates on apply): {{ output "git" "-C" (printf "%s/Git/Github/Tools/rg-theme" .chezmoi.homeDir) "rev-parse" "HEAD" | trim }}

set -euo pipefail

SRC="$HOME/Git/Github/Tools/rg-theme"
BIN="$HOME/.local/bin/rg-theme"

if [ ! -d "$SRC" ]; then
    echo "chezmoi: rg-theme source missing at $SRC; skipping install." >&2
    echo "  git clone git@github.com:HaoZeke/rg-theme.git $SRC" >&2
    exit 0
fi

if ! command -v pixi >/dev/null 2>&1; then
    echo "chezmoi: pixi not found; install pixi first, then rerun chezmoi apply." >&2
    exit 0
fi

# -j4 cap per the local-build policy in ~/.claude/CLAUDE.md. The
# pixi task just wraps `cargo install --path . --root ~/.local`, so
# the env var flows through to cargo and caps parallelism at four.
export CARGO_BUILD_JOBS=4

echo "chezmoi: installing rg-theme via 'pixi run install' ..."
(cd "$SRC" && pixi run install)

# Bootstrap the default state + symlinks if this is a fresh install.
# rg-theme apply is idempotent; calling it twice is harmless.
if [ ! -f "$HOME/.local/state/rg-theme/state" ]; then
    echo "chezmoi: bootstrapping rg-theme state (tomorrow / dark)"
    "$BIN" apply || true
fi
{{- end }}
