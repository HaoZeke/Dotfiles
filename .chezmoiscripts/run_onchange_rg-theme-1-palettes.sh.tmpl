#!/usr/bin/env bash
{{- if and (eq .chezmoi.os "linux") (ne .display_manager "none") }}
# Emit every rg-theme palette file under
# ~/.local/share/rg-theme/palettes/<palette>/<mode>/{foot,alacritty,rofi,sway-colors,swaylock}.conf
# Colours are defined once (per palette/mode) as shell vars and fanned
# out by the write_* helpers below.  Edit this file to change palettes;
# chezmoi re-runs it on content change and rg-theme will pick up the
# new palette on its next `apply` (or `swaymsg reload`).

set -euo pipefail

OUT="$HOME/.local/share/rg-theme/palettes"

# ---------- writers ----------

# Required vars: bg fg r0..r7 b0..b7 sel_bg sel_fg cursor
# $2 is the foot section name: colors-dark or colors-light.
# Foot 1.23+ keeps both sections in memory and switches with
# SIGUSR1 (dark) / SIGUSR2 (light) without re-reading config or
# restarting the server. Mode-scoped files keep a single section;
# combine_foot stitches both into palettes/<palette>/foot.ini for
# the live include symlink.
write_foot() {
    local dir="$1" section="$2"
    mkdir -p "$dir"
    cat >"$dir/foot.ini" <<EOF
# Generated by .chezmoiscripts/run_onchange_rg-theme-palettes.sh.tmpl
[${section}]
background=${bg}
foreground=${fg}

regular0=${r0}
regular1=${r1}
regular2=${r2}
regular3=${r3}
regular4=${r4}
regular5=${r5}
regular6=${r6}
regular7=${r7}

bright0=${b0}
bright1=${b1}
bright2=${b2}
bright3=${b3}
bright4=${b4}
bright5=${b5}
bright6=${b6}
bright7=${b7}

selection-foreground=${sel_fg}
selection-background=${sel_bg}
cursor=${bg} ${cursor}
EOF
}

# Dual-theme file foot loads once: both sections, palette-scoped.
# Soft light/dark flip = signal only; palette change still needs a
# foot-server restart so the new dual file is parsed.
combine_foot() {
    local palette="$1"
    local dest="$OUT/$palette/foot.ini"
    {
        echo "# Generated dual theme for foot (colors-dark + colors-light)."
        echo "# Soft switch: SIGUSR1 -> dark, SIGUSR2 -> light (foot --server)."
        echo "# Do not edit; regenerated by chezmoi rg-theme palettes script."
        cat "$OUT/$palette/dark/foot.ini"
        echo
        cat "$OUT/$palette/light/foot.ini"
    } >"$dest"
}

write_alacritty() {
    local dir="$1"; mkdir -p "$dir"
    cat >"$dir/alacritty.yml" <<EOF
# Generated by .chezmoiscripts/run_onchange_rg-theme-palettes.sh.tmpl
colors:
  primary:
    background: '0x${bg}'
    foreground: '0x${fg}'
  selection:
    text:       '0x${sel_fg}'
    background: '0x${sel_bg}'
  cursor:
    text:   '0x${bg}'
    cursor: '0x${cursor}'
  normal:
    black:   '0x${r0}'
    red:     '0x${r1}'
    green:   '0x${r2}'
    yellow:  '0x${r3}'
    blue:    '0x${r4}'
    magenta: '0x${r5}'
    cyan:    '0x${r6}'
    white:   '0x${r7}'
  bright:
    black:   '0x${b0}'
    red:     '0x${b1}'
    green:   '0x${b2}'
    yellow:  '0x${b3}'
    blue:    '0x${b4}'
    magenta: '0x${b5}'
    cyan:    '0x${b6}'
    white:   '0x${b7}'
EOF
}

write_dunst() {
    local dir="$1"; mkdir -p "$dir"
    # Drop-in for ~/.config/dunst/dunstrc.d/ (loaded by dunst >= 1.13
    # after the base config; settings here override base values).
    cat >"$dir/dunst.conf" <<EOF
# Generated by .chezmoiscripts/run_onchange_rg-theme-palettes.sh.tmpl
[global]
    frame_color = "#${r4}"
    separator_color = frame

[urgency_low]
    background = "#${bg}"
    foreground = "#${fg}"
    timeout = 10

[urgency_normal]
    background = "#${bg}"
    foreground = "#${fg}"
    timeout = 10

[urgency_critical]
    background = "#${r1}"
    foreground = "#${bg}"
    frame_color = "#${r1}"
    timeout = 0
EOF
}

write_i3rust() {
    local dir="$1"; mkdir -p "$dir"
    # i3status-rust theme override file -- loaded when config sets
    # theme = "active". No section headers; every key is top-level.
    #
    # warning_bg uses $orange rather than r3 (yellow) so good (green)
    # and warning stay distinguishable under deuteranopia/protanopia.
    # Each palette provides its own $orange shade (peach in
    # Catppuccin, orange in Gruvbox/Solarized/Tomorrow) so the shift
    # reads natural within the palette.
    cat >"$dir/i3rust.toml" <<EOF
# Generated by .chezmoiscripts/run_onchange_rg-theme-palettes.sh.tmpl
idle_bg = "#${bg}"
idle_fg = "#${fg}"
info_bg = "#${r4}"
info_fg = "#${bg}"
good_bg = "#${r2}"
good_fg = "#${bg}"
warning_bg = "#${orange}"
warning_fg = "#${bg}"
critical_bg = "#${r1}"
critical_fg = "#${bg}"
separator = ""
separator_bg = "auto"
separator_fg = "auto"
alternating_tint_bg = "#242729"
alternating_tint_fg = "#242729"
EOF
}

write_rofi() {
    local dir="$1"; mkdir -p "$dir"
    # Minimal palette-only override; the main config.rasi pulls general
    # layout from @theme "solarized" and this file re-colours on top.
    cat >"$dir/rofi.rasi" <<EOF
/* Generated by .chezmoiscripts/run_onchange_rg-theme-palettes.sh.tmpl */
* {
    background:       #${bg};
    background-color: #${bg};
    foreground:       #${fg};
    selected-normal-background: #${r4};
    selected-normal-foreground: #${bg};
    active-background:  #${r2};
    active-foreground:  #${bg};
    urgent-background:  #${r1};
    urgent-foreground:  #${bg};
    border-color:       #${b0};
    separatorcolor:     #${b0};
    normal-background:  #${bg};
    normal-foreground:  #${fg};
    alternate-normal-background: #${bg};
    alternate-normal-foreground: #${fg};
}
EOF
}

# sway-colors.conf is sourced near the top of sway/config.tmpl (before
# the bar blocks) so these \$vars resolve when sway parses bar { }.
write_sway() {
    local dir="$1"; mkdir -p "$dir"
    cat >"$dir/sway-colors.conf" <<EOF
# Generated by .chezmoiscripts/run_onchange_rg-theme-palettes.sh.tmpl
set \$bar_bg          #${bg}
set \$bar_fg          #${fg}
set \$bar_sep         #${sel_bg}
set \$ws_focus_border #${b4}
set \$ws_focus_bg     #${r4}
set \$ws_focus_fg     #${bg}
set \$ws_active_border #${r4}
set \$ws_active_bg    #${sel_bg}
set \$ws_active_fg    #${fg}
set \$ws_inactive_border #${bg}
set \$ws_inactive_bg  #${bg}
set \$ws_inactive_fg  #${b0}
set \$ws_urgent_border #${r1}
set \$ws_urgent_bg    #${r1}
set \$ws_urgent_fg    #${bg}
set \$border_focus       #${r4}
set \$border_focus_ind   #${b4}
set \$border_unfocus     #${sel_bg}
set \$border_urgent      #${r1}
EOF
}

write_swaylock() {
    local dir="$1"; mkdir -p "$dir"
    cat >"$dir/swaylock.conf" <<EOF
# Generated by .chezmoiscripts/run_onchange_rg-theme-palettes.sh.tmpl
clock
timestr=%H:%M
datestr=%A, %d %B
show-failed-attempts
show-keyboard-layout
indicator-idle-visible
indicator-caps-lock
scaling=fill

font=Atkinson Hyperlegible
font-size=28

indicator-radius=120
indicator-thickness=16
line-uses-ring
separator-color=00000000

effect-vignette=0.30:0.55

color=${bg}
inside-color=${bg}c0
inside-clear-color=${bg}d8
inside-caps-lock-color=${bg}d8
inside-ver-color=${bg}d8
inside-wrong-color=${bg}d8

ring-color=${r4}ff
ring-clear-color=${b4}ff
ring-caps-lock-color=${orange}ff
ring-ver-color=${r2}ff
ring-wrong-color=${r1}ff

line-color=${r4}ff
line-clear-color=${b4}ff
line-caps-lock-color=${orange}ff
line-ver-color=${r2}ff
line-wrong-color=${r1}ff

text-color=${fg}ff
text-clear-color=${fg}ff
text-caps-lock-color=${fg}ff
text-ver-color=${fg}ff
text-wrong-color=${fg}ff

key-hl-color=${b4}ff
bs-hl-color=${orange}ff
caps-lock-key-hl-color=${orange}ff
caps-lock-bs-hl-color=${r3}ff

layout-bg-color=${bg}dd
layout-border-color=${r4}ff
layout-text-color=${fg}ff
EOF
}

# Volume/brightness OSD (wob). Alpha suffix ff/ee for ARGB.
write_wob() {
    local dir="$1"; mkdir -p "$dir"
    cat >"$dir/wob.ini" <<EOF
# Generated by .chezmoiscripts/run_onchange_rg-theme-palettes.sh.tmpl
timeout = 900
max = 100
width = 260
height = 28
border_offset = 0
border_size = 2
bar_padding = 4
anchor = top center
margin = 52 0 0 0
border_color = ${r4}ff
background_color = ${bg}ee
bar_color = ${r4}ff
overflow_mode = nowrap
overflow_bar_color = ${orange}ff
overflow_background_color = ${bg}ee
overflow_border_color = ${orange}ff

[style.muted]
border_color = ${sel_bg}ff
background_color = ${bg}ee
bar_color = ${b0}ff
EOF
}

# Sourced by ~/.tmux.conf via: source-file ~/.config/tmux/rg-theme.conf
write_tmux() {
    local dir="$1"; mkdir -p "$dir"
    cat >"$dir/tmux.conf" <<EOF
# Generated by .chezmoiscripts/run_onchange_rg-theme-palettes.sh.tmpl
# Soft reload: tmux source-file ~/.config/tmux/rg-theme.conf
set -g status-style 'bg=#${bg},fg=#${fg}'
set -g status-left '#[fg=#${r4},bold] #S #[fg=#${b0}]|#{?client_prefix,#[fg=#${r3},bold] prefix #[fg=#${b0}]|,}#{?window_zoomed_flag,#[fg=#${orange},bold] zoom #[fg=#${b0}]|,}'
set -g status-right '#[fg=#${b0}]%Y-%m-%d #[fg=#${fg}]%H:%M '
setw -g window-status-format '#[fg=#${b0}] #I:#W '
setw -g window-status-current-format '#[bg=#${r4},fg=#${bg},bold] #I:#W '
setw -g window-status-activity-style 'fg=#${orange},bold'
setw -g window-status-bell-style 'bg=#${r1},fg=#${bg},bold'
set -g pane-border-style 'fg=#${b0}'
set -g pane-active-border-style 'fg=#${r4}'
set -g pane-border-format '#[fg=#${b0}] #P #[fg=#${b0}]| #[fg=#${fg}]#{pane_current_command}'
set -g message-style 'bg=#${r4},fg=#${bg},bold'
set -g mode-style 'bg=#${r3},fg=#${bg},bold'
set -g clock-mode-colour '#${r4}'
EOF
}

