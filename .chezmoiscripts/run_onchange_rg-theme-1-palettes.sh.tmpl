#!/usr/bin/env bash
{{- if eq .chezmoi.os "linux" }}
# Emit every rg-theme palette file under
# ~/.local/share/rg-theme/palettes/<palette>/<mode>/{foot,alacritty,rofi,sway-colors}.conf
# Colours are defined once (per palette/mode) as shell vars and fanned
# out by the write_* helpers below.  Edit this file to change palettes;
# chezmoi re-runs it on content change and rg-theme will pick up the
# new palette on its next `apply` (or `swaymsg reload`).

set -euo pipefail

OUT="$HOME/.local/share/rg-theme/palettes"

# ---------- writers ----------

# Required vars: bg fg r0..r7 b0..b7 sel_bg sel_fg cursor
write_foot() {
    local dir="$1"; mkdir -p "$dir"
    cat >"$dir/foot.ini" <<EOF
# Generated by .chezmoiscripts/run_onchange_rg-theme-palettes.sh.tmpl
[colors]
background=${bg}
foreground=${fg}

regular0=${r0}
regular1=${r1}
regular2=${r2}
regular3=${r3}
regular4=${r4}
regular5=${r5}
regular6=${r6}
regular7=${r7}

bright0=${b0}
bright1=${b1}
bright2=${b2}
bright3=${b3}
bright4=${b4}
bright5=${b5}
bright6=${b6}
bright7=${b7}

selection-foreground=${sel_fg}
selection-background=${sel_bg}
cursor=${bg} ${cursor}
EOF
}

write_alacritty() {
    local dir="$1"; mkdir -p "$dir"
    cat >"$dir/alacritty.yml" <<EOF
# Generated by .chezmoiscripts/run_onchange_rg-theme-palettes.sh.tmpl
colors:
  primary:
    background: '0x${bg}'
    foreground: '0x${fg}'
  selection:
    text:       '0x${sel_fg}'
    background: '0x${sel_bg}'
  cursor:
    text:   '0x${bg}'
    cursor: '0x${cursor}'
  normal:
    black:   '0x${r0}'
    red:     '0x${r1}'
    green:   '0x${r2}'
    yellow:  '0x${r3}'
    blue:    '0x${r4}'
    magenta: '0x${r5}'
    cyan:    '0x${r6}'
    white:   '0x${r7}'
  bright:
    black:   '0x${b0}'
    red:     '0x${b1}'
    green:   '0x${b2}'
    yellow:  '0x${b3}'
    blue:    '0x${b4}'
    magenta: '0x${b5}'
    cyan:    '0x${b6}'
    white:   '0x${b7}'
EOF
}

write_dunst() {
    local dir="$1"; mkdir -p "$dir"
    # Drop-in for ~/.config/dunst/dunstrc.d/ (loaded by dunst >= 1.13
    # after the base config; settings here override base values).
    cat >"$dir/dunst.conf" <<EOF
# Generated by .chezmoiscripts/run_onchange_rg-theme-palettes.sh.tmpl
[global]
    frame_color = "#${r4}"
    separator_color = frame

[urgency_low]
    background = "#${bg}"
    foreground = "#${fg}"
    timeout = 10

[urgency_normal]
    background = "#${bg}"
    foreground = "#${fg}"
    timeout = 10

[urgency_critical]
    background = "#${r1}"
    foreground = "#${bg}"
    frame_color = "#${r1}"
    timeout = 0
EOF
}

write_i3rust() {
    local dir="$1"; mkdir -p "$dir"
    # i3status-rust theme override file -- loaded when config sets
    # theme = "active". No section headers; every key is top-level.
    #
    # warning_bg uses $orange rather than r3 (yellow) so good (green)
    # and warning stay distinguishable under deuteranopia/protanopia.
    # Each palette provides its own $orange shade (peach in
    # Catppuccin, orange in Gruvbox/Solarized/Tomorrow) so the shift
    # reads natural within the palette.
    cat >"$dir/i3rust.toml" <<EOF
# Generated by .chezmoiscripts/run_onchange_rg-theme-palettes.sh.tmpl
idle_bg = "#${bg}"
idle_fg = "#${fg}"
info_bg = "#${r4}"
info_fg = "#${bg}"
good_bg = "#${r2}"
good_fg = "#${bg}"
warning_bg = "#${orange}"
warning_fg = "#${bg}"
critical_bg = "#${r1}"
critical_fg = "#${bg}"
separator = " | "
separator_bg = "auto"
separator_fg = "auto"
alternating_tint_bg = "#${b0}"
alternating_tint_fg = "#${b0}"
EOF
}

write_rofi() {
    local dir="$1"; mkdir -p "$dir"
    # Minimal palette-only override; the main config.rasi pulls general
    # layout from @theme "solarized" and this file re-colours on top.
    cat >"$dir/rofi.rasi" <<EOF
/* Generated by .chezmoiscripts/run_onchange_rg-theme-palettes.sh.tmpl */
* {
    background:       #${bg};
    background-color: #${bg};
    foreground:       #${fg};
    selected-normal-background: #${r4};
    selected-normal-foreground: #${bg};
    active-background:  #${r2};
    active-foreground:  #${bg};
    urgent-background:  #${r1};
    urgent-foreground:  #${bg};
    border-color:       #${b0};
    separatorcolor:     #${b0};
    normal-background:  #${bg};
    normal-foreground:  #${fg};
    alternate-normal-background: #${bg};
    alternate-normal-foreground: #${fg};
}
EOF
}

# sway-colors.conf is sourced near the top of sway/config.tmpl (before
# the bar blocks) so these \$vars resolve when sway parses bar { }.
write_sway() {
    local dir="$1"; mkdir -p "$dir"
    cat >"$dir/sway-colors.conf" <<EOF
# Generated by .chezmoiscripts/run_onchange_rg-theme-palettes.sh.tmpl
set \$bar_bg          #${bg}
set \$bar_fg          #${fg}
set \$bar_sep         #${b0}
set \$ws_focus_bg     #${r4}
set \$ws_focus_fg     #${bg}
set \$ws_active_bg    #${b0}
set \$ws_active_fg    #${fg}
set \$ws_inactive_bg  #${bg}
set \$ws_inactive_fg  #${b0}
set \$ws_urgent_bg    #${r1}
set \$ws_urgent_fg    #${bg}
set \$border_focus       #${r4}
set \$border_focus_ind   #${b4}
set \$border_unfocus     #${b0}
set \$border_urgent      #${r1}
EOF
}

emit() {
    local palette="$1" mode="$2"
    local dir="$OUT/$palette/$mode"
    write_foot "$dir"
    write_alacritty "$dir"
    write_rofi "$dir"
    write_sway "$dir"
    write_dunst "$dir"
    write_i3rust "$dir"
}

# ---------- palettes ----------
#
# Accessibility notes:
#   * All fg/bg combinations are WCAG AAA (>= 7.0 contrast).
#   * On light palettes, r2/r3/r6 are darkened vs upstream so they
#     clear AA Large (>= 3.0) on the pale backgrounds. The hues stay
#     true to the palette; only luminance moves.
#   * gruvbox/dark r1 is brightened a touch for the same reason
#     (upstream #cc241d clocks ~2.96 on #282828).
#   * $orange is mapped per-palette for i3rust warning_bg so that
#     green/good and yellow/warning stay distinguishable under
#     deuteranopia and protanopia (both collapse r2 and r3 in every
#     palette). $orange is always a real palette color, not invented:
#     Solarized orange, Catppuccin peach, Gruvbox orange, etc.

# Tomorrow palette: Tomorrow Night (dark) + Solarized Light High Contrast (light)
bg=1d1f21 fg=c5c8c6 \
    r0=5c5e5e r1=cc6666 r2=b5bd68 r3=f0c674 r4=81a2be r5=b294bb r6=8abeb7 r7=c5c8c6 \
    b0=757878 b1=de935f b2=b5bd68 b3=f0c674 b4=81a2be b5=c9b4cf b6=8abeb7 b7=ffffff \
    sel_bg=3f4040 sel_fg=1d1f21 cursor=8d9fa1 orange=de935f \
    emit tomorrow dark

bg=eee8d5 fg=002732 \
    r0=002b36 r1=dc322f r2=4d5a00 r3=7c5f00 r4=268bd2 r5=d33682 r6=177770 r7=eee8d5 \
    b0=073642 b1=cb4b16 b2=586e75 b3=657b83 b4=839496 b5=6c71c4 b6=93a1a1 b7=fdf6e3 \
    sel_bg=cfcac0 sel_fg=002732 cursor=002732 orange=cb4b16 \
    emit tomorrow light

# Catppuccin: Mocha (dark) + Latte (light). Canonical Catppuccin ANSI
# mapping on the dark side; Latte r2/r3/r5 darkened for contrast.
bg=1e1e2e fg=cdd6f4 \
    r0=45475a r1=f38ba8 r2=a6e3a1 r3=f9e2af r4=89b4fa r5=f5c2e7 r6=94e2d5 r7=bac2de \
    b0=585b70 b1=f38ba8 b2=a6e3a1 b3=f9e2af b4=89b4fa b5=f5c2e7 b6=94e2d5 b7=a6adc8 \
    sel_bg=585b70 sel_fg=cdd6f4 cursor=f5e0dc orange=fab387 \
    emit catppuccin dark

bg=eff1f5 fg=4c4f69 \
    r0=5c5f77 r1=d20f39 r2=2d7a1f r3=a8690a r4=1e66f5 r5=b5259a r6=179299 r7=acb0be \
    b0=6c6f85 b1=d20f39 b2=40a02b b3=df8e1d b4=1e66f5 b5=ea76cb b6=179299 b7=bcc0cc \
    sel_bg=bcc0cc sel_fg=4c4f69 cursor=dc8a78 orange=fe640b \
    emit catppuccin light

# Gruvbox: canonical medium-contrast dark + light variants; r1 on
# dark nudged brighter, r2/r3/r6 on light nudged darker.
bg=282828 fg=ebdbb2 \
    r0=282828 r1=d62f22 r2=98971a r3=d79921 r4=458588 r5=b16286 r6=689d6a r7=a89984 \
    b0=928374 b1=fb4934 b2=b8bb26 b3=fabd2f b4=83a598 b5=d3869b b6=8ec07c b7=ebdbb2 \
    sel_bg=504945 sel_fg=ebdbb2 cursor=ebdbb2 orange=fe8019 \
    emit gruvbox dark

bg=fbf1c7 fg=3c3836 \
    r0=fbf1c7 r1=cc241d r2=6f6c0a r3=9c6b0a r4=458588 r5=b16286 r6=446846 r7=7c6f64 \
    b0=928374 b1=9d0006 b2=79740e b3=b57614 b4=076678 b5=8f3f71 b6=427b58 b7=3c3836 \
    sel_bg=d5c4a1 sel_fg=3c3836 cursor=3c3836 orange=af3a03 \
    emit gruvbox light

echo "chezmoi: rg-theme palettes regenerated under $OUT"

# If rg-theme is already installed and a state file exists, re-apply so
# the running session picks up any colour tweaks without the user
# having to toggle manually.
if command -v rg-theme >/dev/null 2>&1 && [ -f "$HOME/.local/state/rg-theme/state" ]; then
    rg-theme apply >/dev/null 2>&1 || true
fi
{{- end }}
