    local dir="$1"; mkdir -p "$dir"
    cat >"$dir/tokens.env" <<EOF
# Generated by .chezmoiscripts/run_onchange_rg-theme-palettes.sh.tmpl
RG_THEME_BG=${bg}
RG_THEME_FG=${fg}
RG_THEME_R0=${r0}
RG_THEME_R1=${r1}
RG_THEME_R2=${r2}
RG_THEME_R3=${r3}
RG_THEME_R4=${r4}
RG_THEME_R5=${r5}
RG_THEME_R6=${r6}
RG_THEME_R7=${r7}
RG_THEME_B0=${b0}
RG_THEME_ORANGE=${orange}
RG_THEME_SEL_BG=${sel_bg}
RG_THEME_SEL_FG=${sel_fg}
