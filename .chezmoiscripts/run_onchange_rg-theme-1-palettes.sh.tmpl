#!/usr/bin/env bash
{{- if eq .chezmoi.os "linux" }}
# Emit every rg-theme palette file under
# ~/.local/share/rg-theme/palettes/<palette>/<mode>/{foot,alacritty,rofi,sway-colors}.conf
# Colours are defined once (per palette/mode) as shell vars and fanned
# out by the write_* helpers below.  Edit this file to change palettes;
# chezmoi re-runs it on content change and rg-theme will pick up the
# new palette on its next `apply` (or `swaymsg reload`).

set -euo pipefail

OUT="$HOME/.local/share/rg-theme/palettes"

# ---------- writers ----------

# Required vars: bg fg r0..r7 b0..b7 sel_bg sel_fg cursor
write_foot() {
    local dir="$1"; mkdir -p "$dir"
    cat >"$dir/foot.ini" <<EOF
# Generated by .chezmoiscripts/run_onchange_rg-theme-palettes.sh.tmpl
[colors]
background=${bg}
foreground=${fg}

regular0=${r0}
regular1=${r1}
regular2=${r2}
regular3=${r3}
regular4=${r4}
regular5=${r5}
regular6=${r6}
regular7=${r7}

bright0=${b0}
bright1=${b1}
bright2=${b2}
bright3=${b3}
bright4=${b4}
bright5=${b5}
bright6=${b6}
bright7=${b7}

selection-foreground=${sel_fg}
selection-background=${sel_bg}
cursor=${bg} ${cursor}
EOF
}

write_alacritty() {
    local dir="$1"; mkdir -p "$dir"
    cat >"$dir/alacritty.yml" <<EOF
# Generated by .chezmoiscripts/run_onchange_rg-theme-palettes.sh.tmpl
colors:
  primary:
    background: '0x${bg}'
    foreground: '0x${fg}'
  selection:
    text:       '0x${sel_fg}'
    background: '0x${sel_bg}'
  cursor:
    text:   '0x${bg}'
    cursor: '0x${cursor}'
  normal:
    black:   '0x${r0}'
    red:     '0x${r1}'
    green:   '0x${r2}'
    yellow:  '0x${r3}'
    blue:    '0x${r4}'
    magenta: '0x${r5}'
    cyan:    '0x${r6}'
    white:   '0x${r7}'
  bright:
    black:   '0x${b0}'
    red:     '0x${b1}'
    green:   '0x${b2}'
    yellow:  '0x${b3}'
    blue:    '0x${b4}'
    magenta: '0x${b5}'
    cyan:    '0x${b6}'
    white:   '0x${b7}'
EOF
}

write_rofi() {
    local dir="$1"; mkdir -p "$dir"
    # Minimal palette-only override; the main config.rasi pulls general
    # layout from @theme "solarized" and this file re-colours on top.
    cat >"$dir/rofi.rasi" <<EOF
/* Generated by .chezmoiscripts/run_onchange_rg-theme-palettes.sh.tmpl */
* {
    background:       #${bg};
    background-color: #${bg};
    foreground:       #${fg};
    selected-normal-background: #${r4};
    selected-normal-foreground: #${bg};
    active-background:  #${r2};
    active-foreground:  #${bg};
    urgent-background:  #${r1};
    urgent-foreground:  #${bg};
    border-color:       #${b0};
    separatorcolor:     #${b0};
    normal-background:  #${bg};
    normal-foreground:  #${fg};
    alternate-normal-background: #${bg};
    alternate-normal-foreground: #${fg};
}
EOF
}

# sway-colors.conf is sourced near the top of sway/config.tmpl (before
# the bar blocks) so these \$vars resolve when sway parses bar { }.
write_sway() {
    local dir="$1"; mkdir -p "$dir"
    cat >"$dir/sway-colors.conf" <<EOF
# Generated by .chezmoiscripts/run_onchange_rg-theme-palettes.sh.tmpl
set \$bar_bg          #${bg}
set \$bar_fg          #${fg}
set \$bar_sep         #${b0}
set \$ws_focus_bg     #${r4}
set \$ws_focus_fg     #${bg}
set \$ws_active_bg    #${b0}
set \$ws_active_fg    #${fg}
set \$ws_inactive_bg  #${bg}
set \$ws_inactive_fg  #${b0}
set \$ws_urgent_bg    #${r1}
set \$ws_urgent_fg    #${bg}
set \$border_focus       #${r4}
set \$border_focus_ind   #${b4}
set \$border_unfocus     #${b0}
set \$border_urgent      #${r1}
EOF
}

emit() {
    local palette="$1" mode="$2"
    local dir="$OUT/$palette/$mode"
    write_foot "$dir"
    write_alacritty "$dir"
    write_rofi "$dir"
    write_sway "$dir"
}

# ---------- palettes ----------
# Tomorrow palette: Tomorrow Night (dark) + Solarized Light High Contrast (light)
bg=1d1f21 fg=c5c8c6 \
    r0=5c5e5e r1=cc6666 r2=b5bd68 r3=f0c674 r4=81a2be r5=b294bb r6=8abeb7 r7=c5c8c6 \
    b0=757878 b1=de935f b2=b5bd68 b3=f0c674 b4=81a2be b5=c9b4cf b6=8abeb7 b7=ffffff \
    sel_bg=3f4040 sel_fg=1d1f21 cursor=8d9fa1 \
    emit tomorrow dark

bg=eee8d5 fg=002732 \
    r0=002b36 r1=dc322f r2=859900 r3=b58900 r4=268bd2 r5=d33682 r6=2aa198 r7=eee8d5 \
    b0=073642 b1=cb4b16 b2=586e75 b3=657b83 b4=839496 b5=6c71c4 b6=93a1a1 b7=fdf6e3 \
    sel_bg=cfcac0 sel_fg=002732 cursor=002732 \
    emit tomorrow light

# Catppuccin: Mocha (dark) + Latte (light). Canonical Catppuccin ANSI mapping.
bg=1e1e2e fg=cdd6f4 \
    r0=45475a r1=f38ba8 r2=a6e3a1 r3=f9e2af r4=89b4fa r5=f5c2e7 r6=94e2d5 r7=bac2de \
    b0=585b70 b1=f38ba8 b2=a6e3a1 b3=f9e2af b4=89b4fa b5=f5c2e7 b6=94e2d5 b7=a6adc8 \
    sel_bg=585b70 sel_fg=cdd6f4 cursor=f5e0dc \
    emit catppuccin dark

bg=eff1f5 fg=4c4f69 \
    r0=5c5f77 r1=d20f39 r2=40a02b r3=df8e1d r4=1e66f5 r5=ea76cb r6=179299 r7=acb0be \
    b0=6c6f85 b1=d20f39 b2=40a02b b3=df8e1d b4=1e66f5 b5=ea76cb b6=179299 b7=bcc0cc \
    sel_bg=bcc0cc sel_fg=4c4f69 cursor=dc8a78 \
    emit catppuccin light

# Gruvbox: canonical medium-contrast dark + light variants.
bg=282828 fg=ebdbb2 \
    r0=282828 r1=cc241d r2=98971a r3=d79921 r4=458588 r5=b16286 r6=689d6a r7=a89984 \
    b0=928374 b1=fb4934 b2=b8bb26 b3=fabd2f b4=83a598 b5=d3869b b6=8ec07c b7=ebdbb2 \
    sel_bg=504945 sel_fg=ebdbb2 cursor=ebdbb2 \
    emit gruvbox dark

bg=fbf1c7 fg=3c3836 \
    r0=fbf1c7 r1=cc241d r2=98971a r3=d79921 r4=458588 r5=b16286 r6=689d6a r7=7c6f64 \
    b0=928374 b1=9d0006 b2=79740e b3=b57614 b4=076678 b5=8f3f71 b6=427b58 b7=3c3836 \
    sel_bg=d5c4a1 sel_fg=3c3836 cursor=3c3836 \
    emit gruvbox light

echo "chezmoi: rg-theme palettes regenerated under $OUT"

# If rg-theme is already installed and a state file exists, re-apply so
# the running session picks up any colour tweaks without the user
# having to toggle manually.
if command -v rg-theme >/dev/null 2>&1 && [ -f "$HOME/.local/state/rg-theme/state" ]; then
    rg-theme apply >/dev/null 2>&1 || true
fi
{{- end }}
