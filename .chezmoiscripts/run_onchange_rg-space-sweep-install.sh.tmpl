#!/usr/bin/env bash
{{- if eq .chezmoi.os "linux" }}
# Rebuild rg-space-sweep whenever its chezmoi-managed Rust source changes.
# hash: {{ output "bash" "-lc" (printf "cat %q %q | sha256sum | cut -d' ' -f1" (printf "%s/dot_local/share/rg-space-sweep-src/Cargo.toml" .chezmoi.sourceDir) (printf "%s/dot_local/share/rg-space-sweep-src/main.rs" .chezmoi.sourceDir)) | trim }}

set -euo pipefail

SRC="$HOME/.local/share/rg-space-sweep-src"

if [ ! -d "$SRC" ]; then
    echo "chezmoi: rg-space-sweep source missing at $SRC; skipping install." >&2
    exit 0
fi

if ! command -v cargo >/dev/null 2>&1; then
    echo "chezmoi: cargo not found; skipping rg-space-sweep build." >&2
    exit 0
fi

export CARGO_BUILD_JOBS=4

echo "chezmoi: installing rg-space-sweep via cargo install ..."
cargo install --path "$SRC" --root "$HOME/.local" --force --locked
{{- end }}
