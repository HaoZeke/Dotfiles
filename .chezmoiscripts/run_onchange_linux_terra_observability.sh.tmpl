#!/usr/bin/env bash
{{- if and (eq .chezmoi.os "linux") (eq .chezmoi.hostname "rgam5terra") }}
# The source files are rendered before this hook enables their timers.
set -euo pipefail
SHARE="${HOME}/.local/share/terra-observability"
if [[ ! -d "$SHARE/bin" ]]; then
  echo "chezmoi: missing $SHARE (apply share first)" >&2
  exit 0
fi
# Applied targets (.tmpl renders to these paths on rgam5terra only)
for b in terra-canary-dns terra-canary-heartbeat terra-canary-hermetic terra-notify-telegram; do
  f="${SHARE}/bin/${b}"
  [[ -f "$f" ]] && chmod +x "$f"
done
mkdir -p "${HOME}/.config/terra-observability"
if [[ ! -f "${HOME}/.config/terra-observability/env" && -f "$SHARE/env.example" ]]; then
  install -m 0600 "$SHARE/env.example" "${HOME}/.config/terra-observability/env"
  echo "chezmoi: wrote env.example → ~/.config/terra-observability/env (fill tokens; nimvault seal)"
fi
systemctl --user daemon-reload 2>/dev/null || true
systemctl --user enable --now \
  terra-canary-dns.timer terra-canary-heartbeat.timer terra-canary-hermetic.timer borgmatic.timer 2>/dev/null \
  || echo "chezmoi: enable timers failed (run chezmoi apply for unit tmpls first)" >&2
systemctl --user is-enabled \
  terra-canary-dns.timer terra-canary-heartbeat.timer terra-canary-hermetic.timer borgmatic.timer 2>/dev/null || true
echo "chezmoi: terra-observability done"
{{- end }}
