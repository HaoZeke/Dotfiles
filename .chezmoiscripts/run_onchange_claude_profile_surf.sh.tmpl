#!/usr/bin/env -S bash --norc
{{ $claudeProfile := "none" }}{{ if hasKey . "claude_profile" }}{{ $claudeProfile = .claude_profile }}{{ end }}{{ if eq $claudeProfile "surf" -}}
# Install the curated work-laptop assistant profile.
#
# The profile tree at ~/.claude/profiles/surf is chezmoi-managed and
# age-encrypted at rest. This script wires it into the locations the
# assistant, git, and the prose tools actually read.
#
# Markdown is symlinked so `chezmoi edit` stays the single edit path.
# settings.json is copied, because the client rewrites it in place and an
# atomic rename would replace a symlink with a regular file.
#
# hash: {{ output "bash" "-c" (printf "cat %s/dot_claude/profiles/surf/**/*.age %s/dot_claude/profiles/surf/*.age 2>/dev/null | sha256sum | cut -d' ' -f1" .chezmoi.sourceDir .chezmoi.sourceDir) | trim }}

set -euo pipefail

HOME_DIR="{{ .chezmoi.homeDir }}"
PROFILE="$HOME_DIR/.claude/profiles/surf"

if [ ! -d "$PROFILE" ]; then
    echo "claude-profile: $PROFILE missing, nothing to install" >&2
    exit 0
fi

link() {
    # link <target-path> <relative-source>
    local dest="$1" src="$2"
    mkdir -p "$(dirname "$dest")"
    if [ -e "$dest" ] && [ ! -L "$dest" ]; then
        mv -f "$dest" "$dest.pre-profile"
        echo "claude-profile: kept previous $dest as $dest.pre-profile" >&2
    fi
    ln -sfn "$src" "$dest"
}

# Assistant prompt and style guides.
#
# CLAUDE.md is deliberately not in this list. That path has its own managed
# entry, dot_claude/private_CLAUDE.md.tmpl, which renders the shared globals
# plus the machine-contract override that hands precedence to ~/CLAUDE.md on
# hosts that carry one. Linking it here gave the path two owners that undo each
# other on alternating applies: the template writes a real file, the next run
# of this script moves it to CLAUDE.md.pre-profile and symlinks the profile
# copy, and the template takes it back after that. The leftover .pre-profile
# file is the visible half of that loop.
#
# The three below have no competing entry, so this script is their only owner.
link "$HOME_DIR/.claude/writing-style.md"   "profiles/surf/writing-style.md"
link "$HOME_DIR/.claude/doc-guidelines.md"  "profiles/surf/doc-guidelines.md"
link "$HOME_DIR/.claude/graphviz-style.md"  "profiles/surf/graphviz-style.md"

# Rule manifest targets.
for rule in "$PROFILE"/rules/*.md; do
    [ -e "$rule" ] || continue
    link "$HOME_DIR/.claude/rules/$(basename "$rule")" "../profiles/surf/rules/$(basename "$rule")"
done

# Client-writable settings: copy, do not link.
install -m 0600 "$PROFILE/settings.json" "$HOME_DIR/.claude/settings.json"

# leakguard: global config plus the git hooks that invoke it.
install -Dm 0600 "$PROFILE/leakguard-config.toml" "$HOME_DIR/.config/leakguard/config.toml"
install -Dm 0700 "$PROFILE/git-hooks/pre-commit"  "$HOME_DIR/.config/git/hooks/pre-commit"
install -Dm 0700 "$PROFILE/git-hooks/commit-msg"  "$HOME_DIR/.config/git/hooks/commit-msg"
git config --global core.hooksPath "$HOME_DIR/.config/git/hooks"

# proseguard style profiles.
mkdir -p "$HOME_DIR/.config/proseguard/profiles"
for prof in "$PROFILE"/proseguard-profiles/*.toml; do
    [ -e "$prof" ] || continue
    install -m 0644 "$prof" "$HOME_DIR/.config/proseguard/profiles/$(basename "$prof")"
done

SURF_SKILLS_REPO="$HOME_DIR/Git/Github/Tools/nimtasks-surf"

# Third-party review skills. Cloned as a marketplace but linked directly,
# because the plugin registry keys off a versioned cache directory that is not
# safe to hand-write. Skills under ~/.claude/skills are discovered natively.
PONYTAIL="$HOME_DIR/.claude/plugins/marketplaces/ponytail"
if [ ! -d "$PONYTAIL" ]; then
    git clone -q git@github.com:DietrichGebert/ponytail.git "$PONYTAIL" 2>/dev/null || \
        echo "claude-profile: could not clone the review skills, skipping" >&2
fi
if [ -d "$PONYTAIL/skills" ]; then
    for skill in "$PONYTAIL"/skills/*/; do
        [ -d "$skill" ] || continue
        target="$HOME_DIR/.claude/skills/$(basename "$skill")"
        if [ -e "$target" ] && [ ! -L "$target" ]; then
            echo "claude-profile: $target is a real directory, not linking" >&2
            continue
        fi
        ln -sfn "$skill" "$target"
    done
fi

# The dispatch skill has to be visible to the local harnesses too, not just to
# the assistant, or they never learn to hand work back. Each reads skills from
# its own directory, so link the one copy into all three.
DISPATCH="$SURF_SKILLS_REPO/skills/willma-dispatch"
if [ -d "$DISPATCH" ]; then
    for d in "$HOME_DIR/.local/share/omp-surf/skills/surf" "$HOME_DIR/.hermes/skills"; do
        [ -d "$d" ] || continue
        target="$d/willma-dispatch"
        if [ -e "$target" ] && [ ! -L "$target" ]; then
            echo "claude-profile: $target is a real directory, not linking" >&2
            continue
        fi
        ln -sfn "$DISPATCH" "$target"
    done
    for helper in rg-farm-claude rg-willma-health; do
        [ -x "$DISPATCH/$helper" ] || continue
        install -m 0755 "$DISPATCH/$helper" "$HOME_DIR/.local/bin/$helper"
    done
fi

# Self-test, so the profile can be checked without reconstructing the suite.
if [ -f "$PROFILE/profile-selftest.sh" ]; then
    install -Dm 0755 "$PROFILE/profile-selftest.sh" \
        "$HOME_DIR/.local/bin/rg-surf-profile-selftest"
fi

# surf-work looks for its repo config under XDG before falling back to the
# workstation checkout, so placing it here keeps the CLI working outside the
# assistant session too, where the env block does not apply.
if [ -f "$SURF_SKILLS_REPO/configs/surf-repos.json" ]; then
    install -Dm 0644 "$SURF_SKILLS_REPO/configs/surf-repos.json" \
        "$HOME_DIR/.config/surf-work/surf-repos.json"
fi

# gitguard: shadow the real binaries from the front of PATH. Only wire this
# up when the binary is actually present -- a dangling `git` symlink would
# take the whole toolchain down.
if [ -x "$HOME_DIR/.local/bin/gitguard" ]; then
    for tool in git gh glab lab tea; do
        target="$HOME_DIR/.local/bin/$tool"
        if [ -L "$target" ] || [ ! -e "$target" ]; then
            ln -sfn "$HOME_DIR/.local/bin/gitguard" "$target"
        else
            echo "claude-profile: $target is a real file, not shadowing it" >&2
        fi
    done
else
    echo "claude-profile: gitguard not installed, skipping wrapper symlinks" >&2
fi

# MCP servers. The personal merge script is vault-owned and never lands on
# this host, so the merge is done here from the profile's own snippet.
SNIPPET="$PROFILE/claude-mcp-servers.json"
TARGET="$HOME_DIR/.claude.json"
if [ -f "$SNIPPET" ] && command -v jq >/dev/null 2>&1; then
    EXPANDED=$(sed "s|__HOME__|$HOME_DIR|g" "$SNIPPET")
    if [ ! -f "$TARGET" ]; then
        echo "{\"mcpServers\": $EXPANDED}" | jq . > "$TARGET"
    elif jq -e --argjson servers "$EXPANDED" \
            '(.mcpServers // {}) as $cur | (($cur * $servers) == $cur)' \
            "$TARGET" >/dev/null; then
        # Already merged. Worth checking, because the write below is not free:
        # the client rewrites this file continuously while a session is open,
        # and read-transform-rename drops whatever it wrote in the gap. That
        # file carries the account, the machine id and the project history, so
        # rewriting it to produce byte-identical mcpServers is pure risk.
        :
    else
        # The merge does change something, so it has to run. Narrow the window
        # instead: if the file moved underneath while jq was reading it, the
        # result is built on a stale copy and gets thrown away rather than
        # renamed over the newer one.
        STAMP=$(stat -c '%Y:%s' "$TARGET")
        jq --argjson servers "$EXPANDED" \
            '.mcpServers = (.mcpServers // {}) * $servers' "$TARGET" > "${TARGET}.tmp"
        if [ "$STAMP" = "$(stat -c '%Y:%s' "$TARGET")" ]; then
            mv "${TARGET}.tmp" "$TARGET"
        else
            rm -f "${TARGET}.tmp"
            echo "claude-profile: $TARGET changed while merging, left alone" >&2
        fi
    fi
elif [ -f "$SNIPPET" ]; then
    echo "claude-profile: jq not found, skipping MCP merge" >&2
fi

echo "claude-profile: surf profile installed"
{{ end -}}
