#!/usr/bin/env bash
{{- if and (eq .chezmoi.os "linux") (has .chezmoi.hostname (list "rgx1gen11" "rglat5340")) }}
{{- $helper := joinPath .chezmoi.sourceDir "dot_local/bin/executable_rg-network-ingress-status" }}
{{- if not (stat $helper) }}
# The helper is sealed; this renders again with its hash once it is unsealed.
echo "chezmoi: rg-network-ingress-status is not unsealed yet; skipping ingress setup" >&2
exit 0
{{- else }}
# ingress-helper-sha256: {{ include $helper | sha256sum }}
set -euo pipefail

sudo install -D -m 0755 "$HOME/.local/bin/rg-network-ingress-status" /usr/local/sbin/rg-network-ingress-status

sudoers_tmp=$(mktemp)
trap 'rtrash -f "$sudoers_tmp"' EXIT
cat >"$sudoers_tmp" <<'EOF'
# Read-only fixed-schema firewall and listener verdicts for the network doctor.
rgoswami ALL=(root) NOPASSWD: /usr/local/sbin/rg-network-ingress-status
EOF
sudo visudo -cf "$sudoers_tmp" >/dev/null
sudo install -D -m 0440 -o root -g root "$sudoers_tmp" /etc/sudoers.d/rg-network-ingress-status
{{- end }}
{{- end }}
