{{- if and (eq .chezmoi.os "linux") (eq .chezmoi.hostname "rgSURFLat") -}}
#!/usr/bin/env bash
# rgSURFLat: runtime deps + secret injection.
# Host config/AGENTS/mcp/models structure: git-tracked .tmpl under dot_omp/agent/
# Hash: specialize-v15-willma-devtools-hermes
# Re-run whenever a target carrying an injected secret changes, so a freshly
# applied models.yml / config.yml / mcp.json never keeps its PLACEHOLDER value:
#   models.yml {{ include "dot_omp/agent/encrypted_models.yml.tmpl.age" | sha256sum }}
#   config.yml {{ include "dot_omp/agent/encrypted_config.yml.tmpl.age" | sha256sum }}
#   mcp.json   {{ include "dot_omp/agent/encrypted_mcp.json.tmpl.age" | sha256sum }}
set -euo pipefail

export PATH="${HOME}/.bun/bin:${HOME}/.local/bin:${HOME}/.opencode/bin:${HOME}/.cargo/bin:${PATH}"
log() { printf 'chezmoi rgsurflat-omp: %s\n' "$*"; }

AGENT="${HOME}/.omp/agent"
SHARE="${HOME}/.local/share/omp-surf"
TOOLS="${HOME}/Git/Github/Tools"
PI_ENV="${TOOLS}/pi_env"
EB_STACK="${TOOLS}/eb-stack"
OMP_VER="${OMP_VERSION:-16.4.6}"
RTK_VER="${RTK_VERSION:-0.43.0}"
OPENCODE_VER="${OPENCODE_VERSION:-1.17.18}"

mkdir -p "${AGENT}/extensions" "${HOME}/.omp/extensions" \
  "${HOME}/.local/bin" "${HOME}/.claude/hooks" \
  "${HOME}/.config/context7" "${HOME}/.config/ookcite" \
  "${HOME}/.config/surf-ai-hub" "${HOME}/.config/opencode" "${TOOLS}"

# ---------- PATH durability (bash) ----------
# posix.d/05_paths.sh carries these for both shells. Appending to .bashrc as
# well makes chezmoi strip the line on every apply and this script put it
# straight back, so the host never reaches a clean state. Only fall back to
# the append when the shared file is missing or does not carry the dirs.
shared_paths="${HOME}/.config/shellrc/posix.d/05_paths.sh"
if ! grep -q '\.bun/bin' "$shared_paths" 2>/dev/null \
  && [[ -f "${HOME}/.bashrc" ]] && ! grep -q '\.bun/bin' "${HOME}/.bashrc" 2>/dev/null; then
  printf '\n# SURF OMP / tooling\nexport PATH="$HOME/.bun/bin:$HOME/.local/bin:$HOME/.cargo/bin:$HOME/.opencode/bin:$PATH"\n' \
    >> "${HOME}/.bashrc"
  log "appended PATH to .bashrc (shared paths file did not carry it)"
fi

# ---------- bun + omp ----------
if ! command -v bun >/dev/null 2>&1; then
  log "installing bun"
  curl -fsSL https://bun.sh/install | bash
  export PATH="${HOME}/.bun/bin:${PATH}"
fi
need_omp=1
if command -v omp >/dev/null 2>&1; then
  cur=$(omp --version 2>/dev/null | head -1 || true)
  [[ "$cur" == *"${OMP_VER}"* ]] && need_omp=0 && log "omp ${cur}"
fi
if [[ "$need_omp" -eq 1 ]]; then
  log "installing @oh-my-pi/pi-coding-agent@${OMP_VER}"
  bun install -g "@oh-my-pi/pi-coding-agent@${OMP_VER}"
fi

command -v jq >/dev/null 2>&1 || log "WARN: jq missing (rtk-rewrite may no-op)"

# ---------- vale styles sync (prose linting packages) ----------
VALE_CFG_DIR="${HOME}/.config/vale"
if command -v vale >/dev/null 2>&1; then
  if [[ -d "${VALE_CFG_DIR}" && ! -d "${VALE_CFG_DIR}/styles/proselint" ]]; then
    log "vale: styles missing proselint, running vale sync"
    if (cd "${VALE_CFG_DIR}" && vale sync >/dev/null 2>&1); then
      log "vale sync complete"
    else
      log "WARN: vale sync failed"
    fi
  else
    log "vale: styles present"
  fi
else
  log "vale: not installed, skipping style sync"
fi

# ---------- uv + hermes ----------
if ! command -v uv >/dev/null 2>&1; then
  log "installing uv"
  curl -fsSL https://astral.sh/uv/install.sh | sh
  export PATH="${HOME}/.local/bin:${HOME}/.cargo/bin:${PATH}"
fi
if ! command -v hermes >/dev/null 2>&1 && [[ ! -x "${HOME}/.local/bin/hermes" ]]; then
  log "installing hermes-agent via uv"
  uv tool install hermes-agent 2>/dev/null \
    || uv tool install --from git+https://github.com/NousResearch/hermes-agent.git hermes-agent 2>/dev/null \
    || log "WARN: hermes uv install failed (devtools script may cover)"
fi
if [[ ! -x "${HOME}/.local/bin/hermes" ]]; then
  for c in \
    "${HOME}/.local/share/uv/tools/hermes-agent/bin/hermes" \
    "${HOME}/.local/bin/hermes-agent"
  do
    [[ -x "$c" ]] && ln -sfn "$c" "${HOME}/.local/bin/hermes" && break
  done
fi
log "hermes=$(command -v hermes || echo missing)"

# ---------- RTK ----------
if ! command -v rtk >/dev/null 2>&1; then
  tmp=$(mktemp -d)
  url="https://github.com/rtk-ai/rtk/releases/download/v${RTK_VER}/rtk-x86_64-unknown-linux-musl.tar.gz"
  log "installing rtk ${RTK_VER}"
  if curl -fsSL "$url" -o "${tmp}/rtk.tgz"; then
    tar -C "$tmp" -xzf "${tmp}/rtk.tgz"
    find "$tmp" -type f -name rtk -exec install -m 0755 {} "${HOME}/.local/bin/rtk" \;
  fi
  rm -rf "$tmp"
else
  log "rtk: $(rtk --version 2>/dev/null | head -1 || echo ok)"
fi

# ---------- OpenCode (secondary Willma harness) ----------
need_oc=1
if command -v opencode >/dev/null 2>&1; then
  ocver=$(opencode --version 2>/dev/null | head -1 || true)
  log "opencode ${ocver}"
  need_oc=0
elif [[ -x "${HOME}/.opencode/bin/opencode" ]]; then
  log "opencode at ~/.opencode/bin"
  need_oc=0
  ln -sfn "${HOME}/.opencode/bin/opencode" "${HOME}/.local/bin/opencode"
fi
if [[ "$need_oc" -eq 1 ]]; then
  log "installing opencode ${OPENCODE_VER}"
  if curl -fsSL https://opencode.ai/install | bash -s -- --version "${OPENCODE_VER}" 2>/dev/null \
    || curl -fsSL https://opencode.ai/install | bash 2>/dev/null; then
    export PATH="${HOME}/.opencode/bin:${PATH}"
    [[ -x "${HOME}/.opencode/bin/opencode" ]] && \
      ln -sfn "${HOME}/.opencode/bin/opencode" "${HOME}/.local/bin/opencode"
  else
    log "WARN: opencode install failed (secondary harness optional)"
  fi
fi

# ---------- pi_env + eb-stack (source trees) ----------
if [[ ! -d "${PI_ENV}/.git" ]]; then
  git clone --depth 1 git@github.com:HaoZeke/pi_env.git "${PI_ENV}" 2>/dev/null \
    || git clone --depth 1 https://github.com/HaoZeke/pi_env.git "${PI_ENV}" 2>/dev/null \
    || log "WARN: pi_env clone failed"
fi
if [[ ! -d "${EB_STACK}/.git" ]]; then
  git clone --depth 1 git@github.com:HaoZeke/eb-stack.git "${EB_STACK}" 2>/dev/null \
    || git clone --depth 1 https://github.com/HaoZeke/eb-stack.git "${EB_STACK}" 2>/dev/null \
    || log "WARN: eb-stack clone failed"
fi

# ---------- eb-stack binary (MCP + CLI); never build here — pull if missing ----------
if [[ ! -x "${HOME}/.local/bin/eb-stack" ]]; then
  if [[ -x "${EB_STACK}/target/release/eb-stack" ]]; then
    install -m 0755 "${EB_STACK}/target/release/eb-stack" "${HOME}/.local/bin/eb-stack"
    log "eb-stack from local release build"
  elif command -v scp >/dev/null 2>&1; then
    # Prefer prebuilt from rg.terra or the multi-agent workstation via Tailscale
    for src in "rg.terra:${HOME}/.local/bin/eb-stack" "rgx1gen11:${HOME}/.local/bin/eb-stack"; do
      if scp -o ConnectTimeout=5 -o BatchMode=yes "$src" "${HOME}/.local/bin/eb-stack.tmp" 2>/dev/null; then
        mv "${HOME}/.local/bin/eb-stack.tmp" "${HOME}/.local/bin/eb-stack"
        chmod 755 "${HOME}/.local/bin/eb-stack"
        log "eb-stack pulled from ${src%%:*}"
        break
      fi
    done
  fi
  [[ -x "${HOME}/.local/bin/eb-stack" ]] || log "WARN: eb-stack binary missing (MCP optional)"
else
  log "eb-stack: $(eb-stack --version 2>/dev/null | head -1 || echo present)"
fi

# ---------- pack wrappers / extensions ----------
[[ -x "${SHARE}/bin/ookcite-mcp-pass" ]] && \
  install -m 0755 "${SHARE}/bin/ookcite-mcp-pass" "${HOME}/.local/bin/ookcite-mcp-pass"
[[ -x "${SHARE}/bin/vault-remote-serve" ]] && \
  install -m 0755 "${SHARE}/bin/vault-remote-serve" "${HOME}/.local/bin/vault-remote-serve"

if [[ -f "${SHARE}/gpt-oss-priors.ts" ]]; then
  install -m 0644 "${SHARE}/gpt-oss-priors.ts" "${AGENT}/extensions/gpt-oss-priors.ts"
fi
if [[ -f "${SHARE}/extensions/rtk-rewrite.ts" ]]; then
  install -m 0644 "${SHARE}/extensions/rtk-rewrite.ts" "${AGENT}/extensions/rtk-rewrite.ts"
  install -m 0644 "${SHARE}/extensions/rtk-rewrite.ts" "${HOME}/.omp/extensions/rtk-rewrite.ts"
fi
if [[ -d "${PI_ENV}/.omp/extensions" ]]; then
  # Do NOT install dirty-repo-guard into agent/extensions (blocks -p on dirty trees).
  for ext in code-search.ts fast-tools.ts writing-quality.ts; do
    [[ -f "${PI_ENV}/.omp/extensions/${ext}" ]] && \
      install -m 0644 "${PI_ENV}/.omp/extensions/${ext}" "${AGENT}/extensions/${ext}"
  done
  # Keep a copy off the auto-load path for optional interactive use
  if [[ -f "${PI_ENV}/.omp/extensions/dirty-repo-guard.ts" ]]; then
    mkdir -p "${SHARE}/extensions-optional"
    install -m 0644 "${PI_ENV}/.omp/extensions/dirty-repo-guard.ts" \
      "${SHARE}/extensions-optional/dirty-repo-guard.ts"
  fi
fi
# Remove auto-loaded dirty-repo-guard if a previous specialize installed it
if [[ -f "${AGENT}/extensions/dirty-repo-guard.ts" ]]; then
  mkdir -p "${SHARE}/extensions-optional"
  mv -f "${AGENT}/extensions/dirty-repo-guard.ts" \
    "${SHARE}/extensions-optional/dirty-repo-guard.ts"
  log "moved dirty-repo-guard out of auto-load path"
fi
[[ -f "${SHARE}/hooks/rtk-rewrite.sh" ]] && \
  install -m 0755 "${SHARE}/hooks/rtk-rewrite.sh" "${HOME}/.claude/hooks/rtk-rewrite.sh"

# ---------- orphan skill cleanup ----------
if [[ -d "${SHARE}/skills/superpowers-extended" ]]; then
  # Not in config keep set; leave tree but log — do not rtrash without user ask
  log "note: orphan skills/superpowers-extended present (not in customDirectories)"
fi

# ---------- Puppeteer node_modules ----------
if [[ -f "${SHARE}/puppeteer/puppeteer_mcp.js" ]]; then
  mkdir -p "${HOME}/.omp/puppeteer"
  install -m 0644 "${SHARE}/puppeteer/puppeteer_mcp.js" "${HOME}/.omp/puppeteer/puppeteer_mcp.js"
  install -m 0644 "${SHARE}/puppeteer/package.json" "${HOME}/.omp/puppeteer/package.json"
  if [[ ! -d "${HOME}/.omp/puppeteer/node_modules/@modelcontextprotocol" ]]; then
    log "installing puppeteer MCP deps"
    (cd "${HOME}/.omp/puppeteer" && bun install) || true
  fi
fi

# ---------- resolve Willma token ----------
models="${AGENT}/models.yml"
token=""
if command -v pass >/dev/null 2>&1 && pass show surf/ai-hub/token >/dev/null 2>&1; then
  token=$(pass show surf/ai-hub/token | head -n1 | tr -d '\r\n')
elif [[ -f "${HOME}/.config/surf-ai-hub/api_key" ]]; then
  token=$(tr -d '\r\n' < "${HOME}/.config/surf-ai-hub/api_key")
elif [[ -n "${SURF_AI_HUB_TOKEN:-}" ]]; then
  token="${SURF_AI_HUB_TOKEN}"
elif [[ -f "$models" ]]; then
  token=$(python3 - <<'PY' 2>/dev/null || true
import re
from pathlib import Path
t=Path.home().joinpath(".omp/agent/models.yml").read_text()
m=re.search(r'apiKey:\s*["\']?([^"\'\n]+)', t)
if m and "PLACEHOLDER" not in m.group(1):
    print(m.group(1).strip())
PY
)
fi
if [[ -n "${token}" ]]; then
  printf '%s\n' "$token" > "${HOME}/.config/surf-ai-hub/api_key"
  chmod 600 "${HOME}/.config/surf-ai-hub/api_key"
fi
if [[ -f "$models" && -n "${token}" ]]; then
  export WILLMA_TOKEN="$token" WILLMA_MODELS="$models"
  python3 - <<'PY'
import os, re
from pathlib import Path
p=Path(os.environ["WILLMA_MODELS"])
tok=os.environ["WILLMA_TOKEN"]
t=p.read_text()
t2,n=re.subn(r'(apiKey:\s*)(["\']?)[^"\'\n]+\2',
             lambda m: m.group(1)+'"'+tok.replace("\\","\\\\").replace('"','\\"')+'"',
             t, count=1)
if n==0:
    t2=t.replace("WILLMA_TOKEN_PLACEHOLDER", tok)
p.write_text(t2)
print("models.yml token injected")
PY
else
  log "WARN: could not inject Willma token"
fi

# ---------- inject Willma token into config mnemopi embeddingApiKey ----------
cfg="${AGENT}/config.yml"
if [[ -f "$cfg" && -n "${token}" ]]; then
  export WILLMA_TOKEN="$token" WILLMA_CFG="$cfg"
  python3 - <<'PY'
import os, re
from pathlib import Path
p = Path(os.environ["WILLMA_CFG"])
tok = os.environ["WILLMA_TOKEN"]
t = p.read_text()
esc = tok.replace("\\", "\\\\").replace('"', '\\"')
t2, n = re.subn(
    r'(embeddingApiKey:\s*)(["\']?)[^"\'\n]+\2',
    lambda m: m.group(1) + '"' + esc + '"',
    t,
    count=1,
)
if n == 0 and "WILLMA_TOKEN_PLACEHOLDER" in t:
    t2 = t.replace("WILLMA_TOKEN_PLACEHOLDER", tok)
    n = 1
if n:
    p.write_text(t2)
    print("config.yml mnemopi embeddingApiKey injected")
else:
    print("config.yml: no embeddingApiKey placeholder to inject")
PY
fi

# ---------- OpenCode Willma config (secondary) ----------
if [[ -n "${token}" ]]; then
  export WILLMA_TOKEN="$token"
  python3 - <<'PY'
import json, os
from pathlib import Path
tok = os.environ["WILLMA_TOKEN"]
p = Path.home() / ".config/opencode/opencode.json"
doc = {
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "willma": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "SURF Willma",
      "options": {
        "baseURL": "https://willma.surf.nl/api/v0",
        "apiKey": tok,
      },
      "models": {
        "openai/gpt-oss-120b": {
          "name": "GPT-OSS 120B (Willma)",
        }
      },
    }
  },
  "model": "willma/openai/gpt-oss-120b",
}
p.parent.mkdir(parents=True, exist_ok=True)
p.write_text(json.dumps(doc, indent=2) + "\n")
p.chmod(0o600)
print("opencode.json Willma written")
PY
fi

# ---------- inject Context7 key into mcp.json; drop eb-stack MCP if bin missing ----------
mcp="${AGENT}/mcp.json"
if [[ -f "$mcp" ]]; then
  export CTX7_KEY=""
  [[ -f "${HOME}/.config/context7/api_key" ]] && \
    CTX7_KEY=$(tr -d '\r\n' < "${HOME}/.config/context7/api_key")
  export MCP_PATH="$mcp" CTX7_KEY
  export EB_STACK_BIN="${HOME}/.local/bin/eb-stack"
  python3 - <<'PY'
import json, os
from pathlib import Path
p = Path(os.environ["MCP_PATH"])
d = json.loads(p.read_text())
servers = d.setdefault("mcpServers", {})
key = os.environ.get("CTX7_KEY") or ""
if key:
    s = servers.setdefault("context7", {"type": "stdio", "command": "bunx", "args": []})
    args = s.get("args") or ["-y", "@upstash/context7-mcp"]
    out = []
    skip = False
    for a in args:
        if skip:
            skip = False
            continue
        if a == "--api-key":
            skip = True
            continue
        out.append(a)
    if "-y" not in out:
        out = ["-y", "@upstash/context7-mcp"] + out
    out = out + ["--api-key", key]
    s["args"] = out
    s["command"] = s.get("command") or "bunx"
# eb-stack MCP only if binary exists
eb = Path(os.environ.get("EB_STACK_BIN", ""))
if eb.is_file() and os.access(eb, os.X_OK):
    servers["eb-stack"] = {
        "type": "stdio",
        "command": str(eb),
        "args": ["mcp"],
    }
else:
    servers.pop("eb-stack", None)
p.write_text(json.dumps(d, indent=2) + "\n")
print("mcp.json patched; servers=", sorted(servers))
PY
fi

# ---------- seed eb-stack project-ctx ----------
if [[ -d "${EB_STACK}" && -f "${SHARE}/project-ctx-seeds/eb-stack.project-ctx.toml" ]]; then
  install -m 0644 "${SHARE}/project-ctx-seeds/eb-stack.project-ctx.toml" \
    "${EB_STACK}/.project-ctx.toml"
  log "seeded eb-stack .project-ctx.toml"
fi

# ---------- wizard skip ----------
db="${AGENT}/agent.db"
if command -v sqlite3 >/dev/null 2>&1 && [[ -f "$db" ]]; then
  sqlite3 "$db" "INSERT OR REPLACE INTO settings (key,value) VALUES ('setupVersion','1');"
  sqlite3 "$db" "INSERT OR REPLACE INTO settings (key,value) VALUES ('startup.setupWizard','false');"
fi

# ---------- wrappers (match chezmoi executable_omp-surf) ----------
for name in omp-surf omp-eb-stack; do
  cat > "${HOME}/.local/bin/${name}" <<'WRAP'
#!/usr/bin/env bash
set -euo pipefail
export PATH="$HOME/.bun/bin:$HOME/.local/bin:$HOME/.cargo/bin:$HOME/.opencode/bin:$PATH"
exts=()
for e in \
  "$HOME/.omp/agent/extensions/gpt-oss-priors.ts" \
  "$HOME/.omp/agent/extensions/rtk-rewrite.ts" \
  "$HOME/.omp/agent/extensions/code-search.ts" \
  "$HOME/.omp/agent/extensions/fast-tools.ts" \
  "$HOME/.omp/agent/extensions/writing-quality.ts"
do
  [[ -f "$e" ]] && exts+=(-e "$e")
done
exec omp --model surf-ai-hub/openai/gpt-oss-120b --thinking high --advisor "${exts[@]}" "$@"
WRAP
  chmod 755 "${HOME}/.local/bin/${name}"
done

[[ -f "${SHARE}/README-SURF.txt" ]] && \
  install -m 0644 "${SHARE}/README-SURF.txt" "${HOME}/.omp/README-SURF.txt"

# doctor is managed by chezmoi as executable_omp-surf-doctor; ensure executable
[[ -f "${HOME}/.local/bin/omp-surf-doctor" ]] && chmod 755 "${HOME}/.local/bin/omp-surf-doctor"

log "omp=$(omp --version 2>/dev/null | head -1)"
log "mcp=$(python3 -c 'import json;from pathlib import Path;print(sorted(json.loads(Path.home().joinpath(".omp/agent/mcp.json").read_text()).get("mcpServers",{})))' 2>/dev/null || echo missing)"
log "eb-stack=$(command -v eb-stack || echo missing)"
log "opencode=$(command -v opencode || echo missing)"
if command -v omp >/dev/null 2>&1 && [[ -f "$models" ]] && ! grep -q PLACEHOLDER "$models" 2>/dev/null; then
  out=$(omp -p --mode text --no-session --allow-home "Reply with exactly: pong" 2>&1 | tail -2 || true)
  log "smoke: ${out//$'\n'/ | }"
fi
if command -v omp-surf-doctor >/dev/null 2>&1; then
  omp-surf-doctor 2>&1 | tail -20 | while read -r line; do log "doctor: $line"; done || true
fi
log "done: specialize-v15 SURF OMP"
{{- end }}
