#!/usr/bin/env bash
{{- if and (eq .chezmoi.os "linux") (eq .chezmoi.hostname "rgx1gen11") }}
# Keep the US-egress WireGuard tunnel carrying traffic, defensively layered:
#   1. networkd is told not to reap foreign routes/policy rules, so a networkd
#      restart cannot flush wg-quick's full-tunnel routing (the root cause).
#   2. the tunnel + tailscale interfaces are marked Unmanaged so networkd never
#      touches them either.
#   3. a real-time watcher reacts to every netlink change and re-asserts egress
#      immediately.
#   4. a periodic timer is the backstop.
# All of it is inert until wg-quick@rg-us-egress-wg is enabled.
set -euo pipefail

GUARD_SRC="$HOME/.local/bin/rg-us-egress-guard"
WATCH_SRC="$HOME/.local/bin/rg-us-egress-watch"
if [ ! -x "$GUARD_SRC" ] || [ ! -x "$WATCH_SRC" ]; then
    echo "chezmoi: us-egress guard/watch scripts missing; skipping install." >&2
    exit 0
fi

install_root() {
    local dest="$1" mode="$2" tmp
    tmp="$(mktemp)"
    cat >"$tmp"
    if ! sudo test -f "$dest" || ! sudo cmp -s "$tmp" "$dest"; then
        echo "chezmoi: updating $dest"
        sudo install -D -m "$mode" -o root -g root "$tmp" "$dest"
    fi
    rm -f "$tmp"
}

install_bin() {
    local src="$1" dest="$2"
    if ! sudo cmp -s "$src" "$dest" 2>/dev/null; then
        echo "chezmoi: updating $dest"
        sudo install -D -m 0755 -o root -g root "$src" "$dest"
    fi
}

# Root-owned copies of the managed scripts (systemd runs them as root).
install_bin "$GUARD_SRC" /usr/local/sbin/rg-us-egress-guard
install_bin "$WATCH_SRC" /usr/local/sbin/rg-us-egress-watch

# (1) Root cause: stop networkd reaping rules/routes it did not create.
install_root /etc/systemd/networkd.conf.d/10-rg-keep-foreign-routes.conf 0644 <<'EOF'
# Managed by chezmoi (run_onchange_linux_us_egress_guard.sh.tmpl).
# Do not let systemd-networkd delete routes or routing-policy rules it did not
# create. wg-quick installs a full-tunnel default route in table 51820 plus the
# policy rules that steer traffic into it; with the defaults (yes) a networkd
# restart flushes those and egress silently falls back to the main route.
[Network]
ManageForeignRoutes=no
ManageForeignRoutingPolicyRules=no
EOF

# (2) Belt-and-braces: keep the tunnel + tailscale interfaces unmanaged.
install_root /etc/systemd/network/05-rg-tunnels-unmanaged.network 0644 <<'EOF'
# Managed by chezmoi (run_onchange_linux_us_egress_guard.sh.tmpl).
[Match]
Name=rg-us-egress-wg tailscale0

[Link]
Unmanaged=yes
EOF

# (3) Real-time watcher: react to every netlink change.
install_root /etc/systemd/system/rg-us-egress-watch.service 0644 <<'EOF'
[Unit]
Description=Real-time guard for the US-egress WireGuard tunnel
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/rg-us-egress-watch
Restart=always
RestartSec=3
Nice=5

[Install]
WantedBy=default.target
EOF

# (4) Periodic backstop.
install_root /etc/systemd/system/rg-us-egress-guard.service 0644 <<'EOF'
[Unit]
Description=Re-assert the US-egress WireGuard tunnel if it dropped
After=network.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/rg-us-egress-guard
EOF

install_root /etc/systemd/system/rg-us-egress-guard.timer 0644 <<'EOF'
[Unit]
Description=Periodic check that the US-egress tunnel stays up

[Timer]
OnBootSec=20s
OnUnitActiveSec=30s
AccuracySec=5s

[Install]
WantedBy=timers.target
EOF

# (5) Boot-time bring-up: run the full rg-us-egress-up (tunnel + DNS resettle +
# carve-outs) at boot so the Houston egress is up without a manual step. The
# guard/watch above keep it healthy afterwards.
install_root /etc/systemd/system/rg-us-egress.service 0644 <<'EOF'
[Unit]
Description=rg US (Houston) full-tunnel egress
Wants=network-online.target
After=network-online.target tailscaled.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=RG_US_EGRESS_CONF={{ .chezmoi.homeDir }}/.config/rg-us-egress/wireguard.conf
ExecStart={{ .chezmoi.homeDir }}/.local/bin/rg-us-egress-up
ExecStop=/usr/bin/wg-quick down rg-us-egress-wg
TimeoutStartSec=150

[Install]
WantedBy=multi-user.target
EOF

# Keyboard: kanata is the single Colemak source (runs via user-linger, so it is
# active even at the greeter). Keep the console/greeter keymap on plain "us" so
# it does not re-map kanata's already-Colemak output -- that double pass was the
# "colemak on colemak" scramble at the login greeter.
if [ "$(localectl status 2>/dev/null | awk '/VC Keymap/{print $NF}')" != "us" ]; then
    sudo localectl set-keymap us && echo "chezmoi: VC keymap -> us (kanata provides Colemak)"
fi

sudo systemctl daemon-reload
sudo systemctl enable --now rg-us-egress-watch.service
sudo systemctl enable --now rg-us-egress-guard.timer
sudo systemctl enable rg-us-egress.service
{{- end }}
