#!/usr/bin/env bash
{{- if and (eq .chezmoi.os "linux") (eq .chezmoi.hostname "rgx1gen11") }}
# Install US-egress WireGuard helpers without making base networking depend on
# the full-tunnel path. Deliberate autostart is controlled by
# RG_US_EGRESS_AUTOSTART=1 in chezmoi's environment:
#   1. networkd is told not to reap foreign routes/policy rules, so a networkd
#      restart cannot flush wg-quick's full-tunnel routing.
#   2. the tunnel + tailscale interfaces are marked Unmanaged so networkd never
#      touches them either.
#   3. a manual activation unit runs the tunnel + DNS resettle + carve-outs.
#   4. the periodic guard timer exists for explicit autostart, disabled by
#      default. The retired real-time netlink watcher is actively removed:
#      the 30s serialized guard covers its job without the restart races.
set -euo pipefail

# Root provisioning must never hang a plain `chezmoi apply` on a password
# prompt. Without cached sudo credentials, skip cleanly; `rg-net provision`
# is the explicit interactive path.
if ! sudo -n true 2>/dev/null; then
    echo "chezmoi: no cached sudo credentials; skipping egress provisioning (run: rg-net provision)" >&2
    exit 0
fi

GUARD_SRC="$HOME/.local/bin/rg-us-egress-guard"
AKAMAI_SRC="$HOME/.local/bin/rg-tunnel-akamai-carveout"
if [ ! -x "$GUARD_SRC" ]; then
    echo "chezmoi: us-egress guard script missing; skipping install." >&2
    exit 0
fi

install_root() {
    local dest="$1" mode="$2" tmp
    tmp="$(mktemp)"
    cat >"$tmp"
    if ! sudo test -f "$dest" || ! sudo cmp -s "$tmp" "$dest"; then
        echo "chezmoi: updating $dest"
        sudo install -D -m "$mode" -o root -g root "$tmp" "$dest"
    fi
    rm -f "$tmp"
}

install_bin() {
    local src="$1" dest="$2"
    if ! sudo cmp -s "$src" "$dest" 2>/dev/null; then
        echo "chezmoi: updating $dest"
        sudo install -D -m 0755 -o root -g root "$src" "$dest"
    fi
}

# Root-owned copies of the managed scripts (systemd runs them as root).
install_bin "$GUARD_SRC" /usr/local/sbin/rg-us-egress-guard
[ -x "$AKAMAI_SRC" ] && install_bin "$AKAMAI_SRC" /usr/local/sbin/rg-tunnel-akamai-carveout

# (1) Root cause: stop networkd reaping rules/routes it did not create.
install_root /etc/systemd/networkd.conf.d/10-rg-keep-foreign-routes.conf 0644 <<'EOF'
# Managed by chezmoi (run_onchange_linux_us_egress_guard.sh.tmpl).
# Do not let systemd-networkd delete routes or routing-policy rules it did not
# create. wg-quick installs a full-tunnel default route in table 51820 plus the
# policy rules that steer traffic into it; with the defaults (yes) a networkd
# restart flushes those and egress silently falls back to the main route.
[Network]
ManageForeignRoutes=no
ManageForeignRoutingPolicyRules=no
EOF

# (2) Belt-and-braces: keep the tunnel + tailscale interfaces unmanaged.
install_root /etc/systemd/network/05-rg-tunnels-unmanaged.network 0644 <<'EOF'
# Managed by chezmoi (run_onchange_linux_us_egress_guard.sh.tmpl).
[Match]
Name=rg-us-egress-wg tailscale0

[Link]
Unmanaged=yes
EOF

# (3) Retire the legacy real-time watcher wherever it is still installed. Two
# concurrent restart paths (netlink watch + timer) raced each other into
# half-applied wg-quick state; the serialized 30s timer is the single restart
# authority now, and rg-net-recover treats an active watcher as unsafe.
sudo systemctl disable --now rg-us-egress-watch.service >/dev/null 2>&1 || true
sudo rm -f /etc/systemd/system/rg-us-egress-watch.service /usr/local/sbin/rg-us-egress-watch

# (4) Periodic backstop.
install_root /etc/systemd/system/rg-us-egress-guard.service 0644 <<'EOF'
[Unit]
Description=Re-assert the US-egress WireGuard tunnel if it dropped
After=network.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/rg-us-egress-guard
EOF

install_root /etc/systemd/system/rg-us-egress-guard.timer 0644 <<'EOF'
[Unit]
Description=Periodic check that the US-egress tunnel stays up

[Timer]
OnBootSec=20s
OnUnitActiveSec=30s
AccuracySec=5s

[Install]
WantedBy=timers.target
EOF

# (5) Manual activation unit: run the full rg-us-egress-up (tunnel + DNS
# resettle + carve-outs) when the unit is explicitly started. The unit has an
# [Install] section so RG_US_EGRESS_AUTOSTART=1 can opt into boot activation.
install_root /etc/systemd/system/rg-us-egress.service 0644 <<'EOF'
[Unit]
Description=rg US (Houston) full-tunnel egress
Wants=network-online.target
After=network-online.target tailscaled.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=RG_US_EGRESS_CONF={{ .chezmoi.homeDir }}/.config/rg-us-egress/wireguard.conf
ExecStart={{ .chezmoi.homeDir }}/.local/bin/rg-us-egress-up
ExecStop=/bin/sh -c '/usr/bin/wg-quick down rg-us-egress-wg 2>/dev/null || true'
TimeoutStartSec=150

[Install]
WantedBy=multi-user.target
EOF

# (6) Akamai carve-out refresh: keep the cached Akamai prefix set current so
# CDN-fronted NL sites keep egressing on the local uplink (not the US exit IP).
# rg-us-egress-up runs `up` on bring-up from a warm cache; this timer refetches.
install_root /etc/systemd/system/rg-akamai-carveout-refresh.service 0644 <<'EOF'
[Unit]
Description=Refresh Akamai prefix carve-out around the US-egress tunnel
After=network-online.target rg-us-egress.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/rg-tunnel-akamai-carveout refresh
EOF

install_root /etc/systemd/system/rg-akamai-carveout-refresh.timer 0644 <<'EOF'
[Unit]
Description=Periodically refresh the Akamai carve-out prefix set

[Timer]
OnBootSec=3min
OnUnitActiveSec=12h
AccuracySec=5min
Persistent=true

[Install]
WantedBy=timers.target
EOF

# Keyboard: kanata is the single Colemak source (runs via user-linger, so it is
# active even at the greeter). Keep the console/greeter keymap on plain "us" so
# it does not re-map kanata's already-Colemak output -- that double pass was the
# "colemak on colemak" scramble at the login greeter.
if [ "$(localectl status 2>/dev/null | awk '/VC Keymap/{print $NF}')" != "us" ]; then
    sudo localectl set-keymap us && echo "chezmoi: VC keymap -> us (kanata provides Colemak)"
fi

sudo systemctl daemon-reload
if [ "${RG_US_EGRESS_AUTOSTART:-0}" = "1" ]; then
    sudo systemctl enable --now rg-us-egress-guard.timer
    sudo systemctl enable --now rg-us-egress.service
    [ -x /usr/local/sbin/rg-tunnel-akamai-carveout ] && sudo systemctl enable --now rg-akamai-carveout-refresh.timer
else
    sudo systemctl disable --now rg-us-egress-guard.timer rg-us-egress.service rg-akamai-carveout-refresh.timer >/dev/null 2>&1 || true
    sudo systemctl stop wg-quick@rg-us-egress-wg.service >/dev/null 2>&1 || true
    if [ -x /usr/local/sbin/rg-tunnel-akamai-carveout ]; then
        sudo /usr/local/sbin/rg-tunnel-akamai-carveout down >/dev/null 2>&1 || true
    fi
    echo "chezmoi: US egress services installed; autostart disabled (set RG_US_EGRESS_AUTOSTART=1 to opt in)"
fi
{{- end }}
