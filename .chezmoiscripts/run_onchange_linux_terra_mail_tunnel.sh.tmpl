#!/usr/bin/env bash
{{- if and (eq .chezmoi.os "linux") (eq .chezmoi.hostname "rgx1gen11") }}
set -euo pipefail

systemctl --user daemon-reload 2>/dev/null || true
systemctl --user enable terra-mail-tunnel.service >/dev/null 2>&1 || true

listeners="$(ss -ltn '( sport = :1143 )' 2>/dev/null || true)"
if ! grep -q '127\.0\.0\.1:1143' <<<"$listeners" || ! grep -q '\[::1\]:1143' <<<"$listeners"; then
  systemctl --user restart terra-mail-tunnel.service 2>/dev/null || true
fi

# Daily borg backup of the mail (staged from Terra) + this machine's config
# into the long-standing pCloud repo, whenever the FUSE client is mounted;
# alerts after 7 stale days so an unmounted client cannot silently mean no
# backup.
systemctl --user enable --now rg-mail-pcloud-backup.timer >/dev/null 2>&1 \
  || echo "chezmoi: rg-mail-pcloud-backup.timer not enabled yet" >&2
{{- end }}
