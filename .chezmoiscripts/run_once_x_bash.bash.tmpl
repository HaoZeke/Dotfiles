#!/usr/bin/env bash
{{ if and (eq .chezmoi.os "linux") (eq .chezmoi.hostname "rgx1gen11") (lookPath "bash") -}}
# x-cmd CLI bundle for rgx1gen11 only.
# Nounset stays off: x-cmd's sourced X file references private vars
# like ___X_CMD_ROOT before initializing them, and downstream `x env`
# subcommands inherit the same pattern. Keep -e and pipefail so the
# install/curl path still aborts on real failures.
set -eo pipefail

if [[ ! -d "$HOME/.x-cmd.root/" ]]; then
    echo "x-cmd not found. Installing..."
    installer=$(mktemp /tmp/x-cmd-install.XXXXXX)
    trap 'rm -f "$installer"' EXIT
    if command -v curl >/dev/null 2>&1; then
        curl -fsSL https://get.x-cmd.com -o "$installer"
    elif command -v wget >/dev/null 2>&1; then
        wget -qO "$installer" https://get.x-cmd.com
    else
        echo "Error: Neither curl nor wget is available. Cannot install x-cmd." >&2
        exit 1
    fi
    bash "$installer"
    echo "x-cmd installation complete."
fi

[ ! -f "$HOME/.x-cmd.root/X" ] || . "$HOME/.x-cmd.root/X"

tools=(
    "atuin"
    "bat"
    "btm"
    "delta" # git-delta
    "difft"
    "dust" # du-dust
    "eza" # like exa but maintained
    "fd"
    "grex"
    "hyperfine"
    "hexyl"
    "navi"
    "ouch"
    "pueue"
    "starship"
    "tokei"
    "watchexec"
    "zoxide"
)
# Non Rust tools work too
tools+=(
    "bun"
    "chezmoi"
    "czg"
    "fzf"
    "gopass"
    "hadolint"
    "mermaid-cli"
    "miller"
    "pandoc"
    "shfmt"
    "upx"
    "uv"
    "vale"
    # NOTE(rg): khal?
)

for item in "${tools[@]}"; do
    x env use "$item"
done

