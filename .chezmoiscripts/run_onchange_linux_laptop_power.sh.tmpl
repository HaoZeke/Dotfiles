# shellcheck disable=SC2016
RG_TAILNET_POWER_CONTENT='#!/usr/bin/env bash
set -euo pipefail

cmd="${1:-}"
case "$cmd" in
    start|stop) ;;
    *) printf "usage: rg-tailnet-power [start|stop]\n" >&2; exit 2 ;;
esac

enabled=/etc/rg-tailnets/enabled
[ -r "$enabled" ] || exit 0

sed -e "s/#.*//" -e "s/^[[:space:]]*//" -e "s/[[:space:]]*$//" "$enabled" \
    | sed "/^$/d" \
    | while IFS= read -r name; do
        case "$name" in
            *[!A-Za-z0-9_.-]*)
                printf "rg-tailnet-power: skipping invalid instance name: %s\n" "$name" >&2
                continue
                ;;
        esac
        [ -r "/etc/rg-tailnets/$name.env" ] || continue
        systemctl "$cmd" "tailscaled@$name.service"
    done
'

BTRBK_CONTENT='# Managed by chezmoi (.chezmoiscripts/run_onchange_linux_laptop_power.sh.tmpl)
# Local btrfs snapshot lifecycle for @home and @. Remote push to
# pCloud is a separate step (~/.local/bin/turtleback-push) that reads
# the latest snapshot produced here.

timestamp_format        long
snapshot_preserve_min   2d
snapshot_preserve       24h 14d 8w 12m
backend                 btrfs-progs
incremental             yes
stream_compress         zstd

volume /btrfs
  snapshot_dir          @.snapshots
  subvolume @home
  subvolume @
'

LOGIND_CONTENT='# Managed by chezmoi (.chezmoiscripts/run_onchange_linux_laptop_power.sh.tmpl)
# Policy: on AC the laptop never goes to sleep on its own. Lid close,
# idle timeout, Fn+Suspend, Fn+Hibernate -- all ignored. The only
# sanctioned sleep paths on AC are the power button (HandlePowerKey
# below) and the explicit sway keybindings, all of which hibernate.
#
# On battery, lid-close hibernates directly. The kernel exposes only
# s2idle for suspend on this host, so mem sleep is not a reliable
# recovery boundary.
#
# Idle suspend is disabled here unconditionally (IdleAction=ignore).
# Battery idle hibernation is moved entirely into user-space so it
# can be AC-conditional: swayidle fires ~/.local/bin/rg-idle-hibernate
# at 2700s, which checks /sys/class/power_supply/A{C,DP}*/online and
# hibernates only when unplugged.
#
# HandlePowerKey hibernates so a press of the physical power button on
# either power source is the manual sleep trigger.
[Login]
HandleLidSwitch=hibernate
HandleLidSwitchDocked=ignore
HandleLidSwitchExternalPower=ignore
IdleAction=ignore
IdleActionSec=45min
HandlePowerKey=hibernate
HandleSuspendKey=ignore
HandleHibernateKey=ignore
'

SLEEP_CONTENT='# Managed by chezmoi (.chezmoiscripts/run_onchange_linux_laptop_power.sh.tmpl)
# Hibernate is the only enabled sleep state on rgx1gen11. Plain suspend
# writes "mem", which maps to s2idle on this firmware.
[Sleep]
AllowSuspend=no
AllowSuspendThenHibernate=no
AllowHybridSleep=no
'

JOURNALD_CONTENT='# Managed by chezmoi (.chezmoiscripts/run_onchange_linux_laptop_power.sh.tmpl)
# Persistent journal keeps hibernate/resume evidence across boots.
[Journal]
Storage=persistent
'

