LOGIND_CONTENT='# Managed by chezmoi (.chezmoiscripts/run_onchange_linux_laptop_power.sh.tmpl)
# Policy: lid close and the physical power key use fast suspend. This keeps
# daily wake/unlock latency low and matches the rg.surf operating model.
# Explicit hibernate remains available from the sway ThinkPad binding.
#
# Idle suspend is disabled here unconditionally (IdleAction=ignore).
# Battery idle hibernation is moved entirely into user-space so it
# can be AC-conditional: swayidle fires ~/.local/bin/rg-idle-hibernate
# at 2700s, which checks /sys/class/power_supply/A{C,DP}*/online and
# hibernates only when unplugged.
#
[Login]
HandleLidSwitch=suspend
HandleLidSwitchDocked=ignore
HandleLidSwitchExternalPower=suspend
IdleAction=ignore
IdleActionSec=45min
HandlePowerKey=suspend
HandleSuspendKey=suspend
HandleHibernateKey=hibernate
'

SLEEP_CONTENT='# Managed by chezmoi (.chezmoiscripts/run_onchange_linux_laptop_power.sh.tmpl)
# Fast suspend is the default sleep path. Hibernate remains enabled for explicit
# long-carry commands and for suspend-then-hibernate callers.
[Sleep]
AllowSuspend=yes
AllowSuspendThenHibernate=yes
AllowHybridSleep=no
HibernateDelaySec=180min
'

