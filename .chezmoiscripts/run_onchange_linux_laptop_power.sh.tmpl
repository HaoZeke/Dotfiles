# system-sleep hook: runs as root on every suspend/hibernate cycle.
# Written with 0755 via a separate path because write_if_diff always
# stamps 0644, and systemd-sleep refuses to execute non-executable
# hooks.
RESUME_KICK_PATH=/usr/lib/systemd/system-sleep/99-rg-resume-kick
if ! sudo test -f "$RESUME_KICK_PATH" \
   || ! printf "%s" "$RESUME_KICK_CONTENT" | sudo cmp -s - "$RESUME_KICK_PATH"; then
    TMP=$(mktemp)
    printf "%s" "$RESUME_KICK_CONTENT" > "$TMP"
    sudo install -D -m 0755 -o root -g root "$TMP" "$RESUME_KICK_PATH"
    rm -f "$TMP"
    echo "chezmoi: updated $RESUME_KICK_PATH"
fi

BTRBK_CHANGED=0
NFT_CHANGED=0
SMARTD_CHANGED=0
write_if_diff /etc/btrbk/btrbk.conf                          "$BTRBK_CONTENT"        && BTRBK_CHANGED=1 || true
write_if_diff /etc/nftables.conf                             "$NFTABLES_CONTENT"     && NFT_CHANGED=1 || true
write_if_diff /etc/smartd.conf                               "$SMARTD_CONTENT"       && SMARTD_CHANGED=1 || true
# sudoers must be 0440; write via a tempfile + visudo validation so a
# syntax error never leaves a broken sudoers drop-in on disk.
if ! sudo test -f /etc/sudoers.d/rgpower \
   || ! printf "%s" "$RGPOWER_SUDOERS_CONTENT" | sudo cmp -s - /etc/sudoers.d/rgpower; then
    TMP=$(mktemp)
    printf "%s" "$RGPOWER_SUDOERS_CONTENT" > "$TMP"
    if sudo visudo -c -f "$TMP" >/dev/null; then
        sudo install -D -m 0440 -o root -g root "$TMP" /etc/sudoers.d/rgpower
        echo "chezmoi: updated /etc/sudoers.d/rgpower"
    else
        echo "chezmoi: WARN /etc/sudoers.d/rgpower would be invalid; keeping existing" >&2
    fi
    rm -f "$TMP"
fi

if [ "$BTRBK_CHANGED" = "1" ] \
   || ( ! sudo systemctl is-enabled btrbk.timer >/dev/null 2>&1 ); then
    if pacman -Qi btrbk >/dev/null 2>&1; then
        sudo systemctl enable --now btrbk.timer >/dev/null 2>&1 || true
        echo "chezmoi: btrbk.timer enabled; run 'sudo btrbk run' once to produce the first snapshot."
    fi
fi

# Bring nftables online if the config was just written or the service
# is not yet enabled. Validate the ruleset before attempting to load so
# a syntax error does not leave the firewall in an undefined state.
if [ "$NFT_CHANGED" = "1" ] \
   || ( ! sudo systemctl is-enabled nftables.service >/dev/null 2>&1 ); then
    if sudo nft -c -f /etc/nftables.conf; then
        sudo systemctl enable nftables.service >/dev/null 2>&1 || true
        sudo systemctl restart nftables.service
        echo "chezmoi: nftables reloaded"
    else
        echo "chezmoi: WARN /etc/nftables.conf failed validation; firewall unchanged" >&2
    fi
fi

# Enable smartd so SSD/NVMe health degradation shows up in the journal
# before it turns into a read error.
if [ "$SMARTD_CHANGED" = "1" ] \
   || ( ! sudo systemctl is-enabled smartd.service >/dev/null 2>&1 ); then
    sudo systemctl enable --now smartd.service >/dev/null 2>&1 || true
fi

# --- post-deploy activation ----------------------------------------------
if [ "$XE_CHANGED" = "1" ]; then
    echo "chezmoi: xe.conf updated; module params take effect on next reboot."
fi

# LUKS workqueue bypass on encrypted root: a known cause of
# "freezes" that look like memory pressure but are actually dm-crypt
# workqueue serialization on a single kworker under heavy I/O.
# cryptsetup refresh (with or without --persistent) prompts for the
# LUKS passphrase so it cannot run from a non-interactive chezmoi
# script. Print the exact one-liner for the user to run once.
if [ -e /dev/mapper/luks ] && command -v cryptsetup >/dev/null 2>&1; then
    if cryptsetup status luks 2>/dev/null \
         | grep -qE 'no_(read|write)_workqueue'; then
        :
    else
        cat <<MSG
chezmoi: dm-crypt no-workqueue flags not yet set on luks. Run once,
interactively, at a shell with a TTY (you will be asked for your
LUKS passphrase):

    sudo cryptsetup refresh \\
        --perf-no_read_workqueue \\
        --perf-no_write_workqueue \\
        --persistent luks

The --persistent flag writes the performance options into the LUKS2
header, so every future boot brings up the mapper with them set.
MSG
    fi
fi

if [ "$UDEV_CHANGED" = "1" ]; then
    sudo udevadm control --reload
    # Re-run block and USB policy rules so storage schedulers and camera
    # runtime PM settings take effect without a reboot.
    sudo udevadm trigger --subsystem-match=block --action=change
    sudo udevadm trigger --subsystem-match=usb --action=change
    sudo udevadm trigger --subsystem-match=pci --action=change
    # Live-apply: pin the LPSS I2C controllers on now so the touchpad and
    # touchscreen stop freezing without waiting for a reboot or device re-add.
    for c in /sys/devices/pci0000:00/0000:00:15.0/power/control \
             /sys/devices/pci0000:00/0000:00:15.1/power/control; do
        [ -e "$c" ] && echo on | sudo tee "$c" >/dev/null
    done
    # Belt-and-suspenders: write bfq live in case the scheduler module
    # wasn't loaded yet when udev first saw the device.
    for q in /sys/block/nvme*/queue/scheduler \
             /sys/block/sd*/queue/scheduler \
             /sys/block/mmcblk*/queue/scheduler; do
        [ -e "$q" ] || continue
        grep -q '\bbfq\b' "$q" || continue  # skip if bfq module not available
        echo bfq | sudo tee "$q" >/dev/null
    done
fi

if [ "$LOGIND_CHANGED" = "1" ] || [ "$SLEEP_CHANGED" = "1" ]; then
    sudo systemctl daemon-reload
    # A later-sorting drop-in can override 50-lid.conf. The script
    # reports the conflict and leaves root-owned config removal to an
    # interactive command.
    if [ -f /etc/systemd/logind.conf.d/do-not-suspend.conf ]; then
        cat <<MSG
chezmoi: /etc/systemd/logind.conf.d/do-not-suspend.conf exists and sorts after 50-lid.conf.
It can override the managed lid policy. Review it, then remove it manually:

    sudo trash-put /etc/systemd/logind.conf.d/do-not-suspend.conf
MSG
    fi
    # DO NOT restart systemd-logind from here. On sway sessions a
    # logind restart can terminate the session scope (sway dies,
    # every app with it, hard reboot required to recover). Changes
    # to /etc/systemd/logind.conf.d/*.conf apply to the next boot
    # via daemon-reload above, which is safe. For the current
    # session just confirm the drop-in is in place and tell the
    # user the lid behavior will be live after the next reboot.
    echo "chezmoi: logind drop-in updated."
    echo "  Live until next reboot: the active HandleLidSwitch value remains in effect."
    echo "  Effective after reboot: HandleLidSwitch=suspend."
    echo "  If you need it live immediately, run 'sudo systemctl restart systemd-logind'"
    echo "  manually and accept the risk that sway sessions can drop."
fi

# Persistent journal so `journalctl -b -1` survives reboots. Essential
# for debugging hibernate-resume and OOM-kill chains after the fact.
# Guard on emptiness rather than existence: the directory exists as an
# empty placeholder on stock Arch installs, and systemd-journald only
# starts persisting once it finds the directory populated with the
# right ownership and a flush signal.
write_journald_storage_fix_script
if [ "$JOURNALD_CHANGED" = "1" ] || [ -z "$(sudo ls -A /var/log/journal 2>/dev/null)" ]; then
    echo "chezmoi: enabling persistent journal"
    sudo install -d -m 2755 -o root -g systemd-journal /var/log/journal
    sudo systemd-tmpfiles --create --prefix /var/log/journal >/dev/null || true
    sudo systemctl kill --signal=SIGHUP systemd-journald || true
    sudo journalctl --flush >/dev/null 2>&1 || true
fi

if [ "$TAILSCALED_TEMPLATE_CHANGED" = "1" ] || [ "$CTRLD_CHANGED" = "1" ]; then
    sudo systemctl daemon-reload
fi

disable_networkmanager_for_iwd

sudo systemctl enable --now systemd-networkd.service systemd-resolved.service >/dev/null 2>&1 || true

if [ "$NETWORKD_CHANGED" = "1" ] && sudo systemctl is-active systemd-networkd.service >/dev/null 2>&1; then
    sudo networkctl reload || true
    sudo networkctl reconfigure wlan0 || true
fi

if sudo systemctl is-active ctrld.service >/dev/null 2>&1 \
   || sudo systemctl is-enabled ctrld.service >/dev/null 2>&1; then
    if [ "$CTRLD_CHANGED" = "1" ]; then
        sudo systemctl restart ctrld.service
    fi
fi

if [ "$UNBOUND_CHANGED" = "1" ] \
   || [ "$RESOLVED_CHANGED" = "1" ] \
   || ( ! sudo systemctl is-enabled unbound.service >/dev/null 2>&1 ); then
    if command -v unbound-checkconf >/dev/null 2>&1 \
       && sudo unbound-checkconf /etc/unbound/unbound.conf >/dev/null; then
        sudo systemctl enable unbound.service >/dev/null 2>&1 || true
        sudo systemctl restart unbound.service
        sudo systemctl restart systemd-resolved.service
        echo "chezmoi: local DNS resolver active via unbound + systemd-resolved"
    else
        echo "chezmoi: WARN unbound config validation failed; resolver services unchanged" >&2
    fi
fi

# Conflicting services first: TLP and power-profiles-daemon cannot both
# run. Drop PPD before enabling TLP so the enable doesn't trip a
# same-name conflict.
if sudo systemctl is-enabled power-profiles-daemon.service >/dev/null 2>&1; then
    echo "chezmoi: disabling power-profiles-daemon (conflicts with TLP)"
    sudo systemctl disable --now power-profiles-daemon.service
fi

# iwd/iwctl owns Wi-Fi authentication only; systemd-networkd owns IP/routing
# and systemd-resolved owns DNS (see /etc/iwd/main.conf above).
# NetworkManager's iwd backend registers competing Wi-Fi/netconfig state
# and prevents iwd from completing connection setup on wlan0.
if ! sudo systemctl is-enabled iwd.service >/dev/null 2>&1; then
    echo "chezmoi: enabling iwd.service"
    sudo systemctl enable --now iwd.service
elif ! sudo systemctl is-active iwd.service >/dev/null 2>&1; then
    sudo systemctl start iwd.service
fi

# A changed iwd main.conf (e.g. flipping EnableNetworkConfiguration) only takes
# effect on restart; reconfigure wlan0 afterwards so networkd re-leases cleanly.
if [ "$IWD_CHANGED" = "1" ]; then
    echo "chezmoi: iwd main.conf changed; restarting iwd (Wi-Fi auth-only)"
    sudo systemctl restart iwd.service
    sleep 2
    sudo networkctl reconfigure wlan0 || true
fi

disable_networkmanager_for_iwd

# Enable accept-dns so the x.ai tailnet's split-DNS works (it routes
# *.teachx.ai / *.xai-enterprise.com to the app-connector resolvers, which is
# how Starfleet and friends are reached). This does NOT hijack the default
# resolver: the tailnet publishes split-DNS routes only (no global override),
# and the resolved drop-in pins Global to 127.0.0.1 with Domains=~., so only
# those specific suffixes go to Tailscale while everything else stays on the
# local unbound -> ControlD chain. Leaving it false silently breaks Starfleet.
if command -v tailscale >/dev/null 2>&1 \
   && systemctl is-active tailscaled.service >/dev/null 2>&1; then
    tailscale set --accept-dns=true >/dev/null 2>&1 || true
fi

# Enable TLP's own units explicitly. tlp-stat checks for tlp.service by
# name; a bare `systemctl enable tlp` sometimes resolves to a stale
# symlink target on Arch and leaves it reporting "not enabled".
if ! sudo systemctl is-enabled tlp.service >/dev/null 2>&1; then
    echo "chezmoi: enabling tlp.service"
    sudo systemctl enable tlp.service
fi

if [ "$TLP_CHANGED" = "1" ]; then
    sudo systemctl restart tlp.service
elif ! sudo systemctl is-active tlp.service >/dev/null 2>&1; then
    sudo systemctl start tlp.service
fi

# Confirm the enable actually stuck so a silent failure shows up here
# instead of waiting for the user to notice `tlp-stat` complain.
if ! sudo systemctl is-enabled tlp.service >/dev/null 2>&1; then
    echo "chezmoi: WARNING tlp.service still not enabled" >&2
fi
{{- end }}
