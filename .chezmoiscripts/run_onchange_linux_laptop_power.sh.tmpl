RG_X1GEN11_PROFILE_ROOT_CONTENT='#!/usr/bin/env bash
set -euo pipefail

profile="${1:-}"
PROFILES_JSON="${RG_X1GEN11_PROFILES:-/home/rgoswami/.config/rg-x1gen11/profiles.json}"
CHEZMOI_PROFILES=/home/rgoswami/.local/share/chezmoi/dot_config/rg-x1gen11/profiles.json

if [ ! -r "$PROFILES_JSON" ] && [ -r "$CHEZMOI_PROFILES" ]; then
    PROFILES_JSON="$CHEZMOI_PROFILES"
fi

profile_data=$(python3 - "$PROFILES_JSON" "$profile" <<PY
import json
import shlex
import sys

path, profile = sys.argv[1:3]
data = json.load(open(path, encoding="utf-8"))
profiles = data["profiles"]
if profile not in profiles:
    choices = "|".join(profiles)
    print("usage: %s {%s}" % (sys.argv[0], choices), file=sys.stderr)
    raise SystemExit(2)

spec = profiles[profile]
values = {
    "platform": spec["platform_profile"],
    "governor": spec["scaling_governor"],
    "epp": spec["energy_performance_preference"],
    "hwp": spec.get(
        "hwp_dynamic_boost",
        "1" if spec.get("scaling_governor") == "performance" else "0",
    ),
    "iwl": spec["iwlwifi_power_save"],
    "zram_expr": spec["zram_size"],
    "damon": "Y" if spec["damon_reclaim"] else "N",
}
for key, value in values.items():
    print(f"{key}={shlex.quote(str(value))}")
PY
)
eval "$profile_data"

write_platform_profile() {
    local path choices
    for path in /sys/firmware/acpi/platform_profile /sys/devices/platform/thinkpad_acpi/platform_profile; do
        [ -e "$path" ] || continue
        choices="${path}_choices"
        if [ -r "$choices" ] && ! grep -qw "$platform" "$choices"; then
            printf "platform profile %s unavailable in %s\n" "$platform" "$choices" >&2
            exit 1
        fi
        if ! write_sysfs_value "$path" "$platform"; then
            printf "platform profile %s write rejected; skip\n" "$platform" >&2
        fi
        return 0
    done
    printf "platform_profile sysfs missing; skip\n" >&2
}

write_sysfs_value() {
    local path="$1" value="$2"
    printf "%s\n" "$value" >"$path" 2>/dev/null
}

write_cpufreq_value() {
    local name="$1" value="$2" avail_name="$3"
    local cpu path avail
    for cpu in /sys/devices/system/cpu/cpu[0-9]*; do
        [ -d "$cpu" ] || continue
        path="$cpu/cpufreq/$name"
        avail="$cpu/cpufreq/$avail_name"
        [ -e "$path" ] || continue
        if [ -r "$avail" ] && ! grep -qw "$value" "$avail"; then
            printf "skip %s: %s unavailable\n" "$path" "$value" >&2
            continue
        fi
        if ! write_sysfs_value "$path" "$value"; then
            printf "skip %s: write rejected\n" "$path" >&2
        fi
    done
}

write_if_path() {
    local path="$1" value="$2" label="$3"
    if [ ! -e "$path" ]; then
        printf "%s: missing; skip\n" "$label" >&2
        return 0
    fi
    if [ ! -w "$path" ]; then
        printf "%s: read-only; skip\n" "$label" >&2
        return 0
    fi
    if ! write_sysfs_value "$path" "$value"; then
        printf "%s: write rejected; skip\n" "$label" >&2
    fi
}

write_zram() {
    local conf=/etc/systemd/zram-generator.conf.d/10-rg-profile.conf
    local desired
    install -d -m0755 /etc/systemd/zram-generator.conf.d
    desired="# Managed by rg-x1gen11-profile-root
[zram0]
zram-size = $zram_expr
compression-algorithm = zstd
swap-priority = 100
fs-type = swap"
    # Already at the target size and live: nothing to do. Resizing zram forces a
    # swapoff/swapon cycle that blocks under memory pressure, so skip it whenever
    # the device is already configured the way we want.
    if [ -r "$conf" ] && [ "$(cat "$conf")" = "$desired" ] \
        && swapon --show=NAME --noheadings 2>/dev/null | grep -qx /dev/zram0; then
        return 0
    fi
    printf "%s\n" "$desired" >"$conf"
    systemctl daemon-reload
    # A disksize left on an idle (non-swap) zram0 makes the generator
    # comp_algorithm write fail with EBUSY; reset the device so the rebuild can
    # run. This is the state a killed restart leaves behind.
    if [ -e /sys/block/zram0/disksize ] \
        && [ "$(cat /sys/block/zram0/disksize)" != 0 ] \
        && ! swapon --show=NAME --noheadings 2>/dev/null | grep -qx /dev/zram0; then
        printf "1\n" >/sys/block/zram0/reset 2>/dev/null || true
    fi
    # Detach the restart so a slow swapoff cannot stall the calling oneshot unit
    # past its start timeout; that kill mid-restart is what corrupts zram0.
    systemctl restart --no-block systemd-zram-setup@zram0.service 2>/dev/null || true
}

write_damon() {
    local path=/sys/module/damon_reclaim/parameters/enabled
    [ -e "$path" ] || return 0
    printf "%s\n" "$damon" >"$path"
}

write_platform_profile
write_cpufreq_value scaling_governor "$governor" scaling_available_governors
write_cpufreq_value energy_performance_preference "$epp" energy_performance_available_preferences
write_if_path /sys/devices/system/cpu/intel_pstate/hwp_dynamic_boost "$hwp" hwp_dynamic_boost
write_if_path /sys/module/iwlwifi/parameters/power_save "$iwl" iwlwifi_power_save
write_zram
write_damon

printf "root profile applied: %s\n" "$profile"
'

# shellcheck disable=SC2016
RG_TAILNET_POWER_CONTENT='#!/usr/bin/env bash
set -euo pipefail

cmd="${1:-}"
case "$cmd" in
    start|stop) ;;
    *) printf "usage: rg-tailnet-power [start|stop]\n" >&2; exit 2 ;;
esac

enabled=/etc/rg-tailnets/enabled
[ -r "$enabled" ] || exit 0

sed -e "s/#.*//" -e "s/^[[:space:]]*//" -e "s/[[:space:]]*$//" "$enabled" \
    | sed "/^$/d" \
    | while IFS= read -r name; do
        case "$name" in
            *[!A-Za-z0-9_.-]*)
                printf "rg-tailnet-power: skipping invalid instance name: %s\n" "$name" >&2
                continue
                ;;
        esac
        [ -r "/etc/rg-tailnets/$name.env" ] || continue
        systemctl "$cmd" "tailscaled@$name.service"
    done
'

