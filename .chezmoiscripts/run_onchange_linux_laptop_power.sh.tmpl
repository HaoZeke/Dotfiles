#!/usr/bin/env bash
{{- if and (eq .chezmoi.os "linux") (eq .chezmoi.hostname "rgx1gen11") }}
# Laptop power management, ThinkPad X1 Gen 11 (rgx1gen11) ONLY. Other
# Linux hosts (servers, desktops, cosmolab) must not pick up charge
# thresholds, TLP, or lid-handler changes.
#
#   * BFQ on NVMe/SATA for interactive latency under I/O pressure
#   * fast suspend for everyday lid/power-key sleep, with explicit hibernate
#     left available for long carry/travel
#   * TLP with Intel + ThinkPad charge thresholds (90/98) for useful runtime
#     while avoiding the harshest always-at-100% storage state.
#
# Separate from the memory-tuning script so a desktop host (no battery,
# no lid) can disable just this part via chezmoi data.
#
# Shared TLP baseline (single source of truth — do not paste keys here):
# tlp-baseline-sha256: {{ include "dot_local/share/rgx1gen11/tlp-00-base.conf" | sha256sum }}
# Profile root helper is generated from rg-x1gen11-profile (not embedded).

set -euo pipefail

write_if_diff() {
    local dst="$1" content="$2"
    local tmp
    tmp=$(mktemp)
    printf '%s' "$content" >"$tmp"
    if ! sudo test -f "$dst" || ! sudo cmp -s "$tmp" "$dst"; then
        echo "chezmoi: updating $dst"
        sudo install -D -m 0644 -o root -g root "$tmp" "$dst"
        rm -f "$tmp"
        return 0
    fi
    rm -f "$tmp"
    return 1
}

write_executable_if_diff() {
    local dst="$1" content="$2"
    local tmp
    tmp=$(mktemp)
    printf '%s' "$content" >"$tmp"
    if ! sudo test -f "$dst" || ! sudo cmp -s "$tmp" "$dst"; then
        echo "chezmoi: updating $dst"
        sudo install -D -m 0755 -o root -g root "$tmp" "$dst"
        rm -f "$tmp"
        return 0
    fi
    rm -f "$tmp"
    return 1
}

disable_networkmanager_for_iwd() {
    if sudo systemctl is-enabled NetworkManager.service >/dev/null 2>&1 \
       || sudo systemctl is-active NetworkManager.service >/dev/null 2>&1 \
       || sudo systemctl is-enabled NetworkManager-dispatcher.service >/dev/null 2>&1 \
       || sudo systemctl is-active NetworkManager-dispatcher.service >/dev/null 2>&1 \
       || sudo systemctl is-enabled NetworkManager-wait-online.service >/dev/null 2>&1 \
       || sudo systemctl is-active NetworkManager-wait-online.service >/dev/null 2>&1; then
        echo "chezmoi: disabling NetworkManager services; iwd owns Wi-Fi"
        sudo systemctl disable --now NetworkManager.service NetworkManager-dispatcher.service NetworkManager-wait-online.service >/dev/null 2>&1 || true
    fi
}

write_ctrld_local_chain_dropin() {
    local unit_text cd_uid content

    command -v /usr/local/bin/ctrld >/dev/null 2>&1 || return 1
    unit_text="$(sudo sh -c 'cat /etc/systemd/system/ctrld.service /etc/systemd/system/ctrld.service.d/*.conf 2>/dev/null' || true)"
    [ -n "$unit_text" ] || return 1
    cd_uid="$(printf '%s\n' "$unit_text" \
        | awk '{
            for (i = 1; i <= NF; i++) {
                gsub(/^"|"$/, "", $i)
                if ($i == "--cd" && i < NF) {
                    gsub(/^"|"$/, "", $(i + 1))
                    print $(i + 1)
                } else if ($i ~ /^--cd=/) {
                    sub(/^--cd=/, "", $i)
                    gsub(/^"|"$/, "", $i)
                    print $i
                }
            }
        }' \
        | head -n 1)"
    [ -n "$cd_uid" ] || return 1

    # Prefer the config file: the flag form gives ctrld no bootstrap address, so
    # a failing upstream sends it to the OS resolver -- 127.0.0.53 -> unbound ->
    # ctrld, a loop that turns one upstream blip into a machine-wide DNS stall.
    # bootstrap_ip in the config keeps a failing upstream a failing upstream.
    # The file carries the private resolver uid, so it lives in terra-dns/private
    # (gitignored, sealed with nimvault) and only a redacted example is committed.
    local priv_toml="$HOME/.local/share/terra-dns/private/ctrld.toml" exec_line
    if [ -r "$priv_toml" ] && grep -q '^[[:space:]]*bootstrap_ip' "$priv_toml"; then
        sudo install -D -m 0600 -o root -g root "$priv_toml" /etc/controld/ctrld.toml
        exec_line="ExecStart=/usr/local/bin/ctrld run --config=/etc/controld/ctrld.toml"
    else
        echo "chezmoi: WARN $priv_toml missing or has no bootstrap_ip; ctrld keeps the loop-prone flag form" >&2
        exec_line="ExecStart=/usr/local/bin/ctrld run --listen=127.0.0.1:5354 --primary_upstream=https://76.76.2.22/$cd_uid --secondary_upstream=https://76.76.10.22/$cd_uid --cache_size=10000"
    fi

    content="# Managed by chezmoi (.chezmoiscripts/run_onchange_linux_laptop_power.sh.tmpl)
[Unit]
Description=A highly configurable, multi-protocol DNS forwarding proxy
ConditionFileIsExecutable=/usr/local/bin/ctrld
Wants=nss-lookup.target
After=network.target nss-lookup.target

[Service]
StartLimitInterval=5
StartLimitBurst=10
$exec_line
WorkingDirectory=/etc/controld
Restart=always
RestartSec=30
EnvironmentFile=-/etc/sysconfig/ctrld
KillMode=process

[Install]
WantedBy=multi-user.target
"
    write_if_diff /etc/systemd/system/ctrld.service "$content"
    sudo rm -f /etc/systemd/system/ctrld.service.d/50-rg-local-chain.conf
}

write_journald_storage_fix_script() {
    local dir=/etc/systemd/journald.conf.d
    local script=/tmp/rg-journald-storage-fix.sh
    local file
    local conflicts=()

    sudo test -d "$dir" || return 0
    while IFS= read -r file; do
        [ -n "$file" ] || continue
        case "$file" in
            "$dir/99-persistent-storage.conf") continue ;;
        esac
        if sudo grep -Eq '^[[:space:]]*Storage[[:space:]]*=[[:space:]]*volatile([[:space:]#]|$)' "$file"; then
            conflicts+=("$file")
        fi
    done < <(sudo find "$dir" -maxdepth 1 -type f -name '*.conf' -print 2>/dev/null | sort)

    [ "${#conflicts[@]}" -gt 0 ] || return 0

    {
        printf '#!/usr/bin/env bash\n'
        printf 'set -euo pipefail\n\n'
        printf 'command -v trash-put >/dev/null\n'
        printf 'trash-put'
        printf ' %q' "${conflicts[@]}"
        printf '\n'
        printf 'systemctl daemon-reload\n'
        printf 'systemctl kill --signal=SIGHUP systemd-journald || true\n'
        printf 'journalctl --flush\n'
        printf 'journalctl --disk-usage\n'
    } >"$script"
    chmod 0755 "$script"

    printf 'chezmoi: journald Storage=volatile conflicts with managed persistent storage:\n' >&2
    printf '  %s\n' "${conflicts[@]}" >&2
    printf 'chezmoi: wrote %s; run: sudo bash %s\n' "$script" "$script" >&2
}

IOSCHED_CONTENT='# Managed by chezmoi (.chezmoiscripts/run_onchange_linux_laptop_power.sh.tmpl)
# BFQ on every rotational and non-rotational block device for better
# interactive latency under I/O contention. Only ramdisks, loop, and
# zram use the kernel default.
ACTION=="add|change", KERNEL=="nvme[0-9]n[0-9]",          ATTR{queue/scheduler}="bfq"
ACTION=="add|change", KERNEL=="sd[a-z]",                  ATTR{queue/scheduler}="bfq"
ACTION=="add|change", KERNEL=="mmcblk[0-9]",              ATTR{queue/scheduler}="bfq"
'

XE_MODPROBE_CONTENT='# Managed by chezmoi (.chezmoiscripts/run_onchange_linux_laptop_power.sh.tmpl)
# Intel Xe driver power knobs for the X1 Gen 11 integrated GPU (9a49).
# Panel Self Refresh and Frame Buffer Compression drop display power
# draw 10-30% on battery.
#
# Panel Replay (enable_panel_replay=1) was tried but caused visible
# post-hibernate redraw lag: swaylock took keystrokes without drawing
# the ring, and Chromium frames went stale until a mouse move forced
# a full modeset. The 99-rg-resume-kick hook below works around a
# chunk of that, but dropping Panel Replay removes the root cause on
# the Xe + eDP 1.5 combo in this laptop; regular PSR stays on.
options xe enable_psr=1 enable_fbc=1
'

NFTABLES_CONTENT='#!/usr/sbin/nft -f
# Managed by chezmoi (.chezmoiscripts/run_onchange_linux_laptop_power.sh.tmpl)
# Host firewall: default-deny inbound, allow established + loopback +
# ICMP + known-trusted interfaces. Forward disabled. Output unrestricted.
flush ruleset

table inet filter {
  chain input {
    type filter hook input priority filter; policy drop;

    ct state established,related accept
    ct state invalid drop

    iif lo accept
    ip protocol icmp accept
    ip6 nexthdr ipv6-icmp accept

    # Trusted interfaces: tailscale mesh, libvirt/docker local bridges.
    iifname "tailscale0" accept
    iifname "virbr*"     accept comment "libvirt bridge"
    iifname "docker0"    accept comment "docker bridge"
    iifname "podman*"    accept comment "podman bridge"

    counter comment "dropped inbound"
  }

  chain forward {
    type filter hook forward priority filter; policy drop;
  }

  chain output {
    type filter hook output priority filter; policy accept;
  }
}
'

SMARTD_CONTENT='# Managed by chezmoi (.chezmoiscripts/run_onchange_linux_laptop_power.sh.tmpl)
# Monitor every auto-detected SMART-capable device. Short self-test
# every day at 02:00, long self-test every Saturday at 03:00. Warnings
# go to the system journal (grep with: journalctl -u smartd -p warning).
# No mail transport -- rely on journalctl inspection instead.
DEVICESCAN -a -o on -S on -s (S/../.././02|L/../../6/03) -W 4,45,60
'

