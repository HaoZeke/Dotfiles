{{- if eq .chezmoi.os "linux" -}}
#!/usr/bin/env bash
# Hermes SURF/Willma: keep the key out of ~/.hermes/.env.
# Hash: hermes-willma-env-v4-key-from-pass
#
# config.yaml reads ${OPENAI_API_KEY}. The key comes from pass at launch
# (willma-run, or the hermes wrapper in posix.d/08_willma.sh), so .env carries
# only the base URL. Earlier revisions wrote OPENAI_API_KEY and WILLMA_API_KEY
# here in plain text; this removes them.
set -euo pipefail
log() { printf 'chezmoi hermes-willma: %s\n' "$*"; }

HERMES_HOME="${HOME}/.hermes"
ENVF="${HERMES_HOME}/.env"
mkdir -p "${HERMES_HOME}"
chmod 700 "${HERMES_HOME}" 2>/dev/null || true

export HERMES_ENVF="$ENVF"
python3 << 'PY'
from pathlib import Path
import os
p = Path(os.environ["HERMES_ENVF"])
drop = {"OPENAI_API_KEY", "WILLMA_API_KEY"}
lines, removed = [], 0
if p.exists():
    for line in p.read_text().splitlines():
        k = line.split("=", 1)[0].strip()
        if k in drop:
            removed += 1
            continue
        lines.append(line)
if not any(l.split("=", 1)[0].strip() == "OPENAI_BASE_URL" for l in lines):
    lines.append("OPENAI_BASE_URL=https://willma.surf.nl/api/v0")
p.write_text("\n".join(lines) + "\n")
p.chmod(0o600)
print(f"hermes .env: removed {removed} key line(s), base URL kept")
PY
for f in "${HERMES_HOME}"/.env.bak*; do
  [[ -e "$f" ]] || continue
  if grep -qE '^(OPENAI_API_KEY|WILLMA_API_KEY)=' "$f"; then
    rm -f "$f"
    log "removed backup holding a key: ${f##*/}"
  fi
done
{{- end -}}
