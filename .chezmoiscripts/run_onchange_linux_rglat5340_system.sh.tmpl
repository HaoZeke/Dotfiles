#!/usr/bin/env bash
{{- if and (eq .chezmoi.os "linux") (eq .chezmoi.hostname "rglat5340") }}
# rglat5340 system provisioning: greeter, uinput for kanata, bluetooth,
# tailscale, sshd. The EESSI mount is run_onchange_linux_eessi_cvmfs. The same pieces as the rgSURFLat system script without its
# work DNS and VPN; the Livingston network stack comes from the sealed store.
set -euo pipefail

# Never hang a plain apply on a password prompt; skip until sudo -v.
if ! sudo -n true 2>/dev/null; then
    echo "chezmoi: no cached sudo credentials; skipping rglat5340 system provisioning (sudo -v, then re-apply)" >&2
    exit 1
fi

write_if_diff() {
    local dst="$1" mode="$2" content="$3"
    local tmp
    tmp=$(mktemp)
    printf '%s' "$content" >"$tmp"
    if ! sudo test -f "$dst" || ! sudo cmp -s "$tmp" "$dst"; then
        echo "chezmoi: updating $dst"
        sudo install -D -m "$mode" -o root -g root "$tmp" "$dst"
        rm -f "$tmp"
        return 0
    fi
    rm -f "$tmp"
    return 1
}

# --- greeter: greetd + tuigreet -> start-sway (VT1) -----------------------
GREETD_CONF='[terminal]
vt = 1

[default_session]
command = "tuigreet --time --remember --asterisks --cmd /usr/local/bin/start-sway"
user = "greeter"
'
write_if_diff /etc/greetd/config.toml 0644 "$GREETD_CONF" || true
sudo gpasswd -a greeter video >/dev/null 2>&1 || true
sudo systemctl enable greetd >/dev/null 2>&1 || true

# Sandboxed browsers and portals need to traverse $HOME to reach chosen files.
chmod 711 "$HOME"

if ! command -v Xwayland >/dev/null 2>&1; then
    sudo pacman -S --needed --noconfirm xorg-xwayland
fi

# --- uinput for kanata (colemak) ------------------------------------------
UINPUT_RULE='KERNEL=="uinput", MODE="0660", GROUP="input", OPTIONS+="static_node=uinput"
'
if write_if_diff /etc/udev/rules.d/99-uinput.rules 0644 "$UINPUT_RULE"; then
    sudo udevadm control --reload-rules 2>/dev/null || true
    sudo udevadm trigger 2>/dev/null || true
fi
write_if_diff /etc/modules-load.d/uinput.conf 0644 'uinput
' || true
if ! id -nG "{{ .chezmoi.username }}" | tr ' ' '\n' | grep -qx input; then
    sudo usermod -aG input "{{ .chezmoi.username }}"
    echo "chezmoi: added {{ .chezmoi.username }} to input (re-login for kanata)"
fi

# --- Wi-Fi keeps the kernel name ------------------------------------------
# rgSURFLat gets wlan0 from the iwd package's 80-iwd.link; without iwd this
# host would name the card wlp0s20f3, and the sealed network helpers name
# wlan0. Takes effect at the next boot.
WIFI_LINK='[Match]
Type=wlan

[Link]
NamePolicy=keep kernel
'
write_if_diff /etc/systemd/network/80-wifi-kernel-name.link 0644 "$WIFI_LINK" || true

# --- network stack: NetworkManager owns Wi-Fi ------------------------------
# The sealed helpers expect the Control D binary where the X1 had it, and
# NetworkManager must leave tunnel and veth interfaces to their owners.
if [ -x /usr/bin/ctrld ] && [ ! -e /usr/local/bin/ctrld ]; then
    sudo ln -s /usr/bin/ctrld /usr/local/bin/ctrld
fi
NM_UNMANAGED='# Managed by chezmoi (.chezmoiscripts/run_onchange_linux_rglat5340_system.sh.tmpl)
# WireGuard, OpenVPN and the Livingston namespace veth are owned by their
# helpers; NetworkManager must not address or route them.
[keyfile]
unmanaged-devices=interface-name:rg-*;interface-name:wg*;interface-name:tun*;interface-name:tailscale*
'
if write_if_diff /etc/NetworkManager/conf.d/20-rg-unmanaged.conf 0644 "$NM_UNMANAGED"; then
    sudo nmcli general reload conf >/dev/null 2>&1 || true
fi
sudo systemctl enable systemd-resolved >/dev/null 2>&1 || true
# Same IPv6 source contract as the X1's networkd profile: temporary
# addresses exist but the stable per-prefix address is the outbound source.
NM_IPV6='# Managed by chezmoi (.chezmoiscripts/run_onchange_linux_rglat5340_system.sh.tmpl)
[connection]
ipv6.ip6-privacy=1
ipv6.addr-gen-mode=stable-privacy
'
if write_if_diff /etc/NetworkManager/conf.d/30-rg-ipv6.conf 0644 "$NM_IPV6"; then
    sudo nmcli general reload conf >/dev/null 2>&1 || true
fi

# --- host firewall: default-deny inbound, same ruleset as the X1 -----------
# Both tailnets run in userspace here, so inbound tailnet connections arrive
# through the daemons and reach local listeners over loopback; no tailscale0
# accept is needed for them, and the rule stays for a kernel-mode daemon.
NFTABLES_CONTENT='#!/usr/sbin/nft -f
# Managed by chezmoi (.chezmoiscripts/run_onchange_linux_rglat5340_system.sh.tmpl)
# Host firewall: default-deny inbound, allow established + loopback +
# ICMP + known-trusted interfaces. Forward disabled. Output unrestricted.
flush ruleset

table inet filter {
  chain input {
    type filter hook input priority filter; policy drop;

    ct state established,related accept
    ct state invalid drop

    iif lo accept
    ip protocol icmp accept
    ip6 nexthdr ipv6-icmp accept

    # Trusted interfaces: tailscale mesh, libvirt/docker local bridges.
    iifname "tailscale0" accept
    iifname "virbr*"     accept comment "libvirt bridge"
    iifname "docker0"    accept comment "docker bridge"
    iifname "podman*"    accept comment "podman bridge"

    counter comment "dropped inbound"
  }

  chain forward {
    type filter hook forward priority filter; policy drop;
  }

  chain output {
    type filter hook output priority filter; policy accept;
  }
}
'
if ! pacman -Q nftables >/dev/null 2>&1; then
    sudo pacman -S --needed --noconfirm nftables
fi
NFT_CHANGED=0
write_if_diff /etc/nftables.conf 0644 "$NFTABLES_CONTENT" && NFT_CHANGED=1 || true
if [ "$NFT_CHANGED" = "1" ] || ! sudo systemctl is-enabled nftables.service >/dev/null 2>&1; then
    if sudo nft -c -f /etc/nftables.conf; then
        sudo systemctl enable nftables.service >/dev/null 2>&1 || true
        sudo systemctl restart nftables.service
        echo "chezmoi: nftables reloaded"
    else
        echo "chezmoi: WARN /etc/nftables.conf failed validation; firewall unchanged" >&2
    fi
fi

# --- TCP congestion control ------------------------------------------------
# linux-rg builds BBR as the default, and systemd's sysctl defaults swap its fq
# qdisc for fq_codel. On this host BBR then pins pacing near zero on the
# Livingston veth and on loopback: the SOCKS door moved 40 KB/s under BBR and
# 2.6 MB/s under cubic, over the same tunnel.
TCP_CC='# BBR collapses pacing on the Livingston veth and loopback paths here.
net.ipv4.tcp_congestion_control = cubic
'
if write_if_diff /etc/sysctl.d/60-rg-tcp-cubic.conf 0644 "$TCP_CC"; then
    sudo sysctl -q -p /etc/sysctl.d/60-rg-tcp-cubic.conf || true
fi

# --- services -------------------------------------------------------------
for unit in bluetooth.service tailscaled.service sshd.service; do
    sudo systemctl enable "$unit" >/dev/null 2>&1 || echo "chezmoi: WARN could not enable $unit" >&2
done
{{- end }}
