#!/bin/bash --norc
{{ if eq .setup_claude "yes" -}}
# Bootstrap pi-coding-agent skills dependencies
# Clones gpu-llm-server (for SKILL.md CLI commands) and pi-skills (third-party)

GPU_LLM_DIR="{{ .chezmoi.homeDir }}/Git/Github/Tools/gpu-llm-server"
PI_SKILLS_DIR="{{ .chezmoi.homeDir }}/.pi/agent/skills/pi-skills"

if [ ! -d "$GPU_LLM_DIR" ]; then
    echo "pi-setup: cloning gpu-llm-server..."
    mkdir -p "$(dirname "$GPU_LLM_DIR")"
    git clone git@github.com:HaoZeke/gpu-llm-server.git "$GPU_LLM_DIR" 2>/dev/null || \
        echo "pi-setup: gpu-llm-server clone failed (private repo, needs SSH key)" >&2
fi

if [ ! -d "$PI_SKILLS_DIR" ]; then
    echo "pi-setup: cloning pi-skills..."
    mkdir -p "$(dirname "$PI_SKILLS_DIR")"
    git clone https://github.com/badlogic/pi-skills "$PI_SKILLS_DIR" 2>/dev/null || \
        echo "pi-setup: pi-skills clone failed" >&2
fi

# Install pi-coding-agent if npm is available and pi is not installed
if command -v npm &>/dev/null && ! command -v pi &>/dev/null; then
    echo "pi-setup: installing pi-coding-agent..."
    npm install -g @mariozechner/pi-coding-agent 2>/dev/null || \
        echo "pi-setup: pi-coding-agent install failed" >&2
fi
{{ end -}}
