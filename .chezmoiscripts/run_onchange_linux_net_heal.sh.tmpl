#!/usr/bin/env bash
{{- if and (eq .chezmoi.os "linux") (eq .chezmoi.hostname "rgx1gen11") }}
# Install rg-net-heal as a root timer: keeps the x.ai tailscale up and its
# transport on the US egress (Houston visibility), keeps the haozeke tailnet
# transport on the LAN uplink, and keeps selected direct carve-outs off the
# US egress.
# rg-net-heal-sha256: {{ include "dot_local/bin/executable_rg-net-heal" | sha256sum }}
# rg-net-recover-sha256: {{ include "dot_local/bin/executable_rg-net-recover.tmpl" | sha256sum }}
# rg-haozeke-derp-targets-sha256: {{ include "dot_local/bin/executable_rg-haozeke-derp-targets" | sha256sum }}
# rg-surf-vpn-apply-sha256: {{ include "dot_local/bin/executable_rg-surf-vpn-apply" | sha256sum }}
# rg-surf-vpn-validate-sha256: {{ include "dot_local/bin/executable_rg-surf-vpn-validate" | sha256sum }}
set -euo pipefail

# Root provisioning must never hang a plain `chezmoi apply` on a password
# prompt. Without cached sudo credentials, skip cleanly; `rg-net provision`
# is the explicit interactive path.
if ! sudo -n true 2>/dev/null; then
    echo "chezmoi: no cached sudo credentials; skipping net-heal provisioning (run: rg-net provision)" >&2
    exit 0
fi

HEAL_SRC="$HOME/.local/bin/rg-net-heal"
RECOVER_SRC="$HOME/.local/bin/rg-net-recover"
DERP_TARGETS_SRC="$HOME/.local/bin/rg-haozeke-derp-targets"
SURF_APPLY_SRC="$HOME/.local/bin/rg-surf-vpn-apply"
SURF_VALIDATE_SRC="$HOME/.local/bin/rg-surf-vpn-validate"
if [ ! -x "$HEAL_SRC" ]; then
    echo "chezmoi: rg-net-heal missing; skipping install." >&2
    exit 0
fi
if [ ! -x "$RECOVER_SRC" ]; then
    echo "chezmoi: rg-net-recover missing; skipping install." >&2
    exit 0
fi
if [ ! -x "$DERP_TARGETS_SRC" ]; then
    echo "chezmoi: rg-haozeke-derp-targets missing; skipping install." >&2
    exit 0
fi
if [ ! -x "$SURF_APPLY_SRC" ]; then
    echo "chezmoi: rg-surf-vpn-apply missing; skipping install." >&2
    exit 0
fi
if [ ! -x "$SURF_VALIDATE_SRC" ]; then
    echo "chezmoi: rg-surf-vpn-validate missing; skipping install." >&2
    exit 0
fi

install_bin() {
    if ! sudo cmp -s "$1" "$2" 2>/dev/null; then
        echo "chezmoi: updating $2"
        sudo install -D -m 0755 -o root -g root "$1" "$2"
    fi
}
install_root() {
    local dest="$1" tmp
    tmp="$(mktemp)"
    cat >"$tmp"
    if ! sudo test -f "$dest" || ! sudo cmp -s "$tmp" "$dest"; then
        echo "chezmoi: updating $dest"
        sudo install -D -m 0644 -o root -g root "$tmp" "$dest"
    fi
    rm -f "$tmp"
}

install_bin "$HEAL_SRC" /usr/local/sbin/rg-net-heal
install_bin "$RECOVER_SRC" /usr/local/sbin/rg-net-recover
install_bin "$DERP_TARGETS_SRC" /usr/local/sbin/rg-haozeke-derp-targets
install_bin "$SURF_APPLY_SRC" /usr/local/sbin/rg-surf-vpn-apply
install_bin "$SURF_VALIDATE_SRC" /usr/local/sbin/rg-surf-vpn-validate

install_root /etc/systemd/system/rg-net-heal.service <<'EOF'
[Unit]
Description=Heal x.ai tailscale and local underlay carve-outs
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/rg-net-heal
EOF

install_root /etc/systemd/system/rg-net-heal.timer <<'EOF'
[Unit]
Description=Periodic rg-net-heal (x.ai tailscale + local underlay carve-outs)

[Timer]
OnBootSec=20
OnUnitActiveSec=30
AccuracySec=5

[Install]
WantedBy=timers.target
EOF

install_root /etc/systemd/system/rg-surf-vpn-install.service <<'EOF'
[Unit]
Description=Validate and install a pending SURF eduVPN profile
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/rg-surf-vpn-apply /home/rgoswami/.local/state/rg-surf-vpn/pending.ovpn
TimeoutStartSec=90
EOF

install_root /etc/systemd/system/rg-surf-vpn-install.path <<'EOF'
[Unit]
Description=Watch for authenticated SURF eduVPN exports

[Path]
PathChanged=/home/rgoswami/.local/state/rg-surf-vpn/pending.ovpn
Unit=rg-surf-vpn-install.service

[Install]
WantedBy=multi-user.target
EOF

sudo systemctl daemon-reload
sudo systemctl enable --now rg-net-heal.timer
sudo systemctl enable --now rg-surf-vpn-install.path
sudo systemctl start rg-net-heal.service || true
if sudo test -f /home/rgoswami/.local/state/rg-surf-vpn/pending.ovpn; then
    sudo systemctl start rg-surf-vpn-install.service || true
fi
echo "chezmoi: rg-net-heal timer enabled"

# Live-audit timer (user unit: needs the session bus for notify-send). Best
# effort on first apply: the unit files land with the same chezmoi run.
if systemctl --user daemon-reload >/dev/null 2>&1; then
    systemctl --user enable --now rg-net-doctor.timer >/dev/null 2>&1 \
        && echo "chezmoi: rg-net-doctor timer enabled" \
        || echo "chezmoi: rg-net-doctor timer not enabled yet (unit missing?)" >&2
    systemctl --user enable --now rg-surf-vpn-refresh.timer >/dev/null 2>&1 \
        && echo "chezmoi: rg-surf-vpn-refresh timer enabled" \
        || echo "chezmoi: rg-surf-vpn-refresh timer not enabled yet (unit missing?)" >&2
fi
{{- end }}
