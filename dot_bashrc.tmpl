{{ if eq .machine_role "buildbot" -}}
# Disk-backed TMPDIR, aged by tmpfiles.d. /tmp here is a 24G tmpfs, which is
# RAM: a build that fills it does not merely run out of scratch space, it
# exhausts memory and swap, and then every write to /tmp on the machine starts
# failing. Small ephemera only belong there.
#
# Set before the non-interactive guard below on purpose. Build jobs run in
# non-interactive shells, which return at that guard, so anything placed after
# it would apply to exactly the sessions that do not need it.
export TMPDIR=/var/lib/builds/tmp

{{ end -}}
if [[ $- != *i* ]]; then
	# shell is non-interactive. Do nothing and return
	return
fi

# Strip /etc/bash.bashrc title-setting printf from PROMPT_COMMAND before
# anything else -- it conflicts with ble.sh and starship handles titles.
if [[ "$(declare -p PROMPT_COMMAND 2>/dev/null)" =~ "declare -a" ]]; then
	_pc=()
	for _cmd in "${PROMPT_COMMAND[@]}"; do
		[[ "$_cmd" == *'printf "\033]0;'* || "$_cmd" == *'printf "\033_'* || "$_cmd" == *$'\033]'* || "$_cmd" == *$'\033_'* ]] && continue
		_pc+=("$_cmd")
	done
	PROMPT_COMMAND=("${_pc[@]}")
	unset _pc _cmd
else
	if [[ "$PROMPT_COMMAND" == *'printf "\033]0;'* || "$PROMPT_COMMAND" == *'printf "\033_'* || "$PROMPT_COMMAND" == *$'\033]'* || "$PROMPT_COMMAND" == *$'\033_'* ]]; then
		PROMPT_COMMAND=""
	fi
fi

BLE_SH_PATH="$HOME/.local/share/blesh/ble.sh"
if [ -f "$BLE_SH_PATH" ]; then
	source "$BLE_SH_PATH" --attach=none
fi

if [[ $TERM = dumb ]]; then
	return # fixes TRAMP
fi

export shellHome=$HOME/.config/shellrc

# Load all files from the posix.d directory
if [ -d $shellHome/posix.d ]; then
	source "$shellHome/posix.d/00_show_gre.sh"
	source "$shellHome/posix.d/01_alias_def.sh"
	source "$shellHome/posix.d/02_func_def.sh"
	source "$shellHome/posix.d/03_exports.sh"
	# XXX(rg): Is slow.
	source "$shellHome/posix.d/05_paths.sh"
	source "$shellHome/posix.d/06_prog_conf.sh"
fi

{{- if eq .chezmoi.hostname "rgx1gen11" }}
[ ! -f "$HOME/.x-cmd.root/X" ] || . "$HOME/.x-cmd.root/X"
{{- end }}

# Load all files from the bashrc.d directory
if [ -d $shellHome/bash.d ]; then
	# for file in $shellHome/bash.d/*.bash; do
	# 	source $file
	# done
	source "$shellHome/bash.d/02_functions.bash"
	source "$shellHome/bash.d/99_activate_bin.bash"
fi

[[ ! ${BLE_VERSION-} ]] || ble-attach

export PATH="$HOME/.pixi/bin:$PATH"
export PATH="$HOME/.npm-global/bin:$PATH"

# DEEPSEEK_API_KEY is not exported here on purpose. `pass` on this host is
# pass-remote, an ssh round trip to the secret broker, and an eager lookup makes
# every interactive shell wait out a connect timeout before the prompt appears.
# Export it in the shell that needs it:
#   export DEEPSEEK_API_KEY=$(pass show services/deepseek-api-key)

# OMP Puppeteer
export PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
export PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

{{- $texlive_dir := output "bash" "-c" `ls -dtr ${HOME}/.local/share/texlive-* 2>/dev/null | tail -n1` | trim }}
{{- if $texlive_dir }}
export PATH="$PATH:{{ $texlive_dir }}/bin/x86_64-linux"
{{- end }}

export CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1

# Emacs Stuff (cross platform)
# Local Variables:
# mode: shell-script
# End:

# >>> grok installer >>>
export PATH="$HOME/.grok/bin:$PATH"
# 6203 lines defining one function, 19 ms to parse, for a completion nothing
# needs until the first TAB after `grok`. The stub loads the real file then
# returns 124, which is bash's signal to retry the completion with whatever
# handlers just appeared.
if [[ -r "$HOME/.grok/completions/bash/grok.bash" ]]; then
	_grok_completion_load() {
		complete -r grok 2>/dev/null
		source "$HOME/.grok/completions/bash/grok.bash"
		return 124
	}
	complete -F _grok_completion_load grok
fi
# <<< grok installer <<<

# Host-local shell setup, kept out of this file on purpose.
#
# Two kinds of line end up in a managed .bashrc and neither belongs here. One
# is genuinely host-specific (a cluster alias that means nothing elsewhere).
# The other is appended by tool installers -- cargo, uv, pixi -- which write to
# .bashrc directly and will do it again after every update. Managing this file
# then becomes a standing fight: apply deletes their lines, the next installer
# run puts them back, and the diff never settles.
#
# Anything host-specific goes in ~/.bashrc.local, which is not managed here and
# is never overwritten. Sourced last so it can override anything above it.
[[ -r "$HOME/.bashrc.local" ]] && . "$HOME/.bashrc.local"

# Last word on PATH. Everything between posix.d/05_paths.sh and here prepends
# without checking, and .bashrc.local is free to do the same, so the dedup only
# holds if it runs after all of them. zsh sets typeset -U instead and needs no
# second pass.
command -v dedup_path >/dev/null 2>&1 && dedup_path
