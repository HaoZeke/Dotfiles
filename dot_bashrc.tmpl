if [[ $- != *i* ]]; then
	# shell is non-interactive. Do nothing and return
	return
else
	BLE_SH_PATH="$HOME/.local/share/blesh/ble.sh"
	if [ -f "$BLE_SH_PATH" ]; then
		source "$BLE_SH_PATH" --attach=none
	fi

fi

if [[ $TERM = dumb ]]; then
	return # fixes TRAMP
fi

export shellHome=$HOME/.config/shellrc

# Load all files from the posix.d directory
if [ -d $shellHome/posix.d ]; then
	source "$shellHome/posix.d/00_show_gre.sh"
	source "$shellHome/posix.d/01_alias_def.sh"
	source "$shellHome/posix.d/02_func_def.sh"
	source "$shellHome/posix.d/03_exports.sh"
	# XXX(rg): Is slow.
	source "$shellHome/posix.d/05_paths.sh"
	source "$shellHome/posix.d/06_prog_conf.sh"
fi

# Load all files from the bashrc.d directory
if [ -d $shellHome/bash.d ]; then
	# for file in $shellHome/bash.d/*.bash; do
	# 	source $file
	# done
	source "$shellHome/bash.d/02_functions.bash"
	source "$shellHome/bash.d/99_activate_bin.bash"
fi

[[ ! ${BLE_VERSION-} ]] || ble-attach

