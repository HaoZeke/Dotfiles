if [[ $- != *i* ]]; then
	# shell is non-interactive. Do nothing and return
	return
fi

# Strip /etc/bash.bashrc title-setting printf from PROMPT_COMMAND before
# anything else -- it conflicts with ble.sh and starship handles titles.
if [[ "$(declare -p PROMPT_COMMAND 2>/dev/null)" =~ "declare -a" ]]; then
	_pc=()
	for _cmd in "${PROMPT_COMMAND[@]}"; do
		[[ "$_cmd" == *'printf "\033]0;'* || "$_cmd" == *'printf "\033_'* || "$_cmd" == *$'\033]'* || "$_cmd" == *$'\033_'* ]] && continue
		_pc+=("$_cmd")
	done
	PROMPT_COMMAND=("${_pc[@]}")
	unset _pc _cmd
else
	if [[ "$PROMPT_COMMAND" == *'printf "\033]0;'* || "$PROMPT_COMMAND" == *'printf "\033_'* || "$PROMPT_COMMAND" == *$'\033]'* || "$PROMPT_COMMAND" == *$'\033_'* ]]; then
		PROMPT_COMMAND=""
	fi
fi

BLE_SH_PATH="$HOME/.local/share/blesh/ble.sh"
if [ -f "$BLE_SH_PATH" ]; then
	source "$BLE_SH_PATH" --attach=none
fi

if [[ $TERM = dumb ]]; then
	return # fixes TRAMP
fi

export shellHome=$HOME/.config/shellrc

# Load all files from the posix.d directory
if [ -d $shellHome/posix.d ]; then
	source "$shellHome/posix.d/00_show_gre.sh"
	source "$shellHome/posix.d/01_alias_def.sh"
	source "$shellHome/posix.d/02_func_def.sh"
	source "$shellHome/posix.d/03_exports.sh"
	# XXX(rg): Is slow.
	source "$shellHome/posix.d/05_paths.sh"
	source "$shellHome/posix.d/06_prog_conf.sh"
fi

{{- if eq .chezmoi.hostname "rgx1gen11" }}
[ ! -f "$HOME/.x-cmd.root/X" ] || . "$HOME/.x-cmd.root/X"
{{- end }}

# Load all files from the bashrc.d directory
if [ -d $shellHome/bash.d ]; then
	# for file in $shellHome/bash.d/*.bash; do
	# 	source $file
	# done
	source "$shellHome/bash.d/02_functions.bash"
	source "$shellHome/bash.d/99_activate_bin.bash"
fi

[[ ! ${BLE_VERSION-} ]] || ble-attach

export PATH="$HOME/.pixi/bin:$PATH"
export PATH="$HOME/.npm-global/bin:$PATH"

# Keep API keys in pass; export only when the entry exists.
if command -v pass >/dev/null 2>&1; then
	_deepseek_api_key=$(pass show services/deepseek-api-key 2>/dev/null | sed -n '1p') || _deepseek_api_key=
	if [ -n "$_deepseek_api_key" ]; then
		export DEEPSEEK_API_KEY="$_deepseek_api_key"
	fi
	unset _deepseek_api_key
fi

# OMP Puppeteer
export PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
export PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true

{{- $texlive_dir := output "bash" "-c" `ls -dtr ${HOME}/.local/share/texlive-* 2>/dev/null | tail -n1` | trim }}
{{- if $texlive_dir }}
export PATH="$PATH:{{ $texlive_dir }}/bin/x86_64-linux"
{{- end }}

export GPG_TTY=$(tty)

export CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1

export PATH="$HOME/.opencode/bin:$PATH"

