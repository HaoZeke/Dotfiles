if [[ $- != *i* ]]; then
	# shell is non-interactive. Do nothing and return
	return
fi

if [[ $TERM = dumb ]]; then
	return # fixes TRAMP
fi

export shellHome=$HOME/.config/shellrc

# Load all .sh files from the posix.d directory using find
if [ -d "$shellHome/posix.d" ]; then
    find "$shellHome/posix.d" -maxdepth 1 -name "*.sh" -print0 |
        while IFS= read -r -d $'\0' file; do
            source "$file"
        done
fi

# Load all .bash files from the bash.d directory using find
if [ -d "$shellHome/bash.d" ]; then
    find "$shellHome/bash.d" -maxdepth 1 -name "*.bash" -print0 |
        while IFS= read -r -d $'\0' file; do
            source "$file"
        done
fi

# Mamba / Micromamba setup
{{ if eq .setup_mamba "yes" }}
eval "$(micromamba shell hook --shell=bash)"
{{ end }}

