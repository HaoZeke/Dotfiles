# shellcheck shell=bash
# Managed by chezmoi (dot_config/rg-kernel/build-lanes.env).

RG_KERNEL_MACHINE_ID=rgx1gen11
RG_KERNEL_MACHINE_MODEL="ThinkPad X1 Carbon Gen 11 21HM002GUS"
RG_KERNEL_PROFILE=rgx1gen11-performance-battery

RG_KERNEL_PACKAGE_BASE=linux-rg
RG_KERNEL_SOURCE_REPO="$HOME/Git/Github/Tools/linux-rg"
RG_KERNEL_BASE_REPO="https://gitlab.archlinux.org/archlinux/packaging/packages/linux.git"
RG_KERNEL_BASE_SUBDIR=
RG_KERNEL_ZEN_BASE_REPO="https://gitlab.archlinux.org/archlinux/packaging/packages/linux-zen.git"

RG_KERNEL_BUILD_ROOT="$HOME/.local/share/rg-kernel/build"
RG_KERNEL_ARTIFACT_DIR="$HOME/.local/share/rg-kernel/artifacts"
RG_KERNEL_PATCH_ROOT="$HOME/.config/rg-kernel/linux-rg/patches"
RG_KERNEL_PATCH_SOURCES="$HOME/.config/rg-kernel/linux-rg/patch-sources.tsv"
RG_KERNEL_CONFIG_FRAGMENT="$HOME/.config/rg-kernel/linux-rg/config-fragments/rgx1gen11.config"
RG_KERNEL_COMPAT_MANIFEST="$HOME/.config/rg-kernel/linux-rg/compatible-patches.tsv"
RG_KERNEL_DESIGN_DOC="$HOME/.config/rg-kernel/linux-rg/internal-design.org"
RG_KERNEL_OOMD_CONFIG="$HOME/.config/oomd/oomd-rgx1gen11.json"

RG_KERNEL_MIN_LOCAL_AVAIL_GIB=10
RG_KERNEL_LOCAL_CPU_PERCENT=80
RG_KERNEL_MAX_JOBS=9

RG_KERNEL_REQUIRED_FALLBACKS="linux"
RG_KERNEL_RECOMMENDED_FALLBACKS="linux-lts"

RG_KERNEL_SKIP_DOCS=yes
RG_KERNEL_BUILD_DEPS="base-devel git bc binutils cpio gettext glibc libelf libgcc openssl pahole perl python rust rust-bindgen rust-src tar xxhash xz zlib zstd clang llvm lld"
