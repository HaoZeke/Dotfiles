# shellcheck shell=bash
# Managed by chezmoi (dot_config/rg-kernel/build-lanes.env).

RG_KERNEL_REMOTE=rg.cosmolab
RG_KERNEL_REMOTE_ROOT="$HOME/.cache/rg-kernel-build"
RG_KERNEL_ARTIFACT_DIR="$HOME/.local/share/rg-kernel/artifacts"
RG_KERNEL_PATCH_ROOT="$HOME/.config/rg-kernel/patches"

RG_KERNEL_LANES="arch-zen sched-ext cachy-bore ck-muqss"
RG_KERNEL_RECOMMENDED_LAPTOP_LANE=arch-zen
RG_KERNEL_REQUIRED_FALLBACKS="linux linux-lts"

RG_KERNEL_BASE_arch_zen="https://gitlab.archlinux.org/archlinux/packaging/packages/linux-zen.git"
RG_KERNEL_BASE_sched_ext="https://gitlab.archlinux.org/archlinux/packaging/packages/scx-scheds.git"
RG_KERNEL_BASE_cachy_bore="https://github.com/CachyOS/linux-cachyos.git"
RG_KERNEL_BASE_ck_muqss="https://aur.archlinux.org/linux-ck.git"
