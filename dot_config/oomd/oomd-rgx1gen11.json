{
  "rulesets": [
    {
      "name": "desktop memory pressure guard",
      "post_action_delay": "20",
      "detectors": [
        [
          "user slices and host memory are under pressure",
          {
            "name": "pressure_rising_beyond",
            "args": {
              "cgroup": "user.slice",
              "resource": "memory",
              "threshold": "99",
              "duration": "86400"
            }
          },
          {
            "name": "pressure_rising_beyond",
            "args": {
              "cgroup": "/",
              "resource": "memory",
              "threshold": "99",
              "duration": "86400"
            }
          }
        ],
        [
          "host memory pressure is severe",
          {
            "name": "pressure_above",
            "args": {
              "cgroup": "/",
              "resource": "memory",
              "threshold": "99",
              "duration": "86400"
            }
          }
        ]
      ],
      "actions": [
        {
          "name": "kill_by_memory_size_or_growth",
          "args": {
            "cgroup": "user.slice/*/user@*.service/*",
            "recursive": "true",
            "size_threshold": "35",
            "min_growth_ratio": "1.20",
            "post_action_delay": "20"
          }
        }
      ]
    },
    {
      "name": "io pressure guard",
      "post_action_delay": "20",
      "detectors": [
        [
          "host io pressure is severe",
          {
            "name": "pressure_rising_beyond",
            "args": {
              "cgroup": "/",
              "resource": "io",
              "threshold": "99",
              "duration": "86400"
            }
          }
        ]
      ],
      "actions": [
        {
          "name": "kill_by_pressure",
          "args": {
            "cgroup": "user.slice/*/user@*.service/*",
            "resource": "io",
            "recursive": "true",
            "post_action_delay": "20"
          }
        }
      ]
    }
  ]
}
