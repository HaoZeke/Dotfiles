# -*- mode:conf; -*-

#################################################################
## Window layout rules
#################################################################
# to find window app_id, class, title, role use: swaymsg -t get_tree

## Notes
# pixel 0 is for those which have other active indicators
# pixel 3 provides a think blue active / inactive outline
# pixel 1 is a bit too light for this..

for_window {
  # prevent screen lock if window is in fullscreen mode
  [class=".*"] {
      inhibit_idle fullscreen
  }

  [app_id=".*"] {
      inhibit_idle fullscreen
  }

  # Float tooltips and more
  [window_role = "bubble"] {
      floating enable
  }

  [window_role = "dialog"] {
      floating enable
  }

  [window_role = "task_dialog"] {
      floating enable
  }

  [window_type = "menu"] {
      floating enable
  }

  # Firefox :: begin
  [app_id="firefox"] {
      border none
  }

  [class="Firefox"] {
      border none
  }

  [app_id="viewnior"] {
      border normal 2
  }

  [class="Viewnior"] {
      border normal 2
  }

  [title="Firefox — Sharing Indicator"] {
      border pixel 2
      floating enable
      nofocus
  }

  [window_role="pop-up"] {
      floating enable
  }
  # Firefox :: end

  # Firefox + Chrome :: start
  [title="^Picture-in-Picture$"] {
      focus
      floating enable
      border pixel 2
      sticky toggle
      resize set height 280px
      resize set width 500px
      move position 100ppt 0
      move left 500px
  }

  [title="^Picture in picture$"] {
      focus
      floating enable
      border pixel 2
      sticky toggle
      resize set height 280px
      resize set width 500px
      move position 100ppt 0
      move left 500px
  }
  # Firefox + Chrome :: end

  # Thunar :: begin
  [app_id=app_id="Thunar" title="^Copying.*"] {
      floating enable
  }

  [title="^File Operation Progress$"] {
      floating enable
  }
  # Thunar :: end

  # Zotero :: begin
  [app_id="Zotero"] {
      border pixel 0
  }

  [app_id="Zotero" title="Progress"] {
      floating enable
      border pixel 0
  }

  [app_id="Zotero" title="^Quick Format Citation$"] {
      floating enable
      border pixel 0
  }
  # Zotero :: end

  [title="^Windscribe$"] {
      floating enable
      border pixel 0
  }

  [class="tabby"] {
      border pixel 0
  }

  [app_id="com.github.geigi.cozy"] {
      border pixel 0
  }

}

