# -*- conf -*-
# Settings
set {
 $ms_pos fullscreen disable, border pixel 1, move position 1px 1px, resize set 50 ppt 35 ppt
 $sf_pos fullscreen disable, border pixel 1, move position center
 $fractal_pos fullscreen disable, border pixel 1, move position center, resize set 45 ppt 62 ppt
 $start_ms systemctl --user start foot-ms.service
 $start_sf systemctl --user start foot-subfloat.service
}
# The main scratchpad in the upper left
for_window [app_id="mS"] {
    move to scratchpad
    floating enable
    sticky disable
    $ms_pos
}
bindsym F1 exec swaymsg [app_id="mS"] scratchpad show || $start_ms, $ms_pos

# The secondary scratchpad in the center
for_window [app_id="subFloat"] {
    move to scratchpad
    floating enable
    sticky disable
    $sf_pos
}
bindsym F5 exec swaymsg [app_id="subFloat"] scratchpad show || $start_sf, $sf_pos

# Fractal has no tray mode; keep it alive in the scratchpad for notifications.
for_window [app_id="org.gnome.Fractal"] {
    move to scratchpad
    floating enable
    sticky disable
    $fractal_pos
}
bindsym $mod+m exec ~/.local/bin/rg-fractal-toggle
