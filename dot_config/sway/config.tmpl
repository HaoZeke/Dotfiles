# Default config for sway
#
# Copy this to ~/.config/sway/config and edit it to your liking.
#
# Read `man 5 sway` for a complete reference.

### Variables
#
# Palette variables populated by rg-theme (~/.config/sway/colors.conf
# is a symlink into ~/.local/share/rg-theme/palettes/<palette>/<mode>/).
# Included early so $bar_bg, $ws_focus_bg etc. resolve when the
# bar { } and client.* blocks below are parsed.
include $HOME/.config/sway/colors.conf

# Logo key. Use Mod1 for Alt.
set $mod Mod4
# Home row direction keys, like vim
set $left h
set $down n
set $up e
set $right i
# Your preferred terminal emulator (client)
set $term_server foot -s
# XDG_RUNTIME_DIR should be /run/user/$(id -u $USER)/
set $term footclient --server-socket=$XDG_RUNTIME_DIR/foot-server.sock
# Your preferred application launcher
# Note: pass the final command to swaymsg so that the resulting window can be opened
# on the original workspace that the command was run on.
# Always use https://github.com/lbonn/rofi
# for wayland support
set $menu rofi -show combi -show-icons -combi-modi "drun,run" -modi combi # | xargs swaymsg exec --
set $screenshotTask grim -g "$(slurp -d)" - | wl-copy -t image/png

### Output configuration
#
# Default wallpaper (more resolutions are available in /usr/share/backgrounds/sway/)
output "*" {
       bg ~/Pictures/Walls/desktop.jpg fill
       subpixel rgb
       adaptive_sync on
       max_render_time off
}

# Screen profiles are handled by kanshi

# Special Keys
set $WOBSOCK $XDG_RUNTIME_DIR/wob.sock
exec mkfifo $WOBSOCK && tail -f $WOBSOCK | wob

bindsym XF86AudioRaiseVolume exec pamixer -ui 2 && pamixer --get-volume > $WOBSOCK
bindsym XF86AudioLowerVolume exec pamixer -ud 2 && pamixer --get-volume > $WOBSOCK
bindsym XF86AudioMute exec pamixer --toggle-mute && ( pamixer --get-mute && echo 0 > $WOBSOCK ) || pamixer --get-volume > $WOBSOCK
bindsym --no-repeat XF86AudioMicMute exec pamixer --default-source --toggle-mute

bindsym XF86MonBrightnessDown exec $HOME/.local/bin/brightness_sync.sh 5%- $WOBSOCK
bindsym XF86MonBrightnessUp   exec $HOME/.local/bin/brightness_sync.sh +5% $WOBSOCK

# Media keys: playerctl is installed (see browser-media-watchdog); use
# it so the same key works for whichever player is active (mpv,
# Spotify, browser, etc.).
bindsym --no-repeat XF86AudioPlay exec playerctl play-pause
bindsym --no-repeat XF86AudioNext exec playerctl next
bindsym --no-repeat XF86AudioPrev exec playerctl previous

# Gaps
smart_gaps on
gaps outer 0
gaps inner 5
smart_borders on
hide_edge_borders smart
default_border pixel 2
default_floating_border pixel 2

# Daemons
 exec_always "systemctl --user import-environment; systemctl --user start sway-session.target"

### Input configuration
#
# Example configuration:
#
#   input "2:14:SynPS/2_Synaptics_TouchPad" {
#       dwt enabled
#       tap enabled
#       natural_scroll enabled
#       middle_emulation enabled
#   }
#
# You can get the names of your inputs by running: swaymsg -t get_inputs
# Read `man 5 sway-input` for more information about this section.

### Key bindings
#
# Basics:
#
    # Start a terminal
    # --no-repeat: under CPU load, sway can receive a delayed first
    # event plus a buffered key-repeat as a pair; without this flag,
    # $mod+Return opens two terminals. Applied to every one-shot
    # action binding below for the same reason.
    bindsym --no-repeat $mod+Return exec $term

    # Kill focused window
    bindsym --no-repeat $mod+w kill

    # Start your launcher
    bindsym --no-repeat $mod+Space exec $menu

    # Lookup copied items
    bindsym --no-repeat $mod+Shift+v exec 'rofi -modi clipboard:~/.local/bin/cliphist-rofi-img -show clipboard -show-icons'

    # Drag floating windows by holding down $mod and left mouse button.
    # Resize them with right mouse button + $mod.
    # Despite the name, also works for non-floating windows.
    # Change normal to inverse to use left mouse button for resizing and right
    # mouse button for dragging.
    floating_modifier $mod normal

    # Reload the configuration file
    bindsym --no-repeat $mod+Shift+c reload

    # Lock screen
    # After scu-enable-now swayidle.target
    bindsym --no-repeat $mod+Escape exec 'swaylock -f --clock --indicator-idle-visible --image ~/Pictures/Walls/lockscreen.png --daemonize'

    # Lock + suspend-then-hibernate (auto-hibernates after HibernateDelaySec
    # configured in /etc/systemd/sleep.conf.d/50-hibernate.conf).
    bindsym --no-repeat $mod+Shift+Escape exec 'swaylock -f --clock --indicator-idle-visible --image ~/Pictures/Walls/lockscreen.png && systemctl suspend-then-hibernate'

    # Toggle idle-hibernate suppression while preserving swayidle dim/lock/DPMS
    # and all lid/power-button sleep paths.
    bindsym --no-repeat $mod+Shift+F3 exec '$HOME/.local/bin/rg-caffeine toggle'
    bindsym --no-repeat $mod+Ctrl+Shift+F3 exec '$HOME/.local/bin/rg-caffeine presentation-toggle'
    bindsym --no-repeat $mod+Mod1+Shift+F3 exec '$HOME/.local/bin/rg-caffeine timed 2h'

    # Exit sway (logs you out of your Wayland session)
    bindsym --no-repeat $mod+Shift+q exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'
#
# Moving around:
#
    # Move your focus around
    bindsym $mod+$left focus left
    bindsym $mod+$down focus down
    bindsym $mod+$up focus up
    bindsym $mod+$right focus right
    # Or use $mod+[up|down|left|right]
    bindsym $mod+Left focus left
    bindsym $mod+Down focus down
    bindsym $mod+Up focus up
    bindsym $mod+Right focus right

    # Move the focused window with the same, but add Shift
    bindsym $mod+Shift+$left move left
    bindsym $mod+Shift+$down move down
    bindsym $mod+Shift+$up move up
    bindsym $mod+Shift+$right move right
    # Ditto, with arrow keys
    bindsym $mod+Shift+Left move left
    bindsym $mod+Shift+Down move down
    bindsym $mod+Shift+Up move up
    bindsym $mod+Shift+Right move right
#
# Workspaces:
#
    # Switch to workspace
    bindsym $mod+1 workspace number 1
    bindsym $mod+2 workspace number 2
    bindsym $mod+3 workspace number 3
    bindsym $mod+4 workspace number 4
    bindsym $mod+5 workspace number 5
    bindsym $mod+6 workspace number 6
    bindsym $mod+7 workspace number 7
    bindsym $mod+8 workspace number 8
    bindsym $mod+9 workspace number 9
    bindsym $mod+0 workspace number 10
    # Move focused container to workspace
    bindsym $mod+Shift+1 move container to workspace number 1
    bindsym $mod+Shift+2 move container to workspace number 2
    bindsym $mod+Shift+3 move container to workspace number 3
    bindsym $mod+Shift+4 move container to workspace number 4
    bindsym $mod+Shift+5 move container to workspace number 5
    bindsym $mod+Shift+6 move container to workspace number 6
    bindsym $mod+Shift+7 move container to workspace number 7
    bindsym $mod+Shift+8 move container to workspace number 8
    bindsym $mod+Shift+9 move container to workspace number 9
    bindsym $mod+Shift+0 move container to workspace number 10
    # Note: workspaces can have any name you want, not just numbers.
    # We just use 1-10 as the default.

# Move workspace to other monitor (left right is essentially the same with two
# monitors)
bindsym $mod+Shift+m move workspace to output right

# Screenshot
bindsym --no-repeat $mod+o exec $screenshotTask
bindsym --no-repeat Print    exec $screenshotTask

# Notification management (mako uses dismiss instead of close)
bindsym ctrl+space exec dunstctl close
bindsym ctrl+Shift+space exec dunstctl close-all

#
# Layout stuff:
#
    # You can "split" the current object of your focus with
    # $mod+b or $mod+v, for horizontal and vertical splits
    # respectively.
    bindsym $mod+b splith
    bindsym $mod+v splitv

    # Switch the current container between different layout styles
    bindsym $mod+Shift+s layout stacking
    bindsym $mod+Shift+w layout tabbed
    bindsym $mod+Shift+x layout toggle split

    # Make the current focus fullscreen
    bindsym $mod+f fullscreen

    # Toggle the current focus between tiling and floating mode
    bindsym $mod+Shift+space floating toggle

    # Swap focus between the tiling area and the floating area
    bindsym $mod+space+b focus mode_toggle

    # Move focus to the parent container
    bindsym $mod+a focus parent
#
# Scratchpad:
#
    # Sway has a "scratchpad", which is a bag of holding for windows.
    # You can send windows there and get them back later.

    # Move the currently focused window to the scratchpad
    bindsym $mod+Shift+minus move scratchpad

    # Show the next scratchpad window or hide the focused scratchpad window.
    # If there are multiple scratchpad windows, this command cycles through them.
    bindsym $mod+minus scratchpad show
#
# Resizing containers:
#
mode "resize" {
    # left will shrink the containers width
    # right will grow the containers width
    # up will shrink the containers height
    # down will grow the containers height
    bindsym $left resize shrink width 10 px or 10 ppt
    bindsym $down resize grow height 10 px or 10 ppt
    bindsym $up resize shrink height 10 px or 10 ppt
    bindsym $right resize grow width 10 px or 10 ppt

    # ditto, with arrow keys
    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt

    # return to default mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym q mode "default"
}
bindsym $mod+r mode "resize"

#
# Status Bar:
#
# Read `man 5 sway-bar` for more information about this section.
# bar {
#     position top

#     # When the status_command prints a new line to stdout, swaybar updates.
#     # The default just shows the current date and time.
#     status_command while date +'%Y-%m-%d %I:%M:%S %p'; do sleep 1; done

#     colors {
#         statusline #ffffff
#         background #323232
#         inactive_workspace #32323200 #32323200 #5c5c5c
#     }
# }

# xwayland scale 3
# Wiki
input type:keyboard {
    # When using kanata: leave layout as default (kanata remaps at evdev level)
    # When NOT using kanata: uncomment xkb_file for klfc-generated Colemak+Extend
    # xkb_file ~/.config/sway/keymap.xkb
    repeat_delay 500
    repeat_rate 25
}

# swaymsg -t get_inputs
input type:touchpad {
    natural_scroll enabled
    tap enabled
}

input type:pointer {
    natural_scroll enabled
}

# xwayland force scale 2
exec xsettingsd
# Here: https://www.reddit.com/r/swaywm/comments/p9ah2v/completely_hide_mouse_pointer_wayland/
seat seat0 hide_cursor 1000
bar {
    status_command    eval $(gpg --decrypt $HOME/.config/keys.sh.gpg) && i3status-rs ~/.config/i3rust/i3_top.toml
    position          top
    workspace_buttons yes
    tray_output       eDP-1
    font pango:AtkinsonHyperlegibleMono Nerd Font 12

    colors {
        separator          $bar_sep
        background         $bar_bg
        statusline         $bar_fg
        focused_workspace  $ws_focus_bg    $ws_focus_bg    $ws_focus_fg
        active_workspace   $ws_active_bg   $ws_active_bg   $ws_active_fg
        inactive_workspace $ws_inactive_bg $ws_inactive_bg $ws_inactive_fg
        urgent_workspace   $ws_urgent_bg   $ws_urgent_bg   $ws_urgent_fg
    }
}


bar {
    status_command   eval $(gpg --decrypt $HOME/.config/keys.sh.gpg) && i3status-rs ~/.config/i3rust/i3_bottom.toml
    position          bottom
    workspace_buttons no
    tray_output none
    font pango:AtkinsonHyperlegibleMono Nerd Font 12

    colors {
        separator          $bar_sep
        background         $bar_bg
        statusline         $bar_fg
        focused_workspace  $ws_focus_bg    $ws_focus_bg    $ws_focus_fg
        active_workspace   $ws_active_bg   $ws_active_bg   $ws_active_fg
        inactive_workspace $ws_inactive_bg $ws_inactive_bg $ws_inactive_fg
        urgent_workspace   $ws_urgent_bg   $ws_urgent_bg   $ws_urgent_fg
    }
}

# Faster thunar
exec thunar --daemon

# Faster terminals
# Now managed by .conf/systemd/user/foot-server.{service,sock}
# exec_always $term_server

# Notifications (now with dunst)
# exec_always mako

# Clipboard history
exec_always wl-paste --watch cliphist store

# Sync stuff
# Disabled by default, reduce network calls for offline situations
# exec insync start

# For fingerprint and more
exec_always lxpolkit

# Wayland settings
for_window [shell="xwayland"] title_format "[XWayland] %title"
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway XDG_SESSION_TYPE=wayland

# Moves the external screen to the right
# swaymsg output eDP-1 pos 1600 0 res 1920x1080
# The scaling is because of the DPI stuff
# Swap 1600 and 0 to get the screen on the relative left

# Window borders pick up the active palette via the same include at
# the top of this file.
#             border            background        text              indicator           child_border
client.focused           $border_focus     $border_focus     $bar_fg           $border_focus_ind   $border_focus
client.focused_inactive  $border_unfocus   $border_unfocus   $bar_fg           $border_unfocus     $border_unfocus
client.unfocused         $border_unfocus   $bar_bg           $bar_fg           $border_unfocus     $border_unfocus
client.urgent            $border_urgent    $border_urgent    $bar_fg           $border_urgent      $border_urgent
client.placeholder       $border_unfocus   $bar_bg           $bar_fg           $border_unfocus     $border_unfocus

# rg-theme palette toggle + picker. F1 flips light/dark in the current
# palette; F2 pops the rofi picker for a palette switch.
bindsym $mod+Shift+F1 exec rg-theme toggle
bindsym $mod+Shift+F2 exec rg-theme pick

include /etc/sway/config.d/*
include $HOME/.config/sway/conf.d/*
include $HOME/.config/sway/conf.d/**/*
