# Default config for sway
#
# Copy this to ~/.config/sway/config and edit it to your liking.
#
# Read `man 5 sway` for a complete reference.

### Variables
#
# Palette variables populated by rg-theme (~/.config/sway/colors.conf
# is a symlink into ~/.local/share/rg-theme/palettes/<palette>/<mode>/).
# Included early so $bar_bg, $ws_focus_bg etc. resolve when the
# bar { } and client.* blocks below are parsed.
include $HOME/.config/sway/colors.conf

# Logo key. Use Mod1 for Alt.
set $mod Mod4
# Home row direction keys, like vim
set $left h
set $down n
set $up e
set $right i
# Your preferred terminal emulator (client)
set $term_server foot -s
# XDG_RUNTIME_DIR should be /run/user/$(id -u $USER)/
set $term footclient --server-socket=$XDG_RUNTIME_DIR/foot-server.sock
set $tmux_chooser footclient --server-socket=$XDG_RUNTIME_DIR/foot-server.sock --app-id=tmuxChooser -T tmux-chooser -e $HOME/.local/bin/rg-tmux-role client-chooser
# Your preferred application launcher
# Note: pass the final command to swaymsg so that the resulting window can be opened
# on the original workspace that the command was run on.
# Always use https://github.com/lbonn/rofi
# for wayland support
set $menu rofi -show combi -show-icons -combi-modi "drun,run" -modi combi # | xargs swaymsg exec --
set $screenshotTask grim -g "$(slurp -d)" - | wl-copy -t image/png

### Output configuration
#
# Default wallpaper (more resolutions are available in /usr/share/backgrounds/sway/)
output "*" {
       bg ~/Pictures/Walls/desktop.jpg fill
       subpixel rgb
       adaptive_sync on
       max_render_time off
}

# Screen profiles are handled by kanshi

# Special Keys
set $WOBSOCK $XDG_RUNTIME_DIR/wob.sock
# wob now runs as a user service tied to sway-session.target, so sway
# only needs to publish the FIFO path for brightness/volume helpers.

bindsym XF86AudioRaiseVolume exec pamixer -ui 2 && [ -p $WOBSOCK ] && pamixer --get-volume > $WOBSOCK
bindsym XF86AudioLowerVolume exec pamixer -ud 2 && [ -p $WOBSOCK ] && pamixer --get-volume > $WOBSOCK
bindsym XF86AudioMute exec pamixer --toggle-mute && [ -p $WOBSOCK ] && ( pamixer --get-mute && echo "0 muted" > $WOBSOCK || pamixer --get-volume > $WOBSOCK )
bindsym --no-repeat XF86AudioMicMute exec pamixer --default-source --toggle-mute

bindsym XF86MonBrightnessDown exec $HOME/.local/bin/brightness_sync.sh 5%- $WOBSOCK
bindsym XF86MonBrightnessUp   exec $HOME/.local/bin/brightness_sync.sh +5% $WOBSOCK

# Media keys: playerctl is installed (see browser-media-watchdog); use
# it so the same key works for whichever player is active (mpv,
# Spotify, browser, etc.).
bindsym --no-repeat XF86AudioPlay exec playerctl play-pause
bindsym --no-repeat XF86AudioNext exec playerctl next
bindsym --no-repeat XF86AudioPrev exec playerctl previous

# Gaps
smart_gaps on
gaps outer 0
gaps inner 5
smart_borders on
hide_edge_borders smart
default_border pixel 2
default_floating_border pixel 2

# Daemons
 exec_always "systemctl --user import-environment; systemctl --user start sway-session.target"
 exec_always "$HOME/.local/bin/rg-workspace-sync"

### Input configuration
#
# Example configuration:
#
#   input "2:14:SynPS/2_Synaptics_TouchPad" {
#       dwt enabled
#       tap enabled
#       natural_scroll enabled
#       middle_emulation enabled
#   }
#
# You can get the names of your inputs by running: swaymsg -t get_inputs
# Read `man 5 sway-input` for more information about this section.

### Key bindings
#
# Basics:
#
    # Start a terminal
    # --no-repeat: under CPU load, sway can receive a delayed first
    # event plus a buffered key-repeat as a pair; without this flag,
    # $mod+Return opens two terminals. Applied to every one-shot
    # action binding below for the same reason.
    bindsym --no-repeat $mod+Return exec $term

    # Kill focused window
    bindsym --no-repeat $mod+w kill

    # Start your launcher
    bindsym --no-repeat $mod+Space exec $menu

    # Lookup copied items
    bindsym --no-repeat $mod+Shift+v exec 'rofi -modi clipboard:~/.local/bin/cliphist-rofi-img -show clipboard -show-icons'

    # vissue: rofi-driven launcher for vault issues. Default mode lists
    # actionable items (TODO/STARTED, no open blocker) and opens the chosen
    # one in $EDITOR at the heading's line. Shift variant prompts for a
    # project then a title and creates a new issue.
    # bindsym --no-repeat $mod+i       exec '$HOME/.local/bin/vissue-rofi'
    # bindsym --no-repeat $mod+Shift+i exec '$HOME/.local/bin/vissue-rofi new'

    # Drag floating windows by holding down $mod and left mouse button.
    # Resize them with right mouse button + $mod.
    # Despite the name, also works for non-floating windows.
    # Change normal to inverse to use left mouse button for resizing and right
    # mouse button for dragging.
    floating_modifier $mod normal

    # Reload the configuration file
    bindsym --no-repeat $mod+Shift+c reload

    # Lock screen
    # After scu-enable-now swayidle.target
    bindsym --no-repeat $mod+Escape exec '$HOME/.local/bin/rg-lockscreen --daemonize'

{{- if eq .chezmoi.hostname "rgx1gen11" }}
    # Lock + hibernate. Plain suspend uses s2idle on this host.
    bindsym --no-repeat $mod+Shift+Escape exec '$HOME/.local/bin/rg-lockscreen && systemctl hibernate'
{{- else }}
    # Lock + suspend-then-hibernate (auto-hibernates after HibernateDelaySec
    # configured in /etc/systemd/sleep.conf.d/50-hibernate.conf).
    bindsym --no-repeat $mod+Shift+Escape exec '$HOME/.local/bin/rg-lockscreen && systemctl suspend-then-hibernate'
{{- end }}

    # Session modes:
    #   caffeine: block idle sleep, keep lock behavior
    #   boost: force the battery-side performance backend when requested
    #   focus: presentation-style idle policy plus boost together
    bindsym --no-repeat $mod+Shift+F3 exec '$HOME/.local/bin/rg-caffeine toggle'
    bindsym --no-repeat $mod+Ctrl+F3 exec '$HOME/.local/bin/rg-caffeine performance-toggle'
    bindsym --no-repeat $mod+Ctrl+Shift+F3 exec '$HOME/.local/bin/rg-caffeine focus-toggle'
    bindsym --no-repeat $mod+Mod1+Shift+F3 exec '$HOME/.local/bin/rg-caffeine timed 2h'
    bindsym --no-repeat $mod+F1 exec $tmux_chooser
    bindsym --no-repeat $mod+F5 exec '$HOME/.local/bin/rg-tmux-role save'
    bindsym --no-repeat $mod+F6 exec '$HOME/.local/bin/rg-tmux-role restore'
    bindsym --no-repeat $mod+Shift+slash exec '$HOME/.local/bin/rg-desktop-help'

    # Exit sway (logs you out of your Wayland session)
    bindsym --no-repeat $mod+Shift+q exec swaynag -t warning -m 'You pressed the exit shortcut. Do you really want to exit sway? This will end your Wayland session.' -B 'Yes, exit sway' 'swaymsg exit'
#
# Moving around:
#
    # Move your focus around
    bindsym $mod+$left focus left
    bindsym $mod+$down focus down
    bindsym $mod+$up focus up
    bindsym $mod+$right focus right
    # Or use $mod+[up|down|left|right]
    bindsym $mod+Left focus left
    bindsym $mod+Down focus down
    bindsym $mod+Up focus up
    bindsym $mod+Right focus right

    # Move the focused window with the same, but add Shift
    bindsym $mod+Shift+$left move left
    bindsym $mod+Shift+$down move down
    bindsym $mod+Shift+$up move up
    bindsym $mod+Shift+$right move right
    # Ditto, with arrow keys
    bindsym $mod+Shift+Left move left
    bindsym $mod+Shift+Down move down
    bindsym $mod+Shift+Up move up
    bindsym $mod+Shift+Right move right
#
# Workspaces:
#
    # Named workspaces keep the strip readable without losing number-row muscle
    # memory. Leading numbers keep bar ordering stable.
    set $ws1 "1: term"
    set $ws2 "2: web"
    set $ws3 "3: code"
    set $ws4 "4: note"
    set $ws5 "5: chat"
    set $ws6 "6: file"
    set $ws7 "7: read"
    set $ws8 "8: media"
    set $ws9 "9: lab"
    set $ws10 "10: sys"

    # Repeating the current workspace shortcut flips back to the previous one.
    # The "workspace number" form prefers the numbered slot if it already
    # exists, otherwise it creates the semantic name, so bare "7" and
    # "7:read" stop being a keyboard trap.
    workspace_auto_back_and_forth yes

    # Switch to workspace
    bindsym $mod+1 workspace number $ws1
    bindsym $mod+2 workspace number $ws2
    bindsym $mod+3 workspace number $ws3
    bindsym $mod+4 workspace number $ws4
    bindsym $mod+5 workspace number $ws5
    bindsym $mod+6 workspace number $ws6
    bindsym $mod+7 workspace number $ws7
    bindsym $mod+8 workspace number $ws8
    bindsym $mod+9 workspace number $ws9
    bindsym $mod+0 workspace number $ws10
    bindsym $mod+comma workspace prev_on_output
    bindsym $mod+period workspace next_on_output
    bindsym $mod+Tab workspace back_and_forth
    bindsym --no-repeat $mod+g mode "goto"
    bindsym --no-repeat $mod+slash exec '$HOME/.local/bin/rg-workspace-menu'

    # Move focused container to workspace
    bindsym $mod+Shift+1 move container to workspace number $ws1
    bindsym $mod+Shift+2 move container to workspace number $ws2
    bindsym $mod+Shift+3 move container to workspace number $ws3
    bindsym $mod+Shift+4 move container to workspace number $ws4
    bindsym $mod+Shift+5 move container to workspace number $ws5
    bindsym $mod+Shift+6 move container to workspace number $ws6
    bindsym $mod+Shift+7 move container to workspace number $ws7
    bindsym $mod+Shift+8 move container to workspace number $ws8
    bindsym $mod+Shift+9 move container to workspace number $ws9
    bindsym $mod+Shift+0 move container to workspace number $ws10

    # Absent apps do nothing; matching apps land on the workspace that already
    # matches their role.
    # assign [app_id="firefox"] $ws2
    # assign [app_id="librewolf"] $ws2
    # assign [class="Firefox"] $ws2
    # assign [class="LibreWolf"] $ws2

    # assign [app_id="code"] $ws3
    # assign [app_id="codium"] $ws3
    # assign [app_id="emacs"] $ws3
    # assign [class="Code"] $ws3
    # assign [class="VSCodium"] $ws3
    # assign [class="Emacs"] $ws3

    # assign [app_id="obsidian"] $ws4
    # assign [class="Obsidian"] $ws4

    # assign [app_id="discord"] $ws5
    # assign [app_id="signal"] $ws5
    # assign [app_id="org.telegram.desktop"] $ws5
    # assign [class="discord"] $ws5
    # assign [class="Signal"] $ws5
    # assign [class="Slack"] $ws5
    # assign [class="TelegramDesktop"] $ws5

    # assign [app_id="thunar"] $ws6

mode "goto" {
    bindsym r workspace number $ws7, mode "default"
    bindsym n workspace number $ws4, mode "default"
    bindsym f workspace number $ws6, mode "default"
    bindsym w workspace number $ws2, mode "default"
    bindsym c workspace number $ws3, mode "default"
    bindsym m workspace number $ws8, mode "default"
    bindsym s workspace number $ws10, mode "default"

    bindsym Return mode "default"
    bindsym Escape mode "default"
}
    # assign [class="Thunar"] $ws6

    # assign [app_id="zathura"] $ws7
    # assign [class="Zathura"] $ws7

    # assign [app_id="mpv"] $ws8
    # assign [app_id="spotify"] $ws8
    # assign [app_id="vlc"] $ws8
    # assign [class="mpv"] $ws8
    # assign [class="Spotify"] $ws8
    # assign [class="Vlc"] $ws8

# Move workspace to other monitor (left right is essentially the same with two
# monitors)
bindsym $mod+Shift+m move workspace to output right

# Screenshot
bindsym --no-repeat $mod+o exec $screenshotTask
bindsym --no-repeat Print    exec $screenshotTask

# Notification management (mako uses dismiss instead of close)
bindsym ctrl+space exec dunstctl close
bindsym ctrl+Shift+space exec dunstctl close-all

#
# Layout stuff:
#
    # You can "split" the current object of your focus with
    # $mod+b or $mod+v, for horizontal and vertical splits
    # respectively.
    bindsym $mod+b splith
    bindsym $mod+v splitv

    # Switch the current container between different layout styles
    bindsym $mod+Shift+s layout stacking
    bindsym $mod+Shift+w layout tabbed
    bindsym $mod+Shift+x layout toggle split

    # Make the current focus fullscreen
    bindsym $mod+f fullscreen

    # Toggle the current focus between tiling and floating mode
    bindsym $mod+Shift+space floating toggle

    # Swap focus between the tiling area and the floating area
    bindsym $mod+space+b focus mode_toggle

    # Move focus to the parent container
    bindsym $mod+a focus parent
#
# Scratchpad:
#
    # Sway has a "scratchpad", which is a bag of holding for windows.
    # You can send windows there and get them back later.

    # Move the currently focused window to the scratchpad
    bindsym $mod+Shift+minus move scratchpad

    # Show the next scratchpad window or hide the focused scratchpad window.
    # If there are multiple scratchpad windows, this command cycles through them.
    bindsym $mod+minus scratchpad show
#
# Resizing containers:
#
mode "resize" {
    # left will shrink the containers width
    # right will grow the containers width
    # up will shrink the containers height
    # down will grow the containers height
    bindsym $left resize shrink width 10 px or 10 ppt
    bindsym $down resize grow height 10 px or 10 ppt
    bindsym $up resize shrink height 10 px or 10 ppt
    bindsym $right resize grow width 10 px or 10 ppt

    # ditto, with arrow keys
    bindsym Left resize shrink width 10 px or 10 ppt
    bindsym Down resize grow height 10 px or 10 ppt
    bindsym Up resize shrink height 10 px or 10 ppt
    bindsym Right resize grow width 10 px or 10 ppt

    # return to default mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym q mode "default"
}
bindsym $mod+r mode "resize"

#
# Status Bar:
#
# Read `man 5 sway-bar` for more information about this section.
# bar {
#     position top

#     # When the status_command prints a new line to stdout, swaybar updates.
#     # The default just shows the current date and time.
#     status_command while date +'%Y-%m-%d %I:%M:%S %p'; do sleep 1; done

#     colors {
#         statusline #ffffff
#         background #323232
#         inactive_workspace #32323200 #32323200 #5c5c5c
#     }
# }

# xwayland scale 3
# Wiki
input type:keyboard {
    # When using kanata: leave layout as default (kanata remaps at evdev level)
    # When NOT using kanata: uncomment xkb_file for klfc-generated Colemak+Extend
    # xkb_file ~/.config/sway/keymap.xkb
    repeat_delay 500
    repeat_rate 25
}

{{- if eq .chezmoi.hostname "rgx1gen11" }}
input "1:1:AT_Translated_Set_2_keyboard" {
    # Text input is delivered by kanata's virtual keyboard. The raw
    # built-in keyboard stays disabled so password prompts cannot see
    # untranslated QWERTY events.
    events disabled
}
{{- end }}

# swaymsg -t get_inputs
input type:touchpad {
    natural_scroll enabled
    tap enabled
}

input type:pointer {
    natural_scroll enabled
}

# xwayland force scale 2
exec xsettingsd
# Here: https://www.reddit.com/r/swaywm/comments/p9ah2v/completely_hide_mouse_pointer_wayland/
seat seat0 hide_cursor 1000
bar {
    status_command    i3status-rs ~/.config/i3rust/i3_top.toml
    position          top
    height            32
    status_padding    3
    status_edge_padding 10
    workspace_min_width 32
    binding_mode_indicator yes
    workspace_buttons yes
    tray_output       eDP-1
    tray_padding      6
    font pango:Atkinson Hyperlegible 12, AtkinsonHyperlegibleMono Nerd Font 12

    colors {
        separator          $bar_sep
        background         $bar_bg
        statusline         $bar_fg
        focused_workspace  $ws_focus_border    $ws_focus_bg    $ws_focus_fg
        active_workspace   $ws_active_border   $ws_active_bg   $ws_active_fg
        inactive_workspace $ws_inactive_border $ws_inactive_bg $ws_inactive_fg
        urgent_workspace   $ws_urgent_border   $ws_urgent_bg   $ws_urgent_fg
    }
}


bar {
    status_command   i3status-rs ~/.config/i3rust/i3_bottom.toml
    position          bottom
    height            30
    status_padding    4
    status_edge_padding 10
    binding_mode_indicator no
    workspace_buttons no
    tray_output none
    font pango:Atkinson Hyperlegible 12, AtkinsonHyperlegibleMono Nerd Font 12

    colors {
        separator          $bar_sep
        background         $bar_bg
        statusline         $bar_fg
        focused_workspace  $ws_focus_bg    $ws_focus_bg    $ws_focus_fg
        active_workspace   $ws_active_bg   $ws_active_bg   $ws_active_fg
        inactive_workspace $ws_inactive_bg $ws_inactive_bg $ws_inactive_fg
        urgent_workspace   $ws_urgent_bg   $ws_urgent_bg   $ws_urgent_fg
    }
}

# Faster thunar
exec thunar --daemon

# Faster terminals
# Now managed by .conf/systemd/user/foot-server.{service,sock}
# exec_always $term_server

# Notifications (now with dunst)
# exec_always mako

# Clipboard history
exec_always wl-paste --watch cliphist store

# Sync stuff
# Disabled by default, reduce network calls for offline situations
# exec insync start

# For fingerprint and more
exec_always lxpolkit

# Wayland settings
for_window [shell="xwayland"] title_format "[XWayland] %title"
exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway XDG_SESSION_TYPE=wayland

# Moves the external screen to the right
# swaymsg output eDP-1 pos 1600 0 res 1920x1080
# The scaling is because of the DPI stuff
# Swap 1600 and 0 to get the screen on the relative left

# Window borders pick up the active palette via the same include at
# the top of this file.
#             border            background        text              indicator           child_border
client.focused           $border_focus     $border_focus     $bar_fg           $border_focus_ind   $border_focus
client.focused_inactive  $border_unfocus   $border_unfocus   $bar_fg           $border_unfocus     $border_unfocus
client.unfocused         $border_unfocus   $bar_bg           $bar_fg           $border_unfocus     $border_unfocus
client.urgent            $border_urgent    $border_urgent    $bar_fg           $border_urgent      $border_urgent
client.placeholder       $border_unfocus   $bar_bg           $bar_fg           $border_unfocus     $border_unfocus

# rg-theme palette toggle + picker. F1 flips light/dark in the current
# palette; F2 pops the rofi picker for a palette switch.
bindsym $mod+Shift+F1 exec rg-theme toggle
bindsym $mod+Shift+F2 exec rg-theme pick

include /etc/sway/config.d/*
include $HOME/.config/sway/conf.d/*
include $HOME/.config/sway/conf.d/**/*
