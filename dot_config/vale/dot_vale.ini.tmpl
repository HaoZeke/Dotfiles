# -*- mode: conf -*-
# need to run vale sync in ~/.config/vale to get these setup
StylesPath = styles

MinAlertLevel = suggestion

Packages = Google, proselint, write-good, alex

Vocab = RG

[*]
BasedOnStyles = Vale, rgoswami, proselint, write-good

# --- Stock packs: keep only the useful bits ---

# proselint: keep cliches, corporate speak, hedging, hyperbole, redundancy
proselint.Annotations = NO
proselint.AnimalLabels = NO
proselint.DenizenLabels = NO
proselint.GenderBias = NO
proselint.GroupTerms = NO
proselint.Spelling = NO

# write-good: keep weasel words, cliches
# Passive voice is fine in academic/technical writing
write-good.Passive = NO
# "So" at sentence start is fine in blog posts
write-good.So = NO
# E-Prime is a soft guideline, not a hard rule
write-good.E-Prime = NO
# "There is/are" is fine in moderation
write-good.ThereIs = NO
# TooWordy flags "minimum", "maximum", "magnitude" in math writing
write-good.TooWordy = NO
# Illusions (repeated words) has too many false positives in technical text
write-good.Illusions = NO

# Google: mostly disabled, rgoswami overrides handle these better
Google.FirstPerson = NO
Google.We = NO
Google.Exclamation = NO
Google.EmDash = NO
Google.Headings = NO
Google.Acronyms = NO
Google.Units = NO
Google.Passive = NO
Google.Contractions = NO
Google.Will = NO

# alex: disabled entirely due to false positives in technical text
alex.ProfanityUnlikely = NO
alex.Condescending = NO
alex.LGBTQ = NO
alex.Gendered = NO
alex.Race = NO
alex.Ableism = NO

# --- File type overrides ---

[*.org]
# org-mode specific
proselint.Annotations = NO
# Journal papers use title-case headings (ACS, APS, etc.)
rgoswami.Headings = NO
# "hyperparameter" is standard; Vale.Terms wants initial caps mid-sentence
Vale.Terms = NO
# Acronyms are defined at first use; vale cannot track org cross-file definitions
rgoswami.Acronyms = NO
# "least certain" etc. are valid superlatives in technical prose
proselint.Uncomparables = NO
# We use \AA in LaTeX for Angstrom
proselint.Diacritical = NO

[*.tex]
# LaTeX: skip passive (academic standard)
write-good.Passive = NO
rgoswami.Headings = NO
Vale.Terms = NO
rgoswami.Acronyms = NO
proselint.Uncomparables = NO
proselint.Diacritical = NO

# Starfleet form-paste files: the `*` headings mirror the external form field
# labels verbatim, so they keep Title Case instead of sentence case.
[**/starfleet_answers.org]
rgoswami.Headings = NO
