# You can get the names of your outputs by running: swaymsg -t get_outputs
# See also
# here: https://github.com/swaywm/wlroots/pull/2064#issuecomment-622647075
profile homeLabIS {
  # eDP-1, inbuilt on the left
  output "Chimei Innolux Corporation 0x1417 Unknown" {
   enable
   mode 1920x1200
   position 0,0
   scale 1
  }
  # Home screen, to the right
  output "Lenovo Group Limited LEN L27i-28 0x54573152" {
   enable
   mode 1920x1080
   position 1920,0
  }
}

profile homeLabTripleIS {
    # Left: Lenovo M14 (External)
    # Starts at 0
    output "Lenovo Group Limited M14 V904H2WF" position 0,0

    # Center: Laptop Screen (Internal)
    # Starts after the M14 (1920 pixels)
    # We use the Model identifier here as the serial is "Unknown"
    output "Chimei Innolux Corporation 0x1417 Unknown" position 1920,0

    # Right: Lenovo L27i (External)
    # Starts after the Laptop (1920 + 1920 = 3840 pixels)
    output "Lenovo Group Limited LEN L27i-28 0x54573152" position 3840,0

    # --- M14 (Display 2) Settings ---
    # Set to sRGB mode (01) to fix washed out colors
    exec ddcutil setvcp 14 01 --display 2
    # Boost brightness back to max (100)
    exec ddcutil setvcp 10 100 --display 2
    # Reset settings for display 1
    ddcutil setvcp 04 01 --display 1
}

profile TheochemUI_myGrant {
  # Negative offsets are a no-go, so shift relative to the actual size
  # See:
  # [1] https://github.com/swaywm/wlroots/issues/958
  # [2] https://gitlab.freedesktop.org/xorg/xserver/-/merge_requests/395#note_555613
  # eDP-1, inbuilt on the right
  output "Chimei Innolux Corporation 0x1417 Unknown" {
   enable
   mode 1920x1200
   position 2560,0
   scale 1
  }
  # HI Lab screen, to the left
  # Dell P2416D, 23.8 inches, 123.41 PPI (see https://www.sven.de/dpi/)
  output "BNQ BenQ PD2705Q V3N03357019" {
   enable
   mode 2560x1440
   position 0,0
  }
}

