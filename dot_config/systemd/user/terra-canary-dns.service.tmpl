{{- if eq .chezmoi.hostname "rgam5terra" -}}
[Unit]
Description=Terra DNS/network canary (off-box notify on failure)
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-%h/.config/terra-observability/env
ExecStart=%h/.local/share/terra-observability/bin/terra-canary-dns

[Install]
WantedBy=default.target
{{- end -}}
