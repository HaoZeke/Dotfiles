[Unit]
Description=rg-space-sweep auto-clean when $HOME free space drops below threshold
Documentation=https://github.com/HaoZeke/dotfiles

[Service]
Type=oneshot
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
# Clean only if free space is below 10 GB. Category set: all.
ExecStart=%h/.local/bin/rg-space-sweep auto-clean --min-free-gb 10 all
