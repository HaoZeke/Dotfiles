{{- if eq .chezmoi.hostname "rgx1gen11" -}}
[Unit]
Description=SSH tunnel Terra RustiCal CalDAV -> localhost:4000
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/bash -c 'set -e; if nc -z -w2 192.168.68.65 22 2>/dev/null; then H=rgoswami@192.168.68.65; else H=rg.terra; fi; exec /usr/bin/ssh -N -S none -o ControlMaster=no -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o BatchMode=yes -L 127.0.0.1:4000:127.0.0.1:4000 -L [::1]:4000:127.0.0.1:4000 "$H"'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
{{- end -}}
