{{- if eq .chezmoi.hostname "rgx1gen11" -}}
[Unit]
Description=SSH tunnel Terra RustiCal CalDAV -> 127.0.0.1:42731
After=network-online.target
# No start limit: a tunnel that gives up permanently outlives the outage
# that tripped it. Backoff below carries the cost of retrying forever.
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=all
# Local 42731 is reserved for this tunnel (loopback only). Terra RustiCal stays on :4000.
# 4000 is a common nanoc/dev port and was stolen by snelnext `rake view`.
ExecStart=%h/.local/bin/rg-terra-tunnel caldav
TimeoutStartSec=30
# always: remote host flaps and BatchMode SSH exits 0/255 both need a retry.
Restart=always
# Ramp 15s -> 300s. rg.terra.ts and the relay fail on independent causes,
# so a slow retry keeps the unit alive across either without log flooding.
RestartSec=15
RestartSteps=5
RestartMaxDelaySec=300

[Install]
WantedBy=default.target
{{- end -}}
