[Unit]
Description=Userspace tailscaled on haozeke.github (SOCKS sandbox for cross-tailnet reach to Terra; isolated from x.ai system tailscaled)
Documentation=https://tailscale.com/kb/1112/userspace-networking/
After=network-online.target
Wants=network-online.target
# No start limit: this daemon carries the only relay-independent route to
# terra, so a unit that gives up permanently removes the fallback exactly
# when the relay path is also down. Backoff below bounds the retry cost.
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
RuntimeDirectory=tailscale-haozeke
RuntimeDirectoryMode=0700
# Bind SOCKS to IPv4 loopback only — "localhost" can resolve to ::1 and break
# OpenBSD nc -x 127.0.0.1:1055 clients after dual-stack flaps.
# The user manager owns the socket directory, so stale /tmp cleanup cannot
# detach clients from a live daemon.
ExecStart=/usr/bin/tailscaled --tun=userspace-networking --socks5-server=127.0.0.1:1055 --port=0 --statedir=%h/.local/share/tailscale-haozeke --socket=%t/tailscale-haozeke/tailscaled.sock
TimeoutStartSec=45
# Clear ambient proxies so DERP/control never inherit a broken session proxy.
Environment=ALL_PROXY= HTTP_PROXY= HTTPS_PROXY= http_proxy= https_proxy= HTTPS_PROXY= all_proxy=
Restart=always
RestartSec=5
RestartSteps=5
RestartMaxDelaySec=120
# Cap runaway memory without killing normal magicsock buffers.
MemoryMax=384M

[Install]
WantedBy=default.target
