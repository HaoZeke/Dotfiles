{{- if eq .chezmoi.hostname "rgam5terra" -}}
[Unit]
Description=Sync the HI Exchange mailbox via DavMail (Graph) and mbsync
Wants=network-online.target davmail@rog32hi.service
After=network-online.target davmail@rog32hi.service

[Service]
Type=oneshot
ExecCondition=/usr/bin/test -f %h/.config/isyncrc
ExecStart=/usr/bin/flock -n %t/rg-exchange-mbsync-rog32.lock /usr/bin/mbsync rog32
TimeoutStartSec=30min
{{- end -}}
