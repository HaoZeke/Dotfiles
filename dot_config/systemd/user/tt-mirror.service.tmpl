{{- if eq .chezmoi.hostname "rgam5terra" -}}
[Unit]
Description=Mirror the Tardigrade native store from B2
After=network-online.target

[Service]
Type=oneshot
ExecStart=%h/.local/bin/tt-mirror
# Exit 75 means the 0600 mirror key is not seeded yet. It is a failed unit,
# so a cold store is visible instead of a successful skip.
Nice=10
IOSchedulingClass=idle
{{- end -}}
