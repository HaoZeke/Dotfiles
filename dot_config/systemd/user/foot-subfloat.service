# -*- systemd -*-
[Unit]
Description=Foot client for tmux session subFloat
After=foot-server.service tmux-session-subfloat.service
Requires=foot-server.service tmux-session-subfloat.service

[Service]
ExecStartPre=/bin/sh -c 'i=0; while [ "$i" -lt 100 ]; do [ -S "/run/user/%U/foot-server.sock" ] && exit 0; i=$((i+1)); sleep 0.2; done; echo "foot server socket did not appear after 20s" >&2; exit 1'
ExecStart=/usr/bin/footclient --server-socket=/run/user/%U/foot-server.sock --app-id="subFloat" -e %h/.local/bin/rg-tmux-role client float
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
