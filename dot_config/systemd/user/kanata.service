# -*- systemd -*-
[Unit]
Description=Kanata keyboard remapper
Documentation=https://github.com/jtroo/kanata

[Service]
ExecStart=/usr/bin/kanata -c %h/.config/kanata/config.kbd
Restart=on-failure
RestartSec=3
# Keyboard remapper; losing it makes the user's layout unusable mid-
# session and can strand them with no way to type out of the freeze.
OOMScoreAdjust=-500
ManagedOOMPreference=avoid
# Under heavy CPU load, the event-processing loop can get
# descheduled long enough that libinput observes the accumulated
# burst as key-repeats on a single press -- keys appear doubled.
# Priority boost via cgroup CPUWeight only: systemd --user cannot
# set Nice < 0 or IOSchedulingClass=realtime without CAP_SYS_NICE,
# which user services do not have (status=211/IOPRIO crashes the
# unit and leaves the user typing raw QWERTY). CPUWeight is cgroup-
# level and honored by the kernel scheduler under contention.
CPUWeight=500

[Install]
WantedBy=default.target
