# -*- systemd -*-
# Managed by chezmoi (dot_config/systemd/user/kanata.service).
#
# User service. Reverted from the system-service attempt because the
# system-level unit ran before the greeter's xkb layer applied, and
# the greeter was configured for Colemak -- so the greeter applied
# Colemak on top of kanata's already-Colemaked scancodes, producing
# a doubled-Colemak scramble at login. The user service starts only
# after sway-session.target (post-login), leaving the greeter with
# raw QWERTY physical input and a single greeter-side Colemak pass.
#
# With linger, default.target can pull in kanshi/foot-server (stale
# enablement) which BindsTo=sway-session.target and starts kanata at
# the greetd greeter. ConditionEnvironment blocks that path: vconsole
# colemak alone at the greeter, kanata only once Wayland is up.
[Unit]
Description=Kanata keyboard remapper
Documentation=https://github.com/jtroo/kanata
After=sway-session.target
PartOf=sway-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
ExecStart=/usr/bin/kanata -c %h/.config/kanata/config.kbd
Restart=on-failure
RestartSec=3
# Keyboard remapper; losing it makes the user's layout unusable mid-
# session and can strand them with no way to type out of the freeze.
ManagedOOMPreference=avoid
# The input path must not wait on a thrashing machine: the remapper's
# pages never go to swap and it gets the largest CPU share. No realtime
# policy, negative nice or OOMScoreAdjust below the manager's: this
# user's RLIMIT_RTPRIO and RLIMIT_NICE are 0 and lowering the OOM score
# needs CAP_SYS_RESOURCE, so systemd refuses the start (214/SETSCHEDULER)
# and the remapper never runs.
MemorySwapMax=0
CPUWeight=10000
IOSchedulingClass=best-effort
IOSchedulingPriority=0

[Install]
WantedBy=sway-session.target
