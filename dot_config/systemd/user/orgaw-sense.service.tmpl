{{- if eq .chezmoi.hostname "rgx1gen11" -}}
# Evidence sampler for orgaw (focus / AFK / git).
# Must start with Sway, not linger default.target: a pre-compositor
# start has no SWAYSOCK and records 24 h of IdleHint=active with
# zero focus (2026-08-05..11). Sway already runs
# `systemctl --user import-environment; start sway-session.target`.
[Unit]
Description=orgaw-sense evidence sampler
Documentation=https://github.com/HaoZeke/orgaw
After=graphical-session.target sway-session.target
PartOf=sway-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=%h/.local/bin/orgaw-sense
Restart=on-failure
RestartSec=5
PassEnvironment=SWAYSOCK WAYLAND_DISPLAY XDG_RUNTIME_DIR XDG_SESSION_ID HYPRLAND_INSTANCE_SIGNATURE
KillMode=control-group

[Install]
WantedBy=sway-session.target
{{- else if eq .chezmoi.hostname "rgSURFLat" -}}
# SURF desk. Linger + default.target so SSH-only days still sample
# git; discover_swaysock picks up the office compositor when it exists.
[Unit]
Description=orgaw-sense evidence sampler (rg.surf)
Documentation=https://github.com/HaoZeke/orgaw
After=default.target

[Service]
Type=simple
ExecStart=%h/.local/bin/orgaw-sense
Restart=on-failure
RestartSec=5
PassEnvironment=SWAYSOCK WAYLAND_DISPLAY XDG_RUNTIME_DIR XDG_SESSION_ID
KillMode=control-group

[Install]
WantedBy=default.target
{{- end -}}
