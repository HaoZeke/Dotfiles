{{- if eq .chezmoi.hostname "rgx1gen11" -}}
[Unit]
Description=SSH tunnel Terra Dovecot IMAP -> localhost:1143
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
ExecStart=/usr/bin/bash -c 'set -e; if nc -z -w2 192.168.68.65 22 2>/dev/null; then H=rgoswami@192.168.68.65; else H=rg.terra; fi; exec /usr/bin/ssh -N -S none -o ControlMaster=no -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o BatchMode=yes -L 127.0.0.1:1143:127.0.0.1:143 -L [::1]:1143:127.0.0.1:143 "$H"'
# always: remote host flaps and BatchMode SSH exits 0/255 both need a retry.
Restart=always
RestartSec=15

[Install]
WantedBy=default.target
{{- end -}}
