[Unit]
Description=rg-space-sweep auto-clean timer (hourly)
Documentation=https://github.com/HaoZeke/dotfiles

[Timer]
# Calendar events rearm after the oneshot service exits. Persistent catches a
# missed check when the user manager or machine was unavailable.
OnCalendar=hourly
Persistent=true
RandomizedDelaySec=5min
AccuracySec=1min
Unit=rg-space-sweep.service

[Install]
WantedBy=timers.target
