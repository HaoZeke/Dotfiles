# Managed by chezmoi (dot_config/systemd/user/agent.slice).
#
# Collective throttle for leftover CLI farm processes. Attach live
# leftovers with rg-agent-slice-classify; do not kill them. No
# MemoryMax: a hard ceiling would OOM the farm. MemoryHigh
# reclaim-throttles. The CPU cap allows three cores; the low CPU weight
# preserves interactive workloads when several CLI sessions run together.
[Unit]
Description=Agent farm resource class (throttle, never kill)
Before=shutdown.target

[Slice]
MemoryAccounting=yes
TasksAccounting=yes
CPUWeight=5
CPUQuota=300%
MemoryHigh=10G
IOWeight=20
# systemd-oomd must not reap this slice. Pressure is auto (not kill);
# Preference=omit keeps the slice off the kill list.
ManagedOOMMemoryPressure=auto
ManagedOOMSwap=auto
ManagedOOMPreference=omit

[Install]
WantedBy=default.target
