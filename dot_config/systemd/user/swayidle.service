# -*- systemd -*-
# Kanged from https://github.com/kuhy/.dotfiles/blob/master/system/systemd.org
# scu-enable-now swayidle.target
[Unit]
Description=Idle manager for Wayland
Documentation=man:swayidle(1)
PartOf=graphical-session.target
After=graphical-session.target sway-session.target
# Bound restart attempts so a genuinely broken swayidle cannot spin forever,
# but keep the window wide enough to outlast compositor startup. swayidle exits
# 253 when it cannot reach the compositor, and the unit can be started before
# sway has exported WAYLAND_DISPLAY into the user manager. A narrow limit (5
# tries at 2s) burned every attempt in seven seconds and latched the unit
# failed for the whole session -- taking lock-on-suspend with it, so the laptop
# suspended and resumed with no lock at all. Retry patiently instead.
StartLimitIntervalSec=180
StartLimitBurst=40

[Service]
Type=simple
# If swayidle is killed (OOM, a stray signal, a crash) it otherwise stays dead
# and the idle ladder + lock-on-suspend silently stop -- which also flips the
# caffeine health/focus indicator to an error. Auto-recover.
Restart=on-failure
RestartSec=2
RestartPreventExitStatus=SIGKILL
# swayidle has no singleton lock of its own, so a stray launch (a manual
# start, or exec_always creeping back into the sway config) would run a second
# instance and double-fire every timeout. Reap any stray before starting so
# this unit is always the sole swayidle. The leading - keeps "no match"
# non-fatal, and it runs before ExecStart so it never targets our own process.
ExecStartPre=-/usr/bin/pkill -x swayidle
# Wait for the compositor socket before launching. Without this the unit races
# sway at login, and every retry that lands early is a wasted attempt against
# the start limit. Bounded so a session that never brings up Wayland still
# fails rather than hanging.
ExecStartPre=/bin/sh -c 'i=0; while [ "$i" -lt 100 ]; do for s in "$XDG_RUNTIME_DIR"/wayland-*; do [ -S "$s" ] && exit 0; done; i=$((i+1)); sleep 0.2; done; echo "no wayland socket after 20s" >&2; exit 1'
# Idle staircase:
#   240s   dim the display by 30% (save -> -30%); restore on activity
#   300s   lock the screen
#   450s   DPMS off; DPMS on when the user comes back
#   2700s  rg-idle-hibernate: hibernate only if on battery, no-op on AC
#   sleep  pause media, lock before actual suspend
# brightnessctl -s saves current level, brightnessctl -r restores it
# so a low-brightness work session is not stomped by the idle dim.
ExecStart=/usr/bin/swayidle -w \
         timeout 240 '%h/.local/bin/rg-caffeine run dim brightnessctl -s set 30%-' \
                     resume '%h/.local/bin/rg-caffeine run dim-resume brightnessctl -r' \
         timeout 300 '%h/.local/bin/rg-caffeine run lock %h/.local/bin/rg-lockscreen --daemonize' \
         timeout 450 '%h/.local/bin/rg-caffeine run dpms-off swaymsg "output * dpms off"' \
                     resume '%h/.local/bin/rg-caffeine run dpms-on swaymsg "output * dpms on"' \
         timeout 2700 '%h/.local/bin/rg-idle-hibernate' \
         before-sleep 'playerctl pause' \
         before-sleep '%h/.local/bin/rg-lockscreen --prepare-sleep' \
         after-resume '%h/.local/bin/rg-sway-input-rearm --dpms' \
         idlehint 780
# Lock-screen hook fires on before-sleep; losing it mid-suspend leaves
# the laptop unlocked on wake. Keep this unit out of OOM reach.
#
# --prepare-sleep (vs. plain --daemonize on the idle timeout above)
# blocks until the lock surface is composed onto the scanout buffer
# before swayidle releases its delay inhibitor. Without that gate, the
# hibernate image captures VRAM with the live desktop on it, and the
# resume window paints the pre-lock desktop for the full duration of
# the kernel restore.
OOMScoreAdjust=-500
ManagedOOMPreference=avoid

[Install]
WantedBy=sway-session.target
