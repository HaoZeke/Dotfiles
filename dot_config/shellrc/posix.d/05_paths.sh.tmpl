#!/usr/bin/env sh

# Path Additions
##################

# Linuxbrew
export PATH=$HOME/.linuxbrew/bin:$PATH

{{- if .tex_date }}
# TeX (overloaded variables with chezmoi)
# Guarded on tex_date: with it empty the path resolves to `texlive-` with no
# version, a directory that cannot exist, and the three forks behind $(uname)
# are spent per shell to prepend it anyway.
export PATH="$HOME/.local/share/texlive-{{ .tex_date }}/bin/$(uname -m)-$(uname -s | tr '[:upper:]' '[:lower:]')/:$PATH"
{{- end }}

# Poetry
export PATH="$HOME/.poetry/bin:$PATH"

# Doom
export PATH=$PATH:$HOME/.emacs.d/bin

# Rust
export PATH=$PATH:$HOME/.cargo/bin

# Bun (omp and friends)
export PATH="$HOME/.bun/bin:$PATH"

# OpenCode ships its own launcher dir; absent on hosts that do not use it,
# and a missing PATH entry is inert.
export PATH="$HOME/.opencode/bin:$PATH"

# For the bundled scripts
export PATH="$HOME/.local/bin:$PATH"
export PATH="$PATH:$HOME/.local/bin/cronDrivers"
export PATH="$PATH:$HOME/.local/bin/cryptHelpers"
export PATH="$PATH:$HOME/.local/bin/dockerHelpers"
export PATH="$PATH:$HOME/.local/bin/droidHelpers"
export PATH="$PATH:$HOME/.local/bin/fileHelpers"
export PATH="$PATH:$HOME/.local/bin/gitHelpers"
export PATH="$PATH:$HOME/.local/bin/installHelpers"
export PATH="$PATH:$HOME/.local/bin/shellHelpers"
export PATH="$PATH:$HOME/.local/bin/webHelpers"

# Go Paths
###########

export GOPATH=$HOME/.go
export GOBIN=$HOME/.go/bin
export GOCACHE=$HOME/.cache/go-build

export PATH=$PATH:$GOBIN

# Yarn Paths
#############
export PATH=$HOME/.yarn/bin:$PATH

# Perl Paths
#############
PATH="$HOME/perl5/bin${PATH:+:${PATH}}"; export PATH;
PERL5LIB="$HOME/perl5/lib/perl5${PERL5LIB:+:${PERL5LIB}}"; export PERL5LIB;
PERL_LOCAL_LIB_ROOT="$HOME/perl5${PERL_LOCAL_LIB_ROOT:+:${PERL_LOCAL_LIB_ROOT}}"; export PERL_LOCAL_LIB_ROOT;
PERL_MB_OPT="--install_base \"$HOME/perl5\""; export PERL_MB_OPT;
PERL_MM_OPT="INSTALL_BASE=$HOME/perl5"; export PERL_MM_OPT;

# Snap and Flatpak for rofi
# /usr/share/:/usr/local/share/:
export XDG_DATA_DIRS="$XDG_DATA_DIRS:/var/lib/snapd/desktop:/var/lib/flatpak/exports/share/applications"
# Should be part of the default..
export XDG_DATA_DIRS="$XDG_DATA_DIRS:$HOME/.local/share"


# Deduplicate
###############
#
# Every entry above is added unconditionally, so a shell started inside a shell
# appends the whole set again: PATH runs 30 -> 58 -> 86 entries across three
# nested interactive shells while the unique count stays at 25. A command that
# is not in the hash table is then stat()ed against every duplicate.
#
# zsh has a flag for this and it keeps holding for entries added later in the
# session. bash needs a pass, and needs it again after anything that appends
# further down, so .bashrc calls dedup_path once more at the end.
if [ -n "${ZSH_VERSION:-}" ]; then
    typeset -gU path PATH
else
    dedup_path() {
        _dp_new=
        _dp_rest=$PATH
        while [ -n "$_dp_rest" ]; do
            _dp_head=${_dp_rest%%:*}
            case "$_dp_rest" in
                *:*) _dp_rest=${_dp_rest#*:} ;;
                *) _dp_rest= ;;
            esac
            if [ -n "$_dp_head" ]; then
                case ":$_dp_new:" in
                    *":$_dp_head:"*) ;;
                    *) _dp_new="${_dp_new:+$_dp_new:}$_dp_head" ;;
                esac
            fi
        done
        PATH=$_dp_new
        export PATH
        unset _dp_new _dp_rest _dp_head
    }
    dedup_path
fi

# Conditional paths
####################
{{- if eq .setup_spack "yes" }}
spack_load() {
  echo "Sourcing Spack environment..."
  source "$HOME/spack/share/spack/setup-env.sh"
  unset -f spack_load
}
{{- end }}
# Now use x pixi instead of pixi
{{- if eq .setup_mamba "yes" }}
# Mamba / Micromamba setup
micromamba_load() {
  echo "Sourcing Micromamba environment..."
  eval "$(micromamba shell hook --shell=bash)"
  unset -f micromamba_load
}
{{- end }}

