;; Colemak + Extend + AltGr (Icelandic) for Sway/Wayland
;; Replaces klfc-generated XKB layout
{{- if eq .chezmoi.hostname "rgSURFLat" }}
;; Dell Latitude firmware does not expose the Fn key as a Linux input key.
;; Kanata cannot remap a key event that is not emitted by the keyboard.
{{- end }}
;;
;; Layers:
;;   colemak  -- base Colemak with CapsLock as tap-Backspace / hold-Extend
;;   extend   -- VIM arrows (HJKL on Colemak home row = HNEI positions)
;;   extshift -- Extend+Shift: brackets on N/V positions
;;   extaltgr -- Extend+AltGr: Backspace, Delete, braces
;;   altgr    -- Icelandic characters on AltGr (Left Alt)

(defcfg
  process-unmapped-keys yes
  ;; Exclusively grab the keyboards so sway never sees the raw QWERTY events
  ;; alongside kanata's Colemak-remapped uinput output. Kanata opens these with
  ;; EVIOCGRAB; the grab releases automatically when kanata exits, so the
  ;; keyboards become live in sway again on crash -- that is the fallback path.
  ;;
  ;; Matched by name rather than by path, which survives a move between USB
  ;; ports. Exactly one keyboard is left out of the grab on purpose.
  ;;
  ;; This kanata wedges: the poll loop stops remapping while the process stays
  ;; alive, which is why a watchdog exists to bounce it. A grabbed keyboard
  ;; forwards nothing while that lasts, so grabbing every keyboard on the
  ;; machine turns a recoverable wedge into a machine you cannot type on at
  ;; all -- and the force-exit chord cannot help, because the wedged process is
  ;; not reading it either. Whichever keyboard is not the daily driver stays
  ;; ungrabbed as the way back in.
  ;; Every real keyboard, so the layout is the same whichever one is typed on.
  ;; Listed by name rather than by path: a path match survives neither a change
  ;; of USB port nor a second keyboard, and a keyboard that is silently left out
  ;; types raw QWERTY with no Extend layer, which reads as the remapping being
  ;; broken rather than as never having covered it.
  ;;
  ;; Named explicitly rather than letting kanata autodetect, so the hotkey and
  ;; consumer-control nodes these keyboards also publish stay out of the grab.
  ;;
  ;; Recovery, since nothing is left ungrabbed: this kanata can wedge with the
  ;; process still alive, and a grabbed keyboard forwards nothing while that
  ;; lasts. Reach the machine over ssh and `systemctl --user stop kanata`; the
  ;; grabs release on exit. The force-exit chord will not help, because a
  ;; wedged process is not reading it either.
  linux-dev-names-include (
    "AT Translated Set 2 keyboard"
    "Dell KB216 Wired Keyboard"
    "Lab31 - Keyboard"
  )
  linux-continue-if-no-devs-found no
  ;; On Colemak, physical 'u' key produces 'l', so tell kanata
  ;; which keycode sends the 'u' keysym for unicode input (Ctrl+Shift+U)
  ;; Physical 'i' key = Colemak 'u', so use 'i' keycode
  linux-unicode-u-code i
  linux-unicode-termination space
  log-layer-changes no
)

(defsrc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

(defvar
  tap-time 150
  hold-time 150
)

(defalias
  ;; CapsLock: tap for Backspace, hold for Extend layer
  ext (tap-hold-press $tap-time $hold-time bspc (layer-toggle extend))
  ;; Left Alt: hold for AltGr (Icelandic) layer
  ag  (layer-toggle altgr)
  ;; Within Extend: Shift toggles extshift, AltGr toggles extaltgr
  ext-sft (layer-toggle extshift)
  ext-ag  (layer-toggle extaltgr)
)

;; Base Colemak
(deflayer colemak
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    f    p    g    j    l    u    y    ;    [    ]    \
  @ext a    r    s    t    d    h    n    e    i    o    '    ret
  lsft z    x    c    v    b    k    m    ,    .    /    rsft
  lctl lmet @ag            spc            ralt rmet rctl
)

;; Extend layer (CapsLock held)
;; HNEI = Left/Down/Up/Right, O = Enter
;; N = (, V = )
;; Shift/AltGr within Extend toggle sub-layers
(deflayer extend
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    left down up   rght ret  _    _
  @ext-sft _    _    _    S-0  _    S-9  _    _    _    _    _
  _    _    @ext-ag        _              _    _    _
)

;; Extend+Shift: selection arrows, brackets on N/V
(deflayer extshift
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    S-left S-down S-up S-rght S-ret _ _
  _    _    _    _    ]    _    [    _    _    _    _    _
  _    _    _              _              _    _    _
)

;; Extend+AltGr: Backspace, Delete, braces on N/V
(deflayer extaltgr
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    bspc _    _    del  _    _    _
  _    _    _    _    S-]  _    S-[  _    _    _    _    _
  _    _    _              _              _    _    _
)

;; AltGr layer (Left Alt held) -- Icelandic characters
(deflayer altgr
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    (unicode U+00FA) (unicode U+00FD) _    _    _    _
  _    (unicode U+00E1) _    _    (unicode U+00FE) (unicode U+00F0) _    _    (unicode U+00E9) (unicode U+00ED) (unicode U+00F3) _    _
  _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _              _              _    _    _
)
