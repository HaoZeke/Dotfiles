#-*- mode: conf-toml -*-
# TOML Ref: https://github.com/toml-lang/toml
# Example: https://raw.githubusercontent.com/greshake/i3status-rust/master/examples/config.toml
# Block Doc: https://greshake.github.io/i3status-rust/i3status_rs/blocks/index.html
# Repo: https://github.com/greshake/i3status-rust

[theme]
theme = "active"
[icons]
icons = "awesome5"

[[block]]
block = "custom"
command = "~/.local/bin/rg-weather-json reykjavik"
json = true
interval = 900

[[block]]
block = "custom"
command = "~/.local/bin/rg-weather-json iitk"
json = true
interval = 900

[[block]]
block = "time"
format = "Kingston: $timestamp.datetime(f:'%I:%M %p')"
timezone = "Canada/Eastern"
interval = 60

[[block]]
block = "time"
format = "Reykjavík: $timestamp.datetime(f:'%I:%M %p')"
timezone = "Iceland"
interval = 60

[[block]]
block = "time"
format = "Kanpur: $timestamp.datetime(f:'%I:%M %p')"
timezone = "Asia/Kolkata"
interval = 60

[[block]]
block = "battery"
device = "BAT0"
driver = "upower"
interval = 15
# Full and not-charging keep the percentage. Those states are icon-only
# by default, and a charge threshold holds the pack in not-charging while
# it still has a level worth reading. The icon face is named because the
# bar font's fallback does not cover this private-use glyph.
format = " $icon $percentage {$time_remaining.dur(hms:true, min_unit:m) |}"
charging_format = " $icon $percentage {$time_remaining.dur(hms:true, min_unit:m) |}"
full_format = " $icon $percentage "
empty_format = " $icon $percentage "
not_charging_format = " $icon $percentage "
missing_format = ""
icons_format = "<span font_family='Font Awesome 7 Free' weight='bold'>{icon}</span>"

[[block]]
block = "music"
format = " $icon {$combo.str(max_w:20,rot_interval:0.5) $play $next |}"
interface_name_exclude = [".*kdeconnect.*", "mpd"]
