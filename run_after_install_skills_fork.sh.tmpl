#!/usr/bin/env bash
# Re-target the installed superpowers-extended-cc plugin entry to point at
# the locally-checked-out fork submodule under nimtasks. Idempotent: only
# rewrites installed_plugins.json when the current path differs from the
# fork path. Safe to run on every chezmoi apply.
#
# Why: the upstream plugin marketplace fetches into
# ~/.claude/plugins/cache/.../<version>/, which is the read path for the
# active session. The local fork carries vault-integration patches on the
# vault-integration branch and is the authoritative source. Pointing
# installPath at the fork repo bypasses cache invalidation entirely.

set -euo pipefail

INSTALLED_JSON="${HOME}/.claude/plugins/installed_plugins.json"
FORK_PATH="${HOME}/Git/Github/Tools/nimtasks/superpowers-extended-cc"
KEY='superpowers-extended-cc@superpowers-extended-cc-marketplace'

# Bail quietly on machines that don't have the harness or the fork present.
[ -f "$INSTALLED_JSON" ] || exit 0
[ -d "$FORK_PATH/.git" ] || exit 0
command -v jq >/dev/null || exit 0

current=$(jq -r --arg k "$KEY" '.plugins[$k][0].installPath // empty' "$INSTALLED_JSON" 2>/dev/null || true)

if [ "$current" = "$FORK_PATH" ]; then
    exit 0
fi

fork_sha=$(git -C "$FORK_PATH" rev-parse HEAD)
fork_version=$(jq -r '.version // "unknown"' "$FORK_PATH/.claude-plugin/plugin.json" 2>/dev/null || echo unknown)
ts=$(date -u +"%Y-%m-%dT%H:%M:%SZ")

tmp="${INSTALLED_JSON}.swap.tmp"
jq --arg k "$KEY" --arg p "$FORK_PATH" --arg v "$fork_version" --arg s "$fork_sha" --arg t "$ts" '
  .plugins[$k][0].installPath = $p |
  .plugins[$k][0].version = $v |
  .plugins[$k][0].gitCommitSha = $s |
  .plugins[$k][0].lastUpdated = $t
' "$INSTALLED_JSON" > "$tmp"

# Validate before swapping in.
python3 -c "import json,sys; json.load(open('$tmp'))"
mv "$tmp" "$INSTALLED_JSON"

echo "swapped $KEY -> $FORK_PATH ($fork_version @ ${fork_sha:0:12})"
