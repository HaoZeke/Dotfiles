[user]
    name = Rohit Goswami
    email = rgoswami@ieee.org # If encrypted: {{ if eq .encrypted "yes" }}
	# Sign with the ssh key, not the GPG key. GPG signing needs a pinentry,
	# and pinentry needs a terminal, so any unattended commit over ssh or in a
	# detached session fails to sign at all. The ssh key is the same on every
	# host and needs no prompt. GPG stays in use for the vault, not for git.
	signingkey = {{ .chezmoi.homeDir }}/.ssh/id_ed25519.pub

[gpg]
	format = ssh

[gpg "ssh"]
	allowedSignersFile = {{ .chezmoi.homeDir }}/.config/git/allowed_signers

[commit]
    gpgsign = true

[tag]
    gpgsign = true
# End encrypted {{ end }}

[includeIf "gitdir:~/Git/Github/Ruhi/"]
    path = ~/.config/git/ruhi.gitconfig

# Merge commits by default
[pull]
	rebase = false

# Politically correct
[init]
	defaultBranch = main

# MacOS only {{ if eq .chezmoi.os "darwin" }}
[gpg]
	program = /usr/local/MacGPG2/bin/gpg2
# End MacOS {{ end }}

[core]
	# false ignores permissions changes
	filemode = false
	# The default is $XDG_CONFIG_HOME/git/ignore
	excludesFile = ~/.config/git/ignore
	# Shared hooks. Without this git only looks in each repo's .git/hooks,
	# so the scan hooks below this path never run and the gate is silently
	# absent. A repo that needs its own hooks sets core.hooksPath locally,
	# which then replaces this one rather than adding to it.
	hooksPath = {{ .chezmoi.homeDir }}/.config/git/hooks

[diff]
	# Git diff will use (i)ndex, (w)ork tree, (c)ommit and (o)bject
	# instead of a/b/c/d as prefixes for patches
	mnemonicprefix = true
	# The patience algorithm seems pretty reasonable
	# See: https://github.com/peter-evans/patience
	algorithm = patience
	compactionHeuristic = true
	colorMoved = default
# Pretty outputs
# https://github.com/dandavison/delta
[pager]
	diff = delta
	log = delta
	reflog = delta
	show = delta

[interactive]
	diffFilter = delta --color-only --features=interactive

[delta]
	features = side-by-side line-numbers decorations dark
	syntax-theme = Monokai Extended # Solarized (light)
	navigate = true

[delta "interactive"]
	keep-plus-minus-markers = false

[delta "magit-delta"]
    whitespace-error-style = green reverse

# Keys over passwords
[url "git@github.com:"]
	insteadOf = https://github.com/

# GitLab runs the other way from GitHub: the home uplink drops sustained SSH
# streams to gitlab.com's Cloudflare edge (packs over ~1MB die mid send-pack;
# ssh :22 and altssh :443 both), while git-over-HTTP/2 takes a 10MB pack
# clean. So every gitlab remote, ssh-form included, rewrites to https; auth
# rides the glab credential helper below.
[url "https://gitlab.com/"]
	insteadOf = git@gitlab.com:

[credential]
	helper = cache

[credential "https://gitlab.com"]
	helper = !glab auth git-credential

[alias]
    mr = !sh -c 'git fetch $1 merge-requests/$2/head:mr-$1-$2 && git checkout mr-$1-$2' -
	# Kanged: https://github.com/alrra/dotfiles/blob/main/src/git/gitconfig
	# https://help.github.com/en/articles/creating-a-commit-with-multiple-authors
    credit-co-author = "!f() { \
        if [ -n \"$1\" ] && [ -n \"$2\" ]; then \
            GIT_EDITOR=\"git interpret-trailers --in-place --trailer='Co-authored-by: 1<2>'\" git commit --amend; \
        fi \
    }; f"
	# Prevents .jj from being wiped
	# Usage: git cl -dfnx
	#         ^--------------- check then run without -n
    cl = clean -e .jj

[http "https://gitea.mpi-muelheim.mpg.de:3000"]
proxy=socks5h://127.0.0.1:9998

# xref: https://git-scm.com/book/en/v2/Git-Tools-Rerere
[rerere]
	enabled = true

