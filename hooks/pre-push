#!/usr/bin/env bash
# Chezmoi pre-push audit: reject any push whose commit messages mention
# AI framework names, agent identities, private client / project names,
# session meta-commentary, or internal config-framework paths.
#
# If you need to bypass this (rare: e.g. the ban list itself needs to quote
# a banned phrase in a commit that's been manually sanitized), use
# `git push --no-verify`. That's a deliberate, auditable act.
#
# Installed automatically on every chezmoi apply via the hooks task below.
# The canonical source lives in the chezmoi tree; this file is a symlink.

set -euo pipefail

remote="$1"
url="$2"

banned_re='claude|codex|anthropic|openai|gpt-|chatgpt|\bllm\b|realpython|agent|cursor|windsurf|gemini|called out|session where|tcov-inla|company-confidential|CLAUDE\.md|AGENTS\.md|realpython-reviewer|rp-reviewer|feedback_claude'

blocked=0
while read -r local_ref local_sha remote_ref remote_sha; do
    if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
        # Deleting a ref; nothing to audit.
        continue
    fi
    if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
        # New ref; audit full history of the pushed branch.
        range="$local_sha"
    else
        # Updating ref; audit new commits only.
        range="${remote_sha}..${local_sha}"
    fi

    offenders=$(git log "$range" --format='%H :: %s%n%b%n---SEP---' 2>/dev/null | \
        grep -iE "$banned_re" || true)
    if [ -n "$offenders" ]; then
        echo "BLOCKED: banned tokens in commit messages on $local_ref -> $remote_ref" >&2
        echo "$offenders" >&2
        blocked=1
    fi

    # Selftest-gutting guard: assertions in the *-selftest helpers are the
    # only gate between an automated edit and a broken live network stack
    # (the 2026-07-09 regression removed a carve-out AND its guarding
    # assertion in one sweep). Removing a `fail "` line from a selftest is
    # only pushable when a commit in the range owns the change with an
    # explicit `selftest-rework:` note.
    if [ "$remote_sha" != "0000000000000000000000000000000000000000" ]; then
        gutted=$(git diff "$range" -- 'dot_local/bin/*selftest*' 2>/dev/null | \
            grep -E '^-[^-]' | grep -c 'fail "' || true)
        if [ "${gutted:-0}" -gt 0 ] && \
            ! git log "$range" --format='%B' 2>/dev/null | grep -q 'selftest-rework:'; then
            echo "BLOCKED: $gutted selftest assertion line(s) removed on $local_ref without a selftest-rework: note" >&2
            echo "If the spec really changed, say so in the commit body: selftest-rework: <why>" >&2
            blocked=1
        fi
    fi
done

if [ "$blocked" -eq 1 ]; then
    echo "" >&2
    echo "Rewrite the offending commits (git commit --amend or git rebase -i)" >&2
    echo "with generic scope messages per ~/.local/share/chezmoi/CLAUDE.md," >&2
    echo "or re-run the filter-repo scrub callback if this is a wider leak." >&2
    exit 1
fi

exit 0
