#!/usr/bin/env bash
# Generic off-box notify (used by OnFailure= and canaries).
set -euo pipefail
ENV_FILE="${HOME}/.config/terra-observability/env"
# shellcheck disable=SC1090
[[ -f "$ENV_FILE" ]] && set -a && source "$ENV_FILE" && set +a
MSG=${1:-terra notify}
[[ -n "${TERRA_TELEGRAM_BOT_TOKEN:-}" && -n "${TERRA_TELEGRAM_CHAT_ID:-}" ]] || exit 0
curl -fsS -X POST "https://api.telegram.org/bot${TERRA_TELEGRAM_BOT_TOKEN}/sendMessage" \
  --data-urlencode "chat_id=${TERRA_TELEGRAM_CHAT_ID}" \
  --data-urlencode "text=$MSG" >/dev/null || true
