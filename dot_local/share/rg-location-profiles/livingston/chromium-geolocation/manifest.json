{
  "manifest_version": 3,
  "name": "Livingston Location Profile",
  "version": "1.0.0",
  "description": "Applies Livingston, Texas location signals for the local profile launcher.",
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    }
  ]
}
