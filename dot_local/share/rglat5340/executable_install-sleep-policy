#!/usr/bin/env bash
# Keep userspace filesystem servers available during sleep preparation.
set -euo pipefail

if [ "$(id -u)" -ne 0 ]; then
    echo 'Run this installer as root.' >&2
    exit 1
fi
if [ "$(hostname)" != rglat5340 ]; then
    echo 'This sleep policy is specific to rglat5340.' >&2
    exit 1
fi

for operation in suspend hibernate hybrid-sleep suspend-then-hibernate; do
    install -d -m 0755 "/etc/systemd/system/systemd-$operation.service.d"
    install -m 0644 /dev/stdin "/etc/systemd/system/systemd-$operation.service.d/50-userspace-filesystems.conf" <<'CONF'
# Userspace FUSE servers must answer pending filesystem requests while
# the kernel freezes their clients. Locking is handled by swayidle.
[Service]
Environment=SYSTEMD_SLEEP_FREEZE_USER_SESSIONS=false
CONF
done
systemctl daemon-reload
for operation in suspend hibernate hybrid-sleep suspend-then-hibernate; do
    systemctl show "systemd-$operation.service" -p Environment
done
