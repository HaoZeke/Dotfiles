[Desktop Entry]
Type=Application
Name=Vivaldi Wayland
Comment=Vivaldi on Wayland with a recoverable window launch
Categories=Network;WebBrowser;
Terminal=false
TryExec=/usr/bin/systemd-run
Exec=/usr/bin/systemd-run --user --scope --quiet --slice=browser.slice -- /usr/bin/vivaldi-stable --new-window --enable-features=UseOzonePlatform,WaylandWindowDecorations --ozone-platform=wayland --ozone-platform-hint=auto %U
Icon=vivaldi
StartupWMClass=Vivaldi-stable
