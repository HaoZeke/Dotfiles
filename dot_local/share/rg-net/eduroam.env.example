# Redacted example of the eduroam 802.1X profile.
#
# The real file lives at ~/.local/share/rg-net/private/eduroam.env, is written
# by rg-eduroam-export from a host that already authenticates, and is sealed
# with nimvault. It carries a credential and is never committed in plaintext.
#
# Settings are stack-neutral: rg-eduroam-provision renders them for whichever
# supplicant the target host runs (NetworkManager on rgSURFLat, iwd here).
RG_EDUROAM_SSID=eduroam
RG_EDUROAM_EAP=peap
RG_EDUROAM_PHASE2=mschapv2
RG_EDUROAM_ANON_IDENTITY=anonymous@REPLACE.example.nl
RG_EDUROAM_IDENTITY=REPLACE_USER@REPLACE.example.nl
RG_EDUROAM_PASSWORD=REPLACE_WITH_EDUROAM_PASSWORD
# Without a CA cert this domain match is the only thing preventing an access
# point that merely broadcasts "eduroam" from collecting the credential.
RG_EDUROAM_DOMAIN_SUFFIX=REPLACE.example.nl
