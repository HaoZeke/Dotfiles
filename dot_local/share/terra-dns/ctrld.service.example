# EXAMPLE only — real unit installed from nimvault path:
#   ~/.local/share/terra-dns/private/ctrld.service
# Do not put ControlD profile path tokens in git.
[Unit]
Description=A highly configurable, multi-protocol DNS forwarding proxy
ConditionFileIsExecutable=/usr/local/bin/ctrld
Wants=nss-lookup.target
After=network.target nss-lookup.target

[Service]
StartLimitInterval=5
StartLimitBurst=10
# Prefer EnvironmentFile for upstream URLs on operator hosts; see private unit.
ExecStart=/usr/local/bin/ctrld run --listen=127.0.0.1:5354 --cache_size=10000
WorkingDirectory=/etc/controld
Restart=always
RestartSec=30
EnvironmentFile=-/etc/sysconfig/ctrld
KillMode=process

[Install]
WantedBy=multi-user.target
