#!/bin/bash
# Show live cgroup pressure for buildbot slices
set -euo pipefail
for s in buildbot.slice buildbot-interactive.slice; do
  echo "=== $s ==="
  systemctl show "$s" -p ActiveState -p MemoryCurrent -p MemoryPeak -p CPUUsageNSec -p TasksCurrent 2>/dev/null || echo "(inactive)"
  cg="/sys/fs/cgroup/$s"
  if [[ -d $cg ]]; then
    echo -n "memory.current: "; cat "$cg/memory.current" 2>/dev/null
    echo -n "memory.peak: "; cat "$cg/memory.peak" 2>/dev/null
    echo -n "memory.events: "; cat "$cg/memory.events" 2>/dev/null | tr '\n' ' '; echo
    echo -n "cpu.stat: "; head -3 "$cg/cpu.stat" 2>/dev/null | tr '\n' ' '; echo
  fi
done
echo "=== oomd ==="
systemctl is-active systemd-oomd
busctl get-property org.freedesktop.oom1 /org/freedesktop/oom1 org.freedesktop.oom1.Manager KillDelayUSec 2>/dev/null || true
