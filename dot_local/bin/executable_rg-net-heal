    local -a override_hosts
    if [ -n "${RG_NL_PUBLIC_SERVICE_HOSTS:-}" ]; then
        read -r -a override_hosts <<<"$RG_NL_PUBLIC_SERVICE_HOSTS"
        printf '%s\n' "${override_hosts[@]}"
        return 0
    fi
    cat <<'EOF'
cbr.nl
www.cbr.nl
mijn.cbr.nl
digid.nl
www.digid.nl
mijn.digid.nl
app.digid.nl
inloggen.digid.nl
overheid.nl
www.overheid.nl
mijn.overheid.nl
mijnoverheid.nl
www.mijnoverheid.nl
berichtenbox.overheid.nl
rijksoverheid.nl
www.rijksoverheid.nl
government.nl
www.government.nl
nederlandwereldwijd.nl
www.nederlandwereldwijd.nl
netherlandsworldwide.nl
www.netherlandsworldwide.nl
belastingdienst.nl
www.belastingdienst.nl
mijn.belastingdienst.nl
mijnbelastingdienst.belastingdienst.nl
toeslagen.nl
www.toeslagen.nl
mijn.toeslagen.nl
duo.nl
www.duo.nl
mijn.duo.nl
rdw.nl
www.rdw.nl
mijn.rdw.nl
uwv.nl
www.uwv.nl
werk.nl
www.werk.nl
svb.nl
www.svb.nl
mysvb.nl
www.mysvb.nl
cjib.nl
www.cjib.nl
politie.nl
www.politie.nl
om.nl
www.om.nl
rechtspraak.nl
www.rechtspraak.nl
ind.nl
www.ind.nl
