#!/usr/bin/env bash
# rg-net-heal: automated companion to rg-net-doctor (which only audits).
# Runs as root from rg-net-heal.timer + on network-online. Idempotent, quiet.
#
#   1. x.ai system tailscale (Starfleet / experimental grok models): keep the
#      daemon running + connected. Auto-recover a Stopped state; on a real logout
#      (auth expiry) notify the desktop -- re-login needs a human, so never block
#      on an interactive `tailscale up`.
#   2. x.ai tailnet visibility: the x.ai tailnet must see this node from the
#      Houston exit or model access is refused. The system tailscaled's own
#      transport (fwmark 0x80000) rides the tunnel via the pref-5205 rule that
#      rg-us-egress-up installs; this script must NOT carve x.ai control-plane
#      or peer-transport endpoints onto the LAN, and it deletes any stale /32
#      of that kind left over from the earlier underlay carve-out. Only the
#      haozeke tailnet (section 3) stays on the LAN uplink.
#   3. landsbankinn.is carve-out: the bank times out through the Windscribe US
#      (Houston) egress, so keep its /24 routed DIRECT via the current LAN
#      default. rule 5208 ("lookup main suppress_prefixlength 0") consults main
#      for specific routes before the egress rule, so a /24 in main suffices.
#      Re-asserted each run -> survives network roams with no baked-in gateway.
#   4. eduVPN (SURF) carve-out: the split-VPN control channel to the SURF eduVPN
#      server, plus the portal/discovery hosts used to fetch or renew a profile,
#      must egress on the LOCAL uplink; with the US 0/0 tunnel up they exit the
#      US IP and time out. Carve SURF's eduVPN /24 direct (covers server, portal,
#      static, discovery mirror), pin disco.eduvpn.org's out-of-range IPs, and
#      blackhole its dead IPv6 so discovery falls straight to IPv4. Specific main
#      routes beat wg-quick's 0/0 (rule 5208), re-asserted each run.
#   5. Dutch public-service carve-out: CBR, DigiD, MijnOverheid, tax, RDW,
#      benefits, benefits-adjacent, and similar public portals can reject or
#      mis-handle the Houston egress. Resolve the known public-service host set
#      on each run and route those /32s through the local uplink.
#   6. OLT carve-out: OLT can reject or mis-handle authenticated traffic from
#      the Houston exit. Prefer the local uplink only when its HTTPS path works;
#      otherwise omit the /32 so the reachable Houston path remains available.
set -uo pipefail

log() { logger -t rg-net-heal -- "$1"; }
notify() {
    local bus="/run/user/1001/bus"
    [ -S "$bus" ] && sudo -u rgoswami DBUS_SESSION_BUS_ADDRESS="unix:path=$bus" \
        notify-send -u critical "net-heal" "$1" >/dev/null 2>&1 || true
    log "$1"
}

public_underlay_v4() {
    local ip="$1" o1 o2 o3 o4 oct
    case "$ip" in
        ''|*[!0-9.]*|10.*|127.*|169.254.*|192.168.*|100.6[4-9].*|100.[78][0-9].*|100.9[0-9].*|100.1[01][0-9].*|100.12[0-7].*) return 1 ;;
    esac
    IFS=. read -r o1 o2 o3 o4 <<EOF
$ip
EOF
    for oct in "$o1" "$o2" "$o3" "$o4"; do
        case "$oct" in ''|*[!0-9]*) return 1 ;; esac
        [ "$oct" -ge 0 ] 2>/dev/null && [ "$oct" -le 255 ] 2>/dev/null || return 1
    done
    [ "$o1" -eq 0 ] && return 1
    [ "$o1" -eq 172 ] && [ "$o2" -ge 16 ] && [ "$o2" -le 31 ] && return 1
    [ "$o1" -ge 224 ] && return 1
    return 0
}

# Dynamic /32 carve-outs are recorded per run so stale ones can be pruned: a
# /32 left behind after a roam keeps a dead gateway and blackholes that CDN
# edge for every site it serves. Static /24 carve-outs are not recorded and
# never pruned.
#
# A CDN answers with a rotating subset of its pool, so an address absent from
# the newest answer has not left the pool. Each record therefore carries the
# gateway it was pinned to and the time it was last seen: the departed-gateway
# hazard above is caught by the gateway comparison, which needs no rotation
# guesswork, and everything else ages out on a TTL that spans many runs.
CARVE_STATE="${RG_CARVE_STATE:-/run/rg-net-heal.carves}"
CARVE_STATE_NEW="$(mktemp)"
CARVE_TTL="${RG_CARVE_TTL:-3600}"
now="$(date +%s)"

route_local_v4() {
    local ip="$1" label="${2:-host}"
    public_underlay_v4 "$ip" || return 0
    printf '%s %s %s %s\n' "$ip" "$gw" "$dev" "$now" >>"$CARVE_STATE_NEW"
    if ! ip route show table main "$ip/32" 2>/dev/null | grep -q "via $gw"; then
        ip route replace "$ip/32" via "$gw" dev "$dev" table main 2>/dev/null \
            && log "$label carve-out re-asserted: $ip via $gw dev $dev"
    fi
}

carved_this_run() {
    awk -v ip="$1" '$1 == ip { found = 1 } END { exit !found }' "$CARVE_STATE_NEW" 2>/dev/null
}

ensure_hosts_record() {
    local ip="$1" host="$2" hosts_file="${RG_HOSTS_FILE:-/etc/hosts}" tmp
    [ -r "$hosts_file" ] || return 0
    awk -v ip="$ip" -v host="$host" '
        $1 == ip {
            for (i = 2; i <= NF; i++) {
                if ($i == host) {
                    found = 1
                }
            }
        }
        END { exit !found }
    ' "$hosts_file" && return 0
    tmp="$(mktemp)"
    awk -v host="$host" '
        {
            keep = 1
            for (i = 2; i <= NF; i++) {
                if ($i == host) {
                    keep = 0
                }
            }
            if (keep) {
                print
            }
        }
    ' "$hosts_file" >"$tmp" || { rm -f "$tmp"; return 0; }
    printf '%s\t%s\n' "$ip" "$host" >>"$tmp"
    if ! cmp -s "$tmp" "$hosts_file"; then
        cp "$tmp" "$hosts_file" && log "hosts pin re-asserted: $host -> $ip"
    fi
    rm -f "$tmp"
}

tailscale_underlay_ips() {
    command -v tailscale >/dev/null 2>&1 || return 0
    command -v python3 >/dev/null 2>&1 || return 0
    tailscale status --json 2>/dev/null | python3 -c '
import json
import sys

try:
    data = json.load(sys.stdin)
except Exception:
    raise SystemExit(0)

def host(addr):
    if not isinstance(addr, str) or not addr:
        return None
    if addr.startswith("["):
        return None
    if addr.count(":") == 1:
        return addr.rsplit(":", 1)[0]
    if ":" in addr:
        return None
    return addr

for peer in (data.get("Peer") or {}).values():
    for field in ("CurAddr", "RelayAddr"):
        value = host(peer.get(field))
        if value:
            print(value)
    for addr in peer.get("Addrs") or ():
        value = host(addr)
        if value:
            print(value)
' 2>/dev/null || true
}

xai_control_host_ips() {
    local host
    for host in ${RG_XAI_CONTROL_HOSTS:-controlplane.tailscale.com log.tailscale.com login.tailscale.com}; do
        getent ahostsv4 "$host" 2>/dev/null | awk '{print $1}'
    done
}

