}

olt_hosts() {
    local -a override_hosts
    if [ -n "${RG_OLT_HOSTS:-}" ]; then
        read -r -a override_hosts <<<"$RG_OLT_HOSTS"
        printf '%s\n' "${override_hosts[@]}"
        return 0
    fi
    cat <<'EOF'
olt.com
www.olt.com
kb.olt.com
EOF
}

declare -A olt_residential_probe_cache=()
olt_residential_reachable() {
    local host="$1" ip="$2" cached
    cached="${olt_residential_probe_cache[$ip]:-}"
    case "$cached" in
        reachable) return 0 ;;
        unreachable) return 1 ;;
    esac
    command -v curl >/dev/null 2>&1 || return 1
    if curl -4 --noproxy '*' --interface "$dev" \
        --connect-timeout "${RG_OLT_CONNECT_TIMEOUT:-2}" \
        --max-time "${RG_OLT_MAX_TIME:-4}" \
        --resolve "${host}:443:${ip}" \
        -sS -o /dev/null "https://${host}/" >/dev/null 2>&1; then
        olt_residential_probe_cache[$ip]=reachable
        return 0
    fi
    olt_residential_probe_cache[$ip]=unreachable
    return 1
}

# --- 1. x.ai tailscale ----------------------------------------------------
systemctl is-active --quiet tailscaled.service || { systemctl start tailscaled.service >/dev/null 2>&1 || true; sleep 2; }
ts_state="$(tailscale status --json 2>/dev/null \
    | python3 -c 'import sys,json;print(json.load(sys.stdin).get("BackendState",""))' 2>/dev/null || true)"
case "$ts_state" in
    Running) : ;;
    Stopped) tailscale up --accept-dns=true >/dev/null 2>&1 || notify "x.ai tailscale stuck Stopped; run: sudo tailscale up" ;;
    NeedsLogin|NoState|"") notify "x.ai tailscale logged out -> Starfleet + grok models down. Re-login: sudo tailscale up --accept-dns=true" ;;
esac

# --- 1b. x.ai API hosts pin: keep it, but never let a retired edge rot in it -
# api.x.ai is pinned in /etc/hosts to a Cloudflare edge that answers reliably
# from the Houston egress. A hardcoded edge can die upstream; when it does, the
# guard's quality probe (which resolves through the pin) would blame the tunnel
# and restart-storm it. Validate the pinned edge through the live egress and
# rotate to a currently-resolving edge that answers, keeping the pin honest.
# Rotation only runs with the tunnel up: edge health from the NL uplink says
# nothing about edge health from Houston.
# The live pin in /etc/hosts is the source of truth after a rotation; the
# hardcoded address only seeds a hosts file that lacks the record.
xai_current_pin="$(awk '$1 ~ /^[0-9.]+$/ && $2 == "api.x.ai" {print $1; exit}' \
    "${RG_HOSTS_FILE:-/etc/hosts}" 2>/dev/null)"
XAI_PIN_IP="${RG_XAI_PIN_IP:-${xai_current_pin:-104.18.19.80}}"
XAI_PIN_STATE="${RG_XAI_PIN_STATE:-/run/rg-net-heal.xai-pin-fails}"
XAI_PIN_FAIL_THRESHOLD="${RG_XAI_PIN_FAIL_THRESHOLD:-3}"
xai_pin_reachable() {
    local edge="$1" code
    code="$(curl -4 -sS -o /dev/null --connect-timeout 4 --max-time 8 \
        --resolve "api.x.ai:443:$edge" -w '%{http_code}' \
        https://api.x.ai/v1/models 2>/dev/null)" || return 1
    case "$code" in [23][0-9][0-9]|401|403) return 0 ;; *) return 1 ;; esac
}
ensure_hosts_record "$XAI_PIN_IP" api.x.ai
if ip link show "${RG_US_EGRESS_IFACE:-rg-us-egress-wg}" >/dev/null 2>&1 \
    && command -v curl >/dev/null 2>&1 && command -v dig >/dev/null 2>&1; then
    if xai_pin_reachable "$XAI_PIN_IP"; then
        : >"$XAI_PIN_STATE" 2>/dev/null || true
    else
        pin_fails="$(cat "$XAI_PIN_STATE" 2>/dev/null || echo 0)"
        case "$pin_fails" in ''|*[!0-9]*) pin_fails=0 ;; esac
        pin_fails=$((pin_fails + 1))
        printf '%s\n' "$pin_fails" >"$XAI_PIN_STATE" 2>/dev/null || true
        if [ "$pin_fails" -ge "$XAI_PIN_FAIL_THRESHOLD" ]; then
            : >"$XAI_PIN_STATE" 2>/dev/null || true
            rotated=0
            for cand in $(dig @127.0.0.1 api.x.ai A +time=3 +tries=1 +short 2>/dev/null \
                | grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$'); do
                [ "$cand" = "$XAI_PIN_IP" ] && continue
                if xai_pin_reachable "$cand"; then
                    ensure_hosts_record "$cand" api.x.ai
                    notify "api.x.ai pin rotated: $XAI_PIN_IP -> $cand (old edge dead from the egress)"
                    rotated=1
                    break
                fi
            done
            [ "$rotated" -eq 1 ] \
                || notify "api.x.ai unreachable on the pinned edge and every resolved candidate; upstream or egress problem"
        fi
    fi
fi

# --- 2. landsbankinn.is direct carve-out (roam-proof) ---------------------
BANK="${RG_BANK_DIRECT:-89.104.148.0/24}"
read -r gw dev < <(ip -4 route show table main | awk '/^default via/{print $3, $5; exit}')
if [ -n "${gw:-}" ] && [ -n "${dev:-}" ]; then
    if ! ip route show table main "$BANK" 2>/dev/null | grep -q "via $gw"; then
        ip route replace "$BANK" via "$gw" dev "$dev" table main 2>/dev/null \
            && log "bank carve-out re-asserted: $BANK via $gw dev $dev"
    fi
else
    log "no LAN default route; cannot assert bank carve-out"
fi

# --- 2b. gitlab.com direct carve-out (Cloudflare-fronted; roam-proof) -------
# gitlab.com (git + altssh) is Cloudflare anycast: the US egress reaches some
# pool IPs and times out on others, so SSH pushes to the vault gamble on the
# egress->Cloudflare path and stall. Keep gitlab on the LAN uplink. Static /24
# covers the current pool; also pin whatever gitlab.com / altssh resolve to now.
GITLAB_DIRECT="${RG_GITLAB_DIRECT:-172.65.251.0/24}"
if [ -n "${gw:-}" ] && [ -n "${dev:-}" ]; then
    if ! ip route show table main "$GITLAB_DIRECT" 2>/dev/null | grep -q "via $gw"; then
        ip route replace "$GITLAB_DIRECT" via "$gw" dev "$dev" table main 2>/dev/null \
            && log "gitlab carve-out re-asserted: $GITLAB_DIRECT via $gw dev $dev"
    fi
    for gl_host in gitlab.com altssh.gitlab.com; do
        getent ahostsv4 "$gl_host" 2>/dev/null | awk '{print $1}' | sort -u | while read -r ip; do
            route_local_v4 "$ip" "gitlab"
        done
    done
fi

# --- 2c. Dutch public-service carve-out (CBR, DigiD, MijnOverheid, tax) ----
if [ -n "${gw:-}" ] && [ -n "${dev:-}" ]; then
    nl_public_service_hosts | sort -u | while read -r nl_host; do
        case "$nl_host" in ''|\#*) continue ;; esac
        getent ahostsv4 "$nl_host" 2>/dev/null | awk '{print $1}' | sort -u | while read -r ip; do
            route_local_v4 "$ip" "nl public service:$nl_host"
        done
    done
fi

# --- 2d. OLT residential carve-out ----------------------------------------
if [ -n "${gw:-}" ] && [ -n "${dev:-}" ]; then
    olt_hosts | sort -u | while read -r olt_host; do
        case "$olt_host" in ''|\#*) continue ;; esac
        getent ahostsv4 "$olt_host" 2>/dev/null | awk '{print $1}' | sort -u | while read -r ip; do
            if olt_residential_reachable "$olt_host" "$ip"; then
                route_local_v4 "$ip" "olt:$olt_host"
            else
                if ! carved_this_run "$ip" \
                    && ip route show table main "$ip/32" 2>/dev/null | grep -q "via $gw dev $dev"; then
                    ip route del "$ip/32" table main 2>/dev/null \
                        && log "olt:$olt_host residential path unreachable; using US egress fallback for $ip"
                fi
            fi
        done
    done
fi

# --- 3. Haozeke (cosmolab / Terra) tailnet underlay carve-out ---------------
# The second tailscaled runs userspace-networking on /tmp/ts-hz.sock; its peer
# transport must stay on the LOCAL uplink, or the direct path dies inside the
# US 0/0 tunnel and the peer becomes unreachable. The desired set is recorded
# so the x.ai anti-carve below never deletes an IP the haozeke path needs
# (Terra reachability outranks x.ai visibility on shared infrastructure).
hz_underlay_set="$(mktemp)"
HZ_DERP_TARGETS="${RG_HZ_DERP_TARGETS:-/usr/local/sbin/rg-haozeke-derp-targets}"
if [ -n "${gw:-}" ] && [ -n "${dev:-}" ] && [ -S /tmp/ts-hz.sock ] \
    && command -v tailscale >/dev/null 2>&1 && command -v python3 >/dev/null 2>&1; then
    hz_status_json="$(tailscale --socket=/tmp/ts-hz.sock status --json 2>/dev/null || true)"
    printf '%s\n' "$hz_status_json" | python3 -c '
import json
import sys

try:
    data = json.load(sys.stdin)
except Exception:
    raise SystemExit(0)

def host(addr):
    if not isinstance(addr, str) or not addr or addr.startswith("["):
        return None
    if addr.count(":") == 1:
        return addr.rsplit(":", 1)[0]
    if ":" in addr:
        return None
    return addr

for peer in (data.get("Peer") or {}).values():
    for field in ("CurAddr", "RelayAddr"):
        value = host(peer.get(field))
        if value:
            print(value)
    for addr in peer.get("Addrs") or ():
        value = host(addr)
        if value:
            print(value)
' 2>/dev/null | sort -u | tee "$hz_underlay_set" | while read -r ip; do
        route_local_v4 "$ip" "haozeke underlay"
    done

    if [ -x "$HZ_DERP_TARGETS" ] && [ -n "$hz_status_json" ]; then
        hz_derp_map_json="$(tailscale --socket=/tmp/ts-hz.sock debug derp-map 2>/dev/null || true)"
        if [ -n "$hz_derp_map_json" ]; then
            hz_derp_ips="$("$HZ_DERP_TARGETS" \
                <(printf '%s\n' "$hz_status_json") \
                <(printf '%s\n' "$hz_derp_map_json") 2>/dev/null)" \
                || { log "haozeke DERP target selection failed"; hz_derp_ips=""; }
            if [ -n "$hz_derp_ips" ]; then
                printf '%s\n' "$hz_derp_ips" | sort -u | tee -a "$hz_underlay_set" | while read -r ip; do
                    route_local_v4 "$ip" "haozeke derp"
                done
            fi
        fi
    fi
fi

# --- 3b. x.ai tailnet visibility: keep its transport OFF the LAN uplink -----
# The x.ai tailnet must see this node from the Houston exit or model access is
# refused. The marked pref-5205 rule (rg-us-egress-up) already tunnels the
# system tailscaled's own flows; here we delete any stale LAN /32 for x.ai
# control-plane hosts or system-tailnet transport endpoints (left by the
# retired underlay carve-out), except IPs the haozeke tailnet needs local.
if command -v tailscale >/dev/null 2>&1; then
    { tailscale_underlay_ips; xai_control_host_ips; } | sort -u | while read -r ip; do
        public_underlay_v4 "$ip" || continue
        grep -qxF "$ip" "$hz_underlay_set" 2>/dev/null && continue
        if ip route show table main "$ip/32" 2>/dev/null | grep -q .; then
            ip route del "$ip/32" table main 2>/dev/null \
                && log "x.ai transport un-carved: $ip rides the US egress"
        fi
    done
fi
rm -f "$hz_underlay_set"

# --- 4. eduVPN (SURF) carve-out: control channel + portal off the US egress -
# The split-VPN control channel to the SURF eduVPN server, and the portal /
# discovery hosts used to fetch or renew a profile, must egress on the LOCAL
# uplink; with the US 0/0 tunnel up they exit the US IP and time out. Carve
# SURF's eduVPN range direct, pin disco.eduvpn.org's out-of-range IPs, and
# blackhole disco's IPv6 (this uplink has no working global v6, so its AAAA
# records only stall discovery). Specific main routes beat wg-quick's 0/0
# (rule 5208 suppress_prefixlength 0). The /24 also covers the OpenVPN server.
EDUVPN_NET4="${RG_EDUVPN_NET4:-145.100.179.0/24}"
EDUVPN_DISCO="${RG_EDUVPN_DISCO:-disco.eduvpn.org}"
EDUVPN_V6_DEAD="${RG_EDUVPN_V6_DEAD:-2001:610:188:2011::/64 2001:878:0:e000::/64}"
if [ -n "${gw:-}" ] && [ -n "${dev:-}" ]; then
    if ! ip route show table main "$EDUVPN_NET4" 2>/dev/null | grep -q "via $gw"; then
        ip route replace "$EDUVPN_NET4" via "$gw" dev "$dev" table main 2>/dev/null \
            && log "eduVPN carve-out re-asserted: $EDUVPN_NET4 via $gw dev $dev"
    fi
    getent ahostsv4 "$EDUVPN_DISCO" 2>/dev/null | awk '{print $1}' | sort -u | while read -r ip; do
        case "$ip" in ''|*[!0-9.]*|145.100.179.*) continue ;; esac
        route_local_v4 "$ip" "eduVPN disco"
    done
fi
for p in $EDUVPN_V6_DEAD; do
    ip -6 route show "$p" 2>/dev/null | grep -q unreachable || ip -6 route replace unreachable "$p" 2>/dev/null
done

# --- 5. age out dynamic /32 carve-outs that are no longer desired -----------
# Skipped entirely when this run resolved nothing (total DNS outage must not
# wipe a working carve-out set) or when there is no gateway to compare against.
if [ -s "$CARVE_STATE_NEW" ] && [ -n "${gw:-}" ] && [ -n "${dev:-}" ]; then
    carve_keep="$(mktemp)"
    sort -u "$CARVE_STATE_NEW" >"$carve_keep"
    if [ -f "$CARVE_STATE" ]; then
        while read -r c_ip c_gw c_dev c_seen; do
            [ -n "${c_ip:-}" ] || continue
            carved_this_run "$c_ip" && continue
            # A record written before carve-outs carried a gateway names only
            # an address; adopt it under the current one rather than dropping
            # a route that is still correct.
            if [ -z "${c_gw:-}" ]; then
                c_gw="$gw"
                c_dev="$dev"
                c_seen="$now"
            fi
            if [ "$c_gw" != "$gw" ] || [ "$c_dev" != "$dev" ]; then
                ip route del "$c_ip/32" table main 2>/dev/null \
                    && log "carve-out pruned (gateway changed): $c_ip via $c_gw dev $c_dev"
                continue
            fi
            if [ $((now - c_seen)) -ge "$CARVE_TTL" ]; then
                ip route del "$c_ip/32" table main 2>/dev/null \
                    && log "stale carve-out pruned: $c_ip"
                continue
            fi
            printf '%s %s %s %s\n' "$c_ip" "$c_gw" "$c_dev" "$c_seen" >>"$carve_keep"
        done <"$CARVE_STATE"
    fi
    install -m 0644 "$carve_keep" "$CARVE_STATE"
    rm -f "$carve_keep"
fi
rm -f "$CARVE_STATE_NEW"
