#!/usr/bin/env bash
# Managed by chezmoi (dot_local/bin/executable_rg-git-shim-selftest).
#
# Behaviour checks for the agent git shim (~/.local/libexec/rg-git-shim/git):
# what it refuses, what it lets through, and which trailers it drops. A stub
# `git` after the shim on PATH records what would have reached gitguard.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
shim=""
for c in "$here/../libexec/rg-git-shim/executable_git" "$HOME/.local/libexec/rg-git-shim/git"; do
    [ -f "$c" ] && { shim="$c"; break; }
done
[ -n "$shim" ] || { echo "no git shim found" >&2; exit 1; }

work="$(mktemp -d "${TMPDIR:-/tmp}/rg-git-shim-selftest.XXXXXX")"
trap 'rm -rf -- "$work"' EXIT
mkdir -p "$work/shim" "$work/next"
cp "$shim" "$work/shim/git"
chmod 755 "$work/shim/git"
cat >"$work/next/git" <<'EOF'
#!/usr/bin/env bash
# Answer `config --get alias.NAME` from -c alias.NAME=VALUE the way git does;
# everything else records what would have reached gitguard.
prev=""; want=""; value=""
for a in "$@"; do
    [ "$prev" = "-c" ] && case "$a" in alias.*=*) n="${a%%=*}"; printf -v "alias_${n#alias.}" '%s' "${a#*=}" ;; esac
    prev="$a"
done
if [ "$#" -ge 3 ] && [ "${*: -3:1}" = "config" ] && [ "${*: -2:1}" = "--get" ]; then
    key="${@: -1}"; name="${key#alias.}"; var="alias_$name"
    [ -n "${!var:-}" ] && { printf '%s\n' "${!var}"; exit 0; }
    exit 1
fi
printf 'reached'
for a in "$@"; do printf ' [%s]' "$a"; done
printf '\n'
EOF
chmod 755 "$work/next/git"
printf "agent_ident='(noreply@example\\.invalid|Some Harness)'\n" >"$work/commit-msg"

fail=0
run() {
    env -u GIT_CONFIG_PARAMETERS RG_GIT_SHIM_HOOK="$work/commit-msg" \
        PATH="$work/shim:$work/next:/usr/bin:/bin" "$@" 2>&1
}
refused() {
    local label=$1 out
    shift
    if out="$(run "$@")"; then
        printf 'FAIL %s was let through: %s\n' "$label" "$out" >&2
        fail=1
    else
        case "$out" in
            git-shim:*) printf 'ok   %s refused\n' "$label" ;;
            *) printf 'FAIL %s failed another way: %s\n' "$label" "$out" >&2; fail=1 ;;
        esac
    fi
}
passes() {
    local label=$1 want=$2 out
    shift 2
    if out="$(run "$@")" && [[ "$out" == *"$want"* ]]; then
        printf 'ok   %s\n' "$label"
    else
        printf 'FAIL %s: %s\n' "$label" "$out" >&2
        fail=1
    fi
}

refused "commit --no-verify" git commit --no-verify -m x
refused "push --no-verify" git push --no-verify
refused "commit -n" git commit -n -m x
refused "commit -an" git commit -an -m x
refused "commit -nm" git commit -nm x
refused "-c core.hooksPath=" git -c core.hooksPath=/dev/null commit -m x
refused "-ccore.hooksPath=" git -ccore.hooksPath=/dev/null commit -m x
refused "--config-env core.hooksPath" git --config-env core.hooksPath=X commit -m x
refused "GIT_CONFIG_KEY_0=core.hooksPath" env GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=core.hooksPath GIT_CONFIG_VALUE_0=/dev/null git commit -m x
refused "config core.hooksPath VALUE" git config core.hooksPath /dev/null
refused "config --unset core.hooksPath" git config --unset core.hooksPath
refused "bundle" git bundle create x.bundle --all
refused "-C DIR bundle" git -C /tmp bundle create x.bundle --all
refused "-c k=v bundle" git -c user.name=x bundle create x.bundle --all

refused "config core.hooksPath get (sets it to 'get')" git config core.hooksPath get
refused "config set core.hooksPath" git config set core.hooksPath /dev/null
refused "commit --no-verif (abbreviation)" git commit --no-verif -m x
refused "push --no-ver (abbreviation)" git push --no-ver
refused "command-line alias to commit -n" git -c "alias.c=commit --allow-empty -n -m y" c
refused "command-line shell alias to commit -n" git -c "alias.s=!git commit -n -m y" s
refused "command-line alias to bundle" git -c "alias.b=bundle create x.bundle --all" b
refused "command-line alias to config core.hooksPath" git -c "alias.h=config core.hooksPath /dev/null" h

passes "bare config core.hooksPath (read)" "reached [config] [core.hooksPath]" git config core.hooksPath
passes "config get core.hooksPath (new style read)" "reached [config] [get] [core.hooksPath]" git config get core.hooksPath
passes "alias to log -n" "[lg]" git -c "alias.lg=log -n 5" lg
passes "shell alias to log -n" "[sl]" git -c "alias.sl=!git log -n 5" sl
passes "config --get core.hooksPath" "reached [config] [--get] [core.hooksPath]" git config --get core.hooksPath
passes "commit -m with n in the message" "[-m] [nonsense]" git commit -m nonsense
passes "commit -am" "[-am]" git commit -am x
passes "push -n (dry run)" "[push] [-n]" git push -n
passes "add -n (dry run)" "[add] [-n]" git add -n .
passes "harness trailer dropped" "reached [commit] [-m] [x]" git commit -m x --trailer "Co-authored-by: Some Harness <noreply@example.invalid>"
passes "other trailer kept" "[--trailer] [Reviewed-by: A Person <a@example.org>]" git commit -m x --trailer "Reviewed-by: A Person <a@example.org>"
passes "-C DIR status" "reached [-C] [/tmp] [status]" git -C /tmp status

# A PATH entry naming the shim directory with a trailing slash must still be
# removed, or the shim would exec itself.
if out="$(env RG_GIT_SHIM_HOOK="$work/commit-msg" PATH="$work/shim/:$work/next:/usr/bin:/bin" timeout 10 git status 2>&1)" \
    && [[ "$out" == "reached [status]"* ]]; then
    printf 'ok   trailing-slash PATH entry for the shim is removed\n'
else
    printf 'FAIL trailing-slash PATH entry: %s\n' "$out" >&2
    fail=1
fi

[ "$fail" -eq 0 ] && echo ok
exit "$fail"
