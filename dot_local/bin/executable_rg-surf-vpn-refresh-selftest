#!/usr/bin/env bash
# Behavior checks for silent-first SURF renewal and authorization prompting.
set -euo pipefail

fail() {
    printf 'FAIL: %s\n' "$*" >&2
    exit 1
}

if [ $# -gt 1 ]; then
    printf 'usage: rg-surf-vpn-refresh-selftest [refresh-helper]\n' >&2
    exit 2
fi

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REFRESH="${1:-$SCRIPT_DIR/rg-surf-vpn-refresh}"
[ -r "$REFRESH" ] || fail "refresh helper not readable: $REFRESH"

tmp_dir="$(mktemp -d)"
trap 'rtrash -rf "$tmp_dir"' EXIT
mkdir -p "$tmp_dir/bin" "$tmp_dir/state/rg-surf-vpn"
calls="$tmp_dir/calls"
: >"$calls"

cat >"$tmp_dir/bin/exporter" <<'EOF'
#!/usr/bin/env bash
printf 'export %s\n' "$*" >>"$RG_TEST_CALLS"
case "${RG_TEST_EXPORT_MODE:-success}:$*" in
auth:*--noninteractive*) exit 42 ;;
*) exit 0 ;;
esac
EOF
chmod +x "$tmp_dir/bin/exporter"

cat >"$tmp_dir/bin/notify-send" <<'EOF'
#!/usr/bin/env bash
printf 'notify\n' >>"$RG_TEST_CALLS"
printf 'authenticate\n'
EOF
chmod +x "$tmp_dir/bin/notify-send"

cat >"$tmp_dir/bin/timeout" <<'EOF'
#!/usr/bin/env bash
shift
exec "$@"
EOF
chmod +x "$tmp_dir/bin/timeout"

cat >"$tmp_dir/bin/systemctl" <<'EOF'
#!/usr/bin/env bash
[ "${1:-}" = is-active ]
EOF
chmod +x "$tmp_dir/bin/systemctl"

cat >"$tmp_dir/bin/ip" <<'EOF'
#!/usr/bin/env bash
case "$*" in
"link show tun0") exit 0 ;;
"route get 145.100.179.10") printf '145.100.179.10 dev tun0 src 10.8.0.2\n' ;;
*) exit 1 ;;
esac
EOF
chmod +x "$tmp_dir/bin/ip"

cat >"$tmp_dir/bin/getent" <<'EOF'
#!/usr/bin/env bash
printf '145.100.179.10 STREAM servicedesk.surf.nl\n'
EOF
chmod +x "$tmp_dir/bin/getent"

status_file="$tmp_dir/status.json"
cat >"$status_file" <<'JSON'
{"result":"active","not_after_epoch":2000000000,"cert_sha256":"11:22"}
JSON

run_refresh() {
    XDG_STATE_HOME="$tmp_dir/state" \
    RG_SURF_EXPORTER="$tmp_dir/bin/exporter" \
    RG_SURF_NOTIFY_SEND="$tmp_dir/bin/notify-send" \
    RG_SURF_TIMEOUT="$tmp_dir/bin/timeout" \
    RG_SURF_SYSTEMCTL="$tmp_dir/bin/systemctl" \
    RG_SURF_IP="$tmp_dir/bin/ip" \
    RG_SURF_GETENT="$tmp_dir/bin/getent" \
    RG_SURF_STATUS_FILE="$status_file" \
    RG_SURF_NOW=1000000000 \
    RG_SURF_NOTIFY_COOLDOWN=0 \
    RG_SURF_NOTIFY_TIMEOUT=1 \
    RG_TEST_CALLS="$calls" \
    RG_TEST_EXPORT_MODE="${RG_TEST_EXPORT_MODE:-success}" \
    bash "$REFRESH" "$@"
}

run_refresh --timer >/dev/null
[ ! -s "$calls" ] || fail "healthy long-lived tunnel triggered a renewal"

mv "$status_file" "$tmp_dir/status.saved"
: >"$calls"
run_refresh --timer >/dev/null
[ "$(cat "$calls")" = "export --noninteractive" ] \
    || fail "missing status did not trigger one silent export"

: >"$calls"
RG_TEST_EXPORT_MODE=auth run_refresh --timer >/dev/null
cat >"$tmp_dir/expected-calls" <<'EOF'
export --noninteractive
notify
export --interactive
EOF
cmp -s "$tmp_dir/expected-calls" "$calls" \
    || { diff -u "$tmp_dir/expected-calls" "$calls" >&2 || true; fail "authorization flow did not prompt and retry interactively"; }

: >"$calls"
run_refresh --interactive >/dev/null
[ "$(cat "$calls")" = "export --interactive" ] \
    || fail "explicit renewal did not invoke interactive export directly"

printf 'ok\n'
