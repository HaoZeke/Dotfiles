#!/usr/bin/env bash
# rg-geo-dnsmasq - close the window where a destination leaves on the wrong
# path because its current address was never sampled.
#
#   rg-geo-dnsmasq generate    write the dnsmasq and unbound fragments
#   rg-geo-dnsmasq apply       generate, validate, reload, verify, roll back on failure
#   rg-geo-dnsmasq status      show what is wired
#
# The problem this solves: polling DNS and stuffing the answers into an
# nftables set is always a step behind. Akamai-fronted hosts rotate unicast
# addresses per query, so the first visit to an address never seen before is
# routed on the direct path, silently. For a bank that is the exact request
# that must not leak.
#
# The fix is to populate the set at the moment of answering. dnsmasq's nftset
# does that: it adds every address it returns for a listed name straight into
# the set, so by the time the application connects, the route already exists.
#
# Scope is deliberately narrow. dnsmasq handles ONLY the listed domains,
# reached through per-zone forwarding in unbound. Every other name keeps the
# existing resolved -> unbound -> ctrld path untouched. Each zone also lists
# ctrld directly as a second forwarder, so if dnsmasq is down the name still
# resolves; it just loses set population for that query rather than failing.

set -Eeuo pipefail

real_home() {
    if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ]; then
        getent passwd "$SUDO_USER" | cut -d: -f6
    elif [ -n "${HOME:-}" ]; then printf '%s' "$HOME"
    else getent passwd "$(id -u)" | cut -d: -f6; fi
}
HOME_DIR="$(real_home)"
BASE="${RG_GEO_BASE:-$HOME_DIR/.config/rg-geo-egress}"
DNSMASQ_CONF=/etc/dnsmasq.d/rg-geo.conf
UNBOUND_CONF=/etc/unbound/unbound.conf.d/50-rg-geo-split.conf
# Not 5355: systemd-resolved binds that for LLMNR.
DNSMASQ_PORT="${RG_GEO_DNSMASQ_PORT:-5356}"
CTRLD="127.0.0.1@5354"

die() { printf 'rg-geo-dnsmasq: %s\n' "$*" >&2; exit 1; }
need_root() {
    [ "$(id -u)" -eq 0 ] && return 0
    command -v sudo >/dev/null || die "needs root"
    exec sudo RG_GEO_BASE="$BASE" "$(readlink -f "$0")" "$@"
}

# region -> nft table and set names, matching rg-geo-split exactly.
nft_table_for() { [ "$1" = "us" ] && printf 'rg_us_split' || printf 'rg_geo_%s' "$1"; }
set_v4_for()    { [ "$1" = "us" ] && printf 'us_v4' || printf 'dst_v4'; }
set_v6_for()    { [ "$1" = "us" ] && printf 'us_v6' || printf 'dst_v6'; }

generate() {
    local regions="" r host tbl s4 s6 n=0
    for r in us in uk de sg; do [ -r "$BASE/$r/domains.txt" ] && regions="$regions $r"; done
    [ -n "$regions" ] || die "no region lists under $BASE"

    {
        printf '# Generated by rg-geo-dnsmasq. Do not edit.\n'
        printf '# Answers for these names are written straight into the nftables set\n'
        printf '# that marks them, so no query can precede its own route.\n\n'
        printf 'port=%s\n' "$DNSMASQ_PORT"
        printf 'listen-address=127.0.0.1\n'
        printf 'bind-interfaces\n'
        printf 'no-resolv\n'
        printf 'no-hosts\n'
        # Everything dnsmasq is asked about goes to the same resolver unbound
        # would have used, so filtering still applies.
        printf 'server=127.0.0.1#5354\n'
        printf 'cache-size=1000\n\n'
        for r in $regions; do
            tbl="$(nft_table_for "$r")"; s4="$(set_v4_for "$r")"; s6="$(set_v6_for "$r")"
            printf '# --- region %s ---\n' "$r"
            while read -r host; do
                host="${host%%#*}"; host="$(printf '%s' "$host" | tr -d '[:space:]')"
                [ -n "$host" ] || continue
                printf 'nftset=/%s/inet#%s#%s,inet#%s#%s\n' "$host" "$tbl" "$s4" "$tbl" "$s6"
                n=$((n + 1))
            done < "$BASE/$r/domains.txt"
            printf '\n'
        done
    } > "$DNSMASQ_CONF"

    {
        printf '# Generated by rg-geo-dnsmasq. Do not edit.\n'
        printf '# Only these names detour through dnsmasq, purely so their answers\n'
        printf '# land in the nftables set as they are returned. ctrld is listed\n'
        printf '# second so a dnsmasq outage degrades to plain resolution rather\n'
        printf '# than to failure.\n\n'
        for r in $regions; do
            while read -r host; do
                host="${host%%#*}"; host="$(printf '%s' "$host" | tr -d '[:space:]')"
                [ -n "$host" ] || continue
                printf 'forward-zone:\n    name: "%s."\n    forward-addr: 127.0.0.1@%s\n    forward-addr: %s\n' \
                    "$host" "$DNSMASQ_PORT" "$CTRLD"
            done < "$BASE/$r/domains.txt"
        done
    } > "$UNBOUND_CONF"

    printf 'rg-geo-dnsmasq: wrote %d names across regions:%s\n' "$n" "$regions"
}

apply() {
    need_root apply
    local bak_d bak_u
    bak_d="${DNSMASQ_CONF}.bak-$(date +%s)"; bak_u="${UNBOUND_CONF}.bak-$(date +%s)"
    [ -f "$DNSMASQ_CONF" ] && cp "$DNSMASQ_CONF" "$bak_d"
    [ -f "$UNBOUND_CONF" ] && cp "$UNBOUND_CONF" "$bak_u"
    install -d -m 0755 /etc/dnsmasq.d
    generate

    dnsmasq --test --conf-file=/etc/dnsmasq.conf >/dev/null 2>&1 \
        || die "dnsmasq config failed its own syntax check; nothing reloaded"
    unbound-checkconf >/dev/null 2>&1 \
        || { rm -f "$UNBOUND_CONF"; die "unbound rejected the fragment; removed it and reloaded nothing"; }

    # A failed restart must roll back, not abort the script and leave unbound
    # pointing at a resolver that is not running.
    systemctl enable dnsmasq >/dev/null 2>&1 || true
    if ! systemctl restart dnsmasq; then
        printf 'rg-geo-dnsmasq: dnsmasq refused to start, rolling back\n' >&2
        rm -f "$UNBOUND_CONF" "$DNSMASQ_CONF"
        systemctl restart unbound || true
        journalctl -u dnsmasq -n 3 --no-pager | tail -2 >&2
        exit 1
    fi
    sleep 2
    systemctl restart unbound
    sleep 3

    # DNS is the one thing whose failure hides every other failure, so prove
    # resolution end to end before leaving this in place.
    local fail=0 got
    for h in github.com controld.com wellsfargo.com open.spotify.com; do
        got=$(getent ahostsv4 "$h" 2>/dev/null | awk '{print $1}' | head -1)
        printf '  %-20s %s\n' "$h" "${got:-FAILED}"
        [ -z "$got" ] && fail=1
    done
    if [ "$fail" -ne 0 ]; then
        printf 'rg-geo-dnsmasq: resolution broke, rolling back\n' >&2
        rm -f "$DNSMASQ_CONF" "$UNBOUND_CONF"
        [ -f "$bak_d" ] && cp "$bak_d" "$DNSMASQ_CONF"
        [ -f "$bak_u" ] && cp "$bak_u" "$UNBOUND_CONF"
        systemctl restart unbound; systemctl restart dnsmasq 2>/dev/null || true
        exit 1
    fi
    printf 'rg-geo-dnsmasq: applied and every probe resolved\n'
}

status() {
    printf '== dnsmasq ==\n  service: %s\n' "$(systemctl is-active dnsmasq 2>/dev/null)"
    printf '  names  : %s\n' "$(grep -c '^nftset=' "$DNSMASQ_CONF" 2>/dev/null || echo 0)"
    printf '== unbound ==\n  service: %s\n' "$(systemctl is-active unbound 2>/dev/null)"
    printf '  zones  : %s\n' "$(grep -c '^forward-zone:' "$UNBOUND_CONF" 2>/dev/null || echo 0)"
}

case "${1:-status}" in
    generate) need_root generate; generate ;;
    apply)    apply ;;
    status)   status ;;
    *)        die "usage: $0 {generate|apply|status}" ;;
esac
