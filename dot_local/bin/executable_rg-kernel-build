#!/usr/bin/env bash
# Managed by chezmoi (dot_local/bin/executable_rg-kernel-build).

set -euo pipefail
shopt -s inherit_errexit 2>/dev/null || true

script_dir=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
source_dir=${CHEZMOI_SOURCE_DIR:-}
case "$script_dir" in
    */dot_local/bin)
        candidate_source_dir=${script_dir%/dot_local/bin}
        if [ -r "$candidate_source_dir/dot_config/rg-kernel/build-lanes.env" ]; then
            source_dir=$candidate_source_dir
        fi
        ;;
esac

policy_file=${RG_KERNEL_POLICY:-}
if [ -z "$policy_file" ]; then
    if [ -n "$source_dir" ] && [ -r "$source_dir/dot_config/rg-kernel/build-lanes.env" ]; then
        policy_file="$source_dir/dot_config/rg-kernel/build-lanes.env"
    else
        policy_file="$HOME/.config/rg-kernel/build-lanes.env"
    fi
fi
if [ ! -r "$policy_file" ]; then
    source_dir=${source_dir:-"$HOME/.local/share/chezmoi"}
    source_policy="$source_dir/dot_config/rg-kernel/build-lanes.env"
    if [ -r "$source_policy" ]; then
        policy_file=$source_policy
    fi
fi

if [ ! -r "$policy_file" ]; then
    printf 'rg-kernel-build: missing policy file: %s\n' "$policy_file" >&2
    exit 1
fi

# shellcheck source=/dev/null
source "$policy_file"

chezmoi_source_dir=$source_dir
case "$policy_file" in
    */dot_config/rg-kernel/build-lanes.env)
        chezmoi_source_dir=${policy_file%/dot_config/rg-kernel/build-lanes.env}
        ;;
esac

fail() {
    printf 'rg-kernel-build: %s\n' "$*" >&2
    exit 1
}

usage() {
    cat <<'MSG'
usage:
  rg-kernel-build list
  rg-kernel-build jobs
  rg-kernel-build deps-command
  rg-kernel-build oomd-command
  rg-kernel-build refind-command [output]
  rg-kernel-build refind-status
  rg-kernel-build refind-install-script [output]
  rg-kernel-build patch-report
  rg-kernel-build preflight
  rg-kernel-build update
  rg-kernel-build prepare
  rg-kernel-build build
  rg-kernel-build package-base
  rg-kernel-build install-preflight
  rg-kernel-build install-command

Build policy is read from ~/.config/rg-kernel/build-lanes.env.
MSG
}

local_build_root() {
    printf '%s\n' "$RG_KERNEL_BUILD_ROOT"
}

bounded_jobs() {
    local cpus cap jobs pct
    cpus=$(getconf _NPROCESSORS_ONLN 2>/dev/null || nproc)
    pct=${RG_KERNEL_LOCAL_CPU_PERCENT:-80}
    cap=$((cpus * pct / 100))
    [ "$cap" -ge 1 ] || cap=1
    jobs=${RG_KERNEL_MAX_JOBS:-$cap}
    if [ "$jobs" -gt "$cap" ]; then
        jobs=$cap
    fi
    [ "$jobs" -ge 1 ] || jobs=1
    printf '%s\n' "$jobs"
}

build_dir() {
    printf '%s/work/%s\n' "$(local_build_root)" "$RG_KERNEL_PACKAGE_BASE"
}

artifact_dir() {
    printf '%s/%s\n' "$RG_KERNEL_ARTIFACT_DIR" "$RG_KERNEL_PACKAGE_BASE"
}

makepkg_config() {
    local out
    out="$(local_build_root)/makepkg-linux-rg.conf"
    {
        cat /etc/makepkg.conf
        cat <<'EOF'

DLAGENTS=('file::/usr/bin/curl -qgC - -o %o %u'
          'ftp::/usr/bin/curl -4 -qgfC - --ftp-pasv --retry 3 --retry-delay 3 -o %o %u'
          'http::/usr/bin/curl -4 -qgb "" -fLC - --retry 3 --retry-delay 3 -o %o %u'
          'https::/usr/bin/curl -4 -qgb "" -fLC - --retry 3 --retry-delay 3 -o %o %u'
          'rsync::/usr/bin/rsync --no-motd -z %u %o'
          'scp::/usr/bin/scp -C %u %o')
EOF
    } >"$out"
    printf '%s\n' "$out"
}

managed_path() {
    local path=$1
    if [ -e "$path" ]; then
        printf '%s\n' "$path"
        return 0
    fi
    if [ -n "$chezmoi_source_dir" ]; then
        case "$path" in
            "$HOME/.config/rg-kernel/"*)
                printf '%s/dot_config/rg-kernel/%s\n' \
                    "$chezmoi_source_dir" "${path#"$HOME/.config/rg-kernel/"}"
                return 0
                ;;
            "$HOME/.config/oomd/"*)
                printf '%s/dot_config/oomd/%s\n' \
                    "$chezmoi_source_dir" "${path#"$HOME/.config/oomd/"}"
                return 0
                ;;
        esac
    fi
    printf '%s\n' "$path"
}

package_base() {
    printf '%s\n' "$RG_KERNEL_PACKAGE_BASE"
}

selected_patch_names() {
    local manifest
    if [ -n "${RG_KERNEL_SOURCE_REPO:-}" ] && [ -d "$RG_KERNEL_SOURCE_REPO" ]; then
        find "$RG_KERNEL_SOURCE_REPO" -maxdepth 1 -type f -name '[0-9][0-9][0-9][0-9]-*.patch' \
            -printf '%f\n' | sort
        return 0
    fi
    manifest=$(managed_path "$RG_KERNEL_PATCH_SOURCES")
    [ -r "$manifest" ] || return 0
    awk -F '\t' 'NR > 1 && $1 == "selected" {print $2}' "$manifest"
}

selected_patch_line() {
    local names
    names=$(selected_patch_names | paste -sd, -)
    if [ -n "$names" ]; then
        printf '%s\n' "$names"
    else
        printf 'none\n'
    fi
}

list_policy() {
    local jobs
    jobs=$(bounded_jobs)
    cat <<MSG
package: $RG_KERNEL_PACKAGE_BASE
host: $RG_KERNEL_MACHINE_ID ($RG_KERNEL_MACHINE_MODEL)
profile: $RG_KERNEL_PROFILE
base: Arch linux PKGBUILD
source repo: ${RG_KERNEL_SOURCE_REPO:-fallback-from-arch}
base repo: $RG_KERNEL_BASE_REPO
build root: $RG_KERNEL_BUILD_ROOT
artifacts: $(artifact_dir)
selected patches: $(selected_patch_line)
jobs: $jobs ($RG_KERNEL_LOCAL_CPU_PERCENT% local CPU cap)
docs package: ${RG_KERNEL_SKIP_DOCS:-no}
MSG
}

deps_command() {
    printf 'sudo pacman -S --needed %s\n' "$RG_KERNEL_BUILD_DEPS"
}

oomd_command() {
    printf 'rg-oomd-profile-install %s\n' "$RG_KERNEL_OOMD_CONFIG"
}

boot_dir() {
    printf '%s\n' "${RG_KERNEL_BOOT_DIR:-/boot}"
}

shell_quote() {
    printf '%q' "$1"
}

refind_options_escape() {
    local value=$1
    value=${value//\\/\\\\}
    value=${value//\"/\\\"}
    printf '%s\n' "$value"
}

refind_options() {
    tr ' ' '\n' </proc/cmdline \
        | awk '
            $0 == "" {next}
            /^BOOT_IMAGE=/ {next}
            /^initrd=/ {next}
            {print}
        ' \
        | paste -sd' ' -
}

refind_conf_candidates() {
    local bd
    bd=$(boot_dir)
    if [ -n "${RG_KERNEL_REFIND_CONF:-}" ]; then
        printf '%s\n' "$RG_KERNEL_REFIND_CONF"
    fi
    printf '%s\n' \
        "$bd/EFI/refind/refind.conf" \
        "$bd/efi/EFI/refind/refind.conf" \
        "/boot/efi/EFI/refind/refind.conf" \
        "/efi/EFI/refind/refind.conf"
}

detect_refind_conf() {
    local conf
    while IFS= read -r conf; do
        [ -n "$conf" ] || continue
        if [ -f "$conf" ]; then
            printf '%s\n' "$conf"
            return 0
        fi
    done < <(refind_conf_candidates)
    return 1
}

refind_command() {
    local out options
    out=${1:-/tmp/refind_linux-rg.conf}
    options=$(refind_options)
    cat >"$out" <<EOF
menuentry "Arch Linux (linux-rg)" {
    icon /EFI/refind/icons/os_linux_rg.png
    loader /vmlinuz-linux-rg
    initrd /intel-ucode.img
    initrd /initramfs-linux-rg.img
    options "$options"
}
EOF
    printf 'wrote %s\n' "$out"
    printf 'include or paste this stanza into the active rEFInd configuration after installing linux-rg packages.\n'
}

refind_status() {
    local bd conf file path state
    bd=$(boot_dir)
    printf 'boot dir: %s\n' "$bd"
    if conf=$(detect_refind_conf); then
        printf 'rEFInd config: %s\n' "$conf"
    else
        printf 'rEFInd config: missing\n'
        printf 'searched:\n'
        refind_conf_candidates | sed 's/^/  /'
    fi
    printf '\nboot images:\n'
    for file in \
        vmlinuz-linux \
        initramfs-linux.img \
        vmlinuz-linux-rg \
        initramfs-linux-rg.img \
        intel-ucode.img; do
        path="$bd/$file"
        if [ -e "$path" ]; then
            state=present
        else
            state=missing
        fi
        printf '  %-28s %s\n' "$file" "$state"
    done
    printf '\nartifacts: %s\n' "$(artifact_dir)"
    if compgen -G "$(artifact_dir)/$RG_KERNEL_PACKAGE_BASE-*.pkg.tar.*" >/dev/null; then
        printf 'package artifacts: present\n'
    else
        printf 'package artifacts: missing\n'
    fi
}

refind_install_script() {
    local out bd conf options escaped_options bd_q conf_q
    out=${1:-/tmp/rg-linux-rg-refind-install.sh}
    bd=$(boot_dir)
    conf=${RG_KERNEL_REFIND_CONF:-}
    if [ -z "$conf" ]; then
        conf=$(detect_refind_conf || true)
    fi
    if [ -z "$conf" ]; then
        conf="$bd/EFI/refind/refind.conf"
    fi
    options=$(refind_options)
    escaped_options=$(refind_options_escape "$options")
    bd_q=$(shell_quote "$bd")
    conf_q=$(shell_quote "$conf")

    cat >"$out" <<EOF
#!/usr/bin/env bash
set -euo pipefail

if [ "\$(id -u)" -ne 0 ]; then
    printf 'run as root: sudo bash %s\n' "\$0" >&2
    exit 2
fi

boot_dir=$bd_q
refind_conf=$conf_q
marker_begin="# BEGIN linux-rg managed entry"

require_file() {
    local path=\$1
    if [ ! -e "\$path" ]; then
        printf 'missing required boot file: %s\n' "\$path" >&2
        exit 1
    fi
}

require_file "\$boot_dir/vmlinuz-linux"
require_file "\$boot_dir/initramfs-linux.img"
require_file "\$boot_dir/vmlinuz-linux-rg"
require_file "\$boot_dir/initramfs-linux-rg.img"
require_file "\$boot_dir/intel-ucode.img"

if [ ! -f "\$refind_conf" ]; then
    printf 'missing rEFInd config: %s\n' "\$refind_conf" >&2
    exit 1
fi

backup="\$refind_conf.rg-linux-rg-\$(date +%Y%m%d-%H%M%S).bak"
cp -a "\$refind_conf" "\$backup"
printf 'backup: %s\n' "\$backup"

if grep -Fq "\$marker_begin" "\$refind_conf"; then
    printf 'linux-rg rEFInd entry already present in %s\n' "\$refind_conf"
    exit 0
fi

cat >>"\$refind_conf" <<'STANZA'

# BEGIN linux-rg managed entry
menuentry "Arch Linux (linux-rg)" {
    icon /EFI/refind/icons/os_linux_rg.png
    loader /vmlinuz-linux-rg
    initrd /intel-ucode.img
    initrd /initramfs-linux-rg.img
    options "$escaped_options"
}
# END linux-rg managed entry
STANZA

printf 'added linux-rg rEFInd entry to %s\n' "\$refind_conf"
printf 'stock kernel remains available via existing rEFInd entries; do not change the default until suspend/resume validation passes.\n'
EOF
    chmod 0755 "$out"
    printf 'wrote %s\n' "$out"
    printf 'run after installing linux-rg packages: sudo bash %s\n' "$out"
}

patch_report() {
    local manifest patch_sources
    if [ -n "${RG_KERNEL_SOURCE_REPO:-}" ] && [ -d "$RG_KERNEL_SOURCE_REPO" ]; then
        printf '== source repo ==\n%s\n\n' "$RG_KERNEL_SOURCE_REPO"
        printf '== carried patch files ==\n'
        find "$RG_KERNEL_SOURCE_REPO" -maxdepth 1 -type f -name '[0-9][0-9][0-9][0-9]-*.patch' \
            -printf '%f\n' | sort
        return 0
    fi
    manifest=$(managed_path "$RG_KERNEL_COMPAT_MANIFEST")
    patch_sources=$(managed_path "$RG_KERNEL_PATCH_SOURCES")
    [ -r "$manifest" ] || fail "missing compatibility manifest: $manifest"
    [ -r "$patch_sources" ] || fail "missing selected patch source manifest: $patch_sources"

    printf '== compatibility decisions ==\n'
    column -t -s $'\t' "$manifest" 2>/dev/null || cat "$manifest"
    printf '\n== selected patch sources ==\n'
    column -t -s $'\t' "$patch_sources" 2>/dev/null || cat "$patch_sources"
}

missing_commands() {
    local cmd missing=0
    for cmd in git makepkg patch sed awk find sort gpg column paste tr; do
        if ! command -v "$cmd" >/dev/null 2>&1; then
            printf '%s\n' "$cmd"
            missing=1
        fi
    done
    return "$missing"
}

missing_packages() {
    local pkg missing=0
    command -v pacman >/dev/null 2>&1 || return 0
    for pkg in $RG_KERNEL_BUILD_DEPS; do
        if ! pacman -Qi "$pkg" >/dev/null 2>&1; then
            printf '%s\n' "$pkg"
            missing=1
        fi
    done
    return "$missing"
}

missing_fallbacks() {
    local pkg missing=0
    command -v pacman >/dev/null 2>&1 || return 0
    for pkg in $RG_KERNEL_REQUIRED_FALLBACKS; do
        if ! pacman -Qi "$pkg" >/dev/null 2>&1; then
            printf '%s\n' "$pkg"
            missing=1
        fi
    done
    return "$missing"
}

missing_boot_images() {
    local pkg image missing=0 bd
    bd=$(boot_dir)
    for pkg in $RG_KERNEL_REQUIRED_FALLBACKS; do
        case "$pkg" in
            linux) image="$bd/vmlinuz-linux" ;;
            linux-lts) image="$bd/vmlinuz-linux-lts" ;;
            linux-zen) image="$bd/vmlinuz-linux-zen" ;;
            *) continue ;;
        esac
        if [ ! -e "$image" ]; then
            printf '%s\n' "$image"
            missing=1
        fi
    done
    return "$missing"
}

recommended_fallback_warnings() {
    local pkg image bd
    bd=$(boot_dir)
    command -v pacman >/dev/null 2>&1 || return 0
    for pkg in ${RG_KERNEL_RECOMMENDED_FALLBACKS:-}; do
        if ! pacman -Qi "$pkg" >/dev/null 2>&1; then
            printf 'recommended fallback package is not installed: %s\n' "$pkg"
            continue
        fi
        case "$pkg" in
            linux) image="$bd/vmlinuz-linux" ;;
            linux-lts) image="$bd/vmlinuz-linux-lts" ;;
            linux-zen) image="$bd/vmlinuz-linux-zen" ;;
            *) continue ;;
        esac
        if [ ! -e "$image" ]; then
            printf 'recommended fallback boot image is missing: %s\n' "$image"
        fi
    done
}

check_local_space() {
    local build_root avail_kib min_kib
    build_root=$(local_build_root)
    mkdir -p "$build_root"
    avail_kib=$(df -Pk "$build_root" | awk 'NR == 2 {print $4}')
    min_kib=$((RG_KERNEL_MIN_LOCAL_AVAIL_GIB * 1024 * 1024))
    if [ "$avail_kib" -lt "$min_kib" ]; then
        fail "local build root has insufficient free space: ${avail_kib} KiB available, ${RG_KERNEL_MIN_LOCAL_AVAIL_GIB} GiB required at $build_root"
    fi
}

fallback_preflight() {
    local missing_pkg missing_image
    missing_pkg=$(missing_fallbacks || true)
    missing_image=$(missing_boot_images || true)

    if [ -n "$missing_pkg" ]; then
        printf 'missing fallback packages:\n%s\n' "$missing_pkg" >&2
        printf 'install fallback packages with: sudo pacman -S --needed %s\n' \
            "$RG_KERNEL_REQUIRED_FALLBACKS" >&2
    fi
    if [ -n "$missing_image" ]; then
        printf 'missing fallback boot images:\n%s\n' "$missing_image" >&2
    fi
    if [ -n "$missing_pkg$missing_image" ]; then
        return 1
    fi
    recommended_fallback_warnings >&2
}

local_preflight() {
    local missing_cmd missing_pkg
    missing_cmd=$(missing_commands || true)
    missing_pkg=$(missing_packages || true)

    check_local_space
    fallback_preflight

    if [ -n "$missing_cmd" ]; then
        printf 'missing build commands:\n%s\n' "$missing_cmd" >&2
    fi
    if [ -n "$missing_pkg" ]; then
        printf 'missing build packages:\n%s\n' "$missing_pkg" >&2
        deps_command >&2
    fi
    if [ -n "$missing_cmd$missing_pkg" ]; then
        return 1
    fi

    [ -r "$(managed_path "$RG_KERNEL_CONFIG_FRAGMENT")" ] \
        || fail "missing host config fragment: $(managed_path "$RG_KERNEL_CONFIG_FRAGMENT")"
    if [ -n "${RG_KERNEL_SOURCE_REPO:-}" ]; then
        [ -d "$RG_KERNEL_SOURCE_REPO/.git" ] \
            || fail "source repo is not a git checkout: $RG_KERNEL_SOURCE_REPO"
        [ -r "$RG_KERNEL_SOURCE_REPO/PKGBUILD" ] \
            || fail "source repo has no PKGBUILD: $RG_KERNEL_SOURCE_REPO"
        [ -r "$RG_KERNEL_SOURCE_REPO/.SRCINFO" ] \
            || fail "source repo has no .SRCINFO: $RG_KERNEL_SOURCE_REPO"
        [ -r "$RG_KERNEL_SOURCE_REPO/0021-mm-bulk-free-hotpaths.patch" ] \
            || fail "source repo does not include the finalized 0021 patch queue"
        if [ -n "$(git -C "$RG_KERNEL_SOURCE_REPO" status --porcelain)" ]; then
            fail "source repo has uncommitted changes: $RG_KERNEL_SOURCE_REPO"
        fi
        printf 'local kernel build preflight ok\n'
        return 0
    fi
    [ -r "$(managed_path "$RG_KERNEL_COMPAT_MANIFEST")" ] \
        || fail "missing compatibility manifest: $(managed_path "$RG_KERNEL_COMPAT_MANIFEST")"
    [ -r "$(managed_path "$RG_KERNEL_PATCH_SOURCES")" ] \
        || fail "missing selected patch source manifest: $(managed_path "$RG_KERNEL_PATCH_SOURCES")"

    printf 'local kernel build preflight ok\n'
}

copy_source_pkgbuild() {
    local src build stale_parent stale
    src=$RG_KERNEL_SOURCE_REPO
    build=$(build_dir)
    [ -r "$src/PKGBUILD" ] || fail "source PKGBUILD not found at $src"

    if [ -e "$build" ]; then
        stale_parent="$(dirname "$build")/old"
        stale="$stale_parent/$(basename "$build").$(date +%Y%m%d-%H%M%S)"
        mkdir -p "$stale_parent" || fail "could not create stale package directory: $stale_parent"
        mv "$build" "$stale" || fail "could not move stale package build to $stale"
    fi
    mkdir -p "$build" || fail "could not create package build directory: $build"
    git -C "$src" archive --format=tar HEAD | tar -xf - -C "$build" \
        || fail "could not copy source package from $src to $build"
    printf '%s\n' "$build"
}

default_branch_for() {
    local repo=$1
    git -C "$repo" remote show origin | awk '/HEAD branch/ {print $NF}'
}

clone_or_update_base() {
    local build_root src_root repo_dir branch
    build_root=$(local_build_root)
    src_root="$build_root/src"
    repo_dir="$src_root/arch-linux-pkg"
    mkdir -p "$src_root"

    if [ ! -d "$repo_dir/.git" ]; then
        git clone "$RG_KERNEL_BASE_REPO" "$repo_dir"
    fi

    git -C "$repo_dir" remote set-url origin "$RG_KERNEL_BASE_REPO"
    branch=$(default_branch_for "$repo_dir")
    [ -n "$branch" ] || fail "could not determine default branch for $RG_KERNEL_BASE_REPO"
    git -C "$repo_dir" fetch origin "$branch" --tags
    git -C "$repo_dir" reset --hard "origin/$branch"
    git -C "$repo_dir" clean -fdx
    printf '%s\n' "$repo_dir"
}

copy_base_pkgbuild() {
    local repo_dir src build stale_parent stale
    repo_dir=$1
    build=$(build_dir)
    if [ -n "${RG_KERNEL_BASE_SUBDIR:-}" ]; then
        src="$repo_dir/$RG_KERNEL_BASE_SUBDIR"
    else
        src="$repo_dir"
    fi
    [ -r "$src/PKGBUILD" ] || fail "base PKGBUILD not found at $src"

    if [ -e "$build" ]; then
        stale_parent="$(dirname "$build")/old"
        stale="$stale_parent/$(basename "$build").$(date +%Y%m%d-%H%M%S)"
        mkdir -p "$stale_parent" || fail "could not create stale package directory: $stale_parent"
        mv "$build" "$stale" || fail "could not move stale package build to $stale"
    fi
    mkdir -p "$build" || fail "could not create package build directory: $build"
    (
        cd "$src"
        tar -cf - .
    ) | (
        cd "$build"
        tar -xf -
    ) || fail "could not copy base package from $src to $build"
    printf '%s\n' "$build"
}

append_source_skip() {
    local pkgbuild=$1
    local item=$2
    local arrays=()
    mapfile -t arrays < <(
        awk -F= '/^(sha256sums|b2sums|sha512sums)=\(/ {print $1}' "$pkgbuild" | sort -u
    )
    [ "${#arrays[@]}" -gt 0 ] || fail "could not find checksum arrays in $pkgbuild"
    {
        printf '\nsource+=("%s")\n' "$item"
        local sum_array
        for sum_array in "${arrays[@]}"; do
            printf '%s+=("SKIP")\n' "$sum_array"
        done
    } >>"$pkgbuild"
}

rewrite_kernel_pkgbuild_identity() {
    local dir pkgbuild
    dir=$1
    pkgbuild="$dir/PKGBUILD"
    sed -i -E "s/^pkgbase=.*/pkgbase=$RG_KERNEL_PACKAGE_BASE/" "$pkgbuild"
    sed -i -E "s/^pkgdesc=.*/pkgdesc='Linux kernel for rgx1gen11 ThinkPad X1 Carbon Gen 11'/" "$pkgbuild"
}

drop_docs_package() {
    local dir pkgbuild
    dir=$1
    pkgbuild="$dir/PKGBUILD"
    [ "${RG_KERNEL_SKIP_DOCS:-no}" = yes ] || return 0
    sed -i -E '/^[[:space:]]*# htmldocs$/d' "$pkgbuild"
    sed -i -E '/^[[:space:]]*(graphviz|imagemagick|python-sphinx|python-yaml|texlive-latexextra)$/d' "$pkgbuild"
    sed -i -E '/^[[:space:]]*make htmldocs /d' "$pkgbuild"
    # shellcheck disable=SC2016
    sed -i -E '/^[[:space:]]*"\$pkgbase-docs"$/d' "$pkgbuild"
}

apply_patch_sources() {
    local dir pkgbuild manifest status name source _reason
    dir=$1
    pkgbuild="$dir/PKGBUILD"
    manifest=$(managed_path "$RG_KERNEL_PATCH_SOURCES")
    [ -r "$manifest" ] || fail "missing selected patch source manifest: $manifest"

    while IFS=$'\t' read -r status name source _reason; do
        case "$status" in
            selected) ;;
            ""|\#*|status) continue ;;
            *) continue ;;
        esac
        [ -n "$name" ] || fail "selected patch row has no name in $manifest"
        [ -n "$source" ] || fail "selected patch row has no source in $manifest"
        case "$source" in
            http://*|https://*)
                append_source_skip "$pkgbuild" "$name::$source"
                ;;
            *)
                fail "selected patch source must be an http(s) URL: $source"
                ;;
        esac
    done <"$manifest"
}

apply_local_patch_series() {
    local dir pkgbuild series patch rel
    dir=$1
    pkgbuild="$dir/PKGBUILD"
    series="$(managed_path "$RG_KERNEL_PATCH_ROOT")/series"
    [ -r "$series" ] || return 0

    while IFS= read -r rel; do
        case "$rel" in
            ""|\#*) continue ;;
        esac
        patch="$(managed_path "$RG_KERNEL_PATCH_ROOT")/$rel"
        [ -r "$patch" ] || fail "listed patch is missing: $patch"
        cp "$patch" "$dir/$(basename "$patch")"
        append_source_skip "$pkgbuild" "$(basename "$patch")"
    done <"$series"
}

apply_config_fragment() {
    local dir pkgbuild fragment_name tmp fragment_path
    dir=$1
    pkgbuild="$dir/PKGBUILD"
    fragment_path=$(managed_path "$RG_KERNEL_CONFIG_FRAGMENT")
    fragment_name=$(basename "$fragment_path")
    cp "$fragment_path" "$dir/$fragment_name"
    append_source_skip "$pkgbuild" "$fragment_name"

    tmp="$pkgbuild.rg"
    awk '
        {
            print
            if (index($0, "cp ../config.$CARCH .config") && !done) {
                print "  echo \"Applying linux-rg host config fragment...\""
                print "  while IFS= read -r rg_cfg; do"
                print "    case \"$rg_cfg\" in \"\"|\\#*) continue ;; esac"
                print "    if [[ \"$rg_cfg\" =~ ^CONFIG_([A-Za-z0-9_]+)=(y|m)$ ]]; then"
                print "      if [[ \"${BASH_REMATCH[2]}\" == y ]]; then"
                print "        scripts/config --enable \"${BASH_REMATCH[1]}\""
                print "      else"
                print "        scripts/config --module \"${BASH_REMATCH[1]}\""
                print "      fi"
                print "    elif [[ \"$rg_cfg\" =~ ^\\#\\ CONFIG_([A-Za-z0-9_]+)\\ is\\ not\\ set$ ]]; then"
                print "      scripts/config --disable \"${BASH_REMATCH[1]}\""
                print "    elif [[ \"$rg_cfg\" =~ ^CONFIG_([A-Za-z0-9_]+)=\\\"(.*)\\\"$ ]]; then"
                print "      scripts/config --set-str \"${BASH_REMATCH[1]}\" \"${BASH_REMATCH[2]}\""
                print "    elif [[ \"$rg_cfg\" =~ ^CONFIG_([A-Za-z0-9_]+)=([0-9]+)$ ]]; then"
                print "      scripts/config --set-val \"${BASH_REMATCH[1]}\" \"${BASH_REMATCH[2]}\""
                print "    else"
                print "      echo \"unsupported linux-rg config line: $rg_cfg\" >&2"
                print "      exit 1"
                print "    fi"
                print "  done < ../" fragment
                done=1
            }
        }
    ' fragment="$fragment_name" "$pkgbuild" >"$tmp"
    mv -f "$tmp" "$pkgbuild"
}

prepare_pkgbuild() {
    local repo_dir dir
    check_local_space
    if [ -n "${RG_KERNEL_SOURCE_REPO:-}" ]; then
        dir=$(copy_source_pkgbuild)
    else
        repo_dir=$(clone_or_update_base)
        dir=$(copy_base_pkgbuild "$repo_dir")
        rewrite_kernel_pkgbuild_identity "$dir"
        drop_docs_package "$dir"
        apply_patch_sources "$dir"
        apply_local_patch_series "$dir"
        apply_config_fragment "$dir"
    fi
    printf 'prepared %s at %s\n' "$RG_KERNEL_PACKAGE_BASE" "$dir"
    grep -E '^(pkgbase|pkgname|pkgver|pkgrel)=' "$dir/PKGBUILD" | head -n 8
}

import_validpgpkeys() {
    local keys=()
    local filtered_keys=()
    local key server

    mapfile -t keys < <(
        bash -c 'source PKGBUILD; printf "%s\n" "${validpgpkeys[@]-}"'
    )
    for key in "${keys[@]}"; do
        [ -n "$key" ] && filtered_keys+=("$key")
    done
    keys=("${filtered_keys[@]}")
    [ "${#keys[@]}" -gt 0 ] || return 0

    for server in hkps://keyserver.ubuntu.com hkps://keys.openpgp.org; do
        if gpg --batch --keyserver "$server" --recv-keys "${keys[@]}"; then
            return 0
        fi
    done
    fail "could not import PKGBUILD signing keys: ${keys[*]}"
}

build_kernel() {
    local dir artifact_dir jobs makepkg_conf

    local_preflight
    prepare_pkgbuild >/dev/null

    dir=$(build_dir)
    artifact_dir=$(artifact_dir)
    jobs=$(bounded_jobs)
    makepkg_conf=$(makepkg_config)
    mkdir -p "$artifact_dir" "$(local_build_root)/srcdest"

    (
        cd "$dir"
        import_validpgpkeys
        MAKEFLAGS="-j$jobs ${MAKEFLAGS:-}" \
            CMAKE_BUILD_PARALLEL_LEVEL="$jobs" \
            NINJAFLAGS="-j$jobs" \
            PKGDEST="$artifact_dir" \
            SRCDEST="$(local_build_root)/srcdest" \
            makepkg --config "$makepkg_conf" --syncdeps --noconfirm --cleanbuild --clean --force --log
    )

    printf 'artifacts written to %s\n' "$artifact_dir"
    if install_preflight >/dev/null 2>&1; then
        printf 'install after install preflight: '
    else
        printf 'install preflight is not green; inspect with: rg-kernel-build install-preflight\n'
        printf 'install command after fixing preflight: '
    fi
    install_command_text
}

artifact_preflight() {
    local dir base
    dir=$(artifact_dir)
    base=$RG_KERNEL_PACKAGE_BASE
    compgen -G "$dir/$base-*.pkg.tar.*" >/dev/null \
        || fail "missing $base kernel artifact in $dir"
    compgen -G "$dir/$base-headers-*.pkg.tar.*" >/dev/null \
        || fail "missing $base headers artifact in $dir"
    printf 'artifact preflight ok\n'
}

dkms_packages() {
    command -v pacman >/dev/null 2>&1 || return 0
    pacman -Qq 2>/dev/null | awk '/-dkms$/'
}

dkms_preflight() {
    local packages
    packages=$(dkms_packages || true)
    if [ -z "$packages" ]; then
        printf 'dkms preflight ok (no dkms packages installed)\n'
        return 0
    fi

    command -v dkms >/dev/null 2>&1 \
        || fail "DKMS packages are installed but the dkms command is missing"
    compgen -G "$(artifact_dir)/$RG_KERNEL_PACKAGE_BASE-headers-*.pkg.tar.*" >/dev/null \
        || fail "DKMS packages need the matching $RG_KERNEL_PACKAGE_BASE headers artifact"
    printf 'dkms preflight ok\n'
}

initramfs_preflight() {
    if command -v mkinitcpio >/dev/null 2>&1; then
        printf 'initramfs preflight ok (mkinitcpio)\n'
        return 0
    fi
    if command -v dracut >/dev/null 2>&1; then
        printf 'initramfs preflight ok (dracut present; verify hooks after install)\n'
        return 0
    fi
    fail "no initramfs generator found (expected mkinitcpio or dracut)"
}

install_preflight() {
    fallback_preflight
    artifact_preflight
    initramfs_preflight
    dkms_preflight
}

install_command_text() {
    local installer
    installer=${RG_KERNEL_INSTALLER:-"$RG_KERNEL_SOURCE_REPO/scripts/rgx1gen11-reinstall-check-root"}
    [ -x "$installer" ] || fail "missing linux-rg reinstall helper: $installer"
    printf 'sudo %s --artifact-dir %s\n' \
        "$(shell_quote "$installer")" \
        "$(shell_quote "$(artifact_dir)")"
}

print_install_command() {
    install_preflight >/dev/null
    install_command_text
}

cmd=${1:-list}
case "$cmd" in
    list)
        list_policy
        ;;
    jobs)
        bounded_jobs
        ;;
    deps-command)
        deps_command
        ;;
    oomd-command)
        oomd_command
        ;;
    refind-command)
        refind_command "${2:-}"
        ;;
    refind-status)
        refind_status
        ;;
    refind-install-script)
        refind_install_script "${2:-}"
        ;;
    patch-report)
        patch_report
        ;;
    preflight)
        local_preflight
        ;;
    update)
        prepare_pkgbuild
        ;;
    prepare)
        prepare_pkgbuild
        ;;
    build)
        build_kernel
        ;;
    package-base)
        package_base
        ;;
    install-preflight)
        install_preflight
        ;;
    install-command)
        print_install_command
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        usage >&2
        fail "unknown command '$cmd'"
        ;;
esac
