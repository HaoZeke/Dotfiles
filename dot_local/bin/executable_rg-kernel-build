#!/usr/bin/env bash
# Managed by chezmoi (dot_local/bin/executable_rg-kernel-build).

set -euo pipefail

policy_file=${RG_KERNEL_POLICY:-"$HOME/.config/rg-kernel/build-lanes.env"}
if [ ! -r "$policy_file" ]; then
    source_dir=${CHEZMOI_SOURCE_DIR:-"$HOME/.local/share/chezmoi"}
    source_policy="$source_dir/dot_config/rg-kernel/build-lanes.env"
    if [ -r "$source_policy" ]; then
        policy_file=$source_policy
    fi
fi

if [ ! -r "$policy_file" ]; then
    printf 'rg-kernel-build: missing policy file: %s\n' "$policy_file" >&2
    exit 1
fi

# shellcheck source=/dev/null
source "$policy_file"

fail() {
    printf 'rg-kernel-build: %s\n' "$*" >&2
    exit 1
}

usage() {
    cat <<'MSG'
usage:
  rg-kernel-build list
  rg-kernel-build preflight
  rg-kernel-build remote-preflight
  rg-kernel-build package-base [lane]
  rg-kernel-build prepare [lane]
  rg-kernel-build build [lane]
  rg-kernel-build build-all
  rg-kernel-build install-preflight [lane]
  rg-kernel-build install-command [lane]

Build lanes are defined in ~/.config/rg-kernel/build-lanes.env.
MSG
}

lane_key() {
    printf '%s' "$1" | tr -- '-.' '__'
}

lane_base_url() {
    local lane=$1
    local key var
    key=$(lane_key "$lane")
    var="RG_KERNEL_BASE_${key}"
    printf '%s' "${!var:-}"
}

lane_makepkg_env() {
    local lane=$1
    local key var
    key=$(lane_key "$lane")
    var="RG_KERNEL_MAKEPKG_ENV_${key}"
    printf '%s' "${!var:-}"
}

lane_subdir() {
    local lane=$1
    local key var
    key=$(lane_key "$lane")
    var="RG_KERNEL_SUBDIR_${key}"
    printf '%s' "${!var:-}"
}

is_kernel_lane() {
    local wanted=$1
    local lane
    for lane in ${RG_KERNEL_KERNEL_LANES:-}; do
        if [ "$lane" = "$wanted" ]; then
            return 0
        fi
    done
    return 1
}

lane_package_base() {
    local lane=$1
    if is_kernel_lane "$lane"; then
        printf '%s-%s\n' "$RG_KERNEL_PACKAGE_PREFIX" "$lane"
    fi
}

validate_lane() {
    local wanted=${1:-}
    local lane
    for lane in $RG_KERNEL_LANES; do
        if [ "$lane" = "$wanted" ]; then
            return 0
        fi
    done
    fail "unknown lane '$wanted' (known: $RG_KERNEL_LANES)"
}

refuse_local_build() {
    local short_host
    short_host=$(hostname -s 2>/dev/null || hostname)
    case "$RG_KERNEL_REMOTE" in
        ""|localhost|127.0.0.1|"$short_host")
            fail "refusing local kernel build; set RG_KERNEL_REMOTE=rg.cosmolab"
            ;;
    esac
}

list_lanes() {
    local lane base marker
    printf 'remote: %s\n' "$RG_KERNEL_REMOTE"
    printf 'artifacts: %s\n' "$RG_KERNEL_ARTIFACT_DIR"
    printf 'recommended laptop lane: %s\n\n' "$RG_KERNEL_RECOMMENDED_LAPTOP_LANE"
    for lane in $RG_KERNEL_LANES; do
        marker=' '
        if [ "$lane" = "$RG_KERNEL_RECOMMENDED_LAPTOP_LANE" ]; then
            marker='*'
        fi
        base=$(lane_base_url "$lane")
        printf '%s %s -> %s\n' "$marker" "$lane" "$base"
    done
}

missing_fallbacks() {
    local pkg missing=0
    if ! command -v pacman >/dev/null 2>&1; then
        return 0
    fi
    for pkg in $RG_KERNEL_REQUIRED_FALLBACKS; do
        if ! pacman -Qi "$pkg" >/dev/null 2>&1; then
            printf '%s\n' "$pkg"
            missing=1
        fi
    done
    return "$missing"
}

missing_boot_images() {
    local pkg image missing=0
    for pkg in $RG_KERNEL_REQUIRED_FALLBACKS; do
        case "$pkg" in
            linux) image=/boot/vmlinuz-linux ;;
            linux-lts) image=/boot/vmlinuz-linux-lts ;;
            linux-zen) image=/boot/vmlinuz-linux-zen ;;
            *) continue ;;
        esac
        if [ ! -e "$image" ]; then
            printf '%s\n' "$image"
            missing=1
        fi
    done
    return "$missing"
}

recommended_fallback_warnings() {
    local pkg image
    if ! command -v pacman >/dev/null 2>&1; then
        return 0
    fi
    for pkg in ${RG_KERNEL_RECOMMENDED_FALLBACKS:-}; do
        if ! pacman -Qi "$pkg" >/dev/null 2>&1; then
            printf 'recommended fallback package is not installed: %s\n' "$pkg"
            continue
        fi
        case "$pkg" in
            linux) image=/boot/vmlinuz-linux ;;
            linux-lts) image=/boot/vmlinuz-linux-lts ;;
            linux-zen) image=/boot/vmlinuz-linux-zen ;;
            *) continue ;;
        esac
        if [ ! -e "$image" ]; then
            printf 'recommended fallback boot image is missing: %s\n' "$image"
        fi
    done
}

preflight() {
    local missing_pkg missing_image
    missing_pkg=$(missing_fallbacks || true)
    missing_image=$(missing_boot_images || true)

    if [ -n "$missing_pkg" ]; then
        printf 'missing fallback packages:\n%s\n' "$missing_pkg" >&2
        printf 'install fallback packages with: sudo pacman -S --needed %s\n' \
            "$RG_KERNEL_REQUIRED_FALLBACKS" >&2
    fi
    if [ -n "$missing_image" ]; then
        printf 'missing fallback boot images:\n%s\n' "$missing_image" >&2
    fi
    if [ -n "$missing_pkg$missing_image" ]; then
        return 1
    fi
    recommended_fallback_warnings >&2
    printf 'fallback kernel preflight ok\n'
}

artifact_preflight() {
    local lane=${1:-$RG_KERNEL_RECOMMENDED_LAPTOP_LANE}
    local package_base lane_artifacts

    validate_lane "$lane"
    lane_artifacts="$RG_KERNEL_ARTIFACT_DIR/$lane"
    package_base=$(lane_package_base "$lane")

    if ! compgen -G "$lane_artifacts/*.pkg.tar.zst" >/dev/null; then
        fail "no package artifacts found at $lane_artifacts"
    fi

    if [ -n "$package_base" ]; then
        if ! compgen -G "$lane_artifacts/$package_base-*.pkg.tar.zst" >/dev/null; then
            fail "missing kernel artifact for $package_base in $lane_artifacts"
        fi
        if ! compgen -G "$lane_artifacts/$package_base-headers-*.pkg.tar.zst" >/dev/null; then
            fail "missing headers artifact for $package_base in $lane_artifacts"
        fi
    fi

    printf 'artifact preflight ok\n'
}

dkms_packages() {
    command -v pacman >/dev/null 2>&1 || return 0
    pacman -Qq 2>/dev/null | awk '/-dkms$/'
}

dkms_preflight() {
    local lane=${1:-$RG_KERNEL_RECOMMENDED_LAPTOP_LANE}
    local package_base lane_artifacts packages

    validate_lane "$lane"
    package_base=$(lane_package_base "$lane")
    lane_artifacts="$RG_KERNEL_ARTIFACT_DIR/$lane"
    packages=$(dkms_packages || true)

    if [ -z "$packages" ]; then
        printf 'dkms preflight ok (no dkms packages installed)\n'
        return 0
    fi

    command -v dkms >/dev/null 2>&1 \
        || fail "DKMS packages are installed but the dkms command is missing"

    if [ -n "$package_base" ] \
        && ! compgen -G "$lane_artifacts/$package_base-headers-*.pkg.tar.zst" >/dev/null; then
        printf 'installed DKMS packages:\n%s\n' "$packages" >&2
        fail "DKMS packages need the matching $package_base headers artifact"
    fi

    printf 'dkms preflight ok\n'
}

initramfs_preflight() {
    local lane=${1:-$RG_KERNEL_RECOMMENDED_LAPTOP_LANE}

    validate_lane "$lane"
    if ! is_kernel_lane "$lane"; then
        printf 'initramfs preflight ok (tool lane)\n'
        return 0
    fi

    if command -v mkinitcpio >/dev/null 2>&1; then
        printf 'initramfs preflight ok (mkinitcpio)\n'
        return 0
    fi
    if command -v dracut >/dev/null 2>&1; then
        printf 'initramfs preflight ok (dracut present; verify hooks after install)\n'
        return 0
    fi

    fail "no initramfs generator found (expected mkinitcpio or dracut)"
}

install_preflight() {
    local lane=${1:-$RG_KERNEL_RECOMMENDED_LAPTOP_LANE}

    validate_lane "$lane"
    preflight
    artifact_preflight "$lane"
    initramfs_preflight "$lane"
    dkms_preflight "$lane"
}

remote_preflight() {
    refuse_local_build
    ssh "$RG_KERNEL_REMOTE" \
        RG_KERNEL_CONTAINER_ENGINE="$RG_KERNEL_CONTAINER_ENGINE" \
        RG_KERNEL_CONTAINER_IMAGE="$RG_KERNEL_CONTAINER_IMAGE" \
        RG_KERNEL_REMOTE_ROOT="$RG_KERNEL_REMOTE_ROOT" \
        RG_KERNEL_MIN_REMOTE_AVAIL_GIB="$RG_KERNEL_MIN_REMOTE_AVAIL_GIB" \
        bash -s <<'REMOTE'
set -euo pipefail

case "$RG_KERNEL_REMOTE_ROOT" in
    /*) ;;
    *) RG_KERNEL_REMOTE_ROOT="$HOME/$RG_KERNEL_REMOTE_ROOT" ;;
esac

check_remote_space() {
    local avail_kib min_kib
    mkdir -p "$RG_KERNEL_REMOTE_ROOT"
    avail_kib=$(df -Pk "$RG_KERNEL_REMOTE_ROOT" | awk 'NR == 2 {print $4}')
    min_kib=$((RG_KERNEL_MIN_REMOTE_AVAIL_GIB * 1024 * 1024))
    if [ "$avail_kib" -lt "$min_kib" ]; then
        printf 'remote build root has insufficient free space: %s KiB available, %s GiB required at %s\n' \
            "$avail_kib" "$RG_KERNEL_MIN_REMOTE_AVAIL_GIB" "$RG_KERNEL_REMOTE_ROOT" >&2
        return 1
    fi
}

select_container_engine() {
    case "${RG_KERNEL_CONTAINER_ENGINE:-auto}" in
        auto)
            for candidate in docker podman; do
                if command -v "$candidate" >/dev/null 2>&1 \
                    && "$candidate" info >/dev/null 2>&1; then
                    printf '%s\n' "$candidate"
                    return 0
                fi
            done
            ;;
        docker|podman)
            if command -v "$RG_KERNEL_CONTAINER_ENGINE" >/dev/null 2>&1 \
                && "$RG_KERNEL_CONTAINER_ENGINE" info >/dev/null 2>&1; then
                printf '%s\n' "$RG_KERNEL_CONTAINER_ENGINE"
                return 0
            fi
            ;;
    esac
    return 1
}

missing=0
for cmd in bash git rsync sed find awk; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
        printf 'missing remote command: %s\n' "$cmd" >&2
        missing=1
    fi
done

if [ "$missing" -ne 0 ]; then
    exit 1
fi

check_remote_space

if command -v makepkg >/dev/null 2>&1; then
    if ! command -v sudo >/dev/null 2>&1; then
        printf 'missing remote command: sudo\n' >&2
        exit 1
    fi
    if ! sudo -n true >/dev/null 2>&1; then
        cat >&2 <<'MSG'
remote sudo is not noninteractive; native makepkg --syncdeps may fail if build
dependencies are missing. Install dependencies on the remote or allow
noninteractive sudo for pacman dependency installation.
MSG
    fi
    printf 'remote kernel build preflight ok (native makepkg)\n'
    exit 0
fi

engine=$(select_container_engine) || {
    cat >&2 <<'MSG'
remote makepkg is missing and no usable Docker/Podman engine is available.
MSG
    exit 1
}

printf 'remote kernel build preflight ok (container: %s, image: %s)\n' \
    "$engine" "$RG_KERNEL_CONTAINER_IMAGE"
REMOTE
}

sync_patch_queue() {
    local lane=$1
    local local_patch_dir="$RG_KERNEL_PATCH_ROOT/$lane"
    local remote_patch_dir="$RG_KERNEL_REMOTE_ROOT/patches/$lane"

    ssh "$RG_KERNEL_REMOTE" "mkdir -p '$remote_patch_dir'"
    if [ -d "$local_patch_dir" ]; then
        rsync -az "$local_patch_dir/" "$RG_KERNEL_REMOTE:$remote_patch_dir/"
    fi
}

remote_prepare() {
    local lane=$1
    local base_url=$2
    local package_base=$3
    local subdir=$4

    ssh "$RG_KERNEL_REMOTE" \
        RG_KERNEL_LANE="$lane" \
        RG_KERNEL_BASE_URL="$base_url" \
        RG_KERNEL_PACKAGE_BASE="$package_base" \
        RG_KERNEL_SUBDIR="$subdir" \
        RG_KERNEL_REMOTE_ROOT="$RG_KERNEL_REMOTE_ROOT" \
        RG_KERNEL_MIN_REMOTE_AVAIL_GIB="$RG_KERNEL_MIN_REMOTE_AVAIL_GIB" \
        bash -s <<'REMOTE'
set -euo pipefail

fail() {
    printf 'remote rg-kernel-build: %s\n' "$*" >&2
    exit 1
}

case "$RG_KERNEL_REMOTE_ROOT" in
    /*) ;;
    *) RG_KERNEL_REMOTE_ROOT="$HOME/$RG_KERNEL_REMOTE_ROOT" ;;
esac

check_remote_space() {
    local avail_kib min_kib
    mkdir -p "$RG_KERNEL_REMOTE_ROOT"
    avail_kib=$(df -Pk "$RG_KERNEL_REMOTE_ROOT" | awk 'NR == 2 {print $4}')
    min_kib=$((RG_KERNEL_MIN_REMOTE_AVAIL_GIB * 1024 * 1024))
    if [ "$avail_kib" -lt "$min_kib" ]; then
        printf 'remote build root has insufficient free space: %s KiB available, %s GiB required at %s\n' \
            "$avail_kib" "$RG_KERNEL_MIN_REMOTE_AVAIL_GIB" "$RG_KERNEL_REMOTE_ROOT" >&2
        return 1
    fi
}

command -v git >/dev/null 2>&1 || fail "git is not installed"
check_remote_space

src_root="$RG_KERNEL_REMOTE_ROOT/src"
lane_dir="$src_root/$RG_KERNEL_LANE"
build_dir="$lane_dir"
patch_dir="$RG_KERNEL_REMOTE_ROOT/patches/$RG_KERNEL_LANE"

mkdir -p "$src_root" "$patch_dir"

if [ ! -d "$lane_dir/.git" ]; then
    git clone "$RG_KERNEL_BASE_URL" "$lane_dir"
fi

default_branch=$(git -C "$lane_dir" remote show origin | awk '/HEAD branch/ {print $NF}')
if [ -z "$default_branch" ]; then
    fail "could not determine default branch for $RG_KERNEL_BASE_URL"
fi

git -C "$lane_dir" fetch origin "$default_branch" --tags
git -C "$lane_dir" reset --hard "origin/$default_branch"
git -C "$lane_dir" clean -fdx

while IFS= read -r patch; do
    [ -n "$patch" ] || continue
    git -C "$lane_dir" am "$patch"
done < <(find "$patch_dir" -maxdepth 1 -type f -name '*.patch' | sort)

if [ -n "$RG_KERNEL_SUBDIR" ]; then
    build_dir="$lane_dir/$RG_KERNEL_SUBDIR"
fi

if [ ! -r "$build_dir/PKGBUILD" ]; then
    fail "$RG_KERNEL_LANE has no PKGBUILD at $build_dir"
fi

if [ -n "$RG_KERNEL_PACKAGE_BASE" ]; then
    grep -qE '^pkgbase=' "$build_dir/PKGBUILD" \
        || fail "$RG_KERNEL_LANE PKGBUILD has no pkgbase assignment"
    sed -i -E "s|^pkgbase=.*|pkgbase=$RG_KERNEL_PACKAGE_BASE|" "$build_dir/PKGBUILD"
    grep -qE "^pkgbase=$RG_KERNEL_PACKAGE_BASE$" "$build_dir/PKGBUILD" \
        || fail "$RG_KERNEL_LANE package-base rewrite failed"
fi

printf 'prepared %s at %s\n' "$RG_KERNEL_LANE" "$build_dir"
grep -E '^(pkgbase|pkgname)=' "$build_dir/PKGBUILD" | head -n 4
REMOTE
}

prepare_lane() {
    local lane=${1:-$RG_KERNEL_RECOMMENDED_LAPTOP_LANE}
    local base_url package_base subdir

    validate_lane "$lane"
    refuse_local_build
    base_url=$(lane_base_url "$lane")
    [ -n "$base_url" ] || fail "lane '$lane' has no base repository"
    package_base=$(lane_package_base "$lane")
    subdir=$(lane_subdir "$lane")

    sync_patch_queue "$lane"
    remote_prepare "$lane" "$base_url" "$package_base" "$subdir"
}

remote_build() {
    local lane=$1
    local base_url=$2
    local package_base=$3
    local makepkg_env=$4
    local subdir=$5

    ssh "$RG_KERNEL_REMOTE" \
        RG_KERNEL_LANE="$lane" \
        RG_KERNEL_BASE_URL="$base_url" \
        RG_KERNEL_PACKAGE_BASE="$package_base" \
        RG_KERNEL_MAKEPKG_ENV="$makepkg_env" \
        RG_KERNEL_SUBDIR="$subdir" \
        RG_KERNEL_CONTAINER_ENGINE="$RG_KERNEL_CONTAINER_ENGINE" \
        RG_KERNEL_CONTAINER_IMAGE="$RG_KERNEL_CONTAINER_IMAGE" \
        RG_KERNEL_REMOTE_ROOT="$RG_KERNEL_REMOTE_ROOT" \
        RG_KERNEL_MIN_REMOTE_AVAIL_GIB="$RG_KERNEL_MIN_REMOTE_AVAIL_GIB" \
        bash -s <<'REMOTE'
set -euo pipefail

fail() {
    printf 'remote rg-kernel-build: %s\n' "$*" >&2
    exit 1
}

case "$RG_KERNEL_REMOTE_ROOT" in
    /*) ;;
    *) RG_KERNEL_REMOTE_ROOT="$HOME/$RG_KERNEL_REMOTE_ROOT" ;;
esac

check_remote_space() {
    local avail_kib min_kib
    mkdir -p "$RG_KERNEL_REMOTE_ROOT"
    avail_kib=$(df -Pk "$RG_KERNEL_REMOTE_ROOT" | awk 'NR == 2 {print $4}')
    min_kib=$((RG_KERNEL_MIN_REMOTE_AVAIL_GIB * 1024 * 1024))
    if [ "$avail_kib" -lt "$min_kib" ]; then
        printf 'remote build root has insufficient free space: %s KiB available, %s GiB required at %s\n' \
            "$avail_kib" "$RG_KERNEL_MIN_REMOTE_AVAIL_GIB" "$RG_KERNEL_REMOTE_ROOT" >&2
        return 1
    fi
}

select_container_engine() {
    case "${RG_KERNEL_CONTAINER_ENGINE:-auto}" in
        auto)
            for candidate in docker podman; do
                if command -v "$candidate" >/dev/null 2>&1 \
                    && "$candidate" info >/dev/null 2>&1; then
                    printf '%s\n' "$candidate"
                    return 0
                fi
            done
            ;;
        docker|podman)
            if command -v "$RG_KERNEL_CONTAINER_ENGINE" >/dev/null 2>&1 \
                && "$RG_KERNEL_CONTAINER_ENGINE" info >/dev/null 2>&1; then
                printf '%s\n' "$RG_KERNEL_CONTAINER_ENGINE"
                return 0
            fi
            ;;
        "")
            ;;
        *)
            fail "unknown container engine '$RG_KERNEL_CONTAINER_ENGINE'"
            ;;
    esac
    return 1
}

command -v git >/dev/null 2>&1 || fail "git is not installed"
check_remote_space
if ! command -v makepkg >/dev/null 2>&1; then
    select_container_engine >/dev/null \
        || fail "makepkg is not installed and no usable container engine was found"
fi

src_root="$RG_KERNEL_REMOTE_ROOT/src"
pkg_root="$RG_KERNEL_REMOTE_ROOT/pkg"
lane_dir="$src_root/$RG_KERNEL_LANE"
build_dir="$lane_dir"
pkg_dir="$pkg_root/$RG_KERNEL_LANE"
patch_dir="$RG_KERNEL_REMOTE_ROOT/patches/$RG_KERNEL_LANE"

mkdir -p "$src_root" "$pkg_dir" "$patch_dir"

if [ ! -d "$lane_dir/.git" ]; then
    git clone "$RG_KERNEL_BASE_URL" "$lane_dir"
fi

default_branch=$(git -C "$lane_dir" remote show origin | awk '/HEAD branch/ {print $NF}')
if [ -z "$default_branch" ]; then
    fail "could not determine default branch for $RG_KERNEL_BASE_URL"
fi

git -C "$lane_dir" fetch origin "$default_branch" --tags
git -C "$lane_dir" reset --hard "origin/$default_branch"
git -C "$lane_dir" clean -fdx

while IFS= read -r patch; do
    [ -n "$patch" ] || continue
    git -C "$lane_dir" am "$patch"
done < <(find "$patch_dir" -maxdepth 1 -type f -name '*.patch' | sort)

if [ -n "$RG_KERNEL_SUBDIR" ]; then
    build_dir="$lane_dir/$RG_KERNEL_SUBDIR"
fi

if [ ! -r "$build_dir/PKGBUILD" ]; then
    fail "$RG_KERNEL_LANE has no PKGBUILD at $build_dir"
fi

rewrite_kernel_pkgbase() {
    [ -n "$RG_KERNEL_PACKAGE_BASE" ] || return 0
    grep -qE '^pkgbase=' "$build_dir/PKGBUILD" \
        || fail "$RG_KERNEL_LANE PKGBUILD has no pkgbase assignment"
    sed -i -E "s|^pkgbase=.*|pkgbase=$RG_KERNEL_PACKAGE_BASE|" "$build_dir/PKGBUILD"
    grep -qE "^pkgbase=$RG_KERNEL_PACKAGE_BASE$" "$build_dir/PKGBUILD" \
        || fail "$RG_KERNEL_LANE package-base rewrite failed"
}

rewrite_kernel_pkgbase
find "$pkg_dir" -maxdepth 1 -type f -name '*.pkg.tar.*' -delete

run_makepkg_command() {
    if [ -n "$RG_KERNEL_MAKEPKG_ENV" ]; then
        read -r -a makepkg_env_args <<< "$RG_KERNEL_MAKEPKG_ENV"
        env "${makepkg_env_args[@]}" \
            makepkg --syncdeps --noconfirm --cleanbuild --clean --log
    else
        makepkg --syncdeps --noconfirm --cleanbuild --clean --log
    fi
}

import_validpgpkeys() {
    local keys=()
    local filtered_keys=()
    local key
    local server

    # shellcheck source=/dev/null
    mapfile -t keys < <(
        bash -c 'source PKGBUILD; printf "%s\n" "${validpgpkeys[@]-}"'
    )
    for key in "${keys[@]}"; do
        [ -n "$key" ] && filtered_keys+=("$key")
    done
    keys=("${filtered_keys[@]}")
    [ "${#keys[@]}" -gt 0 ] || return 0

    for server in hkps://keyserver.ubuntu.com hkps://keys.openpgp.org; do
        if gpg --batch --keyserver "$server" --recv-keys "${keys[@]}"; then
            return 0
        fi
    done
    fail "could not import PKGBUILD signing keys: ${keys[*]}"
}

run_native_makepkg() {
    (
        cd "$build_dir"
        import_validpgpkeys
        run_makepkg_command
    )
}

run_container_makepkg() {
    local engine uid gid
    engine=$(select_container_engine) \
        || fail "makepkg is not installed and no usable container engine was found"
    uid=$(id -u)
    gid=$(id -g)

    "$engine" run --rm \
        -e "HOST_UID=$uid" \
        -e "HOST_GID=$gid" \
        -e "RG_KERNEL_REMOTE_ROOT=$RG_KERNEL_REMOTE_ROOT" \
        -e "RG_KERNEL_LANE=$RG_KERNEL_LANE" \
        -e "RG_KERNEL_MAKEPKG_ENV=$RG_KERNEL_MAKEPKG_ENV" \
        -v "$RG_KERNEL_REMOTE_ROOT:$RG_KERNEL_REMOTE_ROOT" \
        -w "$build_dir" \
        "$RG_KERNEL_CONTAINER_IMAGE" \
        bash -lc '
set -euo pipefail

pacman -Syu --needed --noconfirm sudo git rsync gnupg base-devel

if ! getent group "$HOST_GID" >/dev/null 2>&1; then
    groupadd -g "$HOST_GID" builder
fi
group_name=$(getent group "$HOST_GID" | cut -d: -f1)

if ! id -u builder >/dev/null 2>&1; then
    useradd -m -u "$HOST_UID" -g "$group_name" builder
fi

printf "builder ALL=(ALL) NOPASSWD: ALL\n" >/etc/sudoers.d/builder
chmod 0440 /etc/sudoers.d/builder
chown -R "$HOST_UID:$HOST_GID" "$RG_KERNEL_REMOTE_ROOT"

import_validpgpkeys() {
    local keys=()
    local filtered_keys=()
    local key
    local server

    mapfile -t keys < <(
        sudo -u builder -H bash -c \
            '"'"'source PKGBUILD; printf "%s\n" "${validpgpkeys[@]-}"'"'"'
    )
    for key in "${keys[@]}"; do
        [ -n "$key" ] && filtered_keys+=("$key")
    done
    keys=("${filtered_keys[@]}")
    [ "${#keys[@]}" -gt 0 ] || return 0

    for server in hkps://keyserver.ubuntu.com hkps://keys.openpgp.org; do
        if sudo -u builder -H gpg --batch --keyserver "$server" \
            --recv-keys "${keys[@]}"; then
            return 0
        fi
    done
    printf "could not import PKGBUILD signing keys: %s\n" "${keys[*]}" >&2
    return 1
}

import_validpgpkeys

if [ -n "$RG_KERNEL_MAKEPKG_ENV" ]; then
    read -r -a makepkg_env_args <<< "$RG_KERNEL_MAKEPKG_ENV"
    sudo -u builder -H env "${makepkg_env_args[@]}" \
        makepkg --syncdeps --noconfirm --cleanbuild --clean --log
else
    sudo -u builder -H makepkg --syncdeps --noconfirm --cleanbuild --clean --log
fi
'
}

if command -v makepkg >/dev/null 2>&1; then
    run_native_makepkg
else
    run_container_makepkg
fi

find "$build_dir" -maxdepth 1 -type f -name '*.pkg.tar.*' -exec cp -f {} "$pkg_dir/" \;
find "$pkg_dir" -maxdepth 1 -type f -name '*.pkg.tar.*' -print
REMOTE
}

print_install_command() {
    local lane=${1:-$RG_KERNEL_RECOMMENDED_LAPTOP_LANE}
    validate_lane "$lane"
    install_preflight "$lane" >/dev/null
    install_command_text "$lane"
}

install_command_text() {
    local lane=${1:-$RG_KERNEL_RECOMMENDED_LAPTOP_LANE}
    local lane_artifacts="$RG_KERNEL_ARTIFACT_DIR/$lane"
    printf 'sudo pacman -U %s/*.pkg.tar.zst\n' "$lane_artifacts"
}

build_lane() {
    local lane=${1:-$RG_KERNEL_RECOMMENDED_LAPTOP_LANE}
    local base_url package_base makepkg_env subdir

    validate_lane "$lane"
    refuse_local_build
    base_url=$(lane_base_url "$lane")
    [ -n "$base_url" ] || fail "lane '$lane' has no base repository"
    package_base=$(lane_package_base "$lane")
    makepkg_env=$(lane_makepkg_env "$lane")
    subdir=$(lane_subdir "$lane")

    mkdir -p "$RG_KERNEL_ARTIFACT_DIR/$lane"
    sync_patch_queue "$lane"
    remote_build "$lane" "$base_url" "$package_base" "$makepkg_env" "$subdir"
    rsync -az "$RG_KERNEL_REMOTE:$RG_KERNEL_REMOTE_ROOT/pkg/$lane/" \
        "$RG_KERNEL_ARTIFACT_DIR/$lane/"
    printf '\nartifacts fetched to %s/%s\n' "$RG_KERNEL_ARTIFACT_DIR" "$lane"
    if install_preflight "$lane" >/dev/null 2>&1; then
        printf 'install after install preflight: '
    else
        printf 'install preflight is not green; inspect with: rg-kernel-build install-preflight %s\n' "$lane"
        printf 'install command after fixing preflight: '
    fi
    install_command_text "$lane"
}

cmd=${1:-list}
case "$cmd" in
    list)
        list_lanes
        ;;
    preflight)
        preflight
        ;;
    remote-preflight)
        remote_preflight
        ;;
    package-base)
        validate_lane "${2:-$RG_KERNEL_RECOMMENDED_LAPTOP_LANE}"
        lane_package_base "${2:-$RG_KERNEL_RECOMMENDED_LAPTOP_LANE}"
        ;;
    prepare)
        prepare_lane "${2:-$RG_KERNEL_RECOMMENDED_LAPTOP_LANE}"
        ;;
    build)
        build_lane "${2:-$RG_KERNEL_RECOMMENDED_LAPTOP_LANE}"
        ;;
    build-all)
        for lane in $RG_KERNEL_LANES; do
            build_lane "$lane"
        done
        ;;
    install-preflight)
        install_preflight "${2:-$RG_KERNEL_RECOMMENDED_LAPTOP_LANE}"
        ;;
    install-command)
        print_install_command "${2:-$RG_KERNEL_RECOMMENDED_LAPTOP_LANE}"
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        usage >&2
        fail "unknown command '$cmd'"
        ;;
esac
