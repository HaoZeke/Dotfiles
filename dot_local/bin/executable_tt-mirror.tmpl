{{- if eq .chezmoi.hostname "rgam5terra" -}}
#!/usr/bin/env bash
# Mirror the Tardigrade native store from B2 into a local directory on this
# host. Copy, never sync: a deletion on the remote must not reach the mirror.
# The read-only prefix key lives in a 0600 file. pass is only the seed for
# that file, and only while the agent cache is warm.
set -euo pipefail
cred=${TT_MIRROR_CRED:-$HOME/.config/ttech/mirror-ro}
if [ ! -f "$cred" ]; then
    if ! entry=$(timeout 15 pass show turtletech/backblaze/tardigrade-mirror-ro </dev/null 2>/dev/null); then
        printf '%(%F %T)T tt-mirror: mirror key file absent and key store locked; skipped until the next slot\n' -1 >&2
        exit 75
    fi
    mkdir -p -- "$(dirname -- "$cred")"
    umask 077
    printf '%s\n' "$entry" >"$cred"
    chmod 600 "$cred"
    unset entry
fi
key=$(sed -n '1p' "$cred")
kid=$(awk '/^key_id:/{print $2; exit}' "$cred")
bucket=$(awk '/^bucket:/{print $2; exit}' "$cred")
prefix=$(awk '/^prefix:/{print $2; exit}' "$cred")
dest=${TT_MIRROR_DIR:-$HOME/Backups/tardigrade/${prefix%/}}
export RCLONE_CONFIG_TTMIRROR_TYPE=b2 RCLONE_CONFIG_TTMIRROR_ACCOUNT="$kid" RCLONE_CONFIG_TTMIRROR_KEY="$key"
mkdir -p "$dest"
printf '%(%F %T)T tt-mirror: %s/%s -> %s\n' -1 "$bucket" "$prefix" "$dest"
rclone copy --transfers 8 --checkers 8 --stats 5m --stats-one-line "ttmirror:$bucket/${prefix%/}/tardigrade" "$dest/tardigrade"
printf '%(%F %T)T tt-mirror: done, %s objects\n' -1 "$(find "$dest/tardigrade" -type f | wc -l)"
{{- end -}}
