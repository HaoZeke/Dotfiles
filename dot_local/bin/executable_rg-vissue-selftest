#!/usr/bin/env bash
# Managed by chezmoi (dot_local/bin/executable_rg-vissue-selftest).

set -euo pipefail

SCRIPT="${1:-}"
if [ -z "$SCRIPT" ]; then
    here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
    if [ -r "$here/executable_vissue" ]; then
        SCRIPT="$here/executable_vissue"
    else
        SCRIPT="$here/vissue"
    fi
fi

fail() {
    printf 'FAIL: %s\n' "$*" >&2
    exit 1
}

test -r "$SCRIPT" || fail "missing $SCRIPT"

tmp_home=$(mktemp -d)
trap 'rm -rf "$tmp_home"' EXIT

fake_bin="$tmp_home/bin"
fake_vault="$tmp_home/notes-vault"
mkdir -p "$fake_bin" "$fake_vault" "$tmp_home/.config/vissue"

cat > "$fake_bin/vissue-cli" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail
printf 'ROOT=%s ARG=%s\n' "${VISSUE_ROOT:-}" "$*" > "$RG_VISSUE_ARG_LOG"
EOF
chmod +x "$fake_bin/vissue-cli"
printf '%s\n' "$fake_vault" > "$tmp_home/.config/vissue/root"

arg_log="$tmp_home/args"
HOME="$tmp_home" \
    XDG_CONFIG_HOME="$tmp_home/.config" \
    PATH="$fake_bin:$PATH" \
    VISSUE_BIN="$fake_bin/vissue-cli" \
    RG_VISSUE_ARG_LOG="$arg_log" \
    "$SCRIPT" list

expected="ROOT=$fake_vault ARG=list"
actual=$(cat "$arg_log")
[ "$actual" = "$expected" ] || fail "expected '$expected', got '$actual'"

printf 'ok\n'
