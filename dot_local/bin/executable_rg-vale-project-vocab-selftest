#!/usr/bin/env bash
# Managed by chezmoi (dot_local/bin/executable_rg-vale-project-vocab-selftest).

set -euo pipefail

repo=${1:-"$HOME/.local/share/chezmoi"}
script=${2:-"$repo/dot_local/bin/executable_rg-vale-project-vocab"}

fail() {
    printf 'FAIL: %s\n' "$*" >&2
    exit 1
}

test -x "$script" || fail "missing executable helper: $script"
test -r "$HOME/.config/vale/.vale.ini" || fail "missing live Vale config"
test -d "$HOME/.config/vale/styles" || fail "missing live Vale styles"

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

project="$tmp/metatensor-docs"
project_vocab=metatensor-docs
mkdir -p "$project"
printf 'Use LDX here. Run ldd on the binary.\n' > "$project/test.md"

RG_VALE_GLOBAL_CONFIG="$HOME/.config/vale/.vale.ini" \
RG_VALE_STYLES_PATH="$HOME/.config/vale/styles" \
    "$script" --root "$project" accept LDX ldd

test -r "$project/.vale.ini" || fail "project .vale.ini was not created"
test -r "$project/styles/config/vocabularies/$project_vocab/accept.txt" \
    || fail "project accept vocabulary was not created"
test -r "$project/styles/config/vocabularies/$project_vocab/reject.txt" \
    || fail "project reject vocabulary was not created"

rg -q '^StylesPath = '"$HOME"'/\.config/vale/styles$' "$project/.vale.ini" \
    || fail "project config does not point at managed global styles"
rg -q '^Vocab = RG, '"$project_vocab"'$' "$project/.vale.ini" \
    || fail "project config does not enable RG plus project-named vocabulary"
rg -q '^Google\.Acronyms = NO$' "$project/.vale.ini" \
    || fail "project config did not preserve global rule toggles"
rg -q '^LDX$' "$project/styles/config/vocabularies/$project_vocab/accept.txt" \
    || fail "LDX was not added to project accept vocabulary"
rg -q '^ldd$' "$project/styles/config/vocabularies/$project_vocab/accept.txt" \
    || fail "ldd was not added to project accept vocabulary"

project_out="$tmp/project-vale.out"
if ! vale --config="$project/.vale.ini" "$project/test.md" >"$project_out" 2>&1; then
    cat "$project_out" >&2
    fail "project Vale config should accept project vocabulary"
fi

global_out="$tmp/global-vale.out"
if vale --config="$HOME/.config/vale/.vale.ini" "$project/test.md" >"$global_out" 2>&1; then
    cat "$global_out" >&2
    fail "global Vale config should still reject project-only vocabulary"
fi
rg -q 'rgoswami\.Acronyms' "$global_out" \
    || fail "global Vale failure was not the acronym rule"

legacy_project="$tmp/legacy-system-notes"
legacy_vocab=legacy-system-notes
mkdir -p "$legacy_project/styles/config/vocabularies/Project"
printf 'LDY\n' > "$legacy_project/styles/config/vocabularies/Project/accept.txt"
printf 'Use LDY here. Use LDZ here.\n' > "$legacy_project/test.md"
awk -v styles="$HOME/.config/vale/styles" '
    /^StylesPath[[:space:]]*=/ {
        print "StylesPath = " styles
        next
    }
    /^Vocab[[:space:]]*=/ {
        print "Vocab = RG, Project"
        next
    }
    { print }
' "$HOME/.config/vale/.vale.ini" > "$legacy_project/.vale.ini"

RG_VALE_GLOBAL_CONFIG="$HOME/.config/vale/.vale.ini" \
RG_VALE_STYLES_PATH="$HOME/.config/vale/styles" \
    "$script" --root "$legacy_project" accept LDZ

rg -q '^Vocab = RG, '"$legacy_vocab"'$' "$legacy_project/.vale.ini" \
    || fail "legacy config was not migrated to project-named vocabulary"
! rg -q '^Vocab = .*Project' "$legacy_project/.vale.ini" \
    || fail "legacy Project vocabulary remains enabled"
rg -q '^LDY$' "$legacy_project/styles/config/vocabularies/$legacy_vocab/accept.txt" \
    || fail "legacy Project accept terms were not copied"
rg -q '^LDZ$' "$legacy_project/styles/config/vocabularies/$legacy_vocab/accept.txt" \
    || fail "new legacy-project term was not added"

legacy_out="$tmp/legacy-vale.out"
if ! vale --config="$legacy_project/.vale.ini" "$legacy_project/test.md" >"$legacy_out" 2>&1; then
    cat "$legacy_out" >&2
    fail "migrated project Vale config should accept copied and new vocabulary"
fi

printf 'ok\n'
