#!/usr/bin/env bash
# Run the official Starfleet local port-forward helper from a local cache.

set -euo pipefail

STARFLEET_FORWARD_URL="${RG_STARFLEET_FORWARD_URL:-https://starfleet.teachx.ai/scripts/local_port_forward.py}"
PYTHON_BIN="${RG_STARFLEET_PYTHON:-python3}"
CURL_BIN="${RG_STARFLEET_CURL:-curl}"
HEALTH_URL="${RG_STARFLEET_FORWARD_HEALTH_URL:-http://127.0.0.1:58234/health}"
HEALTH_PORT="${RG_STARFLEET_FORWARD_PORT:-58234}"

data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
cache_path="${RG_STARFLEET_FORWARD_CACHE:-$data_home/rg-starfleet/local_port_forward.py}"
refresh=0
replace=0

usage() {
    cat <<'USAGE'
usage: rg-starfleet-port-forward [--refresh] [--print-cache-path] [--] [ARGS...]

Runs the official Starfleet local_port_forward.py from a local cache.

Options:
  --refresh           Re-fetch the official helper before running.
  --print-cache-path  Print the cached helper path and exit.
  -h, --help          Show this help.
USAGE
}

while [ $# -gt 0 ]; do
    case "$1" in
        --refresh)
            refresh=1
            shift
            ;;
        --replace)
            replace=1
            break
            ;;
        --print-cache-path)
            printf '%s\n' "$cache_path"
            exit 0
            ;;
        -h | --help)
            usage
            exit 0
            ;;
        --)
            shift
            break
            ;;
        *)
            break
            ;;
    esac
done

if [ "$refresh" -eq 0 ] && [ "$replace" -eq 0 ] && [ "$#" -eq 0 ]; then
    if "$CURL_BIN" -fsS "$HEALTH_URL" -o /dev/null >/dev/null 2>&1; then
        printf 'Serving on port %s (already running)\n' "$HEALTH_PORT"
        exit 0
    fi
fi

cache_dir="$(dirname -- "$cache_path")"
mkdir -p "$cache_dir"

if [ "$refresh" -eq 1 ] || [ ! -s "$cache_path" ]; then
    tmp="$(mktemp "$cache_dir/.local_port_forward.py.XXXXXX")"
    cleanup() {
        rm -f "$tmp"
    }
    trap cleanup EXIT HUP INT TERM

    case "$STARFLEET_FORWARD_URL" in
        /*)
            cp "$STARFLEET_FORWARD_URL" "$tmp"
            ;;
        file://*)
            cp "${STARFLEET_FORWARD_URL#file://}" "$tmp"
            ;;
        *)
            "$CURL_BIN" -fsSL "$STARFLEET_FORWARD_URL" -o "$tmp"
            ;;
    esac

    chmod 0755 "$tmp"
    mv -f "$tmp" "$cache_path"
    trap - EXIT HUP INT TERM
fi

exec "$PYTHON_BIN" "$cache_path" "$@"
