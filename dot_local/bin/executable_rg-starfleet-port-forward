#!/usr/bin/env python3
"""Starfleet local control and port-forward helper."""

from __future__ import annotations

import http.client
import http.server
import json
import os
import socket
import socketserver
import ssl
import subprocess
import sys
import threading
import time
import urllib.parse
import urllib.request

PORT = int(os.environ.get("RG_STARFLEET_FORWARD_PORT", "58234"))
STREAM_CHUNK_SIZE = 4096
WS_RELAY_BUF = 8192
ALLOWED_ORIGINS = {
    "http://localhost:3000",
    "https://starfleet.teachx.ai",
}

active_forwards: dict[int, dict] = {}
_CLIENT_GONE = (BrokenPipeError, ConnectionResetError, ConnectionAbortedError)


def _json_response(handler: http.server.BaseHTTPRequestHandler, status: int, data: dict) -> None:
    try:
        handler.send_response(status)
        handler.send_header("Content-Type", "application/json")
        set_cors_headers(handler)
        handler.end_headers()
        handler.wfile.write(json.dumps(data).encode())
    except _CLIENT_GONE:
        pass


def set_cors_headers(handler: http.server.BaseHTTPRequestHandler) -> None:
    origin = handler.headers.get("Origin", "")
    if origin in ALLOWED_ORIGINS:
        handler.send_header("Access-Control-Allow-Origin", origin)
        handler.send_header("Access-Control-Allow-Methods", "GET, POST, PUT, DELETE, PATCH, HEAD, OPTIONS")
        handler.send_header("Access-Control-Allow-Headers", "Content-Type, x-starfleet-proxy-port")
        handler.send_header("Access-Control-Allow-Private-Network", "true")


def read_body(handler: http.server.BaseHTTPRequestHandler) -> bytes | None:
    if "Content-Length" in handler.headers:
        return handler.rfile.read(int(handler.headers["Content-Length"]))
    if handler.headers.get("Transfer-Encoding", "").lower() != "chunked":
        return None

    chunks = []
    while True:
        size_line = handler.rfile.readline().strip()
        chunk_size = int(size_line, 16)
        if chunk_size == 0:
            handler.rfile.readline()
            break
        chunks.append(handler.rfile.read(chunk_size))
        handler.rfile.readline()
    return b"".join(chunks)


def is_websocket_upgrade(handler: http.server.BaseHTTPRequestHandler) -> bool:
    upgrade = handler.headers.get("Upgrade", "").lower()
    connection = handler.headers.get("Connection", "").lower()
    return upgrade == "websocket" and "upgrade" in connection


def relay_sockets(
    sock_a: socket.socket,
    sock_b: socket.socket,
    initial_a_to_b: bytes = b"",
    initial_b_to_a: bytes = b"",
) -> None:
    closed = threading.Event()

    def forward(src: socket.socket, dst: socket.socket, initial: bytes) -> None:
        try:
            if initial:
                dst.sendall(initial)
            while not closed.is_set():
                data = src.recv(WS_RELAY_BUF)
                if not data:
                    break
                dst.sendall(data)
        except Exception:
            pass
        finally:
            closed.set()
            for sock in (sock_a, sock_b):
                try:
                    sock.shutdown(socket.SHUT_RDWR)
                except Exception:
                    pass

    left = threading.Thread(target=forward, args=(sock_a, sock_b, initial_a_to_b), daemon=True)
    right = threading.Thread(target=forward, args=(sock_b, sock_a, initial_b_to_a), daemon=True)
    left.start()
    right.start()
    left.join()
    right.join()
    for sock in (sock_a, sock_b):
        try:
            sock.close()
        except Exception:
            pass


def proxy_url_parts(proxy_url: str) -> tuple[str, int, bool]:
    parsed = urllib.parse.urlparse(proxy_url)
    host = parsed.hostname or "localhost"
    port = parsed.port or (443 if parsed.scheme == "https" else 80)
    return host, port, parsed.scheme == "https"


def handle_websocket_via_hades(
    handler: http.server.BaseHTTPRequestHandler,
    proxy_url: str,
    target_port: int,
) -> None:
    host, port, use_tls = proxy_url_parts(proxy_url)
    handler.close_connection = True

    upstream: socket.socket = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    try:
        upstream.connect((host, port))
        if use_tls:
            upstream = ssl.create_default_context().wrap_socket(upstream, server_hostname=host)
    except OSError as exc:
        try:
            handler.send_response(502)
            handler.end_headers()
            handler.wfile.write(f"Cannot connect to Hades proxy: {exc}\n".encode())
        except _CLIENT_GONE:
            pass
        return

    request_line = f"{handler.command} {handler.path} HTTP/1.1\r\n"
    header_lines = f"Host: {host}:{port}\r\n"
    header_lines += f"x-starfleet-proxy-port: {target_port}\r\n"
    for key, value in handler.headers.items():
        if key.lower() != "host":
            header_lines += f"{key}: {value}\r\n"
    upstream.sendall((request_line + header_lines + "\r\n").encode())

    buf = b""
    while b"\r\n\r\n" not in buf:
        chunk = upstream.recv(4096)
        if not chunk:
            break
        buf += chunk
    header_end = buf.find(b"\r\n\r\n")
    if header_end >= 0:
        headers_part = buf[: header_end + 4]
        leftover = buf[header_end + 4 :]
    else:
        headers_part = buf
        leftover = b""

    try:
        handler.wfile.write(headers_part)
        handler.wfile.flush()
    except _CLIENT_GONE:
        upstream.close()
        return

    relay_sockets(handler.request, upstream, initial_b_to_a=leftover)


def proxy_via_hades(
    handler: http.server.BaseHTTPRequestHandler,
    proxy_url: str,
    target_port: int,
) -> None:
    if is_websocket_upgrade(handler):
        handle_websocket_via_hades(handler, proxy_url, target_port)
        return

    host, port, use_tls = proxy_url_parts(proxy_url)
    body = read_body(handler)

    try:
        if use_tls:
            conn: http.client.HTTPConnection = http.client.HTTPSConnection(
                host,
                port,
                timeout=30,
                context=ssl.create_default_context(),
            )
        else:
            conn = http.client.HTTPConnection(host, port, timeout=30)

        headers = {
            "Host": f"{host}:{port}",
            "x-starfleet-proxy-port": str(target_port),
        }
        skip_headers = {"host", "transfer-encoding", "connection"}
        for key, value in handler.headers.items():
            if key.lower() not in skip_headers:
                headers[key] = value

        conn.request(handler.command, handler.path, body=body, headers=headers)
        response = conn.getresponse()
    except Exception as exc:
        try:
            handler.send_response(502)
            handler.end_headers()
            handler.wfile.write(f"Proxy error: {exc}\n".encode())
        except _CLIENT_GONE:
            pass
        return

    try:
        handler.send_response(response.status)
        for key, value in response.getheaders():
            if key.lower() not in {"transfer-encoding", "connection"}:
                handler.send_header(key, value)
        handler.end_headers()
        while True:
            chunk = response.read(STREAM_CHUNK_SIZE)
            if not chunk:
                break
            handler.wfile.write(chunk)
            handler.wfile.flush()
    except _CLIENT_GONE:
        pass
    finally:
        conn.close()


class ReusableTCPServer(socketserver.ThreadingTCPServer):
    allow_reuse_address = True
    allow_reuse_port = False
    daemon_threads = True


class BoundProxyViaHades(http.server.BaseHTTPRequestHandler):
    proxy_url: str
    target_port: int

    def log_message(self, fmt: str, *args) -> None:
        print(f"[proxy-via-hades -> :{self.target_port}] {fmt % args}", flush=True)

    def do_ANY(self) -> None:
        proxy_via_hades(self, self.proxy_url, self.target_port)

    do_GET = do_POST = do_PUT = do_DELETE = do_PATCH = do_HEAD = do_ANY


def stop_forward(info: dict) -> None:
    server = info.get("server")
    if server is not None:
        server.shutdown()
        server.server_close()


def register_forward_via_proxy(
    handler: http.server.BaseHTTPRequestHandler,
    proxy_url: str,
    local_port: int,
    target_port: int,
) -> None:
    forward_key = f"via-proxy:{proxy_url}:{local_port}:{target_port}"
    if local_port in active_forwards:
        if active_forwards[local_port].get("forward_key") == forward_key:
            _json_response(
                handler,
                200,
                {
                    "status": "ok",
                    "proxy": proxy_url,
                    "local_port": local_port,
                    "message": f"Already forwarding via proxy to localhost:{local_port}",
                },
            )
            return
        old = active_forwards.pop(local_port)
        stop_forward(old)
        print(f"[port-forward-via-proxy] Replaced old forward on port {local_port}", flush=True)

    if local_port == PORT:
        active_forwards[local_port] = {
            "host": proxy_url,
            "forward_key": forward_key,
            "inline": True,
            "target_port": target_port,
        }
        print(
            f"[port-forward-via-proxy] {proxy_url} (port {local_port}) -> localhost:{local_port} (inline)",
            flush=True,
        )
        _json_response(
            handler,
            200,
            {
                "status": "ok",
                "proxy": proxy_url,
                "local_port": local_port,
                "message": f"Forwarding via Hades proxy to localhost:{local_port}",
            },
        )
        return

    proxy_handler = type(
        "PortForwardViaHades",
        (BoundProxyViaHades,),
        {"proxy_url": proxy_url, "target_port": target_port},
    )
    try:
        proxy_server = ReusableTCPServer(("", local_port), proxy_handler)
    except OSError as exc:
        _json_response(
            handler,
            409,
            {
                "error": "port_in_use",
                "port": local_port,
                "message": f"Port {local_port} is already in use: {exc}",
            },
        )
        return

    thread = threading.Thread(target=proxy_server.serve_forever, daemon=True)
    thread.start()
    active_forwards[local_port] = {
        "host": proxy_url,
        "forward_key": forward_key,
        "target_port": target_port,
        "server": proxy_server,
        "thread": thread,
    }
    print(f"[port-forward-via-proxy] {proxy_url} (port {local_port}) -> localhost:{local_port}", flush=True)
    _json_response(
        handler,
        200,
        {
            "status": "ok",
            "proxy": proxy_url,
            "local_port": local_port,
            "message": f"Forwarding via Hades proxy to localhost:{local_port}",
        },
    )


class Handler(http.server.SimpleHTTPRequestHandler):
    def log_message(self, fmt: str, *args) -> None:
        print(f"{self.address_string()} - - {fmt % args}", flush=True)

    def do_OPTIONS(self) -> None:
        self.send_response(204)
        set_cors_headers(self)
        self.end_headers()

    def do_ANY(self) -> None:
        parsed = urllib.parse.urlparse(self.path)

        if parsed.path == "/health":
            _json_response(self, 200, {"status": "ok"})
            return

        if parsed.path == "/container-ports":
            params = urllib.parse.parse_qs(parsed.query)
            proxy_url = params.get("proxy", [None])[0]
            if not proxy_url:
                _json_response(self, 400, {"error": "Missing ?proxy=<hades-proxy-url>"})
                return
            try:
                request = urllib.request.Request(
                    proxy_url.rstrip("/") + "/starfleet/list-ports",
                    headers={"User-Agent": "starfleet-local-proxy/1.0"},
                )
                with urllib.request.urlopen(request, context=ssl.create_default_context(), timeout=5) as response:
                    data = json.loads(response.read())
                _json_response(self, 200, data)
            except Exception as exc:
                _json_response(self, 502, {"error": str(exc), "ports": []})
            return

        if parsed.path == "/port-forward-via-proxy":
            params = urllib.parse.parse_qs(parsed.query)
            proxy_url = params.get("proxy", [None])[0]
            port = params.get("port", [None])[0]
            if not proxy_url or not port:
                _json_response(self, 400, {"error": "Missing ?proxy=<url>&port=<port>"})
                return
            try:
                local_port = int(port)
                target_port = int(params.get("target_port", [port])[0])
            except ValueError:
                _json_response(self, 400, {"error": "port must be an integer"})
                return
            register_forward_via_proxy(self, proxy_url, local_port, target_port)
            return

        if parsed.path == "/port-forward/stop":
            params = urllib.parse.parse_qs(parsed.query)
            port = params.get("port", [None])[0]
            if not port:
                _json_response(self, 400, {"error": "Missing ?port=<port>"})
                return
            local_port = int(port)
            if local_port not in active_forwards:
                _json_response(self, 404, {"error": f"No active forward on port {local_port}"})
                return
            stop_forward(active_forwards[local_port])
            del active_forwards[local_port]
            print(f"[port-forward] Stopped forward on port {local_port}", flush=True)
            _json_response(self, 200, {"status": "stopped", "port": local_port})
            return

        if parsed.path == "/port-forward/list":
            forwards = {str(port): info["host"] for port, info in active_forwards.items()}
            _json_response(self, 200, {"forwards": forwards})
            return

        inline_forward = active_forwards.get(PORT)
        if inline_forward and inline_forward.get("inline"):
            proxy_via_hades(self, inline_forward["host"], inline_forward["target_port"])
            return

        try:
            self.send_response(200)
            self.send_header("Content-Type", "text/plain")
            set_cors_headers(self)
            self.end_headers()
            self.wfile.write(b"Hello from the server!\n")
        except _CLIENT_GONE:
            pass

    do_GET = do_POST = do_PUT = do_DELETE = do_PATCH = do_HEAD = do_ANY


def find_pids_on_port(port: int) -> list[str]:
    try:
        result = subprocess.run(
            ["lsof", "-ti", f":{port}"],
            capture_output=True,
            text=True,
            timeout=5,
        )
    except Exception:
        return []
    return [pid for pid in result.stdout.strip().splitlines() if pid and pid != str(os.getpid())]


def replace_existing_processes(port: int) -> None:
    for pid in find_pids_on_port(port):
        try:
            os.kill(int(pid), 15)
            print(f"[startup] Stopped existing process {pid} on port {port}", flush=True)
        except Exception:
            pass
    deadline = time.time() + 2
    while time.time() < deadline and find_pids_on_port(port):
        time.sleep(0.1)
    for pid in find_pids_on_port(port):
        try:
            os.kill(int(pid), 9)
            print(f"[startup] Killed existing process {pid} on port {port}", flush=True)
        except Exception:
            pass


def main(argv: list[str]) -> int:
    if "--replace" in argv:
        replace_existing_processes(PORT)

    server = ReusableTCPServer(("", PORT), Handler)
    print(f"Serving on port {PORT}", flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nShutting down...", flush=True)
    finally:
        server.server_close()
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
