#!/usr/bin/env bash
# Managed by chezmoi (dot_local/bin/executable_rg-lockscreen).
#
# Repo-owned swaylock wrapper with a stable static lockscreen:
# prefer the cat wallpaper, allow explicit live screenshots, and keep
# the visual theme in ~/.config/swaylock/config.local.
#
# --prepare-sleep is the before-sleep / before-hibernate entry point:
# it spawns swaylock in the background and blocks until the swaylock
# main loop is parked on a Wayland poll fd, then sleeps a short frame
# buffer so the lock surface is composed onto the scanout buffer
# before this script returns. Without this gate, swaylock --daemonize
# returns as soon as the keyboard grab is set up -- well before the
# image is decoded, uploaded, and committed -- and the hibernate path
# captures VRAM with the live desktop still on it, which the kernel
# faithfully restores during the resume window.

set -eu

XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
PREFERRED_IMAGE="${RG_LOCKSCREEN_IMAGE:-$HOME/Pictures/Walls/lockscreen.png}"
FALLBACK_IMAGE="$XDG_CONFIG_HOME/swaylock/lockscreen.png"
FALLBACK_COLOR="${RG_LOCKSCREEN_COLOR:-101418}"
MODE="${RG_LOCKSCREEN_MODE:-auto}"
DRY_RUN=0
PREPARE_SLEEP=0
EXTRA_ARGS=""

usage() {
    cat <<'EOF'
Usage: rg-lockscreen [wrapper-options] [-- swaylock-args...]

Wrapper options:
  --dry-run          Print the resolved swaylock command and exit.
  --screenshots      Force live screenshot mode.
  --static           Force static wallpaper mode (default).
  --color-only       Force solid-color fallback mode.
  --prepare-sleep    Lock and block until the lock surface is painted,
                     then return. For swayidle before-sleep hooks: the
                     hibernate snapshot must see VRAM holding the lock
                     image, not the desktop.
  --help             Show this help.

Any other arguments are passed through to swaylock unchanged.
EOF
}

theme_config_path() {
    local state_path="${RG_THEME_STATE:-$XDG_STATE_HOME/rg-theme/state}"
    local palette_root="${RG_THEME_PALETTE_ROOT:-$XDG_DATA_HOME/rg-theme/palettes}"
    local palette="tomorrow"
    local mode="dark"
    local key value candidate

    if [ -r "$state_path" ]; then
        while IFS='=' read -r key value; do
            case "$key" in
                palette)
                    palette="$value"
                    ;;
                mode)
                    mode="$value"
                    ;;
            esac
        done < "$state_path"
    fi

    case "$palette" in
        tomorrow|catppuccin|gruvbox) ;;
        *) palette="tomorrow" ;;
    esac
    case "$mode" in
        dark|light) ;;
        *) mode="dark" ;;
    esac

    candidate="$palette_root/$palette/$mode/swaylock.conf"
    if [ -r "$candidate" ]; then
        printf '%s\n' "$candidate"
    else
        printf '%s\n' "$XDG_CONFIG_HOME/swaylock/config.local"
    fi
}

resolve_config_path() {
    if [ -n "${RG_LOCKSCREEN_CONFIG:-}" ]; then
        printf '%s\n' "$RG_LOCKSCREEN_CONFIG"
    else
        theme_config_path
    fi
}

resolve_fallback_color() {
    local config_path="$1"
    local key value

    if [ -n "${RG_LOCKSCREEN_COLOR:-}" ]; then
        printf '%s\n' "$RG_LOCKSCREEN_COLOR"
        return
    fi

    if [ -r "$config_path" ]; then
        while IFS='=' read -r key value; do
            case "$key" in
                color)
                    if [ -n "$value" ]; then
                        printf '%s\n' "$value"
                        return
                    fi
                    ;;
            esac
        done < "$config_path"
    fi

    printf '%s\n' "$FALLBACK_COLOR"
}

add_arg() {
    if [ -z "$EXTRA_ARGS" ]; then
        EXTRA_ARGS=$(printf '%s\037' "$1")
    else
        EXTRA_ARGS="${EXTRA_ARGS}$(printf '%s\037' "$1")"
    fi
}

while [ $# -gt 0 ]; do
    case "$1" in
        --dry-run)
            DRY_RUN=1
            ;;
        --screenshots)
            MODE=screenshots
            ;;
        --static)
            MODE=static
            ;;
        --color-only)
            MODE=color
            ;;
        --prepare-sleep)
            PREPARE_SLEEP=1
            ;;
        --help)
            usage
            exit 0
            ;;
        --)
            shift
            while [ $# -gt 0 ]; do
                add_arg "$1"
                shift
            done
            break
            ;;
        *)
            add_arg "$1"
            ;;
    esac
    shift
done

BG_MODE="$MODE"
if [ "$BG_MODE" = "auto" ]; then
    BG_MODE=static
fi

CONFIG_PATH="$(resolve_config_path)"
if [ -r "$CONFIG_PATH" ]; then
    set -- swaylock -C "$CONFIG_PATH"
else
    set -- swaylock
fi

case "$BG_MODE" in
    screenshots)
        set -- "$@" --screenshots
        ;;
    static)
        IMAGE_PATH=""
        for candidate in "$PREFERRED_IMAGE" "$FALLBACK_IMAGE"; do
            if [ -r "$candidate" ]; then
                IMAGE_PATH="$candidate"
                break
            fi
        done
        if [ -n "$IMAGE_PATH" ]; then
            set -- "$@" --image "$IMAGE_PATH"
        else
            set -- "$@" --color "$(resolve_fallback_color "$CONFIG_PATH")"
        fi
        ;;
    color)
        set -- "$@" --color "$(resolve_fallback_color "$CONFIG_PATH")"
        ;;
    *)
        echo "rg-lockscreen: unsupported mode '$BG_MODE'" >&2
        exit 2
        ;;
esac

if [ -n "$EXTRA_ARGS" ]; then
    OLDIFS=$IFS
    IFS=$(printf '\037')
    # shellcheck disable=SC2086
    set -- "$@" $EXTRA_ARGS
    IFS=$OLDIFS
fi

if [ "$DRY_RUN" = "1" ]; then
    if [ "$PREPARE_SLEEP" = "1" ]; then
        # Show what swaylock would be invoked with, after stripping the
        # --daemonize / -f flags that --prepare-sleep manages itself.
        filtered_dry=()
        for a in "$@"; do
            case "$a" in
                --daemonize|-f) ;;
                *) filtered_dry+=("$a") ;;
            esac
        done
        printf 'swaymsg output \\* dpms on; '
        printf '%q ' "${filtered_dry[@]}"
        printf '& (waited for first paint)\n'
        exit 0
    fi
    printf '%q ' "$@"
    printf '\n'
    exit 0
fi

if [ "$PREPARE_SLEEP" = "1" ]; then
    # Strip --daemonize / -f: we own the fork. With --daemonize set,
    # swaylock's parent exits as soon as the keyboard grab is in place,
    # which is exactly the race --prepare-sleep is here to close.
    filtered=()
    for a in "$@"; do
        case "$a" in
            --daemonize|-f) ;;
            *) filtered+=("$a") ;;
        esac
    done
    set -- "${filtered[@]}"

    # Idle hibernate commonly starts with outputs in DPMS-off state.
    # Force a live scanout so the hibernate image captures the lock
    # surface instead of the stale frame held by the display engine.
    if command -v swaymsg >/dev/null 2>&1; then
        swaymsg "output * dpms on" >/dev/null 2>&1 || true
        sleep 0.2
    fi

    "$@" &
    swl_pid=$!
    disown "$swl_pid" 2>/dev/null || true

    # Wait for the swaylock event loop to park on a poll/epoll/select
    # syscall. /proc/<pid>/wchan reports the kernel symbol the process
    # is blocked in: anything containing poll, select, or epoll means
    # the main loop has finished initial setup and queued its first
    # frame, and is now waiting on the Wayland fd.
    deadline=$(( SECONDS + 3 ))
    while [ "$SECONDS" -lt "$deadline" ]; do
        kill -0 "$swl_pid" 2>/dev/null || break
        wchan=$(cat "/proc/$swl_pid/wchan" 2>/dev/null) || break
        case "$wchan" in
            *poll*|*select*|*epoll*) break ;;
        esac
        sleep 0.05
    done
    # Frame-pacing buffer: queuing the first frame is not the same as
    # the GPU having scanned it out. A short fixed wait covers texture
    # upload + composite + present for the lockscreen image on the
    # integrated GPU; the cycle that follows (kernel hibernate write)
    # is several seconds, so the added latency is invisible.
    sleep 0.7
    exit 0
fi

exec "$@"
