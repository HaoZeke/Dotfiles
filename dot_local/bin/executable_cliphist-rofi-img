#!/usr/bin/env bash

runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
tmp_dir="$runtime_dir/cliphist-rofi-img"
case "$tmp_dir" in
    /run/user/*/cliphist-rofi-img|/tmp/cliphist-rofi-img) ;;
    *)
        echo "cliphist-rofi-img: refusing unsafe cache path: $tmp_dir" >&2
        exit 1
        ;;
esac

if [[ -n "$1" ]]; then
    cliphist decode <<<"$1" | wl-copy
    exit
fi

install -d -m 700 "$tmp_dir"
find "$tmp_dir" -mindepth 1 -maxdepth 1 -type f -delete

read -r -d '' prog <<EOF
/^[0-9]+\s<meta http-equiv=/ { next }
match(\$0, /^([0-9]+)\s(\[\[\s)?binary.*(jpg|jpeg|png|bmp)/, grp) {
    system("echo " grp[1] "\\\\\t | cliphist decode >$tmp_dir/"grp[1]"."grp[3])
    print \$0"\0icon\x1f$tmp_dir/"grp[1]"."grp[3]
    next
}
1
EOF
cliphist list | gawk "$prog"
