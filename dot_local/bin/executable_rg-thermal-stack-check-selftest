#!/usr/bin/env bash
# Managed by chezmoi (dot_local/bin/executable_rg-thermal-stack-check-selftest).

set -euo pipefail

repo=${1:-"$HOME/.local/share/chezmoi"}
script="$repo/dot_local/bin/executable_rg-thermal-stack-check"

fail() {
    printf 'FAIL: %s\n' "$*" >&2
    exit 1
}

test -x "$script" || fail "missing thermal stack checker"

tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT
fake_root="$tmpdir/root"
fake_bin="$tmpdir/bin"

mkdir -p \
    "$fake_bin" \
    "$fake_root/etc/tlp.d" \
    "$fake_root/sys/firmware/acpi" \
    "$fake_root/sys/class/thermal/thermal_zone0" \
    "$fake_root/proc/acpi/ibm"

printf 'low-power\n' >"$fake_root/sys/firmware/acpi/platform_profile"
printf 'low-power balanced performance\n' >"$fake_root/sys/firmware/acpi/platform_profile_choices"
printf 'x86_pkg_temp\n' >"$fake_root/sys/class/thermal/thermal_zone0/type"
printf '42000\n' >"$fake_root/sys/class/thermal/thermal_zone0/temp"
printf 'temperatures:\t42 41 40\n' >"$fake_root/proc/acpi/ibm/thermal"
printf 'status:\t\tenabled\nspeed:\t\t2300\n' >"$fake_root/proc/acpi/ibm/fan"
cat >"$fake_root/etc/tlp.d/00-base.conf" <<'TLP'
CPU_SCALING_GOVERNOR_ON_AC=powersave
CPU_SCALING_GOVERNOR_ON_BAT=powersave
CPU_ENERGY_PERF_POLICY_ON_AC=power
CPU_ENERGY_PERF_POLICY_ON_BAT=power
CPU_MAX_PERF_ON_AC=70
CPU_MAX_PERF_ON_BAT=60
CPU_SCALING_MAX_FREQ_ON_AC=1200000
CPU_SCALING_MAX_FREQ_ON_BAT=1000000
CPU_BOOST_ON_AC=0
CPU_BOOST_ON_BAT=0
CPU_HWP_DYN_BOOST_ON_AC=0
CPU_HWP_DYN_BOOST_ON_BAT=0
PLATFORM_PROFILE_ON_AC=low-power
PLATFORM_PROFILE_ON_BAT=low-power
TLP

cat >"$fake_bin/systemctl" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
verb=${1:?}
unit=${2:?}
case "$verb:$unit" in
is-active:tlp.service) printf 'active\n' ;;
is-enabled:tlp.service) printf 'enabled\n' ;;
is-active:power-profiles-daemon.service) printf 'inactive\n'; exit 3 ;;
is-enabled:power-profiles-daemon.service) printf 'disabled\n'; exit 1 ;;
is-active:thermald.service) printf 'inactive\n'; exit 3 ;;
is-enabled:thermald.service) printf 'disabled\n'; exit 1 ;;
*) printf 'unexpected systemctl %s %s\n' "$verb" "$unit" >&2; exit 2 ;;
esac
SH
chmod +x "$fake_bin/systemctl"

PATH="$fake_bin:$PATH" RG_THERMAL_ROOT="$fake_root" "$script" --check \
    >"$tmpdir/ok.out" 2>&1 || {
    sed -n '1,200p' "$tmpdir/ok.out" >&2
    fail "complete thermal fixture should pass"
}
rg -q 'ok: TLP owns laptop power policy' "$tmpdir/ok.out" \
    || fail "checker must assert TLP ownership"
rg -q 'ok: thermald inactive; DPTF/platform_profile/TLP remain primary' "$tmpdir/ok.out" \
    || fail "checker must document thermald as inactive under TLP"

sed -i 's/^PLATFORM_PROFILE_ON_AC=.*/PLATFORM_PROFILE_ON_AC=balanced/' \
    "$fake_root/etc/tlp.d/00-base.conf"
if PATH="$fake_bin:$PATH" RG_THERMAL_ROOT="$fake_root" "$script" --check \
    >"$tmpdir/tlp-drift.out" 2>&1; then
    fail "TLP platform profile drift should fail"
fi
rg -q 'fail: TLP PLATFORM_PROFILE_ON_AC live=balanced expected=low-power' \
    "$tmpdir/tlp-drift.out" \
    || fail "checker must report TLP platform profile drift"
sed -i 's/^PLATFORM_PROFILE_ON_AC=.*/PLATFORM_PROFILE_ON_AC=low-power/' \
    "$fake_root/etc/tlp.d/00-base.conf"

cat >"$fake_bin/systemctl" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
verb=${1:?}
unit=${2:?}
case "$verb:$unit" in
is-active:tlp.service) printf 'active\n' ;;
is-enabled:tlp.service) printf 'enabled\n' ;;
is-active:power-profiles-daemon.service) printf 'inactive\n'; exit 3 ;;
is-enabled:power-profiles-daemon.service) printf 'disabled\n'; exit 1 ;;
is-active:thermald.service) printf 'active\n' ;;
is-enabled:thermald.service) printf 'enabled\n' ;;
*) printf 'unexpected systemctl %s %s\n' "$verb" "$unit" >&2; exit 2 ;;
esac
SH
chmod +x "$fake_bin/systemctl"

if PATH="$fake_bin:$PATH" RG_THERMAL_ROOT="$fake_root" "$script" --check \
    >"$tmpdir/conflict.out" 2>&1; then
    fail "TLP plus thermald should fail without explicit split policy"
fi
rg -q 'fail: thermald and TLP are both active' "$tmpdir/conflict.out" \
    || fail "checker must report the TLP/thermald conflict"

# enabled-but-inactive is fiction on DYTC; checker must fail closed
cat >"$fake_bin/systemctl" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
verb=${1:?}
unit=${2:?}
case "$verb:$unit" in
is-active:tlp.service) printf 'active\n' ;;
is-enabled:tlp.service) printf 'enabled\n' ;;
is-active:power-profiles-daemon.service) printf 'inactive\n'; exit 3 ;;
is-enabled:power-profiles-daemon.service) printf 'disabled\n'; exit 1 ;;
is-active:thermald.service) printf 'inactive\n'; exit 3 ;;
is-enabled:thermald.service) printf 'enabled\n' ;;
*) printf 'unexpected systemctl %s %s\n' "$verb" "$unit" >&2; exit 2 ;;
esac
SH
chmod +x "$fake_bin/systemctl"

if PATH="$fake_bin:$PATH" RG_THERMAL_ROOT="$fake_root" "$script" --check \
    >"$tmpdir/thermald-enabled.out" 2>&1; then
    fail "thermald enabled-but-inactive should fail on DYTC chassis"
fi
rg -q 'fail: thermald enabled but unsupported' "$tmpdir/thermald-enabled.out" \
    || fail "checker must reject enabled-but-dead thermald"

printf 'ok\n'
