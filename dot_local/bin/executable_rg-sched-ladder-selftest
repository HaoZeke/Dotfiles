#!/usr/bin/env bash
# Managed by chezmoi (dot_local/bin/executable_rg-sched-ladder-selftest).

set -euo pipefail

repo=${1:-"$HOME/.local/share/chezmoi"}
script="$repo/dot_local/bin/executable_rg-sched-ladder"
wrapper="$repo/dot_local/bin/executable_rg-scx-loader"
ladder="$repo/dot_config/rg-x1gen11/sched-ladder.json"
asa="$repo/dot_config/rg-x1gen11/asa-mapping.conf"

fail() {
    printf 'FAIL: %s\n' "$*" >&2
    exit 1
}

test -r "$script" || fail "missing sched-ladder"
test -r "$wrapper" || fail "missing scx-loader wrapper"
test -r "$ladder" || fail "missing sched-ladder.json"
test -r "$asa" || fail "missing asa-mapping.conf"

chmod +x "$script" 2>/dev/null || true
chmod +x "$wrapper" 2>/dev/null || true

RG_SCHED_LADDER="$ladder" "$script" list | rg '^lavd$' >/dev/null \
    || fail "ladder missing lavd"
RG_SCHED_LADDER="$ladder" "$script" list | rg '^rusty$' >/dev/null \
    || fail "ladder missing rusty"
RG_SCHED_LADDER="$ladder" "$script" list | rg '^asa$' >/dev/null \
    || fail "ladder missing asa"
RG_SCHED_LADDER="$ladder" "$script" list | rg '^off$' >/dev/null \
    || fail "ladder missing off (EEVDF+BORE baseline)"

RG_SCHED_LADDER="$ladder" "$script" describe lavd | rg 'scx_lavd' >/dev/null \
    || fail "lavd must map to scx_lavd"
RG_SCHED_LADDER="$ladder" "$script" packages | rg 'scx-tools scx-scheds' >/dev/null \
    || fail "packages must name Arch scx-tools package"
RG_SCHED_LADDER="$ladder" RG_SCHED_LADDER_BIN="$script" "$wrapper" status | rg '^off$|sched_ext current:' >/dev/null \
    || fail "scx-loader status must be inspectable without linux-rg boot"
rg -q 'switch --sched' "$script" \
    || fail "sched ladder must use current scxctl switch syntax"
rg -q 'start --sched' "$script" \
    || fail "sched ladder must start the first scx scheduler"

rg -q 'interactive=scx_lavd' "$asa" || fail "ASA mapping missing interactive expert"
rg -q 'EEVDF is mainline' "$ladder" || fail "ladder must document EEVDF as baseline not ceiling"

printf 'ok\n'
