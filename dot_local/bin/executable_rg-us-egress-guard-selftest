#!/usr/bin/env bash
# Selftest for rg-us-egress-guard: drives the guard with mocked systemctl/ip and
# asserts it restores egress when the unit is enabled and the tunnel is either
# down or up-but-not-routing, and stays quiet otherwise. No real systemd/network.
set -uo pipefail

fail() { printf 'FAIL: %s\n' "$1" >&2; exit 1; }

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
GUARD="$SCRIPT_DIR/rg-us-egress-guard"
if [ ! -f "$GUARD" ]; then
    guard_template="$SCRIPT_DIR/executable_rg-us-egress-guard.tmpl"
    [ -f "$guard_template" ] || guard_template="$SCRIPT_DIR/../bin/executable_rg-us-egress-guard.tmpl"
    [ -f "$guard_template" ] || fail "rg-us-egress-guard template not found"
    GUARD="$tmp/rg-us-egress-guard"
    printf '#!/usr/bin/env bash\n' >"$GUARD"
    awk 'emit || /^set -uo pipefail$/ { emit = 1; print }' "$guard_template" >>"$GUARD"
fi

# Mock systemctl: is-active/is-enabled honour their test markers; restart is logged.
cat >"$tmp/systemctl.sh" <<'SC'
#!/usr/bin/env bash
case "$1" in
is-active)
    case "$3" in
    rg-us-egress.service) [ "${RG_TEST_SERVICE_ACTIVE:-0}" = "1" ] && exit 0 || exit 1 ;;
    *) exit 1 ;;
    esac
    ;;
is-enabled)
    case "$3" in
    wg-quick@*) [ "${RG_TEST_WG_ENABLED:-0}" = "1" ] && exit 0 || exit 1 ;;
    rg-us-egress.service) [ "${RG_TEST_SERVICE_ENABLED:-0}" = "1" ] && exit 0 || exit 1 ;;
    *) exit 1 ;;
    esac
    ;;
restart) printf 'restart %s\n' "$2" >>"$RG_TEST_CALLS"; exit 0 ;;
*) exit 0 ;;
esac
SC
chmod +x "$tmp/systemctl.sh"

cat >"$tmp/flock.sh" <<'FLOCK'
#!/usr/bin/env bash
[ "${RG_TEST_LOCKED:-0}" = "1" ] && exit 1
exit 0
FLOCK
chmod +x "$tmp/flock.sh"

# Mock curl: quality probes return a fast 401, a slow 401, or transport
# failure. The fallback URL (pin-independent) honours RG_TEST_FALLBACK,
# defaulting to the same behaviour as the primary probe.
cat >"$tmp/curl.sh" <<'CURL'
#!/usr/bin/env bash
mode="${RG_TEST_QUALITY:-ok}"
case "$*" in
*cloudflare*) mode="${RG_TEST_FALLBACK:-$mode}" ;;
# The Control D upstreams are the uplink probe: they ride the local carve-out,
# not the tunnel, so they answer whenever the uplink itself works. Default to a
# healthy uplink so tunnel-specific cases stay tunnel-specific.
*76.76.2.22*|*76.76.10.22*) mode="${RG_TEST_UNDERLAY:-ok}" ;;
esac
case "$mode" in
ok) printf '401 0.250000 100.83.241.81\n'; exit 0 ;;
slow) printf '401 7.500000 100.83.241.81\n'; exit 0 ;;
fail) exit 28 ;;
*) exit 64 ;;
esac
CURL
chmod +x "$tmp/curl.sh"

# Mock ip: `link show` honours RG_TEST_IFACE_UP; `route get` reports the iface
# when RG_TEST_ROUTE_OK, else a different device.
cat >"$tmp/ip.sh" <<'IP'
#!/usr/bin/env bash
if [ "${1:-}" = "-4" ]; then
    shift
fi
case "${1:-} ${2:-}" in
"link show") [ "${RG_TEST_IFACE_UP:-0}" = "1" ] && exit 0 || exit 1 ;;
"route show")
    case "$*" in
    "route show default table main")
        printf 'default via 10.81.17.39 dev wlan0 proto dhcp src 10.81.17.57 metric 600\n'
        ;;
    "route show table 5151")
        printf 'default via 10.81.17.39 dev wlan0\n'
        ;;
    esac
    ;;
"route replace")
    printf '%s\n' "$*" >>"$RG_TEST_CALLS"
    ;;
"route get")
    if [ "${RG_TEST_ROUTE_OK:-0}" = "1" ]; then
        printf '1.1.1.1 dev %s src x\n' "${RG_US_EGRESS_IFACE:-rg-us-egress-wg}"
    else
        printf '1.1.1.1 dev wlan0 src x\n'
    fi
    ;;
"rule show")
    printf '5190:\tfrom all fwmark 0x5151 lookup 5151\n'
    ;;
esac
IP
chmod +x "$tmp/ip.sh"

calls="$tmp/calls"
quality_state="$tmp/quality-state"
restore_state="$tmp/restore-state"
# Deterministic carve-out health: pretend the /32 peer backstops are pinned so
# carveout_present() never depends on the host's real nft/run state.
hz_state="$tmp/hz-endpoints"
printf '203.0.113.7\n' >"$hz_state"

# run_case WG_ENABLED SERVICE_ENABLED IFACE_UP ROUTE_OK QUALITY [SERVICE_ACTIVE]
# -> echoes the restart count
run_case() {
    : >"$calls"
    RG_TEST_WG_ENABLED="$1" RG_TEST_SERVICE_ENABLED="$2" RG_TEST_IFACE_UP="$3" RG_TEST_ROUTE_OK="$4" RG_TEST_QUALITY="$5" \
        RG_TEST_SERVICE_ACTIVE="${6:-0}" \
        RG_TEST_CALLS="$calls" \
        RG_GUARD_SYSTEMCTL="$tmp/systemctl.sh" \
        RG_GUARD_IP="$tmp/ip.sh" \
        RG_GUARD_CURL="$tmp/curl.sh" \
        RG_GUARD_FLOCK="$tmp/flock.sh" \
        RG_GUARD_LOCK="$tmp/guard.lock" \
        RG_TEST_LOCKED="${RG_TEST_LOCKED:-0}" \
        RG_TEST_FALLBACK="${RG_TEST_FALLBACK:-}" \
        RG_TEST_UNDERLAY="${RG_TEST_UNDERLAY:-}" \
        RG_HZ_STATE="$hz_state" \
        RG_US_EGRESS_QUALITY_STATE="$quality_state" \
        RG_US_EGRESS_RESTORE_STATE="$restore_state" \
        RG_US_EGRESS_RESTORE_COOLDOWN="${RG_TEST_RESTORE_COOLDOWN:-0}" \
        RG_US_EGRESS_QUALITY_FAIL_THRESHOLD=2 \
        RG_US_EGRESS_QUALITY_ATTEMPTS=1 \
        RG_GUARD_LOG="true" \
        bash "$GUARD"
    grep -c '^restart wg-quick' "$calls" 2>/dev/null || true
}

n=$(run_case 0 0 0 0 fail); [ "${n:-0}" = "0" ] || fail "disabled unit must not act (got $n)"
test "$(grep -c '^route replace' "$calls" 2>/dev/null || true)" = "0" \
    || fail "disabled unit must not alter Control D routes"
n=$(run_case 1 0 1 1 ok); [ "${n:-0}" = "0" ] || fail "healthy tunnel must not restart (got $n)"
test "$(grep -c '^route replace 76\.76\.\(2\.22\|10\.22\)/32 via 10\.81\.17\.39 dev wlan0 src 10\.81\.17\.57 metric 40$' "$calls" 2>/dev/null || true)" = "2" \
    || fail "healthy tunnel must keep Control D upstreams on the local uplink"
n=$(run_case 0 1 1 1 ok); [ "${n:-0}" = "0" ] || fail "managed egress service marker must not restart a healthy tunnel (got $n)"
test "$(grep -c '^route replace 76\.76\.\(2\.22\|10\.22\)/32 via 10\.81\.17\.39 dev wlan0 src 10\.81\.17\.57 metric 40$' "$calls" 2>/dev/null || true)" = "2" \
    || fail "managed egress service marker must keep Control D upstreams on the local uplink"
n=$(run_case 0 0 1 1 ok 1); [ "${n:-0}" = "0" ] || fail "active managed service must keep a healthy tunnel guarded (got $n)"
test "$(grep -c '^route replace 76\.76\.\(2\.22\|10\.22\)/32 via 10\.81\.17\.39 dev wlan0 src 10\.81\.17\.57 metric 40$' "$calls" 2>/dev/null || true)" = "2" \
    || fail "active managed service must keep Control D upstreams on the local uplink"
RG_TEST_LOCKED=1 n=$(run_case 1 0 1 0 ok); [ "${n:-0}" = "0" ] || fail "locked guard must not restart (got $n)"
test "$(grep -c '^route replace' "$calls" 2>/dev/null || true)" = "0" \
    || fail "locked guard must not alter Control D routes"
unset RG_TEST_LOCKED
rm -f "$quality_state"
n=$(run_case 1 0 1 1 slow); [ "${n:-0}" = "0" ] || fail "slow successful x.ai probe must not restart (got $n)"
n=$(run_case 1 0 1 1 fail); [ "${n:-0}" = "0" ] || fail "first failing x.ai quality probe must not restart (got $n)"
n=$(run_case 1 0 1 1 fail); [ "${n:-0}" = "1" ] || fail "persistent failing x.ai quality probe must restart (got $n)"
rm -f "$quality_state"
# api.x.ai dark but the pin-independent fallback answers: stale hosts pin, the
# tunnel is healthy -- never restart, however often it repeats.
RG_TEST_FALLBACK=ok n=$(run_case 1 0 1 1 fail); [ "${n:-0}" = "0" ] || fail "pin-suspect probe failure must not restart (got $n)"
RG_TEST_FALLBACK=ok n=$(run_case 1 0 1 1 fail); [ "${n:-0}" = "0" ] || fail "repeated pin-suspect probe failure must not restart (got $n)"
unset RG_TEST_FALLBACK
n=$(run_case 1 0 1 1 fail); [ "${n:-0}" = "0" ] || fail "pin-suspect runs must clear the failure counter (got $n)"
rm -f "$quality_state"
n=$(run_case 1 0 1 0 ok); [ "${n:-0}" = "1" ] || fail "interface up but not routing must restart (got $n)"
n=$(run_case 1 0 0 0 ok); [ "${n:-0}" = "1" ] || fail "interface down must restart (got $n)"

# A degraded uplink is not a broken tunnel. On a weak mobile link every probe
# fails whether the tunnel is fine or not; restarting then drops a working
# tunnel and its carve-outs and makes recovery slower. Defer instead -- this is
# the thrash that made a bad connection worse than no connection.
rm -f "$quality_state" "$restore_state"
RG_TEST_UNDERLAY=fail n=$(run_case 1 0 0 0 ok)
[ "${n:-0}" = "0" ] || fail "a missing interface must not restart while the uplink is down (got $n)"
RG_TEST_UNDERLAY=fail n=$(run_case 1 0 1 0 ok)
[ "${n:-0}" = "0" ] || fail "a non-routing interface must not restart while the uplink is down (got $n)"
rm -f "$quality_state" "$restore_state"
RG_TEST_UNDERLAY=fail n=$(run_case 1 0 1 1 fail)
RG_TEST_UNDERLAY=fail n=$(run_case 1 0 1 1 fail)
[ "${n:-0}" = "0" ] || fail "quality failures must not restart while the uplink is down (got $n)"
unset RG_TEST_UNDERLAY
# Uplink back: the same condition must act again, so deferring never latches.
rm -f "$quality_state" "$restore_state"
n=$(run_case 1 0 0 0 ok); [ "${n:-0}" = "1" ] || fail "restart must resume once the uplink recovers (got $n)"

# Cooldown: one restart per window, so a flapping link cannot drive a storm.
rm -f "$quality_state" "$restore_state"
RG_TEST_RESTORE_COOLDOWN=3600 n=$(run_case 1 0 0 0 ok)
[ "${n:-0}" = "1" ] || fail "first restart in the window must proceed (got $n)"
RG_TEST_RESTORE_COOLDOWN=3600 n=$(run_case 1 0 0 0 ok)
[ "${n:-0}" = "0" ] || fail "a second restart inside the cooldown must be suppressed (got $n)"
rm -f "$restore_state"
RG_TEST_RESTORE_COOLDOWN=3600 n=$(run_case 1 0 0 0 ok)
[ "${n:-0}" = "1" ] || fail "restart must proceed once the cooldown window has passed (got $n)"
unset RG_TEST_RESTORE_COOLDOWN

printf 'ok\n'
