#!/usr/bin/env bash
{{- if ne .chezmoi.hostname "rgx1gen11" }}
echo "rg-*: refusing to run on hostname=$(hostname 2>/dev/null || echo unknown); only rgx1gen11" >&2
exit 0
{{- end }}
set -Eeuo pipefail

IP="${RG_POLICY_IP:-ip}"
NFT="${RG_POLICY_NFT:-nft}"
GETENT="${RG_POLICY_GETENT:-getent}"
PYTHON="${RG_POLICY_PYTHON:-python3}"
FLOCK="${RG_POLICY_FLOCK:-/usr/bin/flock}"
SETPRIV="${RG_POLICY_SETPRIV:-/usr/bin/setpriv}"
POLICY_LOCK_FILE="${RG_POLICY_LOCK_FILE:-/run/rg-us-egress-policy.lock}"
RTRASH="${RG_POLICY_RTRASH:-}"
if [ -z "$RTRASH" ]; then
    for candidate in /usr/local/sbin/rtrash /usr/local/bin/rtrash /usr/bin/rtrash; do
        if [ -x "$candidate" ]; then
            RTRASH="$candidate"
            break
        fi
    done
fi
if [ -z "$RTRASH" ]; then
    RTRASH="$(command -v rtrash 2>/dev/null || true)"
fi
IFACE="${RG_US_EGRESS_IFACE:-rg-us-egress-wg}"
HOUSTON_TABLE="${RG_HOUSTON_TABLE:-51820}"
PROTECTED_TABLE="${RG_PROTECTED_TABLE:-51821}"
PROTECTED_MARK="${RG_PROTECTED_MARK:-0x5252}"
TAILSCALE_MARK="${RG_XAI_TAILSCALE_MARK:-0x80000/0xff0000}"
XAI_UNDERLAY_GROUP="${RG_XAI_UNDERLAY_GROUP:-rg-xai-underlay}"
XAI_UNDERLAY_GID="${RG_XAI_UNDERLAY_GID:-}"
PROTECTED_GROUP="${RG_PROTECTED_GROUP:-rg-houston-protected}"
PROTECTED_GROUP_GID="${RG_PROTECTED_GROUP_GID:-}"
STATE_DIR="${RG_POLICY_STATE_DIR:-/var/lib/rg-us-egress-policy}"
RECOVERY_HOST_FILE="${RG_RECOVERY_HOST_FILE:-/etc/rg-us-egress-policy/recovery-hosts}"
XAI_HOSTS="${RG_XAI_PROTECTED_HOSTS:-api.x.ai grok.com auth.x.ai cli-chat-proxy.grok.com}"
NFT_TABLE="rg_houston_protected"
PREF_DEST=5188
PREF_TAILNET=5194
PREF_SURF=5195
PREF_PROCESS=5196
PREF_TS_MARK=5197
FAIL_METRIC=42760

die() {
    printf 'rg-us-egress-policy: %s\n' "$*" >&2
    exit 1
}

need_root() {
    [ "${RG_POLICY_TESTING:-0}" = 1 ] && return 0
    [ "$(id -u)" -eq 0 ] || die "run as root"
}

acquire_policy_lock() {
    need_root
    exec 9>"$POLICY_LOCK_FILE"
    "$FLOCK" -x 9
}

recovery_hosts() {
    if [ -n "${RG_RECOVERY_HOSTS:-}" ]; then
        printf '%s\n' "$RG_RECOVERY_HOSTS"
    elif [ -r "$RECOVERY_HOST_FILE" ]; then
        awk '!/^[[:space:]]*(#|$)/ {print $1}' "$RECOVERY_HOST_FILE" | tr '\n' ' '
    fi
}

state_file() {
    printf '%s/%s\n' "$STATE_DIR" "$1"
}

ensure_state_dir() {
    install -d -m 0755 "$STATE_DIR"
}

atomic_state() {
    local source="$1" name="$2" staged
    staged="$(state_file ".${name}.new")"
    LC_ALL=C sort -u "$source" >"$staged"
    chmod 0644 "$staged"
    mv -f "$staged" "$(state_file "$name")"
}

resolve_family() {
    local family="$1" hosts="$2" host answer incomplete=0
    for host in $hosts; do
        answer=""
        case "$family" in
            ahostsv4)
                if ! answer="$("$GETENT" "$family" "$host" 2>/dev/null \
                    | awk '$1 ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ {print $1}' \
                    | LC_ALL=C sort -u)"; then
                    incomplete=1
                fi
                ;;
            ahostsv6)
                if ! answer="$("$GETENT" "$family" "$host" 2>/dev/null \
                    | awk '$1 ~ /:/ {print $1}' \
                    | LC_ALL=C sort -u)"; then
                    incomplete=1
                fi
                ;;
            *) die "unsupported address family resolver: $family" ;;
        esac
        if [ -n "$answer" ]; then
            printf '%s\n' "$answer"
        else
            incomplete=1
        fi
    done
    return "$incomplete"
}

route_exclusions() {
    local flag="$1" bits="$2"
    {
        "$IP" "$flag" route show table 52 2>/dev/null \
            | awk -v bits="$bits" '$1 !~ /^(default|unreachable|blackhole|prohibit|throw)$/ {print ($1 ~ /\// ? $1 : $1 "/" bits)}'
        "$IP" "$flag" route show table main 2>/dev/null \
            | awk -v bits="$bits" '$0 ~ / dev tun0([[:space:]]|$)/ {print ($1 ~ /\// ? $1 : $1 "/" bits)}'
    } | LC_ALL=C sort -u
}

filter_family() {
    local candidates="$1" recovery="$2" excluded="$3" protected="$4" collisions="$5"
    "$PYTHON" - "$candidates" "$recovery" "$excluded" "$protected" "$collisions" <<'PY'
import ipaddress
import pathlib
import sys

candidates_path, recovery_path, excluded_path, protected_path, collisions_path = map(pathlib.Path, sys.argv[1:])

def lines(path):
    if not path.exists():
        return []
    return [line.strip() for line in path.read_text().splitlines() if line.strip()]

candidates = {ipaddress.ip_address(value) for value in lines(candidates_path)}
recovery = {ipaddress.ip_address(value) for value in lines(recovery_path)}
excluded = [ipaddress.ip_network(value, strict=False) for value in lines(excluded_path)]
collisions = sorted(candidates & recovery, key=lambda value: (value.version, int(value)))
protected = sorted(
    (value for value in candidates - recovery if not any(value in network for network in excluded)),
    key=lambda value: (value.version, int(value)),
)
protected_path.write_text("".join(f"{value}\n" for value in protected))
collisions_path.write_text("".join(f"{value}\n" for value in collisions))
PY
}

sync_family() {
    local family="$1" flag="$2" bits="$3" suffix="$4" work="$5"
    local candidates="$work/candidates-$suffix" recovery="$work/recovery-$suffix"
    local excluded="$work/excluded-$suffix" protected="$work/protected-$suffix"
    local collisions="$work/collisions-$suffix" configured_recovery
    local candidates_complete=1 recovery_complete=1 retained
    configured_recovery="$(recovery_hosts)"
    resolve_family "$family" "$XAI_HOSTS" >"$candidates" \
        || candidates_complete=0
    resolve_family "$family" "$configured_recovery" >"$recovery" \
        || recovery_complete=0
    route_exclusions "$flag" "$bits" >"$excluded"

    retained="$(state_file "recovery-$suffix")"
    if [ "$recovery_complete" -eq 0 ] && [ -r "$retained" ]; then
        cat "$retained" >>"$recovery"
    fi
    if [ -s "$recovery" ]; then
        atomic_state "$recovery" "recovery-$suffix"
    fi

    retained="$(state_file "xai-$suffix")"
    if [ "$candidates_complete" -eq 0 ] && [ -r "$retained" ]; then
        cat "$retained" >>"$candidates"
    fi
    if [ ! -s "$candidates" ]; then
        return 0
    fi

    filter_family "$candidates" "$recovery" "$excluded" "$protected" "$collisions"
    atomic_state "$protected" "xai-$suffix"
    atomic_state "$collisions" "collisions-$suffix"
}

sync_hosts() {
    local work
    need_root
    ensure_state_dir
    work="$(mktemp -d)"
    [ -n "$RTRASH" ] || die "rtrash is required for temporary-state cleanup"
    trap '"$RTRASH" -rf "$work"' RETURN
    sync_family ahostsv4 -4 32 v4 "$work"
    sync_family ahostsv6 -6 128 v6 "$work"
    "$RTRASH" -rf "$work"
    trap - RETURN
}

rules_at_pref() {
    local flag="$1" pref="$2"
    "$IP" "$flag" rule show 2>/dev/null | awk -v prefix="${pref}:" '$1 == prefix'
}

owned_rule() {
    local pref="$1" line="$2"
    case "$pref" in
        "$PREF_DEST")
            [[ "$line" =~ ^${PREF_DEST}:[[:space:]]+from[[:space:]]+all[[:space:]]+to[[:space:]]+[^[:space:]]+[[:space:]]+lookup[[:space:]]+${PROTECTED_TABLE}$ ]]
            ;;
        "$PREF_TAILNET")
            [[ "$line" =~ ^${PREF_TAILNET}:[[:space:]]+from[[:space:]]+all[[:space:]]+lookup[[:space:]]+52$ ]]
            ;;
        "$PREF_SURF")
            [[ "$line" =~ ^${PREF_SURF}:[[:space:]]+from[[:space:]]+all[[:space:]]+to[[:space:]]+[^[:space:]]+[[:space:]]+lookup[[:space:]]+main$ ]]
            ;;
        "$PREF_PROCESS")
            [[ "$line" =~ ^${PREF_PROCESS}:[[:space:]]+from[[:space:]]+all[[:space:]]+fwmark[[:space:]]+0x5252/0xffff[[:space:]]+lookup[[:space:]]+${PROTECTED_TABLE}$ ]]
            ;;
        "$PREF_TS_MARK")
            [[ "$line" =~ ^${PREF_TS_MARK}:[[:space:]]+from[[:space:]]+all[[:space:]]+fwmark[[:space:]]+0x80000/0xff0000[[:space:]]+lookup[[:space:]]+${PROTECTED_TABLE}$ ]]
            ;;
        *) return 1 ;;
    esac
}

validate_preferences() {
    local flag pref line
    for flag in -4 -6; do
        for pref in "$PREF_DEST" "$PREF_TAILNET" "$PREF_SURF" "$PREF_PROCESS" "$PREF_TS_MARK"; do
            while IFS= read -r line; do
                [ -n "$line" ] || continue
                owned_rule "$pref" "$line" \
                    || die "$flag preference $pref is owned by another rule: $line"
            done < <(rules_at_pref "$flag" "$pref")
        done
    done
}

canonical_rule() {
    printf '%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4"
}

normalize_target() {
    local target="$1" bits="$2"
    case "$target" in
        */*) printf '%s\n' "$target" ;;
        *) printf '%s/%s\n' "$target" "$bits" ;;
    esac
}

state_rule_specs() {
    local suffix="$1" bits="$2" file addr
    file="$(state_file "xai-$suffix")"
    [ -r "$file" ] || return 0
    while IFS= read -r addr; do
        [ -n "$addr" ] || continue
        canonical_rule "$PREF_DEST" to "$addr/$bits" "$PROTECTED_TABLE"
    done <"$file"
}

surf_rule_specs() {
    local flag="$1" bits="$2" prefix
    while IFS= read -r prefix; do
        [ -n "$prefix" ] || continue
        canonical_rule "$PREF_SURF" to "$(normalize_target "$prefix" "$bits")" main
    done < <("$IP" "$flag" route show table main 2>/dev/null \
        | awk -v bits="$bits" '$0 ~ / dev tun0([[:space:]]|$)/ {print ($1 ~ /\// ? $1 : $1 "/" bits)}' \
        | LC_ALL=C sort -u)
}

desired_rule_specs() {
    local flag="$1" bits="$2" suffix="$3"
    state_rule_specs "$suffix" "$bits"
    canonical_rule "$PREF_TAILNET" lookup - 52
    surf_rule_specs "$flag" "$bits"
    canonical_rule "$PREF_PROCESS" fwmark "$PROTECTED_MARK/0xffff" "$PROTECTED_TABLE"
    canonical_rule "$PREF_TS_MARK" fwmark "$TAILSCALE_MARK" "$PROTECTED_TABLE"
}

actual_rule_specs() {
    local flag="$1" bits="$2" pref line target
    for pref in "$PREF_DEST" "$PREF_TAILNET" "$PREF_SURF" "$PREF_PROCESS" "$PREF_TS_MARK"; do
        while IFS= read -r line; do
            [ -n "$line" ] || continue
            case "$pref" in
                "$PREF_DEST")
                    target="$(awk '{for (i = 1; i <= NF; i++) if ($i == "to") {print $(i + 1); exit}}' <<<"$line")"
                    canonical_rule "$pref" to "$(normalize_target "$target" "$bits")" "$PROTECTED_TABLE"
                    ;;
                "$PREF_TAILNET") canonical_rule "$pref" lookup - 52 ;;
                "$PREF_SURF")
                    target="$(awk '{for (i = 1; i <= NF; i++) if ($i == "to") {print $(i + 1); exit}}' <<<"$line")"
                    canonical_rule "$pref" to "$(normalize_target "$target" "$bits")" main
                    ;;
                "$PREF_PROCESS") canonical_rule "$pref" fwmark "$PROTECTED_MARK/0xffff" "$PROTECTED_TABLE" ;;
                "$PREF_TS_MARK") canonical_rule "$pref" fwmark "$TAILSCALE_MARK" "$PROTECTED_TABLE" ;;
            esac
        done < <(rules_at_pref "$flag" "$pref")
    done
}

mutate_rule() {
    local action="$1" flag="$2" spec="$3" pref kind value table target bits
    IFS=$'\t' read -r pref kind value table <<<"$spec"
    case "$kind" in
        lookup)
            "$IP" "$flag" rule "$action" pref "$pref" lookup "$table"
            ;;
        to)
            target="$value"
            if [ "$action" = del ]; then
                bits="$([ "$flag" = -4 ] && printf 32 || printf 128)"
                target="${target%/$bits}"
            fi
            "$IP" "$flag" rule "$action" pref "$pref" to "$target" lookup "$table"
            ;;
        fwmark)
            "$IP" "$flag" rule "$action" pref "$pref" fwmark "$value" lookup "$table"
            ;;
        *) die "invalid canonical rule kind: $kind" ;;
    esac
}

reconcile_family_rules() {
    local flag="$1" bits="$2" suffix="$3" spec occurrence allowed
    local -a desired=() actual=()
    local -A wanted=() present=() seen=()
    mapfile -t desired < <(desired_rule_specs "$flag" "$bits" "$suffix")
    mapfile -t actual < <(actual_rule_specs "$flag" "$bits")

    for spec in "${desired[@]}"; do
        wanted["$spec"]=$(( ${wanted["$spec"]:-0} + 1 ))
    done
    for spec in "${actual[@]}"; do
        present["$spec"]=$(( ${present["$spec"]:-0} + 1 ))
    done

    for spec in "${desired[@]}"; do
        occurrence=$(( ${seen["$spec"]:-0} + 1 ))
        seen["$spec"]="$occurrence"
        if [ "$occurrence" -gt "${present["$spec"]:-0}" ]; then
            mutate_rule add "$flag" "$spec"
        fi
    done

    seen=()
    for spec in "${actual[@]}"; do
        occurrence=$(( ${seen["$spec"]:-0} + 1 ))
        seen["$spec"]="$occurrence"
        allowed="${wanted["$spec"]:-0}"
        if [ "$occurrence" -gt "$allowed" ]; then
            mutate_rule del "$flag" "$spec"
        fi
    done
}

retire_legacy_tailnet_rules() {
    local flag line
    for flag in -4 -6; do
        while IFS= read -r line; do
            [ -n "$line" ] || continue
            case "$line" in
                *"fwmark 0x80000/0xff0000"*"lookup $HOUSTON_TABLE"*)
                    "$IP" "$flag" rule del pref 5205 \
                        fwmark "$TAILSCALE_MARK" lookup "$HOUSTON_TABLE"
                    ;;
            esac
        done < <(rules_at_pref "$flag" 5205)
        while IFS= read -r line; do
            [ -n "$line" ] || continue
            if [[ "$line" =~ ^5206:[[:space:]]+from[[:space:]]+all[[:space:]]+lookup[[:space:]]+52$ ]]; then
                "$IP" "$flag" rule del pref 5206 lookup 52
            fi
        done < <(rules_at_pref "$flag" 5206)
    done
}

render_nft_base() {
    cat <<EOF
table inet $NFT_TABLE {
    chain mark_protected {
        type route hook output priority mangle; policy accept;
    }
}
EOF
}

render_nft_cgroup() {
    local cgroup="$1" level
    level="$(awk -F/ '{print NF}' <<<"$cgroup")"
    cat <<EOF
table inet $NFT_TABLE {
    chain mark_protected {
        type route hook output priority mangle; policy accept;
        socket cgroupv2 level $level "$cgroup" meta mark set $PROTECTED_MARK
    }
}
EOF
}

ensure_nft_base() {
    if ! "$NFT" list table inet "$NFT_TABLE" >/dev/null 2>&1; then
        render_nft_base | "$NFT" -f -
    fi
}

xai_underlay_gid() {
    local entry
    if [ -n "$XAI_UNDERLAY_GID" ]; then
        printf '%s\n' "$XAI_UNDERLAY_GID"
        return 0
    fi
    entry="$($GETENT group "$XAI_UNDERLAY_GROUP" 2>/dev/null || true)"
    [ -n "$entry" ] || return 1
    cut -d: -f3 <<<"$entry"
}

ensure_xai_underlay_mark() {
    local gid handle
    gid="$(xai_underlay_gid || true)"
    [ -n "$gid" ] || return 0
    case "$gid" in
        *[!0-9]*) die "invalid gid for $XAI_UNDERLAY_GROUP: $gid" ;;
    esac
    if ! "$NFT" list table inet "$NFT_TABLE" 2>/dev/null \
        | grep -F -q 'comment "rg-xai-houston"'; then
        printf 'add rule inet %s mark_protected meta skgid %s meta mark set %s comment "rg-xai-houston"\n' "$NFT_TABLE" "$gid" "$PROTECTED_MARK" | "$NFT" -f -
    fi
    while IFS= read -r handle; do
        [ -n "$handle" ] || continue
        "$NFT" delete rule inet "$NFT_TABLE" mark_protected handle "$handle"
    done < <("$NFT" -a list chain inet "$NFT_TABLE" mark_protected 2>/dev/null \
        | awk '/comment "rg-xai-underlay"/ {for (i = 1; i < NF; i++) if ($i == "handle") print $(i + 1)}')
}

protected_group_gid() {
    local entry
    if [ -n "$PROTECTED_GROUP_GID" ]; then
        printf '%s\n' "$PROTECTED_GROUP_GID"
        return 0
    fi
    entry="$($GETENT group "$PROTECTED_GROUP" 2>/dev/null || true)"
    [ -n "$entry" ] || return 1
    cut -d: -f3 <<<"$entry"
}

ensure_protected_group_mark() {
    local gid
    gid="$(protected_group_gid)" || die "group is missing: $PROTECTED_GROUP"
    case "$gid" in
        ''|*[!0-9]*) die "invalid gid for $PROTECTED_GROUP: $gid" ;;
    esac
    ensure_nft_base
    if "$NFT" list table inet "$NFT_TABLE" 2>/dev/null \
        | grep -F -q 'comment "rg-houston-protected-group"'; then
        return 0
    fi
    printf 'add rule inet %s mark_protected meta skgid %s meta mark set %s comment "rg-houston-protected-group"\n' "$NFT_TABLE" "$gid" "$PROTECTED_MARK" | "$NFT" -f -
}

remember_protected_cgroup() {
    local cgroup="$1" file staged current=""
    ensure_state_dir
    file="$(state_file protected-cgroup)"
    [ -r "$file" ] && IFS= read -r current <"$file"
    [ "$current" = "$cgroup" ] && return 0
    staged="$(state_file .protected-cgroup.new)"
    printf '%s\n' "$cgroup" >"$staged"
    chmod 0644 "$staged"
    mv -f "$staged" "$file"
}

install_rules() {
    reconcile_family_rules -4 32 v4
    reconcile_family_rules -6 128 v6
    retire_legacy_tailnet_rules
}

has_unreachable_default() {
    local flag="$1"
    "$IP" "$flag" route show table "$PROTECTED_TABLE" 2>/dev/null \
        | awk -v metric="$FAIL_METRIC" '
            $1 == "unreachable" && $2 == "default" {
                for (i = 3; i < NF; i++) {
                    if ($i == "metric" && $(i + 1) == metric) {
                        found = 1
                    }
                }
            }
            END { exit !found }
        '
}

ensure_unreachable_default() {
    local flag="$1"
    has_unreachable_default "$flag" \
        || "$IP" "$flag" route replace unreachable default metric "$FAIL_METRIC" table "$PROTECTED_TABLE"
}

has_live_default() {
    local flag="$1"
    "$IP" "$flag" route show table "$PROTECTED_TABLE" 2>/dev/null \
        | awk -v iface="$IFACE" '
            $1 == "default" {
                for (i = 2; i < NF; i++) {
                    if ($i == "dev" && $(i + 1) == iface) {
                        have_dev = 1
                    }
                    if ($i == "metric" && $(i + 1) == 10) {
                        have_metric = 1
                    }
                }
                if (have_dev && have_metric) {
                    found = 1
                }
                have_dev = have_metric = 0
            }
            END { exit !found }
        '
}

ensure_live_default() {
    local flag="$1"
    has_live_default "$flag" \
        || "$IP" "$flag" route replace default dev "$IFACE" metric 10 table "$PROTECTED_TABLE"
}

policy_assert() {
    need_root
    validate_preferences
    ensure_state_dir
    ensure_nft_base
    ensure_xai_underlay_mark
    restore_protected_cgroup
    ensure_unreachable_default -4
    ensure_unreachable_default -6
    install_rules
}

houston_up() {
    need_root
    policy_assert
    "$IP" link show "$IFACE" >/dev/null 2>&1 \
        || die "$IFACE is absent"
    "$IP" -4 route show table "$HOUSTON_TABLE" 2>/dev/null | grep -q '^default' \
        || die "table $HOUSTON_TABLE has no IPv4 default"
    ensure_live_default -4
    if "$IP" -6 route show table "$HOUSTON_TABLE" 2>/dev/null | grep -q '^default'; then
        ensure_live_default -6
    else
        "$IP" -6 route del default dev "$IFACE" table "$PROTECTED_TABLE" 2>/dev/null || true
    fi
}

houston_down() {
    need_root
    policy_assert
    "$IP" -4 route del default dev "$IFACE" table "$PROTECTED_TABLE" 2>/dev/null || true
    "$IP" -6 route del default dev "$IFACE" table "$PROTECTED_TABLE" 2>/dev/null || true
}

register_cgroup() {
    local cgroup="$1" level
    need_root
    case "$cgroup" in
        *[!A-Za-z0-9_./@-]*) die "invalid character in protected cgroup: $cgroup" ;;
    esac
    case "$cgroup" in
        user.slice/user-[0-9]*.slice/user@*.service/*/rg-houston-protected.slice) ;;
        *) die "refusing cgroup outside rg-houston-protected.slice: $cgroup" ;;
    esac
    ensure_nft_base
    if "$NFT" list table inet "$NFT_TABLE" 2>/dev/null | grep -F -q -- "\"$cgroup\""; then
        remember_protected_cgroup "$cgroup"
        return 0
    fi
    level="$(awk -F/ '{print NF}' <<<"$cgroup")"
    printf 'add rule inet %s mark_protected socket cgroupv2 level %s "%s" meta mark set %s\n' \
        "$NFT_TABLE" "$level" "$cgroup" "$PROTECTED_MARK" | "$NFT" -f -
    remember_protected_cgroup "$cgroup"
}

restore_protected_cgroup() {
    local file cgroup=""
    file="$(state_file protected-cgroup)"
    [ -r "$file" ] || return 0
    IFS= read -r cgroup <"$file"
    [ -n "$cgroup" ] || return 0
    register_cgroup "$cgroup"
}

register_pid() {
    local pid="$1" cgroup
    case "$pid" in ''|*[!0-9]*) die "invalid pid: $pid" ;; esac
    [ -r "/proc/$pid/cgroup" ] || die "pid $pid is not readable"
    cgroup="$(awk -F'::' '/^0::/ {sub(/^\//, "", $2); print $2; exit}' "/proc/$pid/cgroup")"
    [ -n "$cgroup" ] || die "pid $pid has no unified cgroup"
    case "$cgroup" in
        user.slice/*/rg-houston-protected.slice/*.scope) ;;
        *) die "pid $pid is outside rg-houston-protected.slice: $cgroup" ;;
    esac
    cgroup="${cgroup%/*}"
    register_cgroup "$cgroup"
}

run_protected() {
    local uid gid
    [ "${1:-}" = -- ] || die "run-protected requires -- before the command"
    shift
    [ "$#" -gt 0 ] || die "run-protected requires a command"
    uid="${SUDO_UID:-}"
    case "$uid" in
        1001) ;;
        *) die "run-protected is restricted to uid 1001" ;;
    esac
    gid="$(protected_group_gid)" || die "group is missing: $PROTECTED_GROUP"
    policy_assert
    has_live_default -4 || die "Houston protected route has no live IPv4 default"
    ensure_protected_group_mark
    "$FLOCK" -u 9
    exec 9>&-
    exec "$SETPRIV" --reuid="$uid" --regid="$gid" --init-groups -- "$@"
}

status() {
    printf '== protected routes ==\n'
    "$IP" -4 route show table "$PROTECTED_TABLE" 2>/dev/null || true
    "$IP" -6 route show table "$PROTECTED_TABLE" 2>/dev/null || true
    printf '== protected rules ==\n'
    "$IP" -4 rule show 2>/dev/null | awk '$1 ~ /^(5188|5194|5195|5196|5197):/'
    "$IP" -6 rule show 2>/dev/null | awk '$1 ~ /^(5188|5194|5195|5196|5197):/'
    printf '== protected cgroups ==\n'
    "$NFT" list table inet "$NFT_TABLE" 2>/dev/null || true
    printf '== address collisions ==\n'
    cat "$(state_file collisions-v4)" "$(state_file collisions-v6)" 2>/dev/null || true
}

case "${1:-}" in
    assert) acquire_policy_lock; policy_assert ;;
    sync-hosts) acquire_policy_lock; sync_hosts ;;
    houston-up) acquire_policy_lock; houston_up ;;
    houston-down) acquire_policy_lock; houston_down ;;
    register-pid) acquire_policy_lock; register_pid "${2:-}" ;;
    register-cgroup) acquire_policy_lock; register_cgroup "${2:-}" ;;
    run-protected) acquire_policy_lock; shift; run_protected "$@" ;;
    status) status ;;
    --render-nft) render_nft_cgroup "${2:?usage: $0 --render-nft <cgroup>}" ;;
    *) die "usage: $0 {assert|sync-hosts|houston-up|houston-down|register-pid PID|register-cgroup PATH|run-protected -- COMMAND [ARG...]|status}" ;;
esac
