#!/usr/bin/env bash
# Tier-1 backup of the build host's small, irreplaceable state (Documents,
# job scripts, logs, data, the FireWorks LaunchPad, Slurm and tmpfiles config)
# into its own borg repo, then pushed offsite.
#
# Every step that loses data on failure is fatal and alerts: a unit that stays
# green while nothing is archived is worse than one that goes red. A missing
# source path is skipped with a warning rather than aborting the archive.
set -uo pipefail

REPO="${RG_TERRA_REPO:-$HOME/Backups/borg-terra}"
REMOTE="${RG_TERRA_REMOTE:-pcloud-dav:terra-borg}"
PASSFILE="${RG_TERRA_PASSFILE:-$HOME/.config/borg/passphrase}"
STAMP_FILE="${RG_TERRA_STAMP:-$HOME/.local/state/rg-terra-backup.last}"
STALE_DAYS="${RG_TERRA_STALE_DAYS:-3}"
LOCK="${RG_TERRA_LOCK:-/run/user/$(id -u)/rg-terra-backup.lock}"
TODAY=$(date +%Y-%m-%d)
ARCHIVE="terra-${TODAY}T$(date +%H%M%S)"

alert() {
    notify-send -u critical "Terra tier-1 backup" "$1" 2>/dev/null || true
    logger -t rg-terra-backup -- "$1"
    echo "rg-terra-backup: $1" >&2
}
stale_check() {
    if [ -z "$(find "$STAMP_FILE" -mtime "-$STALE_DAYS" 2>/dev/null)" ]; then
        alert "$1; no successful tier-1 backup in ${STALE_DAYS}+ days."
    fi
}

# The braces keep 2>/dev/null on the open alone; on a bare exec it would
# silence stderr for the rest of the run.
{ exec 9>"$LOCK"; } 2>/dev/null || exit 0
flock -n 9 || { echo "another run holds the lock; skipping"; exit 0; }

if [ ! -r "$PASSFILE" ] || [ ! -d "$REPO/data" ]; then
    alert "repo $REPO or passphrase file missing"
    exit 1
fi
export BORG_PASSCOMMAND="cat $PASSFILE"

# The FireWorks LaunchPad runs in a podman container with auth on, so the dump
# runs inside it with the LaunchPad's own credentials. The raw WiredTiger files
# are owned by the container user and are not a consistent copy of a live
# database anyway; the dump is the backup of record.
LAUNCHPAD="${RG_TERRA_LAUNCHPAD:-$HOME/Git/tmp/fw-mongo/configs/my_launchpad_amsel.yaml}"
MONGO_CTR="${RG_TERRA_MONGO_CTR:-amsel-fw-mongo}"
DUMP=$(mktemp -d "${TMPDIR:-/tmp}/fw-mongodump-XXXXXX")
trap 'rm -rf "$DUMP"' EXIT
if podman container exists "$MONGO_CTR" 2>/dev/null && [ -r "$LAUNCHPAD" ]; then
    ( umask 077
      printf 'MU=%s\nMP=%s\nMD=%s\nMA=%s\n' \
        "$(yq -r .username "$LAUNCHPAD")" "$(yq -r .password "$LAUNCHPAD")" \
        "$(yq -r .name "$LAUNCHPAD")" "$(yq -r '.authsource // .name' "$LAUNCHPAD")" \
        > "$DUMP/env" )
    if ! podman exec --env-file "$DUMP/env" "$MONGO_CTR" sh -c \
            'mongodump --quiet --host 127.0.0.1 --username "$MU" --password "$MP" --authenticationDatabase "$MA" --db "$MD" --archive --gzip' \
            > "$DUMP/launchpad.archive.gz" || [ ! -s "$DUMP/launchpad.archive.gz" ]; then
        alert "LaunchPad mongodump failed; archiving without it"
        rm -f "$DUMP/launchpad.archive.gz"
    fi
    rm -f "$DUMP/env"
else
    alert "LaunchPad container $MONGO_CTR or $LAUNCHPAD missing; no database dump"
fi

SOURCES=()
for p in "$HOME/Documents" "$HOME/jobs" "$HOME/logs" "$HOME/data" \
         "$HOME/.bashrc" "$HOME/Git/tmp/fw-mongo" \
         /etc/tmpfiles.d /etc/slurm-llnl "$DUMP"; do
    if [ -e "$p" ]; then SOURCES+=("$p"); else echo "warning: skipping missing $p" >&2; fi
done

# borg exits 1 for warnings (a file changed or became unreadable mid-read)
# with the archive written, and 2 or more when there is no archive.
borg create --compression zstd,6 --exclude '*/node_modules' \
    --exclude "$HOME/Git/tmp/fw-mongo/data" --stats \
    "$REPO::$ARCHIVE" "${SOURCES[@]}"
rc=$?
if [ "$rc" -ge 2 ]; then
    stale_check "borg create failed"
    alert "borg create failed (rc $rc); see journalctl --user -u rg-terra-backup"
    exit 1
elif [ "$rc" -eq 1 ]; then
    alert "borg create finished with warnings; archive $ARCHIVE was written"
fi

borg prune --keep-daily 7 --keep-weekly 4 --keep-monthly 6 "$REPO" || alert "borg prune failed"
borg compact "$REPO" || alert "borg compact failed"

if ! rclone sync "$REPO" "$REMOTE" --transfers 4; then
    stale_check "rclone sync to pCloud failed"
    alert "offsite sync failed; the local archive $ARCHIVE is fine but the remote copy is stale"
    exit 1
fi

mkdir -p "$(dirname "$STAMP_FILE")"
touch "$STAMP_FILE"
echo "tier-1 archive $ARCHIVE + offsite sync ok"
