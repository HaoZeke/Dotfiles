#!/usr/bin/env bash
# rg-geo-split - route a named list of destinations out through a chosen
# region's exit, leaving every other route on this machine alone.
#
#   rg-geo-split <region> up | down | status | refresh
#   rg-geo-split list                  show configured regions
#
#   rg-geo-split us up                 US exit  (banks, x.money, X)
#   rg-geo-split in up                 India exit (accounts billed in India)
#
# Layout, one directory per region:
#   ~/.config/rg-geo-egress/<region>/wireguard.conf
#   ~/.config/rg-geo-egress/<region>/domains.txt
#
# Each region gets its own interface, routing table and fwmark, derived from
# its position in REGIONS below so two regions can be up at once without
# colliding. Nothing touches the main table or the default route.
#
# Why regions at all: some accounts are billed in a specific country and the
# provider expects to see traffic from there. Spotify allows roughly 14 days
# away from the billing country before it expects the home region back, and a
# sustained mismatch has cost people their accounts. That is the case this
# solves; it is not a way to shop for cheaper pricing, which needs a local
# payment method anyway and will not work without one.
#
# Known not to work regardless of region: Netflix and Prime Video score
# datacenter and shared VPN ranges directly and will usually refuse. Do not
# list them and then read the refusal as a bug here.
#
# Regions must not share a destination. Both regions install an output hook at
# the same nftables priority, so a host present in two sets is marked by
# whichever chain runs first, which is not defined. Keep each host in exactly
# one region's list; `rg-geo-split overlap` reports any that are not.
#
# Windscribe issues one keypair per account, so every region config carries the
# same client key and the same interface address. That turns out to be fine:
# both tunnels handshake and route at once, verified with US and India up
# together reaching different exits.
#
# All three fixes the single-region version needed apply per region: the
# socket is created against the LAN route and takes its source address and its
# PMTU, so each region needs masquerade on egress plus MSS clamping in BOTH
# directions. Without the ingress clamp, handshakes complete and TLS hangs.

set -Eeuo pipefail

# Region -> index. The index picks the table, mark and interface, so adding a
# region here is the only change needed. Do not renumber existing entries
# while a tunnel is up.
REGIONS="us in uk de sg"

real_home() {
    if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ]; then
        getent passwd "$SUDO_USER" | cut -d: -f6
    elif [ -n "${HOME:-}" ]; then
        printf '%s' "$HOME"
    else
        getent passwd "$(id -u)" | cut -d: -f6
    fi
}
HOME_DIR="$(real_home)"
BASE="${RG_GEO_BASE:-$HOME_DIR/.config/rg-geo-egress}"

die() { printf 'rg-geo-split: %s\n' "$*" >&2; exit 1; }

region_index() {
    local want="$1" i=0 r
    for r in $REGIONS; do
        [ "$r" = "$want" ] && { printf '%d' "$i"; return 0; }
        i=$((i + 1))
    done
    return 1
}

setup_region() {
    REGION="$1"
    region_index "$REGION" >/dev/null || die "unknown region: $REGION (known: $REGIONS)"
    IFACE="rg-${REGION}-wg"
    # Explicit, not arithmetic. 0x5553 is the US mark the single-region tool
    # already uses, so that tunnel stays interchangeable; 0x5554 belongs to
    # rg-us-tailnet and must not be reused. Everything else starts clear of
    # both.
    case "$REGION" in
        us) RT_TABLE=5553; FWMARK=0x5553; RULE_PRIO=5300 ;;
        in) RT_TABLE=5556; FWMARK=0x5556; RULE_PRIO=5301 ;;
        uk) RT_TABLE=5557; FWMARK=0x5557; RULE_PRIO=5302 ;;
        de) RT_TABLE=5558; FWMARK=0x5558; RULE_PRIO=5303 ;;
        sg) RT_TABLE=5559; FWMARK=0x5559; RULE_PRIO=5304 ;;
        *)  die "no mark allocated for region $REGION" ;;
    esac
    if [ "$REGION" = "us" ]; then NFT_TABLE="rg_us_split"; else NFT_TABLE="rg_geo_${REGION}"; fi
    SRC_CONF="$BASE/$REGION/wireguard.conf"
    [ -r "$SRC_CONF" ] || SRC_CONF="$HOME_DIR/.config/rg-us-egress/wireguard.conf"
    LIST="$BASE/$REGION/domains.txt"
    RUNTIME_CONF="/etc/wireguard/${IFACE}.conf"
    CLAMP_MSS="${RG_GEO_MSS:-1240}"
    SET_TTL="${RG_GEO_TTL:-1h}"
}

need_root() {
    [ "$(id -u)" -eq 0 ] && return 0
    command -v sudo >/dev/null || die "needs root and sudo is not installed"
    exec sudo RG_GEO_BASE="$BASE" "$(readlink -f "$0")" "$@"
}

resolve() {
    { getent ahostsv4 "$1" 2>/dev/null | awk '{print $1}'
      getent ahostsv6 "$1" 2>/dev/null | awk '{print $1}'; } | sort -u
}

render_conf() {
    [ -r "$SRC_CONF" ] || die "no WireGuard config at $SRC_CONF"
    install -d -m 0700 /etc/wireguard
    awk '
        BEGIN { seen = 0 }
        /^[[:space:]]*Table[[:space:]]*=/ { print "Table = off"; seen = 1; next }
        /^[[:space:]]*\[Peer\]/ && !seen { print "Table = off"; seen = 1 }
        { print }
        END { if (!seen) print "Table = off" }
    ' "$SRC_CONF" > "$RUNTIME_CONF"
    chmod 0600 "$RUNTIME_CONF"
}

nft_setup() {
    nft list table inet "$NFT_TABLE" >/dev/null 2>&1 && return 0
    nft -f - <<EOF
table inet $NFT_TABLE {
    set dst_v4 { type ipv4_addr; flags timeout; timeout $SET_TTL; }
    set dst_v6 { type ipv6_addr; flags timeout; timeout $SET_TTL; }

    chain mark_out {
        type route hook output priority mangle; policy accept;
        ip daddr @dst_v4 meta mark set $FWMARK
        ip6 daddr @dst_v6 meta mark set $FWMARK
    }

    chain snat_out {
        type nat hook postrouting priority srcnat; policy accept;
        oifname "$IFACE" masquerade
    }

    chain mss_clamp {
        type filter hook postrouting priority mangle; policy accept;
        oifname "$IFACE" tcp flags syn tcp option maxseg size set rt mtu
    }

    chain mss_in {
        type filter hook prerouting priority mangle; policy accept;
        iifname "$IFACE" tcp flags syn tcp option maxseg size set $CLAMP_MSS
    }
}
EOF
}

refresh_set() {
    [ -r "$LIST" ] || die "no domain list at $LIST"
    nft list table inet "$NFT_TABLE" >/dev/null 2>&1 || die "$REGION not up"
    local host v4 v6 n=0
    while read -r host; do
        host="${host%%#*}"; host="$(printf '%s' "$host" | tr -d '[:space:]')"
        [ -n "$host" ] || continue
        # Never admit an overlay or private address: Tailscale uses
        # 100.64.0.0/10 and split-DNS names can answer from inside it.
        v4=$(resolve "$host" | grep -E '^[0-9]+\.' \
            | grep -vE '^(100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.|10\.|172\.(1[6-9]|2[0-9]|3[01])\.|192\.168\.|127\.|169\.254\.)' \
            | paste -sd, -)
        v6=$(resolve "$host" | grep ':' | grep -vE '^(fd|fe80|::1)' | paste -sd, -)
        [ -n "$v4" ] && nft add element inet "$NFT_TABLE" dst_v4 "{ $v4 }" 2>/dev/null || true
        [ -n "$v6" ] && nft add element inet "$NFT_TABLE" dst_v6 "{ $v6 }" 2>/dev/null || true
        [ -n "$v4$v6" ] && n=$((n + 1))
    done < "$LIST"
    printf 'rg-geo-split[%s]: refreshed %d host(s)\n' "$REGION" "$n"
}

up() {
    command -v wg-quick >/dev/null || die "wg-quick missing"
    render_conf
    ip link show "$IFACE" >/dev/null 2>&1 || wg-quick up "$IFACE"
    ip route replace default dev "$IFACE" table "$RT_TABLE"
    ip -6 route replace default dev "$IFACE" table "$RT_TABLE" 2>/dev/null || true
    ip rule list | grep -q "fwmark $FWMARK" \
        || ip rule add fwmark "$FWMARK/0xffff" table "$RT_TABLE" priority "$RULE_PRIO"
    nft_setup
    refresh_set
    printf 'rg-geo-split[%s]: up on %s, table %s, mark %s\n' "$REGION" "$IFACE" "$RT_TABLE" "$FWMARK"
}

down() {
    ip rule del fwmark "$FWMARK/0xffff" table "$RT_TABLE" priority "$RULE_PRIO" 2>/dev/null || true
    ip route flush table "$RT_TABLE" 2>/dev/null || true
    ip -6 route flush table "$RT_TABLE" 2>/dev/null || true
    nft delete table inet "$NFT_TABLE" 2>/dev/null || true
    ip link show "$IFACE" >/dev/null 2>&1 && wg-quick down "$IFACE" 2>/dev/null || true
    printf 'rg-geo-split[%s]: down\n' "$REGION"
}

status() {
    printf '== %s ==\n' "$REGION"
    ip -br addr show "$IFACE" 2>/dev/null | sed 's/^/  /' || printf '  %s not up\n' "$IFACE"
    ip rule list | grep -E "fwmark $FWMARK" | sed 's/^/  /' || printf '  no rule\n'
    if [ "$(id -u)" -ne 0 ]; then
        printf '  destinations: (needs root to read)\n'
    else
        printf '  destinations: %s address(es)\n' \
            "$(nft list set inet "$NFT_TABLE" dst_v4 2>/dev/null | grep -coE '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' || echo 0)"
    fi
}

case "${1:-}" in
    overlap)
        # A host in two regions is ambiguous, so make it easy to find.
        need_root overlap
        declare -A seen=()
        dup=0
        for r in $REGIONS; do
            f="$BASE/$r/domains.txt"
            [ -r "$f" ] || continue
            while read -r h; do
                h="${h%%#*}"; h="$(printf '%s' "$h" | tr -d '[:space:]')"
                [ -n "$h" ] || continue
                if [ -n "${seen[$h]:-}" ]; then
                    printf '  %-28s in both %s and %s\n' "$h" "${seen[$h]}" "$r"
                    dup=1
                else
                    seen[$h]="$r"
                fi
            done < "$f"
        done
        [ "$dup" -eq 0 ] && printf '  no host is listed in more than one region\n'
        exit 0 ;;
    list)
        for r in $REGIONS; do
            d="$BASE/$r"
            if [ -r "$d/wireguard.conf" ]; then s="configured"; else s="no config"; fi
            printf '  %-4s %s\n' "$r" "$s"
        done
        exit 0 ;;
    "") die "usage: $0 <region> {up|down|status|refresh} | $0 list" ;;
esac

setup_region "$1"
case "${2:-status}" in
    up)      need_root "$@"; up ;;
    down)    need_root "$@"; down ;;
    refresh) need_root "$@"; refresh_set ;;
    status)  status ;;
    *)       die "usage: $0 $REGION {up|down|status|refresh}" ;;
esac
