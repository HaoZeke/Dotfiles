#!/usr/bin/env bash
# Managed by chezmoi (dot_local/bin/executable_rg-x1gen11-profile-selftest).

set -euo pipefail

repo=${1:-"$HOME/.local/share/chezmoi"}
script="$repo/dot_local/bin/executable_rg-x1gen11-profile"
profiles="$repo/dot_config/rg-x1gen11/profiles.json"

fail() {
    printf 'FAIL: %s\n' "$*" >&2
    exit 1
}

test -r "$script" || fail "missing profile switcher"
test -r "$profiles" || fail "missing profiles.json"

output=$(RG_X1GEN11_PROFILES="$profiles" "$script" list)
printf '%s\n' "$output" | rg -q 'undocked-mixed' || fail "list missing undocked-mixed"
printf '%s\n' "$output" | rg -q 'build-heavy' || fail "list missing build-heavy"
printf '%s\n' "$output" | rg -q 'focus' || fail "list missing focus"
printf '%s\n' "$output" | rg -q 'memory-pressure' || fail "list missing memory-pressure"

RG_X1GEN11_PROFILES="$profiles" "$script" show travel | rg 'scaling_governor: powersave' >/dev/null \
    || fail "travel profile must use powersave governor"
RG_X1GEN11_PROFILES="$profiles" "$script" show travel | rg 'energy_performance_preference: power' >/dev/null \
    || fail "travel profile must use the lowest EPP tier"
RG_X1GEN11_PROFILES="$profiles" "$script" show undocked-mixed | rg 'scaling_governor: powersave' >/dev/null \
    || fail "undocked-mixed must use powersave governor on active intel_pstate"
RG_X1GEN11_PROFILES="$profiles" "$script" show undocked-mixed | rg 'platform_profile: low-power' >/dev/null \
    || fail "undocked-mixed must use the low-power ACPI platform profile"
RG_X1GEN11_PROFILES="$profiles" "$script" show undocked-mixed | rg 'energy_performance_preference: balance_power' >/dev/null \
    || fail "undocked-mixed must keep EPP below performance"
RG_X1GEN11_PROFILES="$profiles" "$script" show undocked-mixed | rg 'hwp_dynamic_boost: 0' >/dev/null \
    || fail "undocked-mixed must keep HWP dynamic boost disabled"
RG_X1GEN11_PROFILES="$profiles" "$script" show memory-pressure | rg 'scaling_governor: powersave' >/dev/null \
    || fail "memory-pressure must use powersave governor on active intel_pstate"
RG_X1GEN11_PROFILES="$profiles" "$script" show docked-office | rg 'scaling_governor: powersave' >/dev/null \
    || fail "docked-office must use powersave governor on active intel_pstate"
RG_X1GEN11_PROFILES="$profiles" "$script" show build-heavy | rg 'scaling_governor: performance' >/dev/null \
    || fail "build-heavy must use performance governor"
RG_X1GEN11_PROFILES="$profiles" "$script" show build-heavy | rg 'energy_performance_preference: performance' >/dev/null \
    || fail "build-heavy must use performance EPP"
RG_X1GEN11_PROFILES="$profiles" "$script" show build-heavy | rg 'hwp_dynamic_boost: 1' >/dev/null \
    || fail "build-heavy may enable HWP dynamic boost"
RG_X1GEN11_PROFILES="$profiles" "$script" show focus | rg 'scx_mode: lavd' >/dev/null \
    || fail "focus must select scx_lavd through the scheduler ladder"
RG_X1GEN11_PROFILES="$profiles" "$script" show focus | rg 'hwp_dynamic_boost: 1' >/dev/null \
    || fail "focus may enable HWP dynamic boost"
RG_X1GEN11_PROFILES="$profiles" "$script" show memory-pressure | rg 'damon_reclaim: true' >/dev/null \
    || fail "memory-pressure must enable DAMON reclaim"
RG_X1GEN11_PROFILES="$profiles" "$script" show undocked-mixed | rg 'scx_mode: off' >/dev/null \
    || fail "undocked-mixed must avoid sched_ext userspace overhead"
RG_X1GEN11_PROFILES="$profiles" "$script" show travel | rg 'scx_mode: off' >/dev/null \
    || fail "travel must avoid sched_ext userspace overhead"
RG_X1GEN11_PROFILES="$profiles" "$script" show build-heavy | rg 'scx_mode: rusty' >/dev/null \
    || fail "build-heavy must select scx_rusty"

tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT
mkdir -p "$tmpdir/bin" "$tmpdir/home/.local/bin" "$tmpdir/root"

RG_X1GEN11_PROFILES="$profiles" "$script" root-helper-script "$tmpdir/root-helper" >/dev/null \
    || fail "root-helper-script command must write a generic root helper"
bash -n "$tmpdir/root-helper" \
    || fail "generic root helper must be valid shell"
rg -q 'PROFILES_JSON=' "$tmpdir/root-helper" \
    || fail "generic root helper must load profile JSON"
rg -q 'json.load' "$tmpdir/root-helper" \
    || fail "generic root helper must parse profile JSON"
rg -q 'hwp_dynamic_boost' "$tmpdir/root-helper" \
    || fail "generic root helper must write HWP dynamic boost policy"
if rg -q '^[[:space:]]*(undocked-mixed|build-heavy|focus|memory-pressure|travel|docked-office)[)]' \
    "$tmpdir/root-helper"; then
    fail "generic root helper must not duplicate per-profile policy blocks"
fi

cat >"$tmpdir/bin/fake-sudo" <<'SH'
#!/usr/bin/env bash
set -euo pipefail

root=${RG_X1GEN11_FAKE_ROOT:?}

map_path() {
    case "$1" in
    /etc/* | /sys/*) printf '%s%s\n' "$root" "$1" ;;
    *) printf '%s\n' "$1" ;;
    esac
}

if [ "${1:-}" = "-n" ]; then
    shift
    cmd=${1:?}
    shift || true
    "$cmd" "$@"
    exit $?
fi

cmd=${1:?}
shift || true
case "$cmd" in
mkdir)
    if [ "${1:-}" = "-p" ]; then
        shift
        for path in "$@"; do
            mkdir -p "$(map_path "$path")"
        done
    else
        printf 'fake-sudo: unsupported mkdir args: %s\n' "$*" >&2
        exit 2
    fi
    ;;
tee)
    target=${1:?}
    mapped=$(map_path "$target")
    mkdir -p "$(dirname "$mapped")"
    cat >"$mapped"
    ;;
systemctl)
    printf 'sudo systemctl %s\n' "$*" >>"$root/commands.log"
    ;;
*)
    printf 'fake-sudo: unsupported command: %s\n' "$cmd" >&2
    exit 2
    ;;
esac
SH
chmod +x "$tmpdir/bin/fake-sudo"

cat >"$tmpdir/bin/systemctl" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
printf 'systemctl %s\n' "$*" >>"${RG_X1GEN11_FAKE_ROOT:?}/commands.log"
SH
chmod +x "$tmpdir/bin/systemctl"

cat >"$tmpdir/home/.local/bin/rg-sched-ladder" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
case "${1:-}" in
current)
    printf '%s\n' "${RG_SCHED_FAKE_CURRENT:-off}"
    ;;
*)
    printf 'rg-sched-ladder %s\n' "$*" >>"${RG_X1GEN11_FAKE_ROOT:?}/commands.log"
    ;;
esac
SH
chmod +x "$tmpdir/home/.local/bin/rg-sched-ladder"

RG_X1GEN11_PROFILES="$profiles" \
    RG_X1GEN11_STATE_DIR="$tmpdir/state" \
    RG_X1GEN11_ROOT_HELPER="$tmpdir/missing-root-helper" \
    RG_X1GEN11_SUDO="$tmpdir/bin/fake-sudo" \
    RG_X1GEN11_FAKE_ROOT="$tmpdir/root" \
    RG_SCHED_FAKE_CURRENT=rusty \
    HOME="$tmpdir/home" \
    PATH="$tmpdir/bin:$PATH" \
    "$script" apply travel >/dev/null

test "$(cat "$tmpdir/state/active-profile")" = travel \
    || fail "apply must record the active profile"
test -r "$tmpdir/root/etc/systemd/zram-generator.conf.d/10-rg-profile.conf" \
    || fail "apply must create the zram-generator drop-in"
rg -q 'zram-size = ram / 4' "$tmpdir/root/etc/systemd/zram-generator.conf.d/10-rg-profile.conf" \
    || fail "travel apply must write the travel zram size"
rg -q 'sudo systemctl daemon-reload' "$tmpdir/root/commands.log" \
    || fail "apply must reload systemd for zram-generator"
rg -q 'sudo systemctl restart --no-block systemd-zram-setup@zram0.service' "$tmpdir/root/commands.log" \
    || fail "apply must restart the zram setup unit"
rg -q 'systemctl --user set-property browser.slice MemoryHigh=5G' "$tmpdir/root/commands.log" \
    || fail "apply must set the browser slice cap"
rg -q 'systemctl --user set-property build.slice MemoryHigh=8G' "$tmpdir/root/commands.log" \
    || fail "apply must set the build slice cap"
rg -q 'rg-sched-ladder switch off' "$tmpdir/root/commands.log" \
    || fail "travel apply must keep sched_ext unloaded"
if [ -e /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor ]; then
    rg -q '^powersave$' "$tmpdir/root/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor" \
        || fail "apply must write CPU governors through sudo"
fi
if [ -e /sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference ]; then
    rg -q '^power$' "$tmpdir/root/sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference" \
        || fail "apply must write CPU EPP through sudo"
fi
if [ -e /sys/devices/system/cpu/intel_pstate/hwp_dynamic_boost ]; then
    rg -q '^0$' "$tmpdir/root/sys/devices/system/cpu/intel_pstate/hwp_dynamic_boost" \
        || fail "apply must write HWP dynamic boost through sudo"
fi

stale_state="$tmpdir/stale-state"
stale_root="$tmpdir/stale-root"
mkdir -p \
    "$stale_state" \
    "$stale_root/sys/firmware/acpi" \
    "$stale_root/sys/devices/system/cpu/cpu0/cpufreq" \
    "$stale_root/sys/devices/system/cpu/intel_pstate" \
    "$stale_root/sys/module/iwlwifi/parameters"
printf 'low-power balanced performance\n' >"$stale_root/sys/firmware/acpi/platform_profile_choices"
printf 'balanced\n' >"$stale_root/sys/firmware/acpi/platform_profile"
printf 'powersave\n' >"$stale_root/sys/devices/system/cpu/cpu0/cpufreq/scaling_available_governors"
printf 'powersave\n' >"$stale_root/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor"
printf 'power balance_power balance_performance performance\n' \
    >"$stale_root/sys/devices/system/cpu/cpu0/cpufreq/energy_performance_available_preferences"
printf 'balance_power\n' >"$stale_root/sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference"
printf '1\n' >"$stale_root/sys/devices/system/cpu/intel_pstate/hwp_dynamic_boost"
printf 'Y\n' >"$stale_root/sys/module/iwlwifi/parameters/power_save"

cat >"$tmpdir/stale-root-helper" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
printf 'balanced\n' >"${RG_X1GEN11_FAKE_ROOT:?}/sys/firmware/acpi/platform_profile"
printf 'powersave\n' >"${RG_X1GEN11_FAKE_ROOT:?}/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor"
printf 'balance_power\n' >"${RG_X1GEN11_FAKE_ROOT:?}/sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference"
printf '1\n' >"${RG_X1GEN11_FAKE_ROOT:?}/sys/devices/system/cpu/intel_pstate/hwp_dynamic_boost"
printf 'Y\n' >"${RG_X1GEN11_FAKE_ROOT:?}/sys/module/iwlwifi/parameters/power_save"
SH
chmod +x "$tmpdir/stale-root-helper"

RG_X1GEN11_PROFILES="$profiles" \
    RG_X1GEN11_STATE_DIR="$stale_state" \
    RG_X1GEN11_ROOT_HELPER="$tmpdir/stale-root-helper" \
    RG_X1GEN11_SYSFS_ROOT="$stale_root/sys" \
    RG_X1GEN11_SUDO="$tmpdir/bin/fake-sudo" \
    RG_X1GEN11_FAKE_ROOT="$stale_root" \
    HOME="$tmpdir/home" \
    PATH="$tmpdir/bin:$PATH" \
    "$script" apply undocked-mixed >"$tmpdir/stale-apply.out" 2>&1
# A successful root helper is trusted: the wrapper must not re-issue the
# privileged writes inline (that path needs an interactive sudo the systemd
# user service cannot satisfy). The helper's writes are therefore left as-is.
rg -q '^balanced$' "$stale_root/sys/firmware/acpi/platform_profile" \
    || fail "apply must trust a successful root helper and not override its platform write"
rg -q '^1$' "$stale_root/sys/devices/system/cpu/intel_pstate/hwp_dynamic_boost" \
    || fail "apply must not re-issue privileged writes after a successful helper"
test "$(cat "$stale_state/active-profile")" = undocked-mixed \
    || fail "apply must still record the profile and exit cleanly after a trusted helper"

check_state="$tmpdir/check-state"
fake_sys="$tmpdir/check-sys"
fake_proc="$tmpdir/check-proc"
mkdir -p \
    "$check_state" \
    "$fake_sys/firmware/acpi" \
    "$fake_sys/devices/system/cpu/cpu0/cpufreq" \
    "$fake_sys/devices/system/cpu/intel_pstate" \
    "$fake_sys/module/iwlwifi/parameters" \
    "$fake_proc/pressure"

printf 'undocked-mixed\n' >"$check_state/active-profile"
printf 'low-power\n' >"$fake_sys/firmware/acpi/platform_profile"
printf 'low-power balanced performance\n' >"$fake_sys/firmware/acpi/platform_profile_choices"
printf 'powersave\n' >"$fake_sys/devices/system/cpu/cpu0/cpufreq/scaling_governor"
printf 'power\n' >"$fake_sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference"
printf '0\n' >"$fake_sys/devices/system/cpu/intel_pstate/hwp_dynamic_boost"
printf 'Y\n' >"$fake_sys/module/iwlwifi/parameters/power_save"

if RG_X1GEN11_PROFILES="$profiles" \
    RG_X1GEN11_STATE_DIR="$check_state" \
    RG_X1GEN11_SYSFS_ROOT="$fake_sys" \
    RG_X1GEN11_PROC_ROOT="$fake_proc" \
    HOME="$tmpdir/home" \
    PATH="$tmpdir/bin:$PATH" \
    "$script" doctor --check >"$tmpdir/doctor-drift.out" 2>&1; then
    fail "doctor --check must fail on EPP drift"
fi
rg -q 'profile drift: energy_performance_preference live=power expected=balance_power' \
    "$tmpdir/doctor-drift.out" \
    || fail "doctor --check must report EPP drift"

printf 'balance_power\n' >"$fake_sys/devices/system/cpu/cpu0/cpufreq/energy_performance_preference"
printf '1\n' >"$fake_sys/devices/system/cpu/intel_pstate/hwp_dynamic_boost"
if RG_X1GEN11_PROFILES="$profiles" \
    RG_X1GEN11_STATE_DIR="$check_state" \
    RG_X1GEN11_SYSFS_ROOT="$fake_sys" \
    RG_X1GEN11_PROC_ROOT="$fake_proc" \
    HOME="$tmpdir/home" \
    PATH="$tmpdir/bin:$PATH" \
    "$script" doctor --check >"$tmpdir/doctor-hwp-drift.out" 2>&1; then
    fail "doctor --check must fail on HWP dynamic boost drift"
fi
rg -q 'profile drift: hwp_dynamic_boost live=1 expected=0' \
    "$tmpdir/doctor-hwp-drift.out" \
    || fail "doctor --check must report HWP dynamic boost drift"

printf '0\n' >"$fake_sys/devices/system/cpu/intel_pstate/hwp_dynamic_boost"
if RG_X1GEN11_PROFILES="$profiles" \
    RG_X1GEN11_STATE_DIR="$check_state" \
    RG_X1GEN11_SYSFS_ROOT="$fake_sys" \
    RG_X1GEN11_PROC_ROOT="$fake_proc" \
    RG_SCHED_FAKE_CURRENT=rusty \
    HOME="$tmpdir/home" \
    PATH="$tmpdir/bin:$PATH" \
    "$script" doctor --check >"$tmpdir/doctor-sched-drift.out" 2>&1; then
    fail "doctor --check must fail on scheduler mode drift"
fi
rg -q 'profile drift: scx_mode live=rusty expected=off' \
    "$tmpdir/doctor-sched-drift.out" \
    || fail "doctor --check must report scheduler mode drift"

RG_X1GEN11_PROFILES="$profiles" \
    RG_X1GEN11_STATE_DIR="$check_state" \
    RG_X1GEN11_SYSFS_ROOT="$fake_sys" \
    RG_X1GEN11_PROC_ROOT="$fake_proc" \
    HOME="$tmpdir/home" \
    PATH="$tmpdir/bin:$PATH" \
    "$script" doctor --check >"$tmpdir/doctor-ok.out" 2>&1 \
    || fail "doctor --check must pass when live policy matches active profile"
rg -q '^profile policy: ok$' "$tmpdir/doctor-ok.out" \
    || fail "doctor --check must print policy success"

printf 'ok\n'
