#!/usr/bin/env bash
# Managed by chezmoi (dot_local/bin/executable_rg-vale-project-vocab).

set -euo pipefail

usage() {
    cat >&2 <<'EOF'
usage: rg-vale-project-vocab [--root DIR] [--name NAME] accept|reject TERM [TERM...]
       rg-vale-project-vocab [--root DIR] [--name NAME] rename NAME
       rg-vale-project-vocab [--root DIR] [--name NAME] id|list|sync|import-existing|prune|audit|report

Maintain project-local Vale vocabulary overlays backed by a SQLite registry.
The materialized vocabulary name is <project-slug>-<project-hash>, where the
hash is derived from remote.origin.url when available, otherwise the root path.
EOF
    exit 2
}

slugify() {
    local value=${1:-}
    value=$(
        printf '%s' "$value" \
            | LC_ALL=C tr '[:upper:]' '[:lower:]' \
            | sed -E 's/[^a-z0-9._-]+/-/g; s/^[._-]+//; s/[._-]+$//; s/-+/-/g'
    )
    [ -n "$value" ] || value=local
    printf '%s\n' "$value"
}

sql_literal() {
    local value=${1//\'/\'\'}
    printf "'%s'" "$value"
}

root=
slug_override=
while [ $# -gt 0 ]; do
    case "${1:-}" in
        --root)
            [ $# -ge 2 ] || usage
            root=$2
            shift 2
            ;;
        --name)
            [ $# -ge 2 ] || usage
            slug_override=$2
            shift 2
            ;;
        -h | --help)
            usage
            ;;
        --)
            shift
            break
            ;;
        -*)
            usage
            ;;
        *)
            break
            ;;
    esac
done

[ $# -ge 1 ] || usage
command_name=$1
shift

rename_target=
case "$command_name" in
    accept | reject)
        [ $# -ge 1 ] || usage
        ;;
    rename)
        [ $# -eq 1 ] || usage
        rename_target=$1
        ;;
    id | list | sync | import-existing | prune | audit | report)
        [ $# -eq 0 ] || usage
        ;;
    *)
        usage
        ;;
esac

if [ -z "$root" ]; then
    if root=$(git rev-parse --show-toplevel 2>/dev/null); then
        :
    else
        root=$PWD
    fi
fi

mkdir -p "$root"
root=$(cd -- "$root" && pwd)

remote=$(git -C "$root" config --get remote.origin.url 2>/dev/null || true)
hash_source=${remote:-$root}
project_hash=$(printf '%s' "$hash_source" | sha256sum | awk '{print substr($1, 1, 12)}')
[ -z "$rename_target" ] || slug_override=$rename_target
project_slug=$(slugify "${slug_override:-$(basename "$root")}")
vocab_name="$project_slug-$project_hash"

global_config=${RG_VALE_GLOBAL_CONFIG:-"$HOME/.config/vale/.vale.ini"}
global_styles=${RG_VALE_STYLES_PATH:-"$HOME/.config/vale/styles"}
state_home=${XDG_STATE_HOME:-"$HOME/.local/state"}
registry_db=${RG_VALE_REGISTRY_DB:-"$state_home/rg-vale-vocab/registry.sqlite"}
project_config="$root/.vale.ini"
vocab_root="$root/styles/config/vocabularies"
vocab_dir="$vocab_root/$vocab_name"

test -r "$global_config" || {
    printf 'missing global Vale config: %s\n' "$global_config" >&2
    exit 1
}
test -d "$global_styles" || {
    printf 'missing global Vale styles: %s\n' "$global_styles" >&2
    exit 1
}
command -v sqlite3 >/dev/null 2>&1 || {
    printf 'missing sqlite3\n' >&2
    exit 1
}

init_db() {
    mkdir -p "$(dirname "$registry_db")"
    sqlite3 "$registry_db" <<'SQL'
PRAGMA foreign_keys = ON;
CREATE TABLE IF NOT EXISTS projects (
    hash TEXT PRIMARY KEY,
    slug TEXT NOT NULL,
    vocab TEXT NOT NULL,
    root TEXT NOT NULL,
    remote TEXT,
    hash_source TEXT NOT NULL,
    created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP
);
CREATE TABLE IF NOT EXISTS terms (
    project_hash TEXT NOT NULL,
    mode TEXT NOT NULL CHECK (mode IN ('accept', 'reject')),
    term TEXT NOT NULL,
    created_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TEXT NOT NULL DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (project_hash, mode, term),
    FOREIGN KEY (project_hash) REFERENCES projects(hash) ON DELETE CASCADE
);
SQL
}

ensure_project() {
    sqlite3 "$registry_db" "
        INSERT INTO projects (hash, slug, vocab, root, remote, hash_source, created_at, updated_at)
        VALUES (
            $(sql_literal "$project_hash"),
            $(sql_literal "$project_slug"),
            $(sql_literal "$vocab_name"),
            $(sql_literal "$root"),
            $(sql_literal "$remote"),
            $(sql_literal "$hash_source"),
            CURRENT_TIMESTAMP,
            CURRENT_TIMESTAMP
        )
        ON CONFLICT(hash) DO UPDATE SET
            slug = excluded.slug,
            vocab = excluded.vocab,
            root = excluded.root,
            remote = excluded.remote,
            hash_source = excluded.hash_source,
            updated_at = CURRENT_TIMESTAMP;
    "
}

insert_term() {
    local mode=$1
    local term=$2
    [ -n "$term" ] || return 0
    sqlite3 "$registry_db" "
        INSERT INTO terms (project_hash, mode, term, created_at, updated_at)
        VALUES (
            $(sql_literal "$project_hash"),
            $(sql_literal "$mode"),
            $(sql_literal "$term"),
            CURRENT_TIMESTAMP,
            CURRENT_TIMESTAMP
        )
        ON CONFLICT(project_hash, mode, term) DO UPDATE SET
            updated_at = CURRENT_TIMESTAMP;
    "
}

import_terms_file() {
    local mode=$1
    local file=$2
    [ -r "$file" ] || return 0
    while IFS= read -r term || [ -n "$term" ]; do
        [ -n "$term" ] || continue
        insert_term "$mode" "$term"
    done < "$file"
}

import_legacy_terms() {
    local legacy_dir
    for legacy_dir in "$vocab_root/Project" "$vocab_root/$project_slug" "$vocab_dir"; do
        [ -d "$legacy_dir" ] || continue
        import_terms_file accept "$legacy_dir/accept.txt"
        import_terms_file reject "$legacy_dir/reject.txt"
    done
}

import_existing_terms() {
    local existing_dir
    [ -d "$vocab_root" ] || return 0
    while IFS= read -r -d '' existing_dir; do
        import_terms_file accept "$existing_dir/accept.txt"
        import_terms_file reject "$existing_dir/reject.txt"
    done < <(find "$vocab_root" -mindepth 1 -maxdepth 1 -type d -print0 | sort -z)
}

rewrite_config() {
    local source_config=$project_config
    local tmp

    if [ ! -e "$source_config" ]; then
        source_config=$global_config
    fi

    tmp=$(mktemp)
    awk -v styles="$global_styles" -v vocab="$vocab_name" -v slug="$project_slug" -v registered="$registered_slug" -v hash="$project_hash" '
        function trim(s) {
            sub(/^[[:space:]]+/, "", s)
            sub(/[[:space:]]+$/, "", s)
            return s
        }
        function is_project_vocab(item) {
            if (item == "Project" || item == slug || item == registered || item == vocab) {
                return 1
            }
            if (hash != "" && item ~ ("-" hash "$")) {
                return 1
            }
            return 0
        }
        function add_vocab(item) {
            item = trim(item)
            if (item == "" || is_project_vocab(item) || seen[item]) {
                return
            }
            seen[item] = 1
            if (list == "") {
                list = item
            } else {
                list = list ", " item
            }
        }
        /^StylesPath[[:space:]]*=/ {
            print "StylesPath = " styles
            saw_styles = 1
            next
        }
        /^Vocab[[:space:]]*=/ {
            values = $0
            sub(/^Vocab[[:space:]]*=[[:space:]]*/, "", values)
            delete seen
            list = ""
            add_vocab("RG")
            n = split(values, parts, ",")
            for (i = 1; i <= n; i++) {
                add_vocab(parts[i])
            }
            if (list == "") {
                list = "RG"
            }
            print "Vocab = " list ", " vocab
            saw_vocab = 1
            next
        }
        { print }
        END {
            if (!saw_styles) {
                print "StylesPath = " styles
            }
            if (!saw_vocab) {
                print "Vocab = RG, " vocab
            }
        }
    ' "$source_config" > "$tmp"
    mv "$tmp" "$project_config"
}

materialize_terms() {
    local mode=$1
    local target=$2
    sqlite3 "$registry_db" "
        SELECT term
        FROM terms
        WHERE project_hash = $(sql_literal "$project_hash")
          AND mode = $(sql_literal "$mode")
        ORDER BY lower(term), term;
    " > "$target"
}

materialize_project() {
    mkdir -p "$vocab_dir"
    rewrite_config
    materialize_terms accept "$vocab_dir/accept.txt"
    materialize_terms reject "$vocab_dir/reject.txt"
}

print_identity() {
    printf 'hash=%s\n' "$project_hash"
    printf 'slug=%s\n' "$project_slug"
    printf 'vocab=%s\n' "$vocab_name"
    printf 'root=%s\n' "$root"
    printf 'remote=%s\n' "$remote"
    printf 'hash_source=%s\n' "$hash_source"
    printf 'db=%s\n' "$registry_db"
}

list_terms() {
    sqlite3 -separator $'\t' "$registry_db" "
        SELECT mode, term
        FROM terms
        WHERE project_hash = $(sql_literal "$project_hash")
        ORDER BY mode, lower(term), term;
    "
}

term_count() {
    local mode=$1
    sqlite3 "$registry_db" "
        SELECT COUNT(*)
        FROM terms
        WHERE project_hash = $(sql_literal "$project_hash")
          AND mode = $(sql_literal "$mode");
    "
}

dir_state() {
    if [ -d "$1" ]; then
        printf 'ok\n'
    else
        printf 'missing\n'
    fi
}

file_state() {
    if [ -r "$1" ]; then
        printf 'ok\n'
    else
        printf 'missing\n'
    fi
}

audit_project() {
    printf 'hash=%s\n' "$project_hash"
    printf 'slug=%s\n' "$project_slug"
    printf 'vocab=%s\n' "$vocab_name"
    printf 'root=%s\n' "$root"
    printf 'root_state=%s\n' "$(dir_state "$root")"
    printf 'config_state=%s\n' "$(file_state "$project_config")"
    printf 'accept_file_state=%s\n' "$(file_state "$vocab_dir/accept.txt")"
    printf 'reject_file_state=%s\n' "$(file_state "$vocab_dir/reject.txt")"
    printf 'accept_terms=%s\n' "$(term_count accept)"
    printf 'reject_terms=%s\n' "$(term_count reject)"
}

report_projects() {
    local entry_hash
    local entry_slug
    local entry_vocab
    local entry_root
    local accept_count
    local reject_count
    local root_state

    printf 'hash\tslug\tvocab\troot_state\taccept_terms\treject_terms\troot\n'
    while IFS=$'\t' read -r entry_hash entry_slug entry_vocab entry_root accept_count reject_count; do
        [ -n "$entry_hash" ] || continue
        root_state=$(dir_state "$entry_root")
        printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
            "$entry_hash" \
            "$entry_slug" \
            "$entry_vocab" \
            "$root_state" \
            "$accept_count" \
            "$reject_count" \
            "$entry_root"
    done < <(
        sqlite3 -separator $'\t' "$registry_db" "
            SELECT
                p.hash,
                p.slug,
                p.vocab,
                p.root,
                (SELECT COUNT(*) FROM terms t WHERE t.project_hash = p.hash AND t.mode = 'accept'),
                (SELECT COUNT(*) FROM terms t WHERE t.project_hash = p.hash AND t.mode = 'reject')
            FROM projects p
            ORDER BY lower(p.slug), p.root, p.hash;
        "
    )
}

prune_missing_projects() {
    local entry_hash
    local entry_root
    local pruned=0

    while IFS=$'\t' read -r entry_hash entry_root; do
        [ -n "$entry_hash" ] || continue
        if [ -z "$entry_root" ] || [ ! -d "$entry_root" ]; then
            sqlite3 "$registry_db" "
                DELETE FROM terms
                WHERE project_hash = $(sql_literal "$entry_hash");
                DELETE FROM projects
                WHERE hash = $(sql_literal "$entry_hash");
            "
            pruned=$((pruned + 1))
        fi
    done < <(sqlite3 -separator $'\t' "$registry_db" "SELECT hash, root FROM projects ORDER BY hash;")

    printf 'pruned %s stale project(s)\n' "$pruned"
}

registered_slug=
load_registered_slug() {
    registered_slug=$(
        sqlite3 "$registry_db" "
            SELECT slug
            FROM projects
            WHERE hash = $(sql_literal "$project_hash")
            LIMIT 1;
        "
    )
    [ -n "$registered_slug" ] || return 0
    [ -z "$slug_override" ] || return 0
    project_slug=$registered_slug
    vocab_name="$project_slug-$project_hash"
    vocab_dir="$vocab_root/$vocab_name"
}

init_db
load_registered_slug
ensure_project
import_legacy_terms

case "$command_name" in
    accept | reject)
        for term in "$@"; do
            insert_term "$command_name" "$term"
        done
        materialize_project
        printf 'updated %s\n' "$vocab_dir/$command_name.txt"
        ;;
    id)
        print_identity
        ;;
    list)
        list_terms
        ;;
    sync)
        materialize_project
        printf 'synced %s\n' "$vocab_dir"
        ;;
    import-existing)
        import_existing_terms
        materialize_project
        printf 'imported %s\n' "$vocab_dir"
        ;;
    audit)
        audit_project
        ;;
    report)
        report_projects
        ;;
    rename)
        import_existing_terms
        materialize_project
        printf 'renamed %s\n' "$vocab_dir"
        ;;
    prune)
        prune_missing_projects
        ;;
esac
