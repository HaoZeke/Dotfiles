#!/usr/bin/env bash
# Managed by chezmoi (dot_local/bin/executable_rg-agent-sandbox).
#
# Run a coding agent so that the only files it can read are the ones the work
# needs.
#
# An agent that uploads context can only upload what it can open. Trusting it to
# choose well puts every key, token and unrelated repo on the machine one bad
# heuristic away from leaving; a filesystem that does not contain them removes
# the question. The home directory inside here is an empty tmpfs with a short
# list of things bound back in, so anything not named below is not merely
# unreadable, it does not exist.
#
#   rg-agent-sandbox [--allow PATH]... [--net none] -- COMMAND [ARGS...]
#
# The working directory is bound read-write. Everything else defaults to out.

set -euo pipefail

die() {
    echo "rg-agent-sandbox: $*" >&2
    exit 2
}

command -v bwrap >/dev/null 2>&1 || die "bubblewrap (bwrap) is not installed"

allow_paths=()
net_mode="share"
workdir="$PWD"

while [ $# -gt 0 ]; do
    case "$1" in
        --allow)
            [ $# -ge 2 ] || die "--allow needs a path"
            allow_paths+=("$2")
            shift 2
            ;;
        --net)
            [ $# -ge 2 ] || die "--net needs share or none"
            net_mode="$2"
            shift 2
            ;;
        --workdir)
            [ $# -ge 2 ] || die "--workdir needs a path"
            workdir="$2"
            shift 2
            ;;
        --)
            shift
            break
            ;;
        -h | --help)
            sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'
            exit 0
            ;;
        *)
            die "unknown argument: $1"
            ;;
    esac
done

[ $# -gt 0 ] || die "no command given (use -- COMMAND ...)"
[ -d "$workdir" ] || die "working directory does not exist: $workdir"

home="$HOME"
runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"

args=(
    --unshare-all
    --die-with-parent
    --new-session
    # System, read-only. The agent needs an interpreter and CA roots, not the
    # ability to modify either.
    --ro-bind /usr /usr
    --ro-bind /etc/ssl /etc/ssl
    --ro-bind /etc/ca-certificates /etc/ca-certificates
    --ro-bind /etc/resolv.conf /etc/resolv.conf
    --ro-bind /etc/hosts /etc/hosts
    --ro-bind /etc/nsswitch.conf /etc/nsswitch.conf
    --ro-bind /etc/passwd /etc/passwd
    --ro-bind /etc/group /etc/group
    --symlink usr/lib /lib
    --symlink usr/lib64 /lib64
    --symlink usr/bin /bin
    --symlink usr/sbin /sbin
    --proc /proc
    --dev /dev
    --tmpfs /tmp
    # An empty home. Everything the agent may see is bound back in below.
    --tmpfs "$home"
    --setenv HOME "$home"
    --setenv GROKOS_SANDBOX 1
)

if [ "$net_mode" = "share" ]; then
    args+=(--share-net)
elif [ "$net_mode" != "none" ]; then
    die "--net takes share or none"
fi

# The work itself.
args+=(--bind "$workdir" "$workdir")

# Runtime sockets the seat protocol needs, without exposing the rest of the
# runtime directory.
[ -d "$runtime" ] && args+=(--tmpfs "$runtime")

ro_if_present() {
    [ -e "$1" ] && args+=(--ro-bind "$1" "$1")
    return 0
}

rw_if_present() {
    [ -e "$1" ] && args+=(--bind "$1" "$1")
    return 0
}

# Interpreters and the agent's own code, read-only: it should run from these,
# not rewrite them.
ro_if_present "$home/.local/bin"
ro_if_present "$home/.bun"
ro_if_present "$home/.npm-global"
ro_if_present "$home/.nvm"
# Where the tools are actually installed. A launcher on PATH is usually a
# symlink into a versioned directory elsewhere, and binding the link without its
# target fails with "No such file or directory" naming a command that plainly
# exists. Resolved rather than listed, so a tool installed anywhere under the
# home directory works without being named here and nothing goes stale when an
# installer changes its layout. Read-only: a tool should run from its
# installation, not rewrite it.
seen_dirs=""
for link in "$home/.local/bin"/* "$home/.bun/bin"/*; do
    [ -L "$link" ] || continue
    resolved="$(readlink -f -- "$link" 2>/dev/null)" || continue
    case "$resolved" in "$home"/*) ;; *) continue ;; esac
    dir="$(dirname -- "$resolved")"
    case ":$seen_dirs:" in *":$dir:"*) continue ;; esac
    seen_dirs="$seen_dirs:$dir"
    ro_if_present "$dir"
done

# Seat state, writable because sessions and caches are written here.
rw_if_present "$home/.grok"
rw_if_present "$home/.pi"
rw_if_present "$home/.hermes"

for extra in ${allow_paths+"${allow_paths[@]}"}; do
    [ -e "$extra" ] || die "--allow path does not exist: $extra"
    args+=(--bind "$extra" "$extra")
done

# Bind whatever the command actually resolves to. Launchers are commonly
# symlinks on PATH pointing into a checkout elsewhere, and binding the link
# without its target produces "No such file or directory" naming the command
# that plainly exists, because inside here it points at nothing.
target="$(command -v -- "$1" 2>/dev/null || true)"
if [ -n "$target" ]; then
    real="$(readlink -f -- "$target" 2>/dev/null || printf '%s' "$target")"
    real_dir="$(dirname -- "$real")"
    case "$real_dir" in
        "$home"/*)
            # Bind the project the launcher lives in, not just its bin
            # directory, since a launcher generally reads files beside itself.
            project="$real_dir"
            [ "$(basename -- "$real_dir")" = "bin" ] && project="$(dirname -- "$real_dir")"
            printf '%s\n' "${allow_paths[@]:-}" | grep -qxF "$project" 2>/dev/null \
                || args+=(--ro-bind "$project" "$project")
            ;;
    esac
fi

# Deliberately absent, and worth naming so the list is auditable rather than
# implied: ssh keys, gpg keys, the password store, the dotfiles vault, mail,
# browser profiles, and every repository other than the working directory.

exec bwrap "${args[@]}" --chdir "$workdir" -- "$@"
