#!/usr/bin/env bash
# Managed by chezmoi (dot_local/bin/executable_rg-rgsurflat-system-selftest).

set -euo pipefail

if [ $# -gt 1 ]; then
    printf 'usage: rg-rgsurflat-system-selftest [chezmoi-source]\n' >&2
    exit 2
fi

if [ $# -eq 1 ]; then
    REPO="$1"
else
    REPO="${CHEZMOI_SOURCE_DIR:-$HOME/.local/share/chezmoi}"
fi

fail() {
    printf 'FAIL: %s\n' "$*" >&2
    exit 1
}

rgsurflat_system="$REPO/.chezmoiscripts/run_onchange_linux_rgsurflat_system.sh.tmpl"
test -r "$rgsurflat_system" || fail "missing rgSURFLat system provisioning script"

rg -q 'chmod 711 "\$HOME"' "$rgsurflat_system" \
    || fail "rgSURFLat provisioning does not keep home traversable for browser and Electron helpers"
if rg -n 'chmod 75[0-9] "\$HOME"|chmod 7[0-9]5 "\$HOME"' "$rgsurflat_system"; then
    fail "rgSURFLat provisioning must not make home listable"
fi
rg -q 'Domains=~ts\.net' "$rgsurflat_system" \
    || fail "rgSURFLat DNS must route only Tailscale names to local unbound"
if rg -n 'Domains=~\.|name: "\."|forward-addr: 1\.1\.1\.1|forward-addr: 9\.9\.9\.9' "$rgsurflat_system"; then
    fail "rgSURFLat DNS must not force all domains through local unbound or public forwarders"
fi
if rg -n 'enable --now glam\.service|restart=always' "$rgsurflat_system"; then
    fail "rgSURFLat provisioning must not auto-start glam while route safety is manual"
fi
if rg -n 'glam\.service|/usr/local/bin/glam|GLAM_UNIT' "$rgsurflat_system"; then
    fail "rgSURFLat provisioning must not manage glam; eduVPN CLI owns SURF institute access"
fi
rg -q '49-rg-eduvpn-networkmanager.rules' "$rgsurflat_system" \
    || fail "rgSURFLat provisioning does not install the eduVPN NetworkManager polkit rule"
rg -q 'org.freedesktop.NetworkManager.settings.modify.system' "$rgsurflat_system" \
    || fail "eduVPN polkit rule does not allow replacing the system VPN profile"
rg -q 'rg-eduvpn-ensure' "$rgsurflat_system" \
    || fail "rgSURFLat provisioning does not install the eduVPN ensure helper"
rg -q 'cli="\$home_dir/.local/bin/eduvpn-cli"' "$rgsurflat_system" \
    || fail "eduVPN ensure helper does not use the official CLI path"
rg -q '"\$cli" connect --tcp -n 1' "$rgsurflat_system" \
    || fail "eduVPN ensure helper does not reconnect through the official CLI"
rg -q 'DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/\$uid/bus' "$rgsurflat_system" \
    || fail "eduVPN ensure helper does not target the user session bus"
rg -q 'nmcli connection up eduVPN' "$rgsurflat_system" \
    || fail "eduVPN ensure helper does not fall back to the existing NetworkManager profile"
rg -q 'rg-eduvpn-ensure.timer' "$rgsurflat_system" \
    || fail "rgSURFLat provisioning does not install the eduVPN keepalive timer"
rg -q 'OnUnitActiveSec=120s' "$rgsurflat_system" \
    || fail "eduVPN keepalive timer cadence is not managed"
rg -q 'Amsterdam Science Park" connection.autoconnect no' "$rgsurflat_system" \
    || fail "rgSURFLat provisioning does not disable Amsterdam Science Park autoconnect"

printf 'ok\n'
