#!/bin/sh
# HaoZeke/vissue launcher. The cargo binary is vissue-cli next to this
# script. Default root comes from VISSUE_ROOT, then
# $XDG_CONFIG_HOME/vissue/root, then the cargo cwd walk.
set -eu

if [ -z "${VISSUE_ROOT:-}" ]; then
    cfg="${XDG_CONFIG_HOME:-${HOME}/.config}/vissue/root"
    if [ -r "$cfg" ]; then
        VISSUE_ROOT=$(sed -n '1p' "$cfg")
        export VISSUE_ROOT
    fi
fi

if [ -x "${VISSUE_BIN:-}" ]; then
    exec "${VISSUE_BIN}" "$@"
fi
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if [ -x "$here/vissue-cli" ]; then
    exec "$here/vissue-cli" "$@"
fi
if command -v vissue-cli >/dev/null 2>&1; then
    exec vissue-cli "$@"
fi
printf '[vissue] cargo CLI missing (install HaoZeke/vissue as vissue-cli)\n' >&2
exit 127
