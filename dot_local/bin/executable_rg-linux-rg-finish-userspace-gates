#!/usr/bin/env bash
# Managed by chezmoi (dot_local/bin/executable_rg-linux-rg-finish-userspace-gates).

set -euo pipefail

effective_euid=${RG_FINISH_EUID:-$EUID}
user_name=${RG_FINISH_USER:-${SUDO_USER:-rgoswami}}
target_root=${RG_FINISH_ROOT:-}
repo=${RG_FINISH_REPO:-/home/rgoswami/Git/Github/Tools/linux-rg}
chezmoi=${RG_FINISH_CHEZMOI:-/home/rgoswami/.local/share/chezmoi}

if [[ -n ${RG_FINISH_USER_HOME:-} ]]; then
    user_home=$RG_FINISH_USER_HOME
else
    user_home=$(getent passwd "$user_name" | cut -d: -f6)
    if [[ -z $user_home || ! -d $user_home ]]; then
        user_name=rgoswami
        user_home=/home/rgoswami
    fi
fi

root_setup=$user_home/.local/bin/rg-linux-rg-userspace-root-setup
postboot=$user_home/.local/bin/rg-linux-rg-postboot-check
bench_matrix=$user_home/.local/bin/rg-bench-matrix
source_icon=$repo/os_linux_rg.png
package_icon=/usr/share/linux-rg/refind/os_linux_rg.png
boot_icon=/boot/EFI/refind/icons/os_linux_rg.png

if [[ $effective_euid != 0 ]]; then
    printf 'error: run as root\n' >&2
    exit 1
fi

target_path() {
    local path=$1
    if [[ -n $target_root && $path = /* ]]; then
        printf '%s%s\n' "$target_root" "$path"
    else
        printf '%s\n' "$path"
    fi
}

require_file() {
    local path=$1
    if [[ ! -e $path ]]; then
        printf 'error: missing %s\n' "$path" >&2
        exit 1
    fi
}

install_user_helper() {
    local source=$1 target=$2
    require_file "$source"
    install -D -m 0755 -o "$user_name" -g "$(id -gn "$user_name")" "$source" "$target"
    printf 'installed: %s\n' "$target"
}

install_root_data() {
    local source=$1 target=$2
    require_file "$source"
    install -Dm644 "$source" "$(target_path "$target")"
    printf 'installed: %s\n' "$target"
}

png_color_type() {
    local path=$1
    od -An -tu1 -j25 -N1 "$path" 2>/dev/null | tr -d '[:space:]'
}

png_corner_alpha() {
    local path=$1
    python3 - "$path" 2>/dev/null <<'PY' || true
import struct
import sys
import zlib

path = sys.argv[1]
with open(path, "rb") as handle:
    data = handle.read()

if data[:8] != b"\x89PNG\r\n\x1a\n":
    raise SystemExit(1)

pos = 8
width = bit_depth = color_type = interlace = None
idat = []
while pos + 8 <= len(data):
    length = struct.unpack(">I", data[pos : pos + 4])[0]
    kind = data[pos + 4 : pos + 8]
    chunk = data[pos + 8 : pos + 8 + length]
    pos += length + 12
    if kind == b"IHDR":
        width, _height, bit_depth, color_type, _compression, _filter, interlace = struct.unpack(
            ">IIBBBBB", chunk
        )
    elif kind == b"IDAT":
        idat.append(chunk)
    elif kind == b"IEND":
        break

if bit_depth != 8 or color_type not in (4, 6) or interlace != 0 or not idat:
    raise SystemExit(1)

raw = zlib.decompress(b"".join(idat))
channels = {4: 2, 6: 4}[color_type]
first_row = raw[: 1 + (width * channels)]
if len(first_row) < 1 + channels:
    raise SystemExit(1)

print(first_row[channels])
PY
}

verify_icon_alpha() {
    local path=$1 color_type corner_alpha
    color_type=$(png_color_type "$path")
    case "$color_type" in
    4 | 6)
        printf 'ok: %s keeps PNG alpha channel\n' "$path"
        ;;
    *)
        printf 'error: %s lacks PNG alpha channel (color type %s)\n' "$path" "${color_type:-unreadable}" >&2
        exit 1
        ;;
    esac

    corner_alpha=$(png_corner_alpha "$path")
    case "$corner_alpha" in
    0)
        printf 'ok: %s has transparent corner\n' "$path"
        ;;
    "")
        printf 'error: %s corner alpha unreadable\n' "$path" >&2
        exit 1
        ;;
    *)
        printf 'error: %s corner is not transparent: alpha %s\n' "$path" "$corner_alpha" >&2
        exit 1
        ;;
    esac
}

run_user() {
    sudo -u "$user_name" HOME="$user_home" XDG_CONFIG_HOME="$user_home/.config" "$@"
}

printf '== linux-rg package/user state ==\n'
pacman -Q linux-rg linux-rg-headers linux linux-headers mkinitcpio refind
uname -a

printf '\n== transparent rEFInd icon ==\n'
install_root_data "$source_icon" "$package_icon"
install_root_data "$source_icon" "$boot_icon"
verify_icon_alpha "$(target_path "$package_icon")"
verify_icon_alpha "$(target_path "$boot_icon")"

printf '\n== sync managed helpers ==\n'
install_user_helper "$chezmoi/dot_local/bin/executable_rg-linux-rg-userspace-root-setup" "$root_setup"
install_user_helper "$repo/rgx1gen11-live-check" "$user_home/.local/bin/rgx1gen11-live-check"
for helper in \
    rg-memory-sysctl-check \
    rg-pipewire-rt-check \
    rg-oomd-policy-check \
    rg-ksm-policy \
    rg-storage-trim-check \
    rg-zswap-tune \
    rg-thermal-stack-check \
    rg-x1gen11-profile \
    rg-sched-ladder \
    rg-scx-loader \
    rg-damon-reclaim \
    rg-psi-snapshot \
    rg-psi-top \
    rg-hfi-status; do
    install_user_helper "$chezmoi/dot_local/bin/executable_$helper" "$user_home/.local/bin/$helper"
done
install_user_helper "$chezmoi/dot_local/bin/executable_rg-linux-rg-postboot-check" "$postboot"
install_user_helper "$chezmoi/dot_local/bin/executable_rg-bench-matrix" "$bench_matrix"

printf '\n== userspace root setup ==\n'
"$root_setup"

printf '\n== postboot check ==\n'
"$postboot"

printf '\n== non-root policy gate matrix ==\n'
tmpdir=$(run_user mktemp -d /tmp/rg-bench-gates-final.XXXXXX)
run_dir=$(run_user env RG_BENCH_DIR="$tmpdir" "$bench_matrix" --quick new)
run_user env RG_BENCH_DIR="$tmpdir" "$bench_matrix" --quick run gates "$run_dir" \
    >/tmp/rg-bench-gates-final-run.out 2>&1
printf 'run_dir=%s\n' "$run_dir"
run_user "$bench_matrix" report "$run_dir"

printf '\nlinux-rg userspace finish gates completed\n'
