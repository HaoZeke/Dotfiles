#!/usr/bin/env bash
# Validate and install the SURF medewerkers-split OpenVPN profile.
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
validator="${RG_SURF_VALIDATOR:-$script_dir/rg-surf-vpn-validate}"
installer="${RG_SURF_APPLY:-$script_dir/rg-surf-vpn-apply}"
if [ ! -x "$validator" ] && [ -x "$script_dir/executable_rg-surf-vpn-validate" ]; then
    validator="$script_dir/executable_rg-surf-vpn-validate"
fi
if [ ! -x "$installer" ] && [ -r "$script_dir/executable_rg-surf-vpn-apply" ]; then
    installer="$script_dir/executable_rg-surf-vpn-apply"
fi

usage() {
    printf 'usage: rg-surf-vpn-install --validate-only PROFILE\n' >&2
    printf '       rg-surf-vpn-install install PROFILE\n' >&2
}

case "$#:${1:-}" in
    2:--validate-only)
        exec "$validator" "$2"
        ;;
    2:install)
        if [ -x "$installer" ]; then
            RG_SURF_VALIDATOR="$validator" exec "$installer" "$2"
        fi
        RG_SURF_VALIDATOR="$validator" exec bash "$installer" "$2"
        ;;
    *)
        usage
        exit 2
        ;;
esac
