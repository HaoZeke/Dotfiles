#!/usr/bin/env python3
"""Validate a SURF medewerkers-split OpenVPN export without exposing secrets."""

from __future__ import annotations

import collections
import datetime as dt
import json
import os
import re
import shlex
import shutil
import stat
import subprocess
import sys
import tempfile
from pathlib import Path


DEFAULT_CA_SHA256 = "0D:7D:E6:6B:18:BA:08:F1:C0:CA:56:15:87:5F:51:E1:BD:1C:18:E2:22:AA:64:A4:4F:7E:77:FB:B2:AA:3B:EC"
BLOCK_NAMES = ("ca", "cert", "key", "tls-crypt")
EXPECTED_DIRECTIVES = collections.Counter(
    {
        ("dev", "tun"): 1,
        ("client",): 1,
        ("nobind",): 1,
        ("remote-cert-tls", "server"): 1,
        ("verb", "3"): 1,
        ("server-poll-timeout", "10"): 1,
        ("tls-version-min", "1.3"): 1,
        ("data-ciphers", "AES-256-GCM:CHACHA20-POLY1305"): 1,
        ("reneg-sec", "0"): 1,
        ("script-security", "0"): 1,
        ("remote", "medewerkers-split.surf.eduvpn.nl", "1197", "udp"): 1,
        ("remote", "medewerkers-split.surf.eduvpn.nl", "1197", "tcp"): 1,
    }
)


class ValidationError(Exception):
    """A bounded error that is safe to expose in logs and notifications."""


class InstallError(Exception):
    """A bounded profile installation or tunnel-health error."""


def normalize_fingerprint(value: str) -> str:
    return value.replace(":", "").strip().upper()


def parse_profile(path: Path) -> tuple[collections.Counter[tuple[str, ...]], dict[str, str]]:
    try:
        file_stat = path.lstat()
    except OSError as error:
        raise ValidationError(f"cannot stat profile: {error.strerror}") from error
    if stat.S_ISLNK(file_stat.st_mode) or not stat.S_ISREG(file_stat.st_mode):
        raise ValidationError("profile must be a regular file, not a symlink")
    if stat.S_IMODE(file_stat.st_mode) & 0o077:
        raise ValidationError("profile permissions must not grant group or other access")
    if file_stat.st_size > 512 * 1024:
        raise ValidationError("profile exceeds the 512 KiB size limit")

    try:
        text = path.read_text(encoding="utf-8")
    except (OSError, UnicodeError) as error:
        raise ValidationError(f"cannot read UTF-8 profile: {error}") from error
    if "\x00" in text:
        raise ValidationError("profile contains a NUL byte")

    directives: collections.Counter[tuple[str, ...]] = collections.Counter()
    blocks: dict[str, str] = {}
    block_name: str | None = None
    block_lines: list[str] = []

    for line_number, raw_line in enumerate(text.splitlines(), start=1):
        stripped = raw_line.strip()
        if block_name is not None:
            if stripped == f"</{block_name}>":
                content = "\n".join(block_lines).strip() + "\n"
                if not content.strip():
                    raise ValidationError(f"empty <{block_name}> block")
                blocks[block_name] = content
                block_name = None
                block_lines = []
            elif stripped.startswith("</") or (stripped.startswith("<") and stripped.endswith(">")):
                raise ValidationError(f"invalid nested or mismatched block at line {line_number}")
            else:
                block_lines.append(raw_line)
            continue

        if not stripped or stripped.startswith(("#", ";")):
            continue
        if stripped.startswith("<") and stripped.endswith(">"):
            name = stripped[1:-1]
            if name not in BLOCK_NAMES or name in blocks:
                raise ValidationError(f"unexpected or duplicate <{name}> block")
            block_name = name
            block_lines = []
            continue
        try:
            fields = tuple(shlex.split(stripped, comments=False, posix=True))
        except ValueError as error:
            raise ValidationError(f"invalid directive syntax at line {line_number}") from error
        if not fields:
            continue
        directives[fields] += 1

    if block_name is not None:
        raise ValidationError(f"unterminated <{block_name}> block")
    missing_blocks = sorted(set(BLOCK_NAMES) - set(blocks))
    if missing_blocks:
        raise ValidationError(f"missing inline blocks: {', '.join(missing_blocks)}")
    if directives != EXPECTED_DIRECTIVES:
        unexpected = directives - EXPECTED_DIRECTIVES
        missing = EXPECTED_DIRECTIVES - directives
        details: list[str] = []
        if unexpected:
            details.append("unexpected=" + ",".join(sorted(fields[0] for fields in unexpected)))
        if missing:
            details.append("missing=" + ",".join(sorted(" ".join(fields) for fields in missing)))
        raise ValidationError("directive set does not match medewerkers-split" + (": " + "; ".join(details) if details else ""))
    return directives, blocks


def run_openssl(openssl: str, *arguments: str) -> str:
    result = subprocess.run(
        [openssl, *arguments],
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        encoding="utf-8",
    )
    if result.returncode != 0:
        raise ValidationError("OpenSSL rejected profile cryptographic material")
    return result.stdout


def write_private(path: Path, content: str) -> None:
    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
        stream.write(content)


def certificate_fingerprint(openssl: str, certificate: Path) -> str:
    output = run_openssl(openssl, "x509", "-in", str(certificate), "-noout", "-fingerprint", "-sha256")
    try:
        return output.strip().split("=", 1)[1]
    except IndexError as error:
        raise ValidationError("OpenSSL returned an invalid certificate fingerprint") from error


def certificate_dates(openssl: str, certificate: Path) -> tuple[dt.datetime, dt.datetime]:
    output = run_openssl(openssl, "x509", "-in", str(certificate), "-noout", "-startdate", "-enddate")
    values = dict(line.split("=", 1) for line in output.splitlines() if "=" in line)
    try:
        start = dt.datetime.strptime(values["notBefore"], "%b %d %H:%M:%S %Y %Z").replace(tzinfo=dt.timezone.utc)
        end = dt.datetime.strptime(values["notAfter"], "%b %d %H:%M:%S %Y %Z").replace(tzinfo=dt.timezone.utc)
    except (KeyError, ValueError) as error:
        raise ValidationError("OpenSSL returned invalid certificate dates") from error
    return start, end


def validate(path: Path) -> dict[str, object]:
    _, blocks = parse_profile(path)
    openssl = os.environ.get("RG_OPENSSL", "openssl")
    expected_ca = normalize_fingerprint(os.environ.get("RG_SURF_CA_SHA256", DEFAULT_CA_SHA256))

    with tempfile.TemporaryDirectory(prefix="rg-surf-vpn-validate-") as directory:
        work = Path(directory)
        ca_path = work / "ca.pem"
        cert_path = work / "cert.pem"
        key_path = work / "key.pem"
        write_private(ca_path, blocks["ca"])
        write_private(cert_path, blocks["cert"])
        write_private(key_path, blocks["key"])

        ca_fingerprint = certificate_fingerprint(openssl, ca_path)
        if normalize_fingerprint(ca_fingerprint) != expected_ca:
            raise ValidationError("inline CA fingerprint does not match the pinned SURF CA")

        identity = run_openssl(
            openssl,
            "x509",
            "-in",
            str(cert_path),
            "-noout",
            "-subject",
            "-issuer",
            "-nameopt",
            "RFC2253",
        )
        identity_lines = dict(line.split("=", 1) for line in identity.splitlines() if "=" in line)
        subject = identity_lines.get("subject", "")
        issuer = identity_lines.get("issuer", "")
        if "OU=medewerkers-split" not in subject.split(","):
            raise ValidationError("client certificate OU is not medewerkers-split")
        if issuer != "CN=VPN CA":
            raise ValidationError("client certificate issuer is not CN=VPN CA")

        run_openssl(openssl, "verify", "-CAfile", str(ca_path), str(cert_path))
        cert_public = run_openssl(openssl, "x509", "-in", str(cert_path), "-pubkey", "-noout").strip()
        key_public = run_openssl(openssl, "pkey", "-in", str(key_path), "-pubout").strip()
        if cert_public != key_public:
            raise ValidationError("client private key does not match the certificate")

        start, end = certificate_dates(openssl, cert_path)
        current = dt.datetime.now(dt.timezone.utc)
        if start > current:
            raise ValidationError("client certificate is not valid yet")
        if end <= current + dt.timedelta(hours=1):
            raise ValidationError("client certificate has less than one hour remaining")

        tls_crypt = blocks["tls-crypt"].splitlines()
        tls_header = [
            "#",
            "# 2048 bit OpenVPN static key",
            "#",
            "-----BEGIN OpenVPN Static key V1-----",
        ]
        tls_key_lines = tls_crypt[len(tls_header):-1]
        if tls_crypt[:len(tls_header)] != tls_header \
            or tls_crypt[-1:] != ["-----END OpenVPN Static key V1-----"] \
            or len(tls_key_lines) != 16 \
            or any(re.fullmatch(r"[0-9A-Fa-f]{32}", line) is None for line in tls_key_lines):
            raise ValidationError("tls-crypt block has an invalid static-key envelope")

        return {
            "profile": "medewerkers-split",
            "remote_host": "medewerkers-split.surf.eduvpn.nl",
            "remote_port": 1197,
            "ca_sha256": ca_fingerprint,
            "cert_sha256": certificate_fingerprint(openssl, cert_path),
            "not_before": start.isoformat(),
            "not_before_epoch": int(start.timestamp()),
            "not_after": end.isoformat(),
            "not_after_epoch": int(end.timestamp()),
        }


def tool_path(variable: str, default: str) -> str:
    return os.environ.get(variable, default)


def run_tool(arguments: list[str]) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        arguments,
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        encoding="utf-8",
    )


def canary_ip() -> str:
    getent = tool_path("RG_SURF_GETENT", "getent")
    result = run_tool([getent, "ahostsv4", os.environ.get("RG_SURF_CANARY_HOST", "servicedesk.surf.nl")])
    if result.returncode != 0:
        return ""
    for line in result.stdout.splitlines():
        fields = line.split()
        if fields:
            return fields[0]
    return ""


def tunnel_healthy() -> tuple[bool, str]:
    systemctl = tool_path("RG_SURF_SYSTEMCTL", "systemctl")
    ip = tool_path("RG_SURF_IP", "ip")
    unit = os.environ.get("RG_SURF_OPENVPN_UNIT", "openvpn-client@surf-split.service")
    if run_tool([systemctl, "is-active", "--quiet", unit]).returncode != 0:
        return False, ""
    if run_tool([ip, "link", "show", "tun0"]).returncode != 0:
        return False, ""
    address = canary_ip()
    if not address:
        return False, ""
    route = run_tool([ip, "route", "get", address])
    if route.returncode != 0 or " dev tun0 " not in f" {route.stdout.strip()} ":
        return False, address
    return True, address


def write_status(metadata: dict[str, object], result: str, address: str, device: str) -> None:
    status_path = Path(os.environ.get("RG_SURF_STATUS_FILE", "/var/lib/rg-surf-vpn/status.json"))
    status_path.parent.mkdir(mode=0o755, parents=True, exist_ok=True)
    payload = dict(metadata)
    payload.update(
        {
            "result": result,
            "installed_at": dt.datetime.now().astimezone().isoformat(timespec="seconds"),
            "canary_host": os.environ.get("RG_SURF_CANARY_HOST", "servicedesk.surf.nl"),
            "canary_ip": address,
            "canary_device": device,
        }
    )
    descriptor, temporary_name = tempfile.mkstemp(prefix=".status.", dir=status_path.parent)
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            json.dump(payload, stream, sort_keys=True, separators=(",", ":"))
            stream.write("\n")
        temporary.chmod(0o644)
        temporary.replace(status_path)
    finally:
        temporary.unlink(missing_ok=True)


def installed_fingerprint(status_path: Path) -> str:
    try:
        payload = json.loads(status_path.read_text(encoding="utf-8"))
    except (OSError, ValueError, TypeError):
        return ""
    value = payload.get("cert_sha256", "")
    return value if isinstance(value, str) else ""


def install_profile(source: Path) -> None:
    try:
        source_stat = source.lstat()
    except OSError as error:
        raise InstallError(f"cannot stat profile: {error.strerror}") from error
    if stat.S_ISLNK(source_stat.st_mode) or not stat.S_ISREG(source_stat.st_mode):
        raise InstallError("profile must be a regular file, not a symlink")
    source_uid = int(os.environ.get("RG_SURF_SOURCE_UID", "1001"))
    if source_stat.st_uid != source_uid:
        raise InstallError(f"profile owner does not match uid {source_uid}")
    if stat.S_IMODE(source_stat.st_mode) not in (0o400, 0o600):
        raise InstallError("profile must have mode 0400 or 0600")

    destination = Path(os.environ.get("RG_SURF_OVPN", "/etc/openvpn/client/surf-split.conf"))
    destination_parent = destination.parent
    if os.geteuid() != 0 and (not destination_parent.exists() or not os.access(destination_parent, os.W_OK)):
        os.execvp("sudo", ["sudo", "--", str(Path(__file__).resolve()), "install", str(source)])

    descriptor, candidate_name = tempfile.mkstemp(prefix="rg-surf-vpn-candidate.", dir="/tmp")
    os.close(descriptor)
    candidate = Path(candidate_name)
    try:
        shutil.copyfile(source, candidate)
        candidate.chmod(0o600)
        if os.geteuid() == 0:
            os.chown(candidate, 0, 0)
        metadata = validate(candidate)

        status_path = Path(os.environ.get("RG_SURF_STATUS_FILE", "/var/lib/rg-surf-vpn/status.json"))
        old_fingerprint = installed_fingerprint(status_path)
        new_fingerprint = str(metadata["cert_sha256"])

        destination_parent.mkdir(mode=0o755, parents=True, exist_ok=True)
        destination_new = destination.with_name(destination.name + ".new")
        shutil.copyfile(candidate, destination_new)
        destination_new.chmod(0o600)
        if os.geteuid() == 0:
            os.chown(destination_new, 0, 0)
        destination_new.replace(destination)

        healthy, address = tunnel_healthy()
        if old_fingerprint == new_fingerprint and healthy:
            write_status(metadata, "active", address, "tun0")
            print("rg-surf-vpn-install: certificate unchanged and tunnel healthy")
            return

        systemctl = tool_path("RG_SURF_SYSTEMCTL", "systemctl")
        unit = os.environ.get("RG_SURF_OPENVPN_UNIT", "openvpn-client@surf-split.service")
        started_at = dt.datetime.now().astimezone().isoformat(timespec="seconds")
        if run_tool([systemctl, "restart", unit]).returncode != 0:
            write_status(metadata, "restart-failed", "", "")
            raise InstallError(f"failed to restart {unit}")

        journalctl = tool_path("RG_SURF_JOURNALCTL", "journalctl")
        sleep = tool_path("RG_SURF_SLEEP", "sleep")
        attempts = int(os.environ.get("RG_SURF_WAIT_ATTEMPTS", "20"))
        for _ in range(attempts):
            journal = run_tool([journalctl, "-u", unit, "--since", started_at, "--no-pager", "-o", "cat"])
            healthy, address = tunnel_healthy()
            if "Initialization Sequence Completed" in journal.stdout and healthy:
                write_status(metadata, "active", address, "tun0")
                print(f"rg-surf-vpn-install: SURF split tunnel active through tun0 until {metadata['not_after']}")
                return
            run_tool([sleep, "1"])

        write_status(metadata, "tunnel-failed", "", "")
        raise InstallError("tunnel did not pass initialization, tun0, and route checks")
    finally:
        candidate.unlink(missing_ok=True)


def main(argv: list[str]) -> int:
    if len(argv) != 3 or argv[1] not in ("--validate-only", "install"):
        print("usage: rg-surf-vpn-install --validate-only PROFILE", file=sys.stderr)
        print("       rg-surf-vpn-install install PROFILE", file=sys.stderr)
        return 2
    try:
        if argv[1] == "--validate-only":
            metadata = validate(Path(argv[2]))
            print(json.dumps(metadata, sort_keys=True))
        else:
            install_profile(Path(argv[2]))
    except (ValidationError, InstallError) as error:
        print(f"rg-surf-vpn-install: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
