#!/usr/bin/env bash
set -euo pipefail

VAULT_ROOT="/home/rgoswami/Git/Gitlab/obsidian-notes"
VT_BIN="$VAULT_ROOT/tools/vault-tools/target/release/vault-tools"
VT_MANIFEST="$VAULT_ROOT/tools/vault-tools/Cargo.toml"

if [[ -x "$VT_BIN" ]]; then
    exec "$VT_BIN" --root "$VAULT_ROOT" "$@"
fi

exec cargo run -q --release --manifest-path "$VT_MANIFEST" -- --root "$VAULT_ROOT" "$@"
