#!/usr/bin/env bash
set -euo pipefail

VAULT_ROOT="${VAULT_ROOT:-/home/rgoswami/Git/Gitlab/obsidian-notes}"
VT_BIN="$VAULT_ROOT/tools/vault-tools/target/release/vault-tools"

if [[ ! -x "$VT_BIN" ]]; then
    printf 'vault-tools release binary is missing: %s\n' "$VT_BIN" >&2
    printf 'Build on rg.cosmolab and install the release binary before using this wrapper.\n' >&2
    exit 127
fi

exec "$VT_BIN" --root "$VAULT_ROOT" "$@"
