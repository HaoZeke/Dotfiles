#!/usr/bin/env bash
# Managed by chezmoi (dot_local/bin/executable_rg-space-sweep).
#
# Report and prune the recurring cache/build directories across $HOME.

set -euo pipefail

HOME_DIR="${HOME:?}"

usage() {
    cat <<'EOF'
usage: rg-space-sweep [report|clean] [default|all|rust|python|pixi|tox|venv|js]

report
    Show matching cache/build directories sorted by size.

clean
    Remove the matching directories.

default
    rust python pixi tox

all
    default + venv + js
EOF
}

expand_categories() {
    local token
    for token in "$@"; do
        case "$token" in
            default) printf '%s\n' rust python pixi tox ;;
            all) printf '%s\n' rust python pixi tox venv js ;;
            rust|python|pixi|tox|venv|js) printf '%s\n' "$token" ;;
            *) printf 'unknown category: %s\n' "$token" >&2; exit 2 ;;
        esac
    done | awk '!seen[$0]++'
}

find_named_dirs() {
    local name="$1"
    find "$HOME_DIR" -xdev -type d -name "$name" -prune -print 2>/dev/null
}

find_cargo_targets() {
    find "$HOME_DIR" -xdev -type d -name target -prune -print 2>/dev/null | while read -r dir; do
        local parent
        parent="$(dirname "$dir")"
        if { [ -e "$parent/Cargo.toml" ] || [ -e "$parent/Cargo.lock" ]; } \
            && { [ -d "$dir/debug" ] || [ -d "$dir/release" ] || [ -d "$dir/.fingerprint" ] || [ -e "$dir/.rustc_info.json" ]; }; then
            printf '%s\n' "$dir"
        fi
    done
}

find_node_caches() {
    find "$HOME_DIR" -xdev -type d -path '*/node_modules/.cache' -prune -print 2>/dev/null
}

emit_category_paths() {
    local category="$1"
    case "$category" in
        rust)
            find_cargo_targets
            printf '%s\n' "$HOME_DIR/.cargo/registry/cache" "$HOME_DIR/.cargo/git/db"
            ;;
        python)
            find_named_dirs .pytest_cache
            find_named_dirs .mypy_cache
            find_named_dirs .ruff_cache
            find_named_dirs .hypothesis
            printf '%s\n' "$HOME_DIR/.cache/pip" "$HOME_DIR/.cache/uv" "$HOME_DIR/.cache/pre-commit" "$HOME_DIR/.local/share/hatch"
            ;;
        pixi)
            find_named_dirs .pixi
            ;;
        tox)
            find_named_dirs .tox
            ;;
        venv)
            find_named_dirs .venv
            ;;
        js)
            find_node_caches
            printf '%s\n' "$HOME_DIR/.npm"
            ;;
    esac
}

main() {
    local cmd="${1:-report}"
    shift || true

    case "$cmd" in
        report|clean) ;;
        -h|--help|help) usage; exit 0 ;;
        *) usage >&2; exit 2 ;;
    esac

    if [ "$#" -eq 0 ]; then
        set -- default
    fi

    mapfile -t categories < <(expand_categories "$@")
    mapfile -t paths < <(
        for category in "${categories[@]}"; do
            emit_category_paths "$category"
        done | sed '/^$/d' | awk '!seen[$0]++'
    )

    if [ "$cmd" = "report" ]; then
        {
            for path in "${paths[@]}"; do
                [ -e "$path" ] || continue
                du -s --block-size=1 "$path" 2>/dev/null || true
            done
        } | sort -n | tail -n 80 | awk '
            BEGIN { total = 0 }
            {
                total += $1
                path = $2
                for (i = 3; i <= NF; i++) path = path " " $i
                printf "%8.1fG  %s\n", $1 / 1024 / 1024 / 1024, path
            }
            END {
                printf "\nTotal listed: %.1fG\n", total / 1024 / 1024 / 1024
            }'
        exit 0
    fi

    for path in "${paths[@]}"; do
        [ -e "$path" ] || continue
        printf 'removing %s\n' "$path"
        rm -rf -- "$path"
    done
}

main "$@"
