#!/usr/bin/env bash
set -euo pipefail

repo=${1:-"$HOME/.local/share/chezmoi"}

fail() {
    printf 'FAIL: %s\n' "$*" >&2
    exit 1
}

tmp_selftest=$(mktemp -d)
trap 'rm -rf "$tmp_selftest"' EXIT

resolve_helper() {
    local path="$1" out
    if [ -r "$path" ]; then
        printf '%s\n' "$path"
        return 0
    fi
    if [ -r "$path.tmpl" ]; then
        out="$tmp_selftest/$(basename "$path")"
        chezmoi --source "$repo" --no-tty --refresh-externals=never execute-template <"$path.tmpl" >"$out"
        chmod +x "$out"
        printf '%s\n' "$out"
        return 0
    fi
    printf '%s\n' "$path"
}

airplane="$repo/dot_local/bin/executable_rg-airplane"
network_json="$repo/dot_local/bin/executable_rg-network-status-json"
weather_json="$repo/dot_local/bin/executable_rg-weather-json.tmpl"
fix_local_dns="$(resolve_helper "$repo/dot_local/bin/executable_rg-fix-local-dns")"
fix_nm_ctrld="$(resolve_helper "$repo/dot_local/bin/executable_rg-fix-networkmanager-ctrld")"
profile_selftest="$repo/dot_local/bin/executable_rg-network-profile-selftest"
us_egress_up="$(resolve_helper "$repo/dot_local/bin/executable_rg-us-egress-up")"
net_recover="$(resolve_helper "$repo/dot_local/bin/executable_rg-net-recover")"
net_heal="$(resolve_helper "$repo/dot_local/bin/executable_rg-net-heal")"
derp_targets="$repo/dot_local/bin/executable_rg-haozeke-derp-targets"
net_cli="$repo/dot_local/bin/executable_rg-net"
surf_validate="$repo/dot_local/bin/executable_rg-surf-vpn-validate"
surf_apply="$repo/dot_local/bin/executable_rg-surf-vpn-apply"
surf_export="$repo/dot_local/bin/executable_rg-surf-vpn-export"
surf_refresh="$repo/dot_local/bin/executable_rg-surf-vpn-refresh"
surf_refresh_service="$repo/dot_config/systemd/user/rg-surf-vpn-refresh.service"
surf_refresh_timer="$repo/dot_config/systemd/user/rg-surf-vpn-refresh.timer"
net_heal_script="$repo/.chezmoiscripts/run_onchange_linux_net_heal.sh.tmpl"
chezmoi_ignore="$repo/.chezmoiignore"
us_egress_guard_script="$repo/.chezmoiscripts/run_onchange_linux_us_egress_guard.sh.tmpl"
laptop_script="$repo/.chezmoiscripts/run_onchange_linux_laptop_power.sh.tmpl"
top_bar="$repo/dot_config/i3rust/i3_top.toml.tmpl"
bottom_bar="$repo/dot_config/i3rust/i3_bottom.toml.tmpl"
sway_config="$repo/dot_config/sway/config.tmpl"

test -r "$airplane" || fail "missing rg-airplane helper"
test -r "$network_json" || fail "missing rg-network-status-json helper"
test -r "$weather_json" || fail "missing rg-weather-json helper"
test -r "$fix_local_dns" || fail "missing local DNS repair helper"
test -r "$fix_nm_ctrld" || fail "missing NetworkManager Control D repair helper"
test -r "$profile_selftest" || fail "missing live network profile selftest"
test -r "$us_egress_up" || fail "missing US egress activation helper"
test -r "$net_recover" || fail "missing one-shot network recovery helper"
test -r "$net_heal" || fail "missing periodic network heal helper"
test -x "$derp_targets" || fail "missing haozeke DERP target selector"
test -r "$net_cli" || fail "missing rg-net entry point"
test -x "$surf_validate" || fail "missing strict SURF profile validator"
test -r "$surf_apply" || fail "missing SURF profile installer"
test -x "$surf_export" || fail "missing authenticated SURF export adapter"
test -x "$surf_refresh" || fail "missing SURF renewal orchestrator"
test -r "$surf_refresh_service" || fail "missing SURF renewal user service"
test -r "$surf_refresh_timer" || fail "missing SURF renewal user timer"
test -r "$net_heal_script" || fail "missing net heal provisioning script"
test -r "$chezmoi_ignore" || fail "missing host-specific chezmoi ignore policy"
test -r "$us_egress_guard_script" || fail "missing US egress guard provisioning script"
test -r "$laptop_script" || fail "missing laptop power script"
test -r "$top_bar" || fail "missing top i3status-rs config"
test -r "$bottom_bar" || fail "missing bottom i3status-rs config"
test -r "$sway_config" || fail "missing sway config"

rg -q 'rfkill block wlan wwan gps fm nfc uwb wimax' "$airplane" \
    || fail "airplane mode does not block non-Bluetooth radios"
rg -q 'bluetoothctl power on' "$airplane" \
    || fail "airplane mode does not expose an explicit Bluetooth-on path"
rg -q 'toggle\)' "$airplane" \
    || fail "airplane mode does not expose a Bluetooth toggle path"
rg -q 'systemctl stop tailscaled.service' "$airplane" \
    || fail "airplane mode does not stop the primary tailnet"
rg -q 'rg-tailnet-power' "$airplane" \
    || fail "airplane mode does not delegate named tailnet instances"
rg -q 'RG_AIRPLANE_DRY_RUN' "$airplane" \
    || fail "airplane helper lacks dry-run test support"

out=$(RG_AIRPLANE_DRY_RUN=1 XDG_STATE_HOME="$(mktemp -d)" "$airplane" on)
printf '%s\n' "$out" | rg -q 'rfkill block wlan wwan gps fm nfc uwb wimax' \
    || fail "airplane dry-run does not show radio block command"
printf '%s\n' "$out" | rg -q 'systemctl stop tailscaled.service' \
    || fail "airplane dry-run does not show primary tailnet stop"

rg -q 'status-json' "$network_json" \
    || fail "network status helper does not respect airplane state"
tmp_net=$(mktemp -d)
mkdir -p "$tmp_net/sys/wlan0/statistics" "$tmp_net/state"
printf 'up\n' > "$tmp_net/sys/wlan0/operstate"
printf '1000\n' > "$tmp_net/sys/wlan0/statistics/rx_bytes"
printf '2000\n' > "$tmp_net/sys/wlan0/statistics/tx_bytes"
RG_NETWORK_STATUS_SYSFS="$tmp_net/sys" \
RG_NETWORK_STATUS_NOW=100 \
XDG_STATE_HOME="$tmp_net/state" \
    "$network_json" >/dev/null
printf '31000\n' > "$tmp_net/sys/wlan0/statistics/rx_bytes"
printf '12000\n' > "$tmp_net/sys/wlan0/statistics/tx_bytes"
speed_out=$(
    RG_NETWORK_STATUS_SYSFS="$tmp_net/sys" \
    RG_NETWORK_STATUS_NOW=103 \
    XDG_STATE_HOME="$tmp_net/state" \
        "$network_json"
)
printf '%s\n' "$speed_out" | rg -q 'D:[^ ]+/s U:[^ ]+/s' \
    || fail "network status helper does not report download/upload speed"
! printf '%s\n' "$speed_out" | rg -q 'WIFI' \
    || fail "network status helper repeats a redundant WiFi label"
! printf '%s\n' "$speed_out" | rg -q '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' \
    || fail "network status helper leaks IP address instead of transfer speed"
readonly_state="$tmp_net/readonly-state"
mkdir -p "$readonly_state"
chmod 500 "$readonly_state"
readonly_err="$tmp_net/readonly.err"
readonly_out=$(
    RG_NETWORK_STATUS_SYSFS="$tmp_net/sys" \
    RG_NETWORK_STATUS_NOW=106 \
    XDG_STATE_HOME="$readonly_state" \
        "$network_json" 2>"$readonly_err"
)
chmod 700 "$readonly_state"
test ! -s "$readonly_err" \
    || fail "network status helper writes bar-visible errors when state cannot be saved"
printf '%s\n' "$readonly_out" | rg -q 'D:-- U:--' \
    || fail "network status helper does not degrade cleanly without writable state"
rg -q 'status 2>/dev/null' "$weather_json" \
    || fail "weather helper does not suppress output during airplane mode"
rg -q 'urllib.request' "$weather_json" \
    || fail "weather helper does not fetch weather without i3status-rs error blocks"
! rg -q '\{\{[[:space:]]*pass' "$weather_json" \
    || fail "weather helper reads OpenWeather key at template-render time"
rg -q 'OPENWEATHER_API_KEY' "$weather_json" \
    || fail "weather helper does not support environment-provided OpenWeather key"
rg -q 'pass show services/openweather-api-key 2>/dev/null' "$weather_json" \
    || fail "weather helper does not tolerate a missing pass entry at runtime"
rendered_weather="$tmp_net/rg-weather-json"
chezmoi --source "$repo" --no-tty --refresh-externals=never execute-template < "$weather_json" > "$rendered_weather"
bash -n "$rendered_weather"
bash -n "$fix_local_dns"
bash -n "$profile_selftest"
bash -n "$us_egress_up"
bash -n "$net_recover"
mkdir -p "$tmp_net/bin"
cat >"$tmp_net/bin/pass" <<'SH'
#!/usr/bin/env sh
exit 1
SH
chmod +x "$tmp_net/bin/pass"
missing_pass_err="$tmp_net/weather-missing-pass.err"
missing_pass_out=$(
    PATH="$tmp_net/bin:$PATH" \
    HOME="$tmp_net/home" \
    OPENWEATHER_API_KEY='' \
        bash "$rendered_weather" reykjavik 2>"$missing_pass_err"
)
test ! -s "$missing_pass_err" \
    || fail "weather helper writes errors when pass lacks the OpenWeather key"
printf '%s\n' "$missing_pass_out" | rg -q '"state": "Idle"' \
    || fail "weather helper does not degrade to an idle JSON block without an OpenWeather key"

rg -q 'rg-network-status-json' "$top_bar" \
    || fail "top bar does not use quiet network status wrapper"
! rg -q '^block = "net"$' "$top_bar" \
    || fail "top bar still uses the generic net block"
rg -q 'rg-weather-json reykjavik' "$bottom_bar" \
    || fail "bottom bar does not use quiet Reykjavik weather wrapper"
rg -q 'rg-weather-json iitk' "$bottom_bar" \
    || fail "bottom bar does not use quiet IITK weather wrapper"
! rg -q '^block = "weather"$' "$bottom_bar" \
    || fail "bottom bar still uses generic weather blocks"

rg -q 'zzzz-rg-local-dns.conf' "$fix_local_dns" \
    || fail "local DNS repair helper does not install a last-sorting resolved drop-in"
rg -q 'resolvectl dns' "$fix_local_dns" \
    || fail "local DNS repair helper does not verify resolved global DNS"
rg -q -- '--secondary_upstream=https://76\.76\.10\.22/' "$fix_local_dns" \
    || fail "local DNS repair helper lacks a secondary Control D upstream"
rg -F -q 'else if ($i ~ /^--primary_upstream=https:\/\/76\.76\.(2|10)\.22\//)' "$fix_local_dns" \
    || fail "local DNS repair helper cannot recover Control D id from local upstream flags"
rg -q 'cat >/etc/systemd/system/ctrld.service <<EOF' "$fix_local_dns" \
    || fail "local DNS repair helper does not replace the Control D unit"
rg -q 'rm -f /etc/systemd/system/ctrld.service.d/50-rg-local-chain.conf' "$fix_local_dns" \
    || fail "local DNS repair helper does not retire the stale Control D drop-in"
rg -q 'MulticastDNS=no' "$fix_local_dns" \
    || fail "local DNS repair helper does not disable resolved mDNS"
rg -U -q '\[Unit\]\nDescription=A highly configurable, multi-protocol DNS forwarding proxy\nConditionFileIsExecutable=/usr/local/bin/ctrld\nWants=nss-lookup\.target\nAfter=network\.target nss-lookup\.target' "$fix_local_dns" \
    || fail "local DNS repair helper does not install Control D without NetworkManager dependencies"
rg -q 'systemctl show ctrld.service -p Wants -p After' "$fix_local_dns" \
    || fail "local DNS repair helper does not verify effective Control D dependencies"
rg -q -- '--restore-from' "$fix_local_dns" \
    || fail "local DNS repair helper lacks snapshot restore support"
rg -q '/var/tmp/rg-dns-backups' "$fix_local_dns" \
    || fail "local DNS repair helper does not use a stable backup root"
rg -q 'cat >"\$unit_file" <<EOF' "$fix_nm_ctrld" \
    || fail "NetworkManager Control D repair helper does not replace the Control D unit"
rg -q 'rm -f "\$dropin"' "$fix_nm_ctrld" \
    || fail "NetworkManager Control D repair helper does not retire the stale Control D drop-in"
rg -U -q '\[Unit\]\nDescription=A highly configurable, multi-protocol DNS forwarding proxy\nConditionFileIsExecutable=/usr/local/bin/ctrld\nWants=nss-lookup\.target\nAfter=network\.target nss-lookup\.target' "$fix_nm_ctrld" \
    || fail "NetworkManager Control D repair helper does not install Control D without NetworkManager dependencies"
rg -q 'systemctl show ctrld.service -p Wants -p After' "$fix_nm_ctrld" \
    || fail "NetworkManager Control D repair helper does not verify effective Control D dependencies"
rg -q 'systemctl disable --now NetworkManager-wait-online.service NetworkManager-dispatcher.service NetworkManager.service' "$fix_nm_ctrld" \
    || fail "NetworkManager Control D repair helper does not disable the NetworkManager service trio"
rg -q 'systemctl restart ctrld.service' "$fix_nm_ctrld" \
    || fail "NetworkManager Control D repair helper does not restart Control D after dependency cleanup"
rg -q 'disable --now rg-us-egress-watch.service' "$net_recover" \
    || fail "network recovery helper must keep the realtime egress watcher disabled"
rg -q 'systemctl stop rg-us-egress-guard.timer' "$net_recover" \
    || fail "network recovery helper must stop the periodic guard before rebuilding egress"
rg -q 'systemctl restart rg-us-egress.service' "$net_recover" \
    || fail "network recovery helper must rebuild the managed Houston egress stack"
rg -q '/usr/local/sbin/rg-net-heal' "$net_recover" \
    || fail "network recovery helper must reassert x.ai tailscale and carve-outs"
rg -q 'tailscale set --accept-dns=true' "$net_recover" \
    || fail "network recovery helper must re-enable x.ai split DNS"
rg -q 'https://api.x.ai/v1/models' "$net_recover" \
    || fail "network recovery helper must probe the x.ai API path"
rg -q 'systemctl restart rg-us-egress-guard.timer' "$net_recover" \
    || fail "network recovery helper must leave the periodic guard active"
rg -q 'recover_rgx1gen11()' "$net_recover" \
    || fail "network recovery helper must keep rgx1gen11 recovery isolated"
rg -q 'recover_rgsurflat()' "$net_recover" \
    || fail "network recovery helper must provide rgSURFLat recovery"
rg -F -q 'rgSURFLat)' "$net_recover" \
    || fail "network recovery helper must dispatch rgSURFLat by hostname"
rg -F -q 'rgam5terra|rg.terra|terra*)' "$net_recover" \
    || fail "network recovery helper must not mutate Terra hosts"
rg -q 'rg-eduvpn-ensure.service' "$net_recover" \
    || fail "rgSURFLat recovery must include the managed eduVPN ensure service"
rg -q 'Amsterdam Science Park" connection.autoconnect no' "$net_recover" \
    || fail "rgSURFLat recovery must disable Amsterdam Science Park autoconnect"
rg -q 'ip route get 100\.119\.130\.84' "$net_recover" \
    || fail "rgSURFLat recovery must verify the local Terra route without contacting Terra"
rg -q 'tailscale status --json' "$net_heal" \
    || fail "periodic network heal helper must inspect Tailscale peer transport endpoints"
rg -q 'x\.ai tailnet visibility' "$net_heal" \
    || fail "periodic network heal helper must document the x.ai Houston-visibility requirement"
! rg -q 'route_local_v4 "\$ip" "tailscale underlay"' "$net_heal" \
    || fail "periodic network heal helper must not carve x.ai tailnet transport onto the LAN"
rg -q 'route_local_v4 "\$ip" "haozeke underlay"' "$net_heal" \
    || fail "periodic network heal helper must keep the haozeke tailnet transport on the LAN"
rg -F -q 'ip route del "$ip/32" table main' "$net_heal" \
    || fail "periodic network heal helper must delete stale LAN carve-outs for x.ai transport"
rg -F -q 'grep -qxF "$ip" "$hz_underlay_set"' "$net_heal" \
    || fail "periodic network heal helper must never un-carve IPs the haozeke tailnet needs"
rg -F -q 'ip route replace "$ip/32" via "$gw" dev "$dev" table main' "$net_heal" \
    || fail "periodic network heal helper must route carve-out endpoints via the LAN gateway"
rg -F -q '100.6[4-9].*|100.[78][0-9].*|100.9[0-9].*|100.1[01][0-9].*|100.12[0-7].*' "$net_heal" \
    || fail "periodic network heal helper must not carve tailnet CGNAT addresses onto the LAN"
rg -q 'ensure_hosts_record "\$XAI_PIN_IP" api\.x\.ai' "$net_heal" \
    || fail "periodic network heal helper must pin api.x.ai without restarting DNS"
rg -q -- '--resolve "api\.x\.ai:443:\$edge"' "$net_heal" \
    || fail "periodic network heal helper must validate the api.x.ai pin through the live egress"
rg -q 'api\.x\.ai pin rotated' "$net_heal" \
    || fail "periodic network heal helper must rotate a dead api.x.ai pin to a live edge"
rg -q 'nl_public_service_hosts' "$net_heal" \
    || fail "periodic network heal helper lacks a Dutch public-service host list"
rg -q 'www\.cbr\.nl' "$net_heal" \
    || fail "periodic network heal helper does not cover CBR"
rg -q 'www\.digid\.nl' "$net_heal" \
    || fail "periodic network heal helper does not cover DigiD"
rg -q 'mijnoverheid\.nl' "$net_heal" \
    || fail "periodic network heal helper does not cover MijnOverheid"
rg -q 'belastingdienst\.nl' "$net_heal" \
    || fail "periodic network heal helper does not cover Belastingdienst"
rg -q 'getent ahostsv4 "\$nl_host"' "$net_heal" \
    || fail "periodic network heal helper does not resolve Dutch public-service routes dynamically"
rg -q 'olt_hosts' "$net_heal" \
    || fail "periodic network heal helper lacks a dedicated OLT host set"
rg -q 'RG_OLT_HOSTS' "$net_heal" \
    || fail "periodic network heal helper lacks an OLT host override"
rg -q '^olt\.com$' "$net_heal" \
    || fail "periodic network heal helper does not cover the OLT apex"
rg -q '^www\.olt\.com$' "$net_heal" \
    || fail "periodic network heal helper does not cover www.olt.com"
rg -q '^kb\.olt\.com$' "$net_heal" \
    || fail "periodic network heal helper does not cover kb.olt.com"
rg -q 'getent ahostsv4 "\$olt_host"' "$net_heal" \
    || fail "periodic network heal helper does not resolve OLT routes dynamically"
rg -q 'olt_residential_reachable' "$net_heal" \
    || fail "periodic network heal helper does not probe OLT on the residential path"
rg -F -q 'if olt_residential_reachable "$olt_host" "$ip"; then' "$net_heal" \
    || fail "periodic network heal helper does not gate OLT carve-outs on reachability"
rg -F -q 'route_local_v4 "$ip" "olt:$olt_host"' "$net_heal" \
    || fail "periodic network heal helper does not send OLT hosts through the LAN"
rg -q 'debug derp-map' "$net_heal" \
    || fail "periodic network heal helper does not read the haozeke DERP map"
rg -q 'rg-haozeke-derp-targets' "$net_heal" \
    || fail "periodic network heal helper does not select active DERP nodes"
rg -F -q 'route_local_v4 "$ip" "haozeke derp"' "$net_heal" \
    || fail "periodic network heal helper does not route active DERP nodes through the LAN"
rg -q 'stale carve-out pruned' "$net_heal" \
    || fail "periodic network heal helper must prune dynamic carve-outs that are no longer desired"
rg -F -q 'if [ -s "$CARVE_STATE_NEW" ]; then' "$net_heal" \
    || fail "periodic network heal helper must not prune on a run that resolved nothing"
rg -q '/usr/local/sbin/rg-net-heal' "$us_egress_up" \
    || fail "US egress helper must reassert destination carve-outs at bring-up"
rg -q 'install_bin "\$RECOVER_SRC" /usr/local/sbin/rg-net-recover' "$net_heal_script" \
    || fail "net heal provisioning must install rg-net-recover as a root command"
rg -q 'install_bin "\$DERP_TARGETS_SRC" /usr/local/sbin/rg-haozeke-derp-targets' "$net_heal_script" \
    || fail "net heal provisioning must install the DERP selector as a root command"
rg -q 'rg-haozeke-derp-targets-sha256:' "$net_heal_script" \
    || fail "net heal provisioning must rerun when the DERP selector changes"
rg -q 'rg-haozeke-derp-targets:/usr/local/sbin/rg-haozeke-derp-targets' "$net_cli" \
    || fail "rg-net drift must compare the installed DERP selector"
rg -q 'rg-surf-vpn-apply-sha256:' "$net_heal_script" \
    || fail "root provisioning must rerun when the SURF installer changes"
rg -q 'rg-surf-vpn-validate-sha256:' "$net_heal_script" \
    || fail "root provisioning must rerun when the SURF validator changes"
rg -q 'install_bin "\$SURF_APPLY_SRC" /usr/local/sbin/rg-surf-vpn-apply' "$net_heal_script" \
    || fail "root provisioning must install the SURF installer"
rg -q 'install_bin "\$SURF_VALIDATE_SRC" /usr/local/sbin/rg-surf-vpn-validate' "$net_heal_script" \
    || fail "root provisioning must install the SURF validator"
rg -q '/etc/systemd/system/rg-surf-vpn-install\.path' "$net_heal_script" \
    || fail "root provisioning must install the SURF spool path unit"
rg -q 'PathChanged=/home/rgoswami/\.local/state/rg-surf-vpn/pending\.ovpn' "$net_heal_script" \
    || fail "SURF spool path unit must watch the authenticated export"
rg -q 'ExecStart=/usr/local/sbin/rg-surf-vpn-apply /home/rgoswami/\.local/state/rg-surf-vpn/pending\.ovpn' "$net_heal_script" \
    || fail "SURF install unit must pass the watched profile to the strict installer"
rg -q 'enable --now rg-surf-vpn-install\.path' "$net_heal_script" \
    || fail "root provisioning must enable the SURF spool path unit"
rg -q 'enable --now rg-surf-vpn-refresh\.timer' "$net_heal_script" \
    || fail "network provisioning must enable the user SURF renewal timer"
rg -q '^ExecStart=%h/\.local/bin/rg-surf-vpn-refresh --timer$' "$surf_refresh_service" \
    || fail "SURF renewal service must invoke timer mode"
rg -q '^TimeoutStartSec=15min$' "$surf_refresh_service" \
    || fail "SURF renewal service must bound browser authorization"
rg -q '^OnUnitActiveSec=1h$' "$surf_refresh_timer" \
    || fail "SURF renewal timer cadence is not hourly"
rg -q '^Persistent=true$' "$surf_refresh_timer" \
    || fail "SURF renewal timer must catch up after missed runs"
rg -U -q '(?s)\{\{ if ne \.chezmoi\.hostname "rgx1gen11" \}\}.*\.config/systemd/user/rg-surf-vpn-refresh\.service.*\.config/systemd/user/rg-surf-vpn-refresh\.timer.*\.local/bin/rg-surf-vpn-apply.*\.local/bin/rg-surf-vpn-export.*\.local/bin/rg-surf-vpn-refresh.*\.local/bin/rg-surf-vpn-validate.*\{\{ end \}\}' "$chezmoi_ignore" \
    || fail "SURF renewal files must remain exclusive to the OpenVPN-owned laptop"
rg -q 'surf-renew\).*rg-surf-vpn-refresh.*--interactive' "$net_cli" \
    || fail "rg-net must expose explicit SURF browser renewal"
rg -q 'enable --now rg-net-doctor.timer' "$net_heal_script" \
    || fail "net heal provisioning must enable the periodic live doctor"
net_doctor="$repo/dot_local/bin/executable_rg-net-doctor"
net_doctor_alert="$repo/dot_local/bin/executable_rg-net-doctor-alert"
test -r "$net_doctor" || fail "missing live network doctor"
test -r "$net_doctor_alert" || fail "missing doctor alert wrapper"
test -r "$repo/dot_config/systemd/user/rg-net-doctor.service" || fail "missing doctor service unit"
test -r "$repo/dot_config/systemd/user/rg-net-doctor.timer" || fail "missing doctor timer unit"
bash -n "$net_doctor" && bash -n "$net_doctor_alert" || fail "doctor helpers do not parse"
rg -q '5205:.*fwmark 0x80000' "$net_doctor" \
    || fail "doctor must verify the x.ai Houston-visibility rule"
rg -q 'ip route get 8.8.8.8 mark 0x80000' "$net_doctor" \
    || fail "doctor must verify tailscale-marked traffic exits via the tunnel"
rg -q -- '--resolve "api\.x\.ai:443:\$pin"' "$net_doctor" \
    || fail "doctor must probe the api.x.ai pin health"
rg -q 'ipinfo\.io/json' "$net_doctor" \
    || fail "doctor must report the egress exit geography"
rg -q 'grok models.*v9-stickynote|v9-stickynote.*grok models' "$net_doctor" \
    || fail "doctor must gate on v9-stickynote model visibility"
rg -q 'ssh .*rg\.terra\.ts' "$net_doctor" \
    || fail "doctor must probe the userspace-Tailscale Terra fallback explicitly"
! rg -q 'SOCKS path ok via ssh rg\.terra ' "$net_doctor" \
    || fail "doctor must not describe the cosmoet rg.terra host as the SOCKS path"
rg -q 'haozeke DERP source routes' "$net_doctor" \
    || fail "doctor must audit source-correct routes for active haozeke DERP nodes"
rg -q 'rg-haozeke-derp-targets' "$net_doctor" \
    || fail "doctor must use the shared active-DERP selector"
rg -q 'active DERP routes audited below' "$net_doctor" \
    || fail "doctor must defer missing legacy backstops to the active-DERP audit"
! rg -q 'bad "nft rg_hz_carveout ABSENT and no peer backstops' "$net_doctor" \
