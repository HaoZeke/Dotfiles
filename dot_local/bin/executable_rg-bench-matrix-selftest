#!/usr/bin/env bash
# Managed by chezmoi (dot_local/bin/executable_rg-bench-matrix-selftest).

set -euo pipefail

repo=${1:-"$HOME/.local/share/chezmoi"}
script="$repo/dot_local/bin/executable_rg-bench-matrix"
tmpdir=$(mktemp -d)

fail() {
    printf 'FAIL: %s\n' "$*" >&2
    exit 1
}

test -r "$script" || fail "missing rg-bench-matrix"
chmod +x "$script" 2>/dev/null || true

"$script" list | rg '^sched' >/dev/null || fail "list missing sched bench"
"$script" list | rg '^thermal' >/dev/null || fail "list missing thermal bench"
"$script" list | rg '^collect' >/dev/null || fail "list missing collect bench"
"$script" list | rg '^wifi' >/dev/null || fail "list missing wifi bench"
"$script" list | rg '^gates' >/dev/null || fail "list missing gates bench"
"$script" --help | rg 'gates' >/dev/null || fail "help missing gates bench"

fake_home="$tmpdir/home"
mkdir -p "$fake_home/.local/bin"
for cmd in \
    rg-memory-sysctl-check \
    rg-pipewire-rt-check \
    rg-oomd-policy-check \
    rg-ksm-policy \
    rg-storage-trim-check \
    rg-zswap-tune \
    rg-thermal-stack-check \
    rg-x1gen11-profile \
    rg-sched-ladder; do
    cat >"$fake_home/.local/bin/$cmd" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
printf '%s %s\n' "$(basename "$0")" "$*"
SH
    chmod +x "$fake_home/.local/bin/$cmd"
done

out=$(RG_BENCH_DIR="$tmpdir/bench-runs" "$script" --dry-run new)
test -d "$out" || fail "new did not create run dir"
HOME="$fake_home" RG_BENCH_DIR="$tmpdir/bench-runs" "$script" --dry-run run smoke "$out" >/dev/null
mkdir -p "$tmpdir/sys/kernel/sched_ext"
HOME="$fake_home" \
    RG_BENCH_DIR="$tmpdir/bench-runs" \
    RG_BENCH_SYSFS_ROOT="$tmpdir/sys" \
    "$script" --dry-run run sched "$out" >"$tmpdir/sched-dry-run.out"
for sched in off lavd rusty bpfland p2dq; do
    rg -q "rg-sched-ladder bench $sched 20" "$tmpdir/sched-dry-run.out" \
        || fail "sched bench dry-run missing $sched"
done
HOME="$fake_home" RG_BENCH_DIR="$tmpdir/bench-runs" "$script" run gates "$out" >/dev/null
test -r "$out/gates/zswap.txt" || fail "gates bench did not preserve zswap output"
rg -q 'gate-zswap.*PASS' "$out/results.tsv" || fail "gates bench did not record zswap pass"
rg -q 'gate-oomd.*PASS' "$out/results.tsv" || fail "gates bench did not record oomd pass"
rg -q 'gate-profile.*PASS' "$out/results.tsv" || fail "gates bench did not record profile pass"
HOME="$fake_home" RG_BENCH_DIR="$tmpdir/bench-runs" "$script" --dry-run --quick run-all "$out" >/dev/null
RG_BENCH_DIR="$tmpdir/bench-runs" "$script" report "$out" >/dev/null

rm -rf "$tmpdir"

printf 'ok\n'
