#!/usr/bin/env bash
set -euo pipefail

# Delegate to the vault-tools launcher, which resolves the binary in order:
# VAULT_TOOLS_BIN, the vault repo target/{release,debug} build, then the
# hash-stamped cached install. Never duplicate that logic here: a hardcoded
# path that only exists on the build host kills the MCP server everywhere else.
exec "$HOME/.local/bin/vault-tools" serve "$@"
