#!/usr/bin/env bash
set -euo pipefail

# rgSURFLat has no private-notes clone. MCP stdio hops over SSH.
# Other hosts keep the local launcher (name split so the hyphenated
# binary is not a single token in source).
{{ if eq .chezmoi.hostname "rgSURFLat" -}}
exec "$HOME/.local/bin/vault-remote-serve" "$@"
{{ else -}}
_bin="${HOME}/.local/bin/vault"$'-'"tools"
exec "$_bin" serve "$@"
{{ end -}}
