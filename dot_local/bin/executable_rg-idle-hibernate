#!/usr/bin/env bash
# Managed by chezmoi (dot_local/bin/executable_rg-idle-hibernate).
#
# Battery-only hibernate trigger for swayidle. logind idle sleep is
# disabled; this script is the late-timeout hook that hibernates when
# the idle laptop is unplugged and the battery would otherwise drain.
#
# Exits silently on AC so a plugged-in laptop can idle without entering
# a sleep state.

set -u

if [ -x "$HOME/.local/bin/rg-caffeine" ] \
   && ! "$HOME/.local/bin/rg-caffeine" action-allowed hibernate; then
    exit 0
fi

online=0
for f in /sys/class/power_supply/A{C,DP}*/online; do
    [ -r "$f" ] || continue
    if [ "$(cat "$f")" = "1" ]; then
        online=1
        break
    fi
done

[ "$online" = "1" ] && exit 0

exec systemctl hibernate
