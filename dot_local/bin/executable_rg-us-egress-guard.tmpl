#!/usr/bin/env bash
# Hostname gate: laptop DNS/network mutators must not run on Terra buildbot.
{{- if ne .chezmoi.hostname "rgx1gen11" }}
echo "rg-*: refusing to run on hostname=$(hostname 2>/dev/null || echo unknown); only rgx1gen11" >&2
exit 0
{{- end }}
# Keep the US-egress WireGuard tunnel actually carrying traffic. Once
# wg-quick@<iface> is enabled it self-heals two failure modes:
#   - the interface is gone (networkd restart, resume, Wi-Fi flap), or
#   - the interface is up but a public probe no longer routes through it,
#     i.e. wg-quick's policy rules were flushed underneath it (a
#     systemd-networkd restart with ManageForeignRoutingPolicyRules=yes does
#     exactly this, leaving egress silently back on the default route).
# Inert while the unit is disabled, honouring the opt-in design.
#
# systemctl/ip/log are overridable so the selftest can drive the decision
# logic without real systemd or network state.
set -uo pipefail

iface="${RG_US_EGRESS_IFACE:-rg-us-egress-wg}"
unit="wg-quick@${iface}.service"
managed_unit="rg-us-egress.service"
probe="${RG_US_EGRESS_PROBE:-1.1.1.1}"
quality_url="${RG_US_EGRESS_QUALITY_URL:-https://api.x.ai/v1/models}"
# Second probe target that does NOT depend on the api.x.ai /etc/hosts pin: if
# api.x.ai fails but this answers through the tunnel, the pin is stale (a dead
# Cloudflare edge), not the tunnel -- restarting cannot help and storms.
quality_fallback_url="${RG_US_EGRESS_QUALITY_FALLBACK_URL:-https://www.cloudflare.com/cdn-cgi/trace}"
quality_max_ms="${RG_US_EGRESS_QUALITY_MAX_MS:-3000}"
quality_attempts="${RG_US_EGRESS_QUALITY_ATTEMPTS:-2}"
quality_probe="${RG_US_EGRESS_QUALITY_PROBE:-1}"
ctrld_upstreams="${RG_US_EGRESS_CTRLD_UPSTREAMS:-76.76.2.22 76.76.10.22}"
SYSTEMCTL="${RG_GUARD_SYSTEMCTL:-systemctl}"
IP="${RG_GUARD_IP:-ip}"
CURL="${RG_GUARD_CURL:-curl}"
FLOCK="${RG_GUARD_FLOCK:-flock}"
LOG="${RG_GUARD_LOG:-logger -t rg-us-egress-guard}"
CARVEOUT="${RG_HZ_CARVEOUT:-/home/rgoswami/.local/bin/rg-haozeke-tunnel-carveout}"
HZ_MARK="${RG_HZ_MARK:-0x5151}"
# Mutual-exclusion lock: the periodic timer and manual invocations can overlap,
# so serialize them (set to "none" to disable, e.g. under test).
LOCK="${RG_GUARD_LOCK:-/run/rg-us-egress-guard.lock}"
# Consecutive x.ai probe failures before a restart is warranted, and where the
# count is persisted between guard ticks.
quality_state="${RG_US_EGRESS_QUALITY_STATE:-/run/rg-us-egress-guard.quality-fails}"
quality_fail_threshold="${RG_US_EGRESS_QUALITY_FAIL_THRESHOLD:-3}"

case "$quality_max_ms" in ''|*[!0-9]*) quality_max_ms=3000 ;; esac
case "$quality_attempts" in ''|*[!0-9]*) quality_attempts=2 ;; esac
[ "$quality_attempts" -gt 0 ] || quality_attempts=1
case "$quality_fail_threshold" in ''|*[!0-9]*) quality_fail_threshold=3 ;; esac
[ "$quality_fail_threshold" -gt 0 ] || quality_fail_threshold=1

# Re-apply the haozeke carve-out so rg.terra stays reachable. A bare wg-quick
# restart re-installs the 0/0 route but NOT the carve-out, which would leave the
# terra tailnet dark; this re-asserts the cgroup mark + peer /32 backstops.
reassert_carveout() {
    [ -x "$CARVEOUT" ] && "$CARVEOUT" up >/dev/null 2>&1 || true
}
# Healthy carve-out needs (a) the policy rule, (b) a default in table 5151,
# and (c) EITHER the nft cgroup mark table OR the /32 peer backstops. The
# cgroupv2 socket match does not load on every kernel/nft build; the carve-out
# script then falls back to the backstops by design, and demanding nft anyway
# made the guard re-apply a working carve-out every tick, forever.
carveout_present() {
    $IP rule show 2>/dev/null | grep -q "fwmark $HZ_MARK" || return 1
    $IP route show table "${RG_HZ_TABLE:-5151}" 2>/dev/null | grep -q '^default ' || return 1
    nft list table inet rg_hz_carveout >/dev/null 2>&1 && return 0
    [ -s "${RG_HZ_STATE:-/run/rg-hz-carveout.endpoints}" ] && return 0
    return 1
}

quality_probe_once() {
    [ "$quality_probe" = "0" ] && return 0
    command -v "$CURL" >/dev/null 2>&1 || return 0

    local url="${1:-$quality_url}" result code
    result="$($CURL -4 -sS --connect-timeout 4 --max-time 8 -o /dev/null \
        -w '%{http_code} %{time_total} %{local_ip}\n' "$url" 2>/dev/null)" || return 1
    set -- $result
    code="${1:-000}"

    # Reachable through the tunnel = healthy. Latency does NOT gate the restart
    # decision: a slow-but-answered probe still proves the tunnel is carrying
    # traffic, and tearing it down for slowness caused the restart storm. Only an
    # unreachable endpoint (no HTTP status) counts as a failure.
    case "$code" in
    [23][0-9][0-9]|401|403) return 0 ;;
    *) return 1 ;;
    esac
}

quality_ok() {
    local attempt=1
    while [ "$attempt" -le "$quality_attempts" ]; do
        quality_probe_once && return 0
        attempt=$((attempt + 1))
    done
    return 1
}

fallback_ok() {
    local attempt=1
    while [ "$attempt" -le "$quality_attempts" ]; do
        quality_probe_once "$quality_fallback_url" && return 0
        attempt=$((attempt + 1))
    done
    return 1
}

main_ipv4_default() {
    $IP -4 route show default table main 2>/dev/null |
        awk -v tunnel="$iface" '
            $1 == "default" {
                dev = ""; via = "-"; src = "-"
                for (i = 1; i <= NF; i++) {
                    if ($i == "dev") dev = $(i + 1)
                    else if ($i == "via") via = $(i + 1)
                    else if ($i == "src") src = $(i + 1)
                }
                if (dev != "" && dev != tunnel) {
                    print dev, via, src
                    exit
                }
            }
        '
}

reassert_ctrld_carveout() {
    local dev via src upstream
    read -r dev via src <<EOF
$(main_ipv4_default)
EOF
    [ -n "${dev:-}" ] || return 0

    for upstream in $ctrld_upstreams; do
        case "$upstream" in
        ''|*[!0-9.]*)
            continue
            ;;
        esac

        if [ "$via" != "-" ] && [ "$src" != "-" ]; then
            $IP -4 route replace "$upstream/32" via "$via" dev "$dev" src "$src" metric 40 >/dev/null 2>&1 || return 1
        elif [ "$via" != "-" ]; then
            $IP -4 route replace "$upstream/32" via "$via" dev "$dev" metric 40 >/dev/null 2>&1 || return 1
        elif [ "$src" != "-" ]; then
            $IP -4 route replace "$upstream/32" dev "$dev" src "$src" metric 40 >/dev/null 2>&1 || return 1
        else
            $IP -4 route replace "$upstream/32" dev "$dev" metric 40 >/dev/null 2>&1 || return 1
        fi
    done
}

restore_egress() {
    $LOG "$1"
    $SYSTEMCTL reset-failed "$unit" 2>/dev/null || true
    # restart (not start): re-applies wg-quick's routes and policy rules even when
    # the interface is already up but no longer routing.
    if $SYSTEMCTL restart "$unit"; then
        # The route flip can drop the Control D DoH session; resettle DNS.
        $SYSTEMCTL restart ctrld.service 2>/dev/null || true
        # wg-quick restart does not re-apply the carve-out; do it so terra survives.
        reassert_carveout
        $LOG "restored egress on $iface"
    else
        $LOG "failed to restore $iface"
    fi
}

egress_desired() {
    $SYSTEMCTL is-enabled --quiet "$unit" || $SYSTEMCTL is-enabled --quiet "$managed_unit"
}

# Desired-up marker: the unit is enabled. Skip entirely otherwise.
egress_desired || exit 0

# Serialize every mutation. The periodic timer and a manual run can overlap;
# two concurrent `systemctl restart wg-quick` calls make systemd
# cancel one mid-flight, leaving the interface up but its 0/0 route half-applied
# -- a total blackhole until reboot. A non-blocking lock makes a second instance
# skip instead of colliding, so a restart's own netlink churn can never trigger a
# racing restart.
if [ "$LOCK" != "none" ]; then
    if { exec 9>"$LOCK"; } 2>/dev/null; then
        "$FLOCK" -n 9 2>/dev/null || { $LOG "another rg-us-egress-guard holds $LOCK; skipping"; exit 0; }
    else
        # Better to guard unserialized than to never guard; log and continue.
        $LOG "cannot open lock $LOCK; proceeding without serialization"
    fi
fi

reassert_ctrld_carveout || $LOG "failed to keep Control D upstreams on the local uplink"

# Healthy = interface present AND the public probe egresses through it.
if $IP link show "$iface" >/dev/null 2>&1 \
    && $IP route get "$probe" 2>/dev/null | grep -q " dev $iface"; then
    if quality_ok; then
        # Reachable through the tunnel: clear the consecutive-failure counter.
        : >"$quality_state" 2>/dev/null || true
    elif fallback_ok; then
        # The tunnel demonstrably carries traffic; api.x.ai alone is dark, so
        # the /etc/hosts pin points at a dead edge. A restart cannot fix that
        # (rg-net-heal rotates the pin) and tearing down a healthy tunnel is
        # the restart-storm failure mode. Clear the counter and leave it be.
        : >"$quality_state" 2>/dev/null || true
        $LOG "$iface carries traffic but the x.ai probe failed; api.x.ai hosts pin suspect, not restarting"
    else
        # One slow/failed x.ai probe is not proof the tunnel is dead (transient
        # upstream jitter looks identical); only restart after N consecutive
        # misses so a healthy-but-slow tunnel is never needlessly torn down.
        fails="$(cat "$quality_state" 2>/dev/null || echo 0)"
        case "$fails" in ''|*[!0-9]*) fails=0 ;; esac
        fails=$((fails + 1))
        printf '%s\n' "$fails" >"$quality_state" 2>/dev/null || true
        if [ "$fails" -ge "$quality_fail_threshold" ]; then
            : >"$quality_state" 2>/dev/null || true
            restore_egress "$iface x.ai quality probe degraded ${fails}x while $unit enabled; restoring"
            exit 0
        fi
        $LOG "$iface x.ai quality probe degraded (${fails}/${quality_fail_threshold}); not restoring yet"
    fi
    # Egress is fine, but the carve-out can be missing on its own (e.g. the
    # tunnel was restarted directly); re-assert it so rg.terra is not dark.
    carveout_present || { $LOG "egress up but haozeke carve-out missing; re-applying"; reassert_carveout; }
    exit 0
fi

restore_egress "$iface not carrying egress while $unit enabled; restoring"
