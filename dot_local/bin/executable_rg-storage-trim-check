#!/usr/bin/env bash
# Managed by chezmoi (dot_local/bin/executable_rg-storage-trim-check).

set -euo pipefail

root=${RG_STORAGE_TRIM_ROOT:-}
check=0
failures=0

usage() {
    cat <<'USAGE'
usage: rg-storage-trim-check [--check]

Validate the encrypted btrfs trim policy for rgx1gen11:
btrfs uses asynchronous discard, encrypted discard passthrough is present, and
weekly fstrim stays disabled to avoid a duplicate discard path.
USAGE
}

host_path() {
    local path=$1
    if [[ -n $root && $path == /* ]]; then
        printf '%s%s\n' "$root" "$path"
    else
        printf '%s\n' "$path"
    fi
}

pass() {
    printf 'ok: %s\n' "$*"
}

warn() {
    printf 'warn: %s\n' "$*" >&2
}

fail() {
    printf 'fail: %s\n' "$*" >&2
    failures=$((failures + 1))
}

trim_spaces() {
    sed 's/^[[:space:]]*//; s/[[:space:]]*$//'
}

check_timer() {
    local enabled active wants
    printf '== fstrim timer ==\n'
    if enabled=$(systemctl is-enabled fstrim.timer 2>&1); then
        enabled=$(printf '%s' "$enabled" | trim_spaces)
        if [[ $enabled == disabled || $enabled == masked ]]; then
            pass "fstrim.timer disabled for btrfs discard=async policy"
        else
            fail "fstrim.timer enabled; disable it when btrfs discard=async is active"
        fi
    else
        enabled=$(printf '%s' "$enabled" | trim_spaces)
        case "$enabled" in
        *"Operation not permitted"* | *"Failed to connect"*)
            wants=$(host_path /etc/systemd/system/timers.target.wants/fstrim.timer)
            if [[ -e $wants ]]; then
                fail "fstrim.timer enabled via systemd wants symlink"
            else
                pass "fstrim.timer disabled via missing wants symlink"
            fi
            ;;
        disabled | masked)
            pass "fstrim.timer disabled for btrfs discard=async policy"
            ;;
        *)
            fail "fstrim.timer enabled=$enabled expected=disabled"
            ;;
        esac
    fi

    if active=$(systemctl is-active fstrim.timer 2>&1); then
        active=$(printf '%s' "$active" | trim_spaces)
        if [[ $active == inactive ]]; then
            pass "fstrim.timer inactive"
        else
            fail "fstrim.timer active=$active expected=inactive"
        fi
    else
        active=$(printf '%s' "$active" | trim_spaces)
        case "$active" in
        *"Operation not permitted"* | *"Failed to connect"*)
            warn "fstrim.timer active state unavailable"
            ;;
        inactive)
            pass "fstrim.timer inactive"
            ;;
        *)
            fail "fstrim.timer active=$active expected=inactive"
            ;;
        esac
    fi
}

check_btrfs_mount_options() {
    local mounts source target fstype opts dump passno option bad=0 seen=0 has_async sync_option
    mounts=$(host_path /proc/mounts)
    printf '\n== btrfs async discard policy ==\n'
    if [[ ! -r $mounts ]]; then
        fail "missing readable /proc/mounts"
        return
    fi

    while read -r source target fstype opts dump passno; do
        [[ -n ${source:-} ]] || continue
        [[ ${fstype:-} == btrfs ]] || continue
        seen=1
        has_async=0
        sync_option=
        IFS=',' read -ra options <<<"${opts:-}"
        for option in "${options[@]}"; do
            case "$option" in
            discard=async)
                has_async=1
                ;;
            discard)
                sync_option=$option
                ;;
            discard=*)
                sync_option=$option
                ;;
            esac
        done
        if [[ -n $sync_option ]]; then
            fail "btrfs mount $target uses synchronous discard option $sync_option"
            bad=1
        elif (( has_async == 0 )); then
            fail "btrfs mount $target missing discard=async"
            bad=1
        fi
    done <"$mounts"

    if (( seen == 0 )); then
        fail "no live btrfs mounts found"
        return
    fi

    if (( bad == 0 )); then
        pass "live btrfs mounts use discard=async"
    fi
}

check_encrypted_passthrough() {
    local cmdline_path crypttab_path cmdline crypttab
    cmdline_path=$(host_path /proc/cmdline)
    crypttab_path=$(host_path /etc/crypttab)
    printf '\n== encrypted discard passthrough ==\n'

    cmdline=
    crypttab=
    [[ -r $cmdline_path ]] && cmdline=$(<"$cmdline_path")
    [[ -r $crypttab_path ]] && crypttab=$(<"$crypttab_path")

    if printf '%s\n%s\n' "$cmdline" "$crypttab" | rg -q \
        '(^|[[:space:],:])allow-discards($|[[:space:],:])|(^|[[:space:],])discard($|[[:space:],])|(^|[[:space:]])rd\.luks\.option=discard($|[[:space:]])'; then
        pass "encrypted discard passthrough allows btrfs discard=async"
    else
        fail "encrypted discard passthrough missing"
    fi
}

while [[ $# -gt 0 ]]; do
    case "$1" in
    --check)
        check=1
        shift
        ;;
    -h | --help)
        usage
        exit 0
        ;;
    *)
        usage >&2
        exit 2
        ;;
    esac
done

check_timer
check_btrfs_mount_options
check_encrypted_passthrough

if (( check == 1 && failures > 0 )); then
    printf '\nstorage trim policy failed: %d issue(s)\n' "$failures" >&2
    exit 1
fi

printf '\nstorage trim policy: ok\n'
