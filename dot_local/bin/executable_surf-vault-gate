#!/bin/bash
# surf-vault-gate: forced-command dispatcher for a restricted SSH key.
# Validates $SSH_ORIGINAL_COMMAND against a fixed allowlist, then execs the
# validated argv directly (never `sh -c` on untrusted input).
set -u

LOG="${HOME}/.local/state/surf-vault-gate.log"
VT_SERVE_CMD='/home/rgoswami/.local/bin/vault-tools serve --root /home/rgoswami/Git/Gitlab/obsidian-notes'
VISSUE_BIN='/home/rgoswami/.local/bin/vissue'
SECRET_STORE="${HOME}/.config/rg-broker-secrets"
SVC_VAULT="${NIMVAULT_SVC_REPO:-${HOME}/svc}"
# A forced command runs with a minimal PATH, so the other binaries here are
# named absolutely. This one has to be too: resolving it through PATH silently
# failed over to a store that no longer exists, and the gate answered "no store
# here can produce it" for a secret it was holding all along.
NIMVAULT_BIN="${NIMVAULT_BIN:-/home/rgoswami/.local/bin/nimvault}"

# Naming the binary absolutely is not enough: it shells out to helpers of its
# own, and an age-backed vault needs `age` on PATH. A forced command starts
# with a minimal one, so the read failed with "no age binary found" while the
# gate itself was working perfectly.
PATH="/home/rgoswami/.local/bin:${PATH}"
export PATH

# Entries the work laptop may read, named one by one. It holds no secrets of
# its own; it asks for these over the tailnet and keeps the answer in memory
# for the life of one process.
#
# An allowlist rather than a prefix or the whole store: the restricted key is
# on hardware administered by someone else, so the blast radius of that key
# being taken has to be exactly this list and nothing that gets added to the
# store later. Adding an entry here is a deliberate act.
SECRET_ALLOW='
surf/ai-hub/token
'

reject() {
    mkdir -p "$(dirname "$LOG")"
    printf '%s reject: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${SSH_ORIGINAL_COMMAND:-<empty>}" >>"$LOG" 2>/dev/null
    printf 'surf-vault-gate: command not permitted\n' >&2
    exit 127
}

cmd="${SSH_ORIGINAL_COMMAND:-}"
[ -n "$cmd" ] || reject

case "$cmd" in
    'true')
        exec true
        ;;
    'hostname')
        exec hostname
        ;;
    "$VT_SERVE_CMD")
        exec /home/rgoswami/.local/bin/vault-tools serve --root /home/rgoswami/Git/Gitlab/obsidian-notes
        ;;
    'secret '*)
        # `secret <entry>` prints one allowlisted secret on stdout and nothing
        # else. Matched against the list by exact string, so no traversal, no
        # glob and no prefix can widen it.
        want="${cmd#secret }"
        case "$want" in
            *[!A-Za-z0-9._/-]*) reject ;;
        esac
        ok=0
        while read -r entry; do
            [ -n "$entry" ] || continue
            [ "$entry" = "$want" ] && { ok=1; break; }
        done <<<"$SECRET_ALLOW"
        [ "$ok" -eq 1 ] || reject
        # Every read is recorded. A secret leaving this machine is worth a line
        # in the log even when it was permitted.
        mkdir -p "$(dirname "$LOG")"
        printf '%s secret: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$want" >>"$LOG" 2>/dev/null

        # Two stores, because the two hosts that can act as broker differ in
        # what they can decrypt without a person present. A laptop has an
        # unlocked agent, so `pass` answers. The always-on host does not: its
        # key needs a pinentry, which is exactly why naming it as the fallback
        # produced a fallback that could never answer. There it reads a small
        # store encrypted to a passphraseless key holding only allowlisted
        # entries, so availability does not depend on somebody having logged in
        # recently.
        if command -v pass >/dev/null 2>&1 && pass show "$want" 2>/dev/null; then
            exit 0
        fi
        # The service vault, read one entry at a time. Going through the CLI
        # rather than gpg directly means these secrets are visible to `list`,
        # `status` and `scan`; hand-rolled blobs beside the vault were not, so
        # nothing could tell you what this machine was actually serving.
        entry="$SECRET_STORE/$(printf '%s' "$want" | tr '/' '_' | sed 's/_/__/g')"
        if [ -d "$SVC_VAULT/.vault" ] && [ -x "$NIMVAULT_BIN" ]; then
            cd "$SVC_VAULT" || reject
            exec "$NIMVAULT_BIN" get "$entry"
        fi
        # Pre-migration layout, kept so a host that has not been migrated yet
        # still answers rather than failing closed on a secret it holds.
        if [ -r "$entry.gpg" ]; then
            exec gpg -q -d --batch "$entry.gpg"
        fi
        printf 'surf-vault-gate: %s is allowed but no store here can produce it\n' "$want" >&2
        exit 1
        ;;
    'secret-list')
        printf '%s\n' "$SECRET_ALLOW" | sed '/^$/d'
        exit 0
        ;;
esac

# only remaining shape accepted: the tracker CLI plus <subcommand> [args...]
case "$cmd" in
    'vissue '*|"${VISSUE_BIN} "*) ;;
    *) reject ;;
esac

# no shell metacharacters anywhere in the line
case "$cmd" in
    *[\;\|\&\>\<\`\$\(\)\\]*) reject ;;
esac
case "$cmd" in
    *$'\n'*) reject ;;
esac

# conservative overall character safelist
case "$cmd" in
    *[!A-Za-z0-9._/\ #@:=-]*) reject ;;
esac

read -r -a argv <<<"$cmd"

bin="${argv[0]}"
case "$bin" in
    vissue) bin="$VISSUE_BIN" ;;
    "$VISSUE_BIN") ;;
    *) reject ;;
esac

sub="${argv[1]:-}"
case "$sub" in
    ready|list|show|update|claim|hygiene|waiting-on|body-excerpt|identity|export) ;;
    *) reject ;;
esac

exec "$bin" "${argv[@]:1}"
