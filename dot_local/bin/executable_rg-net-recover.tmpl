#!/usr/bin/env bash
set -Eeuo pipefail

if [ "$(id -u)" -ne 0 ]; then
    printf 'run as root: sudo %s\n' "$0" >&2
    exit 2
fi

log_step() {
    printf '\n== %s ==\n' "$1"
}

run_optional() {
    "$@" || printf 'warning: command failed: %s\n' "$*" >&2
}

unit_file_exists() {
    systemctl list-unit-files "$1" --no-legend 2>/dev/null | grep -q "$1"
}

recover_rgx1gen11() {
    log_step "stop egress mutators while rebuilding"
    systemctl disable --now rg-us-egress-watch.service >/dev/null 2>&1 || true
    systemctl stop rg-us-egress-guard.timer >/dev/null 2>&1 || true
    systemctl reset-failed rg-us-egress-watch.service rg-us-egress-guard.service rg-us-egress.service wg-quick@rg-us-egress-wg.service >/dev/null 2>&1 || true

    log_step "ensure x.ai tailnet DNS is accepted"
    systemctl start tailscaled.service
    tailscale set --accept-dns=true

    log_step "reassert x.ai tailnet and local carve-outs"
    if [ -x /usr/local/sbin/rg-net-heal ]; then
        /usr/local/sbin/rg-net-heal
    else
        /home/rgoswami/.local/bin/rg-net-heal
    fi

    log_step "rebuild Houston egress and local DNS"
    systemctl restart rg-us-egress.service

    log_step "leave periodic guard active, realtime watcher disabled"
    systemctl restart rg-net-heal.timer
    systemctl restart rg-us-egress-guard.timer
    systemctl disable --now rg-us-egress-watch.service >/dev/null 2>&1 || true
    resolvectl flush-caches || true

    log_step "quick checks"
    systemctl is-active --quiet tailscaled.service && printf 'tailscaled: active\n'
    systemctl is-active --quiet ctrld.service && printf 'ctrld: active\n'
    systemctl is-active --quiet unbound.service && printf 'unbound: active\n'
    systemctl is-active --quiet wg-quick@rg-us-egress-wg.service && printf 'wg-quick@rg-us-egress-wg: active\n'
    systemctl is-active --quiet rg-us-egress-watch.service && {
        printf 'rg-us-egress-watch.service is still active; this is unsafe\n' >&2
        exit 5
    }
    resolvectl query api.x.ai >/dev/null
    curl -4 -sS --connect-timeout 5 --max-time 12 -o /dev/null \
        -w 'api.x.ai: http=%{http_code} time=%{time_total}s local=%{local_ip}\n' \
        https://api.x.ai/v1/models
    ip route get 100.100.100.100 | grep -q ' dev tailscale0' \
        && printf 'tailscale DNS route: tailscale0\n'
    ip route get 1.1.1.1 | grep -q ' dev rg-us-egress-wg' \
        && printf 'default IPv4 route: rg-us-egress-wg\n'
}

recover_rgsurflat() {
    log_step "start base network services"
    run_optional systemctl start NetworkManager.service
    run_optional systemctl start systemd-resolved.service
    run_optional systemctl start unbound.service
    run_optional systemctl start tailscaled.service
    systemctl reset-failed NetworkManager.service systemd-resolved.service unbound.service tailscaled.service rg-eduvpn-ensure.service openvpn-client@surf-split.service >/dev/null 2>&1 || true

    log_step "prefer stable Wi-Fi profiles"
    nmcli connection modify "Amsterdam Science Park" connection.autoconnect no connection.autoconnect-priority -999 >/dev/null 2>&1 || true
    nmcli connection modify "The Fairphone (Gen. 6)" connection.autoconnect yes connection.autoconnect-priority 100 >/dev/null 2>&1 || true
    nmcli general reload >/dev/null 2>&1 || true

    log_step "refresh resolver state"
    run_optional systemctl restart systemd-resolved.service
    run_optional systemctl restart unbound.service
    resolvectl flush-caches || true

    log_step "heal SURF eduVPN"
    if unit_file_exists rg-eduvpn-ensure.service; then
        run_optional systemctl start rg-eduvpn-ensure.service
    fi
    if unit_file_exists openvpn-client@surf-split.service; then
        run_optional systemctl restart openvpn-client@surf-split.service
    fi

    log_step "quick checks"
    systemctl is-active --quiet NetworkManager.service && printf 'NetworkManager: active\n'
    systemctl is-active --quiet systemd-resolved.service && printf 'systemd-resolved: active\n'
    systemctl is-active --quiet unbound.service && printf 'unbound: active\n'
    systemctl is-active --quiet tailscaled.service && printf 'tailscaled: active\n'
    systemctl is-active --quiet rg-eduvpn-ensure.timer && printf 'rg-eduvpn-ensure.timer: active\n' || true
    ip route get 100.119.130.84 >/dev/null 2>&1 && printf 'Terra route: local route exists\n' || true
    for host in confluence.ia.surf.nl jira.ia.surf.nl git.ia.surf.nl; do
        curl -k -L --connect-timeout 4 --max-time 8 -o /dev/null -sS "https://$host/" && {
            printf 'SURF internal HTTPS: ok (%s)\n' "$host"
            break
        }
    done || true
}

host="$(hostname 2>/dev/null || echo unknown)"
case "$host" in
    rgx1gen11)
        recover_rgx1gen11
        ;;
    rgSURFLat)
        recover_rgsurflat
        ;;
    rgam5terra|rg.terra|terra*)
        printf 'rg-net-recover: Terra host %s is intentionally not mutated\n' "$host"
        ;;
    *)
        printf 'rg-net-recover: no host-specific recovery for %s\n' "$host"
        ;;
esac
