#!/usr/bin/env bash
# Managed by chezmoi (dot_local/bin/executable_rg-lockscreen-selftest).
#
# Minimal behavior checks for the rg-lockscreen wrapper.

set -eu

if [ $# -gt 1 ]; then
    echo "usage: executable_rg-lockscreen-selftest [/path/to/executable_rg-lockscreen]" >&2
    exit 2
fi

SCRIPT="${1:-}"
if [ -z "$SCRIPT" ]; then
    here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
    SCRIPT="$here/executable_rg-lockscreen"
fi

assert_contains() {
    local haystack="$1" needle="$2" label="$3"
    case "$haystack" in
        *"$needle"*) ;;
        *)
            echo "FAIL: missing ${label}: ${needle}" >&2
            echo "$haystack" >&2
            exit 1
            ;;
    esac
}

assert_not_contains() {
    local haystack="$1" needle="$2" label="$3"
    case "$haystack" in
        *"$needle"*)
            echo "FAIL: unexpected ${label}: ${needle}" >&2
            echo "$haystack" >&2
            exit 1
            ;;
    esac
}

tmp_home=$(mktemp -d)
trap 'rm -rf "$tmp_home"' EXIT

mkdir -p \
    "$tmp_home/.config/swaylock" \
    "$tmp_home/.local/share/rg-theme/palettes/catppuccin/light" \
    "$tmp_home/.local/state/rg-theme" \
    "$tmp_home/Pictures/Walls"
touch "$tmp_home/.config/swaylock/config.local"
touch "$tmp_home/.config/swaylock/override.conf"
printf 'color=eff1f5\n' > "$tmp_home/.local/share/rg-theme/palettes/catppuccin/light/swaylock.conf"
printf 'palette=catppuccin\nmode=light\n' > "$tmp_home/.local/state/rg-theme/state"
touch "$tmp_home/Pictures/Walls/lockscreen.png"

out=$(
    HOME="$tmp_home" \
    XDG_CONFIG_HOME="$tmp_home/.config" \
    XDG_DATA_HOME="$tmp_home/.local/share" \
    XDG_STATE_HOME="$tmp_home/.local/state" \
    WAYLAND_DISPLAY=wayland-1 \
    "$SCRIPT" --dry-run --daemonize
)
assert_contains "$out" "--image" "default static image mode"
assert_contains "$out" "$tmp_home/Pictures/Walls/lockscreen.png" "default cat image path"
assert_not_contains "$out" "--screenshots" "screenshot mode by default"
assert_contains "$out" "$tmp_home/.local/share/rg-theme/palettes/catppuccin/light/swaylock.conf" "theme config path"
assert_contains "$out" "--daemonize" "daemonize passthrough"

fake_bin="$tmp_home/bin"
log="$tmp_home/daemonize.log"
pidfile="$tmp_home/fake-swaylock.pid"
mkdir -p "$fake_bin"

cat > "$fake_bin/systemd-run" <<'EOF'
#!/usr/bin/env bash
{
    printf 'systemd-run'
    printf ' %q' "$@"
    printf '\n'
} >> "$RG_TEST_LOG"
sleep 30 &
printf '%s\n' "$!" > "$RG_TEST_PIDFILE"
exit 0
EOF
chmod +x "$fake_bin/systemd-run"

cat > "$fake_bin/pgrep" <<'EOF'
#!/usr/bin/env bash
{
    printf 'pgrep'
    printf ' %q' "$@"
    printf '\n'
} >> "$RG_TEST_LOG"
cat "$RG_TEST_PIDFILE"
EOF
chmod +x "$fake_bin/pgrep"

cat > "$fake_bin/cat" <<'EOF'
#!/usr/bin/env bash
case "$1" in
    /proc/*/wchan)
        printf 'poll_schedule_timeout\n'
        ;;
    *)
        /usr/bin/cat "$@"
        ;;
esac
EOF
chmod +x "$fake_bin/cat"

PATH="$fake_bin:$PATH" \
HOME="$tmp_home" \
XDG_CONFIG_HOME="$tmp_home/.config" \
XDG_DATA_HOME="$tmp_home/.local/share" \
XDG_STATE_HOME="$tmp_home/.local/state" \
WAYLAND_DISPLAY=wayland-1 \
RG_TEST_LOG="$log" \
RG_TEST_PIDFILE="$pidfile" \
RG_LOCKSCREEN_READY_TIMEOUT=1 \
    "$SCRIPT" --daemonize
if [ -r "$pidfile" ]; then
    kill "$(cat "$pidfile")" 2>/dev/null || true
fi
daemon_log="$(cat "$log")"
assert_contains "$daemon_log" "systemd-run --user" "daemon lock transient scope"
assert_contains "$daemon_log" "pgrep -n -x swaylock" "daemon lock readiness wait"

out=$(
    HOME="$tmp_home" \
    XDG_CONFIG_HOME="$tmp_home/.config" \
    XDG_DATA_HOME="$tmp_home/.local/share" \
    XDG_STATE_HOME="$tmp_home/.local/state" \
    RG_LOCKSCREEN_CONFIG="$tmp_home/.config/swaylock/override.conf" \
    WAYLAND_DISPLAY=wayland-1 \
    "$SCRIPT" --dry-run
)
assert_contains "$out" "$tmp_home/.config/swaylock/override.conf" "explicit config override"

out=$(
    HOME="$tmp_home" \
    XDG_CONFIG_HOME="$tmp_home/.config" \
    XDG_DATA_HOME="$tmp_home/.local/share" \
    XDG_STATE_HOME="$tmp_home/.local/state" \
    WAYLAND_DISPLAY=wayland-1 \
    "$SCRIPT" --dry-run --screenshots
)
assert_contains "$out" "--screenshots" "explicit screenshot mode"

rm -f "$tmp_home/Pictures/Walls/lockscreen.png"
out=$(
    HOME="$tmp_home" \
    XDG_CONFIG_HOME="$tmp_home/.config" \
    XDG_DATA_HOME="$tmp_home/.local/share" \
    XDG_STATE_HOME="$tmp_home/.local/state" \
    WAYLAND_DISPLAY=wayland-1 \
    "$SCRIPT" --dry-run
)
assert_contains "$out" "--color" "solid fallback mode"
assert_contains "$out" "eff1f5" "theme fallback color"

# --prepare-sleep strips --daemonize / -f from the resolved swaylock
# command (the wrapper manages the fork lifecycle itself) and the
# dry-run marker confirms the wait branch was taken.
out=$(
    HOME="$tmp_home" \
    XDG_CONFIG_HOME="$tmp_home/.config" \
    XDG_DATA_HOME="$tmp_home/.local/share" \
    XDG_STATE_HOME="$tmp_home/.local/state" \
    WAYLAND_DISPLAY=wayland-1 \
    "$SCRIPT" --dry-run --prepare-sleep --daemonize
)
assert_contains "$out" "(waited for first paint)" "prepare-sleep marker"
assert_contains "$out" "swaymsg output \\* dpms on" "prepare-sleep dpms wake"
assert_not_contains "$out" "--daemonize" "daemonize stripped under --prepare-sleep"
assert_not_contains "$out" " -f " "short daemonize stripped under --prepare-sleep"

echo "ok"
