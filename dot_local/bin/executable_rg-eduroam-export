#!/usr/bin/env bash
# Export this host's working eduroam 802.1X settings into the private profile
# that rg-eduroam-provision consumes.
#
# The point is to copy settings that already authenticate rather than retype
# them per machine. With eduroam a missing CA check lets any access point
# broadcasting the SSID harvest the credential, so the CA cert and the server
# domain match travel with the identity instead of being left to a guess.
#
# Output carries the credential, so it lands in rg-net/private (gitignored,
# sealed with nimvault) and never in the chezmoi source tree.
set -uo pipefail

iwd_profile="${RG_EDUROAM_IWD_PROFILE:-/var/lib/iwd/eduroam.8021x}"
priv_dir="${RG_EDUROAM_PRIVATE_DIR:-$HOME/.local/share/rg-net/private}"
env_out="$priv_dir/eduroam.env"
ca_out="$priv_dir/eduroam-ca.pem"

die() { printf '%s\n' "$1" >&2; exit "${2:-1}"; }

# Run as yourself. Under `sudo su` the output lands in /root instead of the
# account whose vault will seal it, leaving a credential in a directory nobody
# is tracking. Privilege for reading the profile is taken per command below.
[ "$(id -u)" -ne 0 ] || die "run as your normal user, not root: the profile must land in your \$HOME for nimvault to seal it" 2

sudo test -r "$iwd_profile" 2>/dev/null \
    || die "cannot read $iwd_profile (run 'sudo -v' first, or set RG_EDUROAM_IWD_PROFILE)" 2

get() { sudo awk -F= -v k="$1" '$1 == k { sub(/^[^=]*=/, ""); print; exit }' "$iwd_profile"; }

method="$(get EAP-Method)"
anon="$(get EAP-Identity)"
case "$method" in
PEAP) p=EAP-PEAP ;;
TTLS) p=EAP-TTLS ;;
*) die "unsupported EAP method: ${method:-<empty>}" 3 ;;
esac
inner="$(get "$p-Phase2-Method")"
ident="$(get "$p-Phase2-Identity")"
pass="$(get "$p-Phase2-Password")"
cacert="$(get "$p-CACert")"
domain="$(get "$p-ServerDomainMask")"

[ -n "$ident" ] || die "no inner identity in $iwd_profile" 3
[ -n "$pass" ] || die "no inner password in $iwd_profile (it may live in a keyring)" 3

umask 077
install -d -m 0700 "$priv_dir"

# Normalise to the lowercase spellings NetworkManager expects, so the consumer
# does not have to know which stack the settings came from.
{
    printf '# Generated by rg-eduroam-export from %s\n' "$iwd_profile"
    printf '# Private: sealed with nimvault, never committed in plaintext.\n'
    printf 'RG_EDUROAM_SSID=%s\n' "${RG_EDUROAM_SSID:-eduroam}"
    printf 'RG_EDUROAM_EAP=%s\n' "$(printf '%s' "$method" | tr 'A-Z' 'a-z')"
    printf 'RG_EDUROAM_PHASE2=%s\n' "$(printf '%s' "${inner:-mschapv2}" | tr 'A-Z' 'a-z')"
    printf 'RG_EDUROAM_ANON_IDENTITY=%s\n' "$anon"
    printf 'RG_EDUROAM_IDENTITY=%s\n' "$ident"
    printf 'RG_EDUROAM_PASSWORD=%s\n' "$pass"
    printf 'RG_EDUROAM_DOMAIN_SUFFIX=%s\n' "$domain"
} >"$env_out"
chmod 0600 "$env_out"

if [ -n "$cacert" ] && sudo test -r "$cacert"; then
    sudo cat "$cacert" >"$ca_out"
    chmod 0600 "$ca_out"
    printf 'wrote %s (CA cert)\n' "$ca_out"
else
    rm -f "$ca_out"
    printf 'WARNING: no readable CA cert in the profile; provisioning will rely on the domain match alone\n' >&2
fi

# Shape only: the identity and password must not reach a terminal or a log.
printf 'wrote %s\n' "$env_out"
printf '  eap=%s phase2=%s domain-match=%s identity=%s password=%s\n' \
    "$(printf '%s' "$method" | tr 'A-Z' 'a-z')" "${inner:-mschapv2}" \
    "${domain:-none}" "${ident:+present}" "${pass:+present}"
printf '\nSeal it:\n  nimvault add %s\n' "$env_out"
[ -r "$ca_out" ] && printf '  nimvault add %s\n' "$ca_out"
printf '  nimvault seal\n'
