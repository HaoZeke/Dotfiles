#!/usr/bin/env bash
set -euo pipefail

repo=${1:-"$HOME/.local/share/chezmoi"}

fail() {
    printf 'FAIL: %s\n' "$*" >&2
    exit 1
}

launcher="$repo/dot_local/bin/executable_rg-kernel-build"
policy="$repo/dot_config/rg-kernel/build-lanes.env"

test -r "$launcher" || fail "missing rg-kernel-build launcher"
test -r "$policy" || fail "missing rg-kernel build lane policy"

rg -q '^RG_KERNEL_REMOTE=rg\.cosmolab$' "$policy" \
    || fail "kernel build policy does not target rg.cosmolab"
rg -q '^RG_KERNEL_REMOTE_ROOT=/scratch/goswami/rg-kernel-build$' "$policy" \
    || fail "kernel build remote root must use cosmolab scratch storage"
rg -q '^RG_KERNEL_MIN_REMOTE_AVAIL_GIB=40$' "$policy" \
    || fail "kernel build policy must require enough remote free space"
rg -q '^RG_KERNEL_LANES=.*arch-zen' "$policy" \
    || fail "kernel build policy is missing arch-zen lane"
rg -q '^RG_KERNEL_LANES=.*sched-ext' "$policy" \
    || fail "kernel build policy is missing sched-ext lane"
rg -q '^RG_KERNEL_LANES=.*cachy-bore' "$policy" \
    || fail "kernel build policy is missing cachy-bore lane"
rg -q '^RG_KERNEL_LANES=.*ck-muqss' "$policy" \
    || fail "kernel build policy is missing ck-muqss lane"
rg -q '^RG_KERNEL_REQUIRED_FALLBACKS="linux"$' "$policy" \
    || fail "kernel build policy must require the stock linux fallback"
rg -q '^RG_KERNEL_RECOMMENDED_FALLBACKS=.*linux-lts' "$policy" \
    || fail "kernel build policy does not recommend linux-lts fallback"
rg -q '^RG_KERNEL_PACKAGE_PREFIX=linux-rg$' "$policy" \
    || fail "kernel build policy does not isolate custom package names"
rg -q '^RG_KERNEL_KERNEL_LANES=.*arch-zen' "$policy" \
    || fail "kernel build policy does not mark arch-zen as a kernel lane"
rg -q '^RG_KERNEL_KERNEL_LANES=.*cachy-bore' "$policy" \
    || fail "kernel build policy does not mark cachy-bore as a kernel lane"
rg -q '^RG_KERNEL_KERNEL_LANES=.*ck-muqss' "$policy" \
    || fail "kernel build policy does not mark ck-muqss as a kernel lane"
rg -q '^RG_KERNEL_SUBDIR_cachy_bore="linux-cachyos-bore"$' "$policy" \
    || fail "cachy-bore lane does not select the BORE packaging subdir"
rg -q '^RG_KERNEL_MAKEPKG_ENV_cachy_bore=.*_cpusched=bore' "$policy" \
    || fail "cachy-bore lane does not select the BORE scheduler"
rg -q '^RG_KERNEL_CONTAINER_IMAGE=docker\.io/archlinux:base-devel$' "$policy" \
    || fail "kernel build policy does not define an Arch base-devel container"
rg -q '^RG_KERNEL_CONTAINER_ENGINE=auto$' "$policy" \
    || fail "kernel build policy does not auto-detect a container engine"

rg -q 'refuse_local_build' "$launcher" \
    || fail "launcher does not expose a local-build refusal guard"
rg -q 'remote_preflight' "$launcher" \
    || fail "launcher does not expose a remote preflight"
rg -q 'remote-preflight' "$launcher" \
    || fail "launcher does not route the remote preflight command"
rg -q 'install_preflight' "$launcher" \
    || fail "launcher does not expose a host install preflight"
rg -Fq 'install-preflight)' "$launcher" \
    || fail "launcher does not route the host install preflight command"
rg -q 'artifact_preflight' "$launcher" \
    || fail "launcher does not verify local artifacts before install guidance"
rg -q 'dkms_preflight' "$launcher" \
    || fail "launcher does not verify DKMS readiness before install guidance"
rg -q 'initramfs_preflight' "$launcher" \
    || fail "launcher does not verify initramfs readiness before install guidance"
rg -q 'check_remote_space' "$launcher" \
    || fail "launcher does not check remote build space"
rg -q 'df -Pk' "$launcher" \
    || fail "launcher does not inspect remote filesystem space"
rg -q 'remote_prepare' "$launcher" \
    || fail "launcher does not expose a remote prepare step"
rg -Fq 'prepare)' "$launcher" \
    || fail "launcher does not route the prepare command"
rg -q 'lane_subdir' "$launcher" \
    || fail "launcher does not resolve lane-specific packaging subdirectories"
rg -q 'select_container_engine' "$launcher" \
    || fail "launcher does not select a container engine"
rg -q 'run_container_makepkg' "$launcher" \
    || fail "launcher does not build through an Arch container"
rg -q 'import_validpgpkeys' "$launcher" \
    || fail "launcher does not import PKGBUILD signing keys"
rg -q 'filtered_keys' "$launcher" \
    || fail "launcher does not ignore empty signing key entries"
rg -q 'gpg --batch --keyserver' "$launcher" \
    || fail "launcher does not import signing keys from a keyserver"
rg -q 'RG_KERNEL_CONTAINER_IMAGE' "$launcher" \
    || fail "launcher does not pass a container image to remote builds"
rg -q 'command -v "\$cmd"' "$launcher" \
    || fail "remote preflight does not check required commands"
rg -q 'rewrite_kernel_pkgbase' "$launcher" \
    || fail "launcher does not isolate kernel package bases"
rg -q 'RG_KERNEL_PACKAGE_BASE' "$launcher" \
    || fail "launcher does not pass isolated package base to remote builds"
rg -q 'rg\.cosmolab' "$launcher" \
    || fail "launcher does not route work to rg.cosmolab"
rg -q 'ssh "\$RG_KERNEL_REMOTE"' "$launcher" \
    || fail "launcher does not execute the build over ssh"
rg -q 'makepkg --syncdeps --noconfirm' "$launcher" \
    || fail "launcher does not use makepkg for pacman artifacts"
rg -q 'rsync -az' "$launcher" \
    || fail "launcher does not sync artifacts back with rsync"
rg -q 'pacman -U' "$launcher" \
    || fail "launcher does not print pacman install guidance"
rg -q -- '-headers-\*\.pkg\.tar\.zst' "$launcher" \
    || fail "launcher does not require headers artifacts for kernel lanes"
rg -q 'pacman -Qq.*-dkms' "$launcher" \
    || fail "launcher does not inspect installed DKMS packages"
rg -q 'mkinitcpio' "$launcher" \
    || fail "launcher does not check for mkinitcpio"

list_output=$(RG_KERNEL_POLICY="$policy" "$launcher" list)
case "$list_output" in
    *'arch-zen -> https://gitlab.archlinux.org/archlinux/packaging/packages/linux-zen.git'*)
        ;;
    *)
        printf '%s\n' "$list_output" >&2
        fail "launcher list does not resolve arch-zen base repository"
        ;;
esac
case "$list_output" in
    *'sched-ext -> https://gitlab.archlinux.org/archlinux/packaging/packages/scx-scheds.git'*)
        ;;
    *)
        printf '%s\n' "$list_output" >&2
        fail "launcher list does not resolve sched-ext tool repository"
        ;;
esac

if rg -n 'makepkg[[:space:]][^;&|]*--install|makepkg[[:space:]][^;&|]*[[:space:]]-i([^[:alnum:]_-]|$)' "$launcher"; then
    fail "launcher must not install kernel packages during build"
fi

iso_output=$(RG_KERNEL_POLICY="$policy" "$launcher" package-base arch-zen)
test "$iso_output" = "linux-rg-arch-zen" \
    || fail "arch-zen package base is not isolated"
tool_output=$(RG_KERNEL_POLICY="$policy" "$launcher" package-base sched-ext)
test -z "$tool_output" \
    || fail "sched-ext tool lane should not be renamed as a kernel"

printf 'ok\n'
