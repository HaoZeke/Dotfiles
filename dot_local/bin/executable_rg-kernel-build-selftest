#!/usr/bin/env bash
set -euo pipefail

repo=${1:-"$HOME/.local/share/chezmoi"}

fail() {
    printf 'FAIL: %s\n' "$*" >&2
    exit 1
}

launcher="$repo/dot_local/bin/executable_rg-kernel-build"
policy="$repo/dot_config/rg-kernel/build-lanes.env"
series="$repo/dot_config/rg-kernel/linux-rg/patches/series"
patch_sources="$repo/dot_config/rg-kernel/linux-rg/patch-sources.tsv"
compat="$repo/dot_config/rg-kernel/linux-rg/compatible-patches.tsv"
compression_policy="$repo/dot_config/rg-kernel/linux-rg/compression-policy.tsv"
fragment="$repo/dot_config/rg-kernel/linux-rg/config-fragments/rgx1gen11.config"
oomd_config="$repo/dot_config/oomd/oomd-rgx1gen11.json"
oomd_installer="$repo/dot_local/bin/executable_rg-oomd-profile-install"
memory_tuning="$repo/.chezmoiscripts/run_onchange_linux_memory_tuning.sh.tmpl"
x1_profile="$repo/dot_local/bin/executable_rg-x1gen11-profile"

test -r "$launcher" || fail "missing rg-kernel-build launcher"
test -r "$policy" || fail "missing rg-kernel build policy"
test -r "$series" || fail "missing linux-rg patch series"
test -r "$patch_sources" || fail "missing linux-rg selected patch source manifest"
test -r "$compat" || fail "missing linux-rg compatibility manifest"
test -r "$compression_policy" || fail "missing linux-rg compression policy manifest"
test -r "$fragment" || fail "missing rgx1gen11 kernel config fragment"
test -r "$oomd_config" || fail "missing rgx1gen11 oomd config"
test -x "$oomd_installer" || fail "missing executable oomd profile installer"
test -r "$memory_tuning" || fail "missing memory tuning script"
test -x "$x1_profile" || fail "missing rgx1gen11 profile switcher"

if rg -n 'rg[.]cosmolab|RG_KERNEL_REMOTE|remote-preflight|remote_prepare|remote_build|refuse_local_build|RG_KERNEL_CONTAINER' \
    "$launcher" "$policy"; then
    fail "kernel build policy must be local-only while remote buildbot access is unavailable"
fi

rg -q '^RG_KERNEL_MACHINE_ID=rgx1gen11$' "$policy" \
    || fail "kernel build policy does not pin this host"
rg -q '^RG_KERNEL_MACHINE_MODEL="ThinkPad X1 Carbon Gen 11 21HM002GUS"$' "$policy" \
    || fail "kernel build policy does not record this laptop model"
rg -q '^RG_KERNEL_PROFILE=rgx1gen11-performance-battery$' "$policy" \
    || fail "kernel build policy must name the host profile"
rg -q '^RG_KERNEL_PACKAGE_BASE=linux-rg$' "$policy" \
    || fail "kernel build policy must define the linux-rg package base"
rg -q '^RG_KERNEL_SOURCE_REPO="\$HOME/Git/Github/Tools/linux-rg"$' "$policy" \
    || fail "kernel build policy must point at the finalized linux-rg source repo"
rg -q '^RG_KERNEL_BASE_REPO="https://gitlab\.archlinux\.org/archlinux/packaging/packages/linux\.git"$' "$policy" \
    || fail "kernel build policy must use the Arch linux package base"
rg -q '^RG_KERNEL_ZEN_BASE_REPO="https://gitlab\.archlinux\.org/archlinux/packaging/packages/linux-zen\.git"$' "$policy" \
    || fail "kernel build policy must record the Arch linux-zen comparison base"
rg -q '^RG_KERNEL_PATCH_SOURCES="\$HOME/\.config/rg-kernel/linux-rg/patch-sources\.tsv"$' "$policy" \
    || fail "kernel build policy does not define the selected patch source manifest"
rg -q '^RG_KERNEL_CONFIG_FRAGMENT="\$HOME/\.config/rg-kernel/linux-rg/config-fragments/rgx1gen11\.config"$' "$policy" \
    || fail "kernel build policy does not define the host config fragment"
rg -q '^RG_KERNEL_OOMD_CONFIG="\$HOME/\.config/oomd/oomd-rgx1gen11\.json"$' "$policy" \
    || fail "kernel build policy does not define the host oomd profile"
rg -q '^RG_KERNEL_MIN_LOCAL_AVAIL_GIB=10$' "$policy" \
    || fail "kernel build policy should fit the current local free-space budget"
rg -q '^RG_KERNEL_LOCAL_CPU_PERCENT=80$' "$policy" \
    || fail "kernel build policy must cap local CPU use"
rg -q '^RG_KERNEL_MAX_JOBS=9$' "$policy" \
    || fail "kernel build policy should cap this 12-thread laptop at 9 jobs"
rg -q '^RG_KERNEL_REQUIRED_FALLBACKS="linux"$' "$policy" \
    || fail "kernel build policy must require the stock linux fallback"
rg -q '^RG_KERNEL_RECOMMENDED_FALLBACKS=.*linux-lts' "$policy" \
    || fail "kernel build policy does not recommend linux-lts fallback"
rg -q '^RG_KERNEL_SKIP_DOCS=yes$' "$policy" \
    || fail "kernel build policy must suppress the docs package for local laptop builds"

case "$(<"$policy")" in
    *'RG_KERNEL_MAKEPKG_ENV'*|*'_cpusched='*|*'_cachy_config='*|*'_tcp_bbr3='*)
        fail "kernel build policy must not depend on CachyOS makepkg options"
        ;;
esac

for pkg in base-devel git bc cpio gettext libelf openssl pahole rust rust-bindgen rust-src clang llvm lld; do
    rg -q "(^|[=\" ])$pkg( |\")" "$policy" \
        || fail "kernel build dependency list missing $pkg"
done

rg -q $'^selected\tarch-linux-pkgbuild\t' "$compat" \
    || fail "compatibility manifest must select the Arch package base"
rg -q $'^selected\tbore\t' "$compat" \
    || fail "compatibility manifest must select BORE"
rg -q $'^selected\tbbr3\t' "$compat" \
    || fail "compatibility manifest must select carried BBRv3"
rg -q $'^selected\tadios\t' "$compat" \
    || fail "compatibility manifest must select carried ADIOS"
rg -q $'^selected\tmglru-devtree\t' "$compat" \
    || fail "compatibility manifest must select the carried MGLRU weld"
rg -q $'^survey\tliquorix\t' "$compat" \
    || fail "compatibility manifest must account for Liquorix inputs"
rg -q $'^disabled\tck-muqss\t' "$compat" \
    || fail "compatibility manifest must disable incompatible CK/MuQSS overlays"
rg -q $'^disabled\tcachyos-wholesale\t' "$compat" \
    || fail "compatibility manifest must disable CachyOS as a wholesale base"
rg -q $'^selected\tpsi-oomd\t' "$compat" \
    || fail "compatibility manifest must select PSI and oomd pressure control"
rg -q $'^selected\tmglru\t' "$compat" \
    || fail "compatibility manifest must select Multi-Gen LRU"
rg -q $'^selected\tcache-aware-sched\t' "$compat" \
    || fail "compatibility manifest must select carried cache-aware scheduling"
rg -q $'^selected\tmm-bulk-free-hotpaths\t' "$compat" \
    || fail "compatibility manifest must select carried bulk-free hot paths"

rg -q $'^selected\tzswap-zstd\t' "$compression_policy" \
    || fail "compression policy must select zstd-backed zswap"
rg -q $'^selected\tzram-zstd\t' "$compression_policy" \
    || fail "compression policy must select zstd-backed zram"
rg -q $'^selected\tzram-writeback-tracking\t' "$compression_policy" \
    || fail "compression policy must track zram writeback and memory accounting"
rg -q $'^selected\tinitramfs-package-zstd\t' "$compression_policy" \
    || fail "compression policy must keep initramfs/package zstd compatibility explicit"
rg -q $'^evaluate\tbtrfs-compress-zstd\t' "$compression_policy" \
    || fail "compression policy must require measured btrfs compress=zstd evaluation"
rg -q 'compression-algorithm = zstd' "$memory_tuning" \
    || fail "base zram-generator policy must use zstd"
rg -q 'compression-algorithm = zstd' "$x1_profile" \
    || fail "profile zram-generator override must use zstd"
if rg -n --glob '*.tmpl' --glob '*.conf' --glob '*.json' --glob '*.sh' \
    '(^|[,[:space:]])compress=zstd' \
    "$repo/.chezmoiscripts" "$repo/dot_config" "$repo/dot_local/bin"; then
    fail "btrfs compress=zstd must stay out of live host config until evaluated"
fi

for carried_patch in 0001-bore-cachy.patch 0018-cachy-mm-ratios.patch 0021-mm-bulk-free-hotpaths.patch; do
    test -r "$HOME/Git/Github/Tools/linux-rg/$carried_patch" \
        || fail "linux-rg source repo missing $carried_patch"
done

for config in \
    CONFIG_PSI=y \
    CONFIG_USER_NS_UNPRIVILEGED=y \
    CONFIG_COMPACT_UNEVICTABLE_DEFAULT=0 \
    CONFIG_LRU_GEN=y \
    CONFIG_LRU_GEN_ENABLED=y \
    CONFIG_ANON_MIN_RATIO=1 \
    CONFIG_CLEAN_LOW_RATIO=15 \
    CONFIG_CLEAN_MIN_RATIO=4 \
    CONFIG_SCHED_CLASS_EXT=y \
    CONFIG_SCHED_ASA=y \
    CONFIG_SCHED_BORE=y \
    CONFIG_SCHED_CACHE=y \
    CONFIG_ZSWAP=y \
    CONFIG_ZSWAP_DEFAULT_ON=y \
    CONFIG_ZSWAP_COMPRESSOR_DEFAULT_ZSTD=y \
    CONFIG_ZRAM_WRITEBACK=y \
    CONFIG_ZRAM_MEMORY_TRACKING=y \
    CONFIG_ZSTD_COMPRESS=m \
    CONFIG_ZSTD_DECOMPRESS=m \
    CONFIG_MIN_BASE_SLICE_NS=2000000 \
    CONFIG_DEBUG_INFO_BTF=y \
    CONFIG_BPF_JIT=y \
    CONFIG_X86_INTEL_PSTATE=y \
    CONFIG_INTEL_IDLE=y \
    CONFIG_PCIEASPM=y \
    CONFIG_PM_AUTOSLEEP=y \
    CONFIG_PM_WAKELOCKS=y \
    CONFIG_HIBERNATION=y \
    CONFIG_THINKPAD_ACPI=m \
    CONFIG_DRM_I915=m \
    CONFIG_DRM_XE=m \
    CONFIG_IWLWIFI=m \
    CONFIG_IWLMVM=m \
    CONFIG_SND_SOC_SOF_INTEL_TGL=m \
    CONFIG_BLK_DEV_NVME=m \
    CONFIG_USB4=m \
    CONFIG_THUNDERBOLT=m \
    CONFIG_BT_INTEL=m \
    CONFIG_ZRAM=m \
    CONFIG_TRANSPARENT_HUGEPAGE_MADVISE=y \
    CONFIG_MQ_IOSCHED_ADIOS=m \
    CONFIG_IOSCHED_BFQ=y \
    CONFIG_BFQ_GROUP_IOSCHED=y \
    CONFIG_TCP_CONG_BBR=y \
    CONFIG_DEFAULT_BBR=y \
    CONFIG_DEFAULT_FQ=y \
    CONFIG_DDCCI=m \
    CONFIG_V4L2_LOOPBACK=m
do
    rg -q "^$config$" "$fragment" \
        || fail "host config fragment missing $config"
done

for disabled in \
    CONFIG_PSI_DEFAULT_DISABLED \
    CONFIG_CPU_FREQ_DEFAULT_GOV_PERFORMANCE \
    CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS \
    CONFIG_DEFAULT_CUBIC
do
    rg -q "^# $disabled is not set$" "$fragment" \
        || fail "host config fragment should disable $disabled"
done

rg -q 'local_preflight' "$launcher" \
    || fail "launcher does not expose a local build preflight"
rg -q 'local_build_root' "$launcher" \
    || fail "launcher does not normalize the local build root"
rg -q 'bounded_jobs' "$launcher" \
    || fail "launcher does not compute bounded build jobs"
rg -q 'MAKEFLAGS="-j\$jobs' "$launcher" \
    || fail "launcher does not bound makepkg jobs"
rg -q 'CMAKE_BUILD_PARALLEL_LEVEL="\$jobs"' "$launcher" \
    || fail "launcher does not bound CMake jobs"
rg -q 'NINJAFLAGS="-j\$jobs"' "$launcher" \
    || fail "launcher does not bound Ninja jobs"
rg -q 'check_local_space' "$launcher" \
    || fail "launcher does not check local build space"
rg -q 'df -Pk' "$launcher" \
    || fail "launcher does not inspect local filesystem space"
rg -q 'prepare_pkgbuild' "$launcher" \
    || fail "launcher does not prepare a custom PKGBUILD"
rg -q 'rewrite_kernel_pkgbuild_identity' "$launcher" \
    || fail "launcher does not rewrite the package identity"
rg -q 'apply_patch_sources' "$launcher" \
    || fail "launcher does not apply selected patch sources"
rg -q 'apply_local_patch_series' "$launcher" \
    || fail "launcher does not apply the local compatible patch queue"
rg -q 'apply_config_fragment' "$launcher" \
    || fail "launcher does not apply the host config fragment"
rg -q 'scripts/config' "$launcher" \
    || fail "launcher does not use kernel scripts/config for config fragments"
rg -q 'drop_docs_package' "$launcher" \
    || fail "launcher does not suppress the docs package"
rg -q 'import_validpgpkeys' "$launcher" \
    || fail "launcher does not import PKGBUILD signing keys"
rg -q 'filtered_keys' "$launcher" \
    || fail "launcher does not ignore empty signing key entries"
rg -q 'makepkg --syncdeps --noconfirm' "$launcher" \
    || fail "launcher does not use makepkg for pacman artifacts"
rg -q 'PKGDEST="\$artifact_dir"' "$launcher" \
    || fail "launcher does not put built packages in the artifact directory"
rg -q 'pacman -U' "$launcher" \
    || fail "launcher does not print pacman install guidance"
rg -q '\$RG_KERNEL_PACKAGE_BASE-headers-\*\.pkg\.tar\.\*' "$launcher" \
    || fail "launcher does not require linux-rg headers artifacts"
rg -q 'pacman -Qq.*-dkms' "$launcher" \
    || fail "launcher does not inspect installed DKMS packages"
rg -q 'mkinitcpio' "$launcher" \
    || fail "launcher does not check for mkinitcpio"
rg -q 'refind_command' "$launcher" \
    || fail "launcher does not generate a rEFInd stanza"
rg -Fq 'patch-report)' "$launcher" \
    || fail "launcher does not route the patch-report command"
rg -Fq 'deps-command)' "$launcher" \
    || fail "launcher does not route the deps-command command"
rg -Fq 'oomd-command)' "$launcher" \
    || fail "launcher does not route the oomd-command command"
rg -Fq 'refind-command)' "$launcher" \
    || fail "launcher does not route the refind-command command"
rg -Fq 'refind-status)' "$launcher" \
    || fail "launcher does not route the refind-status command"
rg -Fq 'refind-install-script)' "$launcher" \
    || fail "launcher does not route the refind-install-script command"
rg -Fq 'update)' "$launcher" \
    || fail "launcher does not route the update command"

list_output=$(RG_KERNEL_POLICY="$policy" "$launcher" list)
case "$list_output" in
    *'package: linux-rg'*) ;;
    *) printf '%s\n' "$list_output" >&2; fail "launcher list does not report linux-rg package" ;;
esac
case "$list_output" in
    *'base: Arch linux PKGBUILD'*) ;;
    *) printf '%s\n' "$list_output" >&2; fail "launcher list does not report the Arch base" ;;
esac
case "$list_output" in
    *'profile: rgx1gen11-performance-battery'*) ;;
    *) printf '%s\n' "$list_output" >&2; fail "launcher list does not report the host profile" ;;
esac
case "$list_output" in
    *'source repo: '*'/Git/Github/Tools/linux-rg'*'selected patches: '*'0021-mm-bulk-free-hotpaths.patch'*) ;;
    *) printf '%s\n' "$list_output" >&2; fail "launcher list does not report finalized source repo patch selection" ;;
esac
case "$list_output" in
    *'jobs: 9 (80% local CPU cap)'*) ;;
    *) printf '%s\n' "$list_output" >&2; fail "launcher list does not report bounded jobs" ;;
esac

pkg_output=$(RG_KERNEL_POLICY="$policy" "$launcher" package-base)
test "$pkg_output" = "linux-rg" \
    || fail "package base is not linux-rg"

case "$(RG_KERNEL_POLICY="$policy" "$launcher" jobs)" in
    9) ;;
    *) fail "bounded job calculation did not return 9" ;;
esac

bad_src=$(mktemp -d /tmp/rg-kernel-bad-src.XXXXXX)
bad_build_root=$(mktemp -d /tmp/rg-kernel-bad-build.XXXXXX)
bad_policy=$(mktemp /tmp/rg-kernel-bad-policy.XXXXXX)
printf 'pkgbase=linux-rg\n' >"$bad_src/PKGBUILD"
sed \
    -e "s|^RG_KERNEL_SOURCE_REPO=.*|RG_KERNEL_SOURCE_REPO=\"$bad_src\"|" \
    -e "s|^RG_KERNEL_BUILD_ROOT=.*|RG_KERNEL_BUILD_ROOT=\"$bad_build_root\"|" \
    -e 's|^RG_KERNEL_MIN_LOCAL_AVAIL_GIB=.*|RG_KERNEL_MIN_LOCAL_AVAIL_GIB=0|' \
    "$policy" >"$bad_policy"
if RG_KERNEL_POLICY="$bad_policy" "$launcher" prepare >/tmp/rg-kernel-bad-prepare.out 2>&1; then
    fail "prepare should fail when source repo is not a git checkout"
fi
if rg -q '^prepared linux-rg' /tmp/rg-kernel-bad-prepare.out; then
    cat /tmp/rg-kernel-bad-prepare.out >&2
    fail "prepare must not print success after source copy failure"
fi
rg -q 'could not copy source package' /tmp/rg-kernel-bad-prepare.out \
    || fail "prepare failure should explain source package copy failure"

deps_output=$(RG_KERNEL_POLICY="$policy" "$launcher" deps-command)
case "$deps_output" in
    *'sudo pacman -S --needed'*'base-devel'*'rust-bindgen'*'rust-src'*'clang'*'lld'*) ;;
    *) printf '%s\n' "$deps_output" >&2; fail "deps-command does not include kernel build dependencies" ;;
esac

oomd_output=$(RG_KERNEL_POLICY="$policy" "$launcher" oomd-command)
case "$oomd_output" in
    *'rg-oomd-profile-install'*) ;;
    *) printf '%s\n' "$oomd_output" >&2; fail "oomd-command does not point at the installer" ;;
esac

patch_report=$(RG_KERNEL_POLICY="$policy" "$launcher" patch-report)
case "$patch_report" in
    *'== source repo =='*'linux-rg'*'0001-bore-cachy.patch'*'0021-mm-bulk-free-hotpaths.patch'*) ;;
    *) printf '%s\n' "$patch_report" >&2; fail "patch-report does not expose compatibility decisions" ;;
esac

refind_tmp=$(mktemp /tmp/rg-kernel-refind.XXXXXX)
RG_KERNEL_POLICY="$policy" "$launcher" refind-command "$refind_tmp" >/tmp/rg-kernel-refind.out
rg -q 'menuentry "Arch Linux \(linux-rg\)"' "$refind_tmp" \
    || fail "refind-command did not write a linux-rg menuentry"
rg -q 'loader /vmlinuz-linux-rg' "$refind_tmp" \
    || fail "refind-command did not point at vmlinuz-linux-rg"
rg -q 'initrd /initramfs-linux-rg.img' "$refind_tmp" \
    || fail "refind-command did not point at initramfs-linux-rg.img"

boot_tmp=$(mktemp -d /tmp/rg-kernel-boot.XXXXXX)
mkdir -p "$boot_tmp/EFI/refind"
printf '# refind test config\n' >"$boot_tmp/EFI/refind/refind.conf"
for boot_file in \
    vmlinuz-linux \
    initramfs-linux.img \
    vmlinuz-linux-rg \
    initramfs-linux-rg.img \
    intel-ucode.img; do
    : >"$boot_tmp/$boot_file"
done

refind_status=$(
    RG_KERNEL_POLICY="$policy" \
        RG_KERNEL_BOOT_DIR="$boot_tmp" \
        RG_KERNEL_REFIND_CONF="$boot_tmp/EFI/refind/refind.conf" \
        "$launcher" refind-status
)
case "$refind_status" in
    *"boot dir: $boot_tmp"*'rEFInd config: '*'vmlinuz-linux-rg'*'present'*) ;;
    *) printf '%s\n' "$refind_status" >&2; fail "refind-status does not report fake boot tree" ;;
esac

refind_script=$(mktemp /tmp/rg-kernel-refind-install.XXXXXX)
RG_KERNEL_POLICY="$policy" \
    RG_KERNEL_BOOT_DIR="$boot_tmp" \
    RG_KERNEL_REFIND_CONF="$boot_tmp/EFI/refind/refind.conf" \
    "$launcher" refind-install-script "$refind_script" >/tmp/rg-kernel-refind-install.out
test -x "$refind_script" || fail "refind-install-script did not create an executable script"
bash -n "$refind_script" || fail "generated refind install script is not valid bash"
shellcheck "$refind_script" || fail "generated refind install script fails shellcheck"
rg -q 'BEGIN linux-rg managed entry' "$refind_script" \
    || fail "generated refind install script lacks managed entry marker"
rg -Fq 'require_file "$boot_dir/vmlinuz-linux"' "$refind_script" \
    || fail "generated refind install script must require stock fallback kernel"
rg -Fq 'require_file "$boot_dir/vmlinuz-linux-rg"' "$refind_script" \
    || fail "generated refind install script must require linux-rg kernel image"

for json_text in \
    '"pressure_rising_beyond"' \
    '"kill_by_memory_size_or_growth"' \
    '"kill_by_swap_usage"' \
    '"resource": "memory"' \
    '"resource": "io"' \
    '"post_action_delay"'
do
    rg -q "$json_text" "$oomd_config" \
        || fail "oomd config missing $json_text"
done

rg -q 'MemoryMin=64M' "$oomd_installer" \
    || fail "oomd installer does not protect oomd memory"
rg -q 'DefaultMemoryAccounting=true' "$oomd_installer" \
    || fail "oomd installer does not enable memory accounting"
rg -q 'systemd.unified_cgroup_hierarchy=1' "$oomd_installer" \
    || fail "oomd installer does not document unified cgroup requirement"

if rg -n 'makepkg[[:space:]][^;&|]*--install|makepkg[[:space:]][^;&|]*[[:space:]]-i([^[:alnum:]_-]|$)' "$launcher"; then
    fail "launcher must not install kernel packages during build"
fi

printf 'rg-kernel-build source selftest ok\n'
