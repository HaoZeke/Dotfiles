#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
    printf 'usage: rg-networkd-apply INTERFACE\n' >&2
    exit 64
}

test "$#" -eq 1 || usage
interface=$1
[[ "$interface" =~ ^[[:alnum:]_.:-]+$ ]] || usage

networkctl_package_version() {
    networkctl --version 2>/dev/null \
        | sed -n '1{s/.*(\([^()]*\)).*/\1/p;q;}'
}

networkd_package_version() {
    varlinkctl info /run/systemd/netif/io.systemd.Network 2>/dev/null \
        | sed -n 's/^[[:space:]]*Version:[[:space:]]*[^[:space:]]*[[:space:]]*(\([^()]*\)).*/\1/p'
}

client_version=$(networkctl_package_version || true)
server_version=$(networkd_package_version || true)

if [ -n "$client_version" ] && [ "$client_version" = "$server_version" ]; then
    networkctl reload
    networkctl reconfigure "$interface"
    exit 0
fi

link=$(ip -o link show dev "$interface")
ifindex=${link%%:*}
ifindex=${ifindex//[[:space:]]/}
[[ "$ifindex" =~ ^[1-9][0-9]*$ ]] || {
    printf 'rg-networkd-apply: invalid interface index for %s\n' "$interface" >&2
    exit 1
}

printf 'rg-networkd-apply: networkctl=%s networkd=%s; using D-Bus compatibility path\n' \
    "${client_version:-unknown}" "${server_version:-unknown}" >&2
busctl call org.freedesktop.network1 /org/freedesktop/network1 \
    org.freedesktop.network1.Manager Reload
busctl call org.freedesktop.network1 /org/freedesktop/network1 \
    org.freedesktop.network1.Manager ReconfigureLink i "$ifindex"
