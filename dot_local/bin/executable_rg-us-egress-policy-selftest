#!/usr/bin/env bash
set -euo pipefail

fail() {
    printf 'FAIL: %s\n' "$*" >&2
    exit 1
}

repo=${1:-"$HOME/.local/share/chezmoi"}
policy_source="$repo/dot_local/bin/executable_rg-us-egress-policy.tmpl"
launcher="$repo/dot_local/bin/executable_rg-houston-protected"
slice="$repo/dot_config/systemd/user/rg-houston-protected.slice"
provision="$repo/.chezmoiscripts/run_onchange_linux_us_egress_guard.sh.tmpl"
tailscale_provision="$repo/.chezmoiscripts/run_onchange_linux_tailscale_refresh.sh.tmpl"

test -r "$policy_source" || fail "missing protected-egress policy helper"
test -r "$launcher" || fail "missing protected-process launcher"
test -r "$slice" || fail "missing protected process slice"
test -r "$provision" || fail "missing protected-egress provisioner"
test -r "$tailscale_provision" || fail "missing x.ai tailnet provisioner"
rg -F -q '$HOME/.config/rg-us-egress-policy/recovery-hosts' "$provision" \
    || fail "provisioner does not consume the sealed recovery host set"
rg -q 'install.*recovery-hosts.*/etc/rg-us-egress-policy/recovery-hosts' "$provision" \
    || fail "sealed recovery host set is not installed for the root policy"
rg -q '^After=local-fs.target nftables.service$' "$provision" \
    || fail "protected policy can race the firewall ruleset loader"
rg -q '^Wants=network-pre.target nftables.service$' "$provision" \
    || fail "protected policy does not pull in its firewall owner"
rg -F -q 'install_bin "$rtrash" /usr/local/sbin/rtrash' "$provision" \
    || fail "root policy cleanup does not use a root-owned rtrash binary"
! rg -F -q 'sudo "$rtrash"' "$provision" \
    || fail "provisioner executes a user-owned rtrash binary as root"
rg -F -q '/usr/local/sbin/rtrash' "$policy_source" \
    || fail "root policy does not resolve its installed cleanup binary"
rg -F -q '"$FLOCK" -x 9' "$policy_source" \
    || fail "protected policy mutations are not serialized"
rg -q -- '--tun=userspace-networking' "$tailscale_provision" \
    || fail "x.ai tailnet still depends on kernel routing"
rg -q '^Group=rg-xai-underlay$' "$tailscale_provision" \
    || fail "x.ai userspace tailnet has no dedicated underlay group"
rg -q 'rg-xai-\(underlay\|houston\)' "$policy_source" \
    || fail "policy no longer retires the x.ai output-hook group remarks"
! rg -q 'meta skgid.*rg-xai' "$policy_source" \
    || fail "x.ai underlay must not be group-remarked in the output hook (wrong-source reroute)"
rg -q 'supervise_houston' "$launcher" \
    || fail "protected launcher has no Houston-monitor fallback"
rg -q 'kill -TERM.*child' "$launcher" \
    || fail "Houston-monitor fallback does not stop the browser on route loss"
rg -q 'meta skgid.*meta mark set.*PROTECTED_MARK' "$policy_source" \
    || fail "protected socket-group fallback has no nft mark"
rg -q 'setpriv.*--reuid' "$policy_source" \
    || fail "protected fallback does not drop root before command execution"
rg -q 'rg-us-egress-policy run-protected -- \*' "$provision" \
    || fail "protected fallback lacks a narrow sudoers grant"

tmp=$(mktemp -d)
trap 'rtrash -rf "$tmp"' EXIT
mkdir -p "$tmp/bin" "$tmp/state"

policy="$tmp/rg-us-egress-policy"
chezmoi --source "$repo" --no-tty --refresh-externals=never execute-template \
    <"$policy_source" >"$policy"
chmod +x "$policy"
bash -n "$policy" "$launcher"

log="$tmp/ip.log"
rules4="$tmp/rules4"
rules6="$tmp/rules6"
routes4="$tmp/routes4"
routes6="$tmp/routes6"
: >"$rules4"
: >"$rules6"
: >"$routes4"
: >"$routes6"

cat >"$tmp/bin/ip" <<'SH'
#!/usr/bin/env bash
set -eu
printf '%s\n' "$*" >>"$RG_FAKE_IP_LOG"
case "$*" in
    '-4 rule show') cat "$RG_FAKE_RULES4" ;;
    '-6 rule show') cat "$RG_FAKE_RULES6" ;;
    'link show rg-us-egress-wg')
        test "${RG_FAKE_HOUSTON_UP:-0}" = 1
        ;;
    '-4 route show table 51820')
        test "${RG_FAKE_HOUSTON_UP:-0}" = 1 \
            && printf 'default dev rg-us-egress-wg scope link\n'
        ;;
    '-6 route show table 51820')
        test "${RG_FAKE_HOUSTON_V6_UP:-0}" = 1 \
            && printf 'default dev rg-us-egress-wg metric 1024\n'
        ;;
    '-4 route show table 52')
        printf '203.0.113.12 dev tailscale0\n'
        ;;
    '-6 route show table 52')
        printf '2001:db8:52::12 dev tailscale0\n'
        ;;
    '-4 route show table main')
        printf '203.0.113.13 dev tun0\n'
        printf 'default via 192.0.2.1 dev wlan0\n'
        ;;
    '-6 route show table main')
        printf '2001:db8:13::/64 dev tun0\n'
        printf 'default via 2001:db8::1 dev wlan0\n'
        ;;
    '-4 route show table 51821')
        cat "$RG_FAKE_ROUTES4"
        ;;
    '-6 route show table 51821')
        cat "$RG_FAKE_ROUTES6"
        ;;
esac
SH
chmod +x "$tmp/bin/ip"

cat >"$tmp/bin/nft" <<'SH'
#!/usr/bin/env bash
set -eu
printf '%s\n' "$*" >>"$RG_FAKE_NFT_LOG"
if test "${1:-}" = -f; then
    cat >>"$RG_FAKE_NFT_LOG"
fi
case "$*" in
    'list table inet rg_houston_protected')
        test -s "$RG_FAKE_NFT_STATE" && cat "$RG_FAKE_NFT_STATE"
        ;;
esac
SH
chmod +x "$tmp/bin/nft"

cat >"$tmp/bin/getent" <<'SH'
#!/usr/bin/env bash
set -eu
family=$1
host=$2
case "${RG_FAKE_GETENT_PARTIAL:-0}:$family:$host" in
    1:ahostsv4:api.x.ai) printf '203.0.113.20 STREAM api.x.ai\n' ;;
    1:ahostsv4:grok.com|1:ahostsv4:repair-a.invalid) exit 2 ;;
    *:ahostsv4:api.x.ai) printf '203.0.113.10 STREAM api.x.ai\n' ;;
    *:ahostsv4:grok.com) printf '203.0.113.11 STREAM grok.com\n203.0.113.99 STREAM grok.com\n' ;;
    *:ahostsv4:auth.x.ai) printf '203.0.113.12 STREAM auth.x.ai\n' ;;
    *:ahostsv4:cli-chat-proxy.grok.com) printf '203.0.113.13 STREAM cli-chat-proxy.grok.com\n' ;;
    *:ahostsv4:repair-a.invalid) printf '198.51.100.10 STREAM repair-a.invalid\n203.0.113.99 STREAM repair-a.invalid\n' ;;
    *:ahostsv4:repair-b.invalid) printf '198.51.100.11 STREAM repair-b.invalid\n' ;;
    *:ahostsv6:api.x.ai) printf '2001:db8:10::1 STREAM api.x.ai\n' ;;
    *:ahostsv6:grok.com) printf '2001:db8:99::1 STREAM grok.com\n' ;;
    *:ahostsv6:repair-a.invalid) printf '2001:db8:99::1 STREAM repair-a.invalid\n' ;;
esac
SH
chmod +x "$tmp/bin/getent"

cat >"$tmp/bin/id" <<'SH'
#!/usr/bin/env bash
test "${1:-}" = -u && printf '0\n'
SH
chmod +x "$tmp/bin/id"

nft_log="$tmp/nft.log"
nft_state="$tmp/nft.state"
: >"$nft_log"
: >"$nft_state"

run_policy() {
    PATH="$tmp/bin:$PATH" \
    RG_POLICY_IP="$tmp/bin/ip" \
    RG_POLICY_NFT="$tmp/bin/nft" \
    RG_POLICY_GETENT="$tmp/bin/getent" \
    RG_POLICY_STATE_DIR="$tmp/state" \
    RG_POLICY_TESTING=1 \
    RG_FAKE_IP_LOG="$log" \
    RG_FAKE_NFT_LOG="$nft_log" \
    RG_FAKE_NFT_STATE="$nft_state" \
    RG_FAKE_RULES4="$rules4" \
    RG_FAKE_RULES6="$rules6" \
    RG_FAKE_ROUTES4="$routes4" \
    RG_FAKE_ROUTES6="$routes6" \
    RG_POLICY_LOCK_FILE="$tmp/policy.lock" \
    RG_XAI_UNDERLAY_GID=920 \
    RG_XAI_PROTECTED_HOSTS='api.x.ai grok.com auth.x.ai cli-chat-proxy.grok.com' \
    RG_RECOVERY_HOSTS='repair-a.invalid repair-b.invalid' \
        "$policy" "$@"
}

run_policy sync-hosts
rg -qx '203\.0\.113\.10' "$tmp/state/xai-v4" \
    || fail "api.x.ai address is not protected"
rg -qx '203\.0\.113\.11' "$tmp/state/xai-v4" \
    || fail "grok.com address is not protected"
! rg -q '203\.0\.113\.(12|13|99)' "$tmp/state/xai-v4" \
    || fail "protected set captures Teachx, SURF, or recovery overlap"
rg -qx '203\.0\.113\.99' "$tmp/state/collisions-v4" \
    || fail "recovery/xAI overlap is not recorded"
rg -qx '2001:db8:99::1' "$tmp/state/collisions-v6" \
    || fail "IPv6 recovery/xAI overlap is not recorded"

if ! RG_FAKE_GETENT_PARTIAL=1 run_policy sync-hosts; then
    fail "partial DNS refresh aborted protected-state reconciliation"
fi
for retained in 203.0.113.10 203.0.113.11 203.0.113.20; do
    rg -F -x -q "$retained" "$tmp/state/xai-v4" \
        || fail "partial xAI refresh discarded protected address $retained"
done
rg -F -x -q '203.0.113.99' "$tmp/state/recovery-v4" \
    || fail "partial recovery refresh discarded a retained repair address"

run_policy sync-hosts
! rg -F -x -q '203.0.113.20' "$tmp/state/xai-v4" \
    || fail "complete xAI refresh did not prune a stale protected address"

: >"$log"
run_policy assert
! rg -F -q 'comment "rg-xai-houston"' "$nft_log" \
    || fail "policy still installs the x.ai output-hook group remark"
for expected in \
    '-4 route replace unreachable default metric 42760 table 51821' \
    '-6 route replace unreachable default metric 42760 table 51821' \
    '-4 rule add pref 5194 lookup 52' \
    '-6 rule add pref 5194 lookup 52' \
    '-4 rule add pref 5196 fwmark 0x5252/0xffff lookup 51821' \
    '-6 rule add pref 5196 fwmark 0x5252/0xffff lookup 51821' \
    '-4 rule add pref 5188 to 203.0.113.10/32 lookup 51821' \
    '-4 rule add pref 5195 to 203.0.113.13/32 lookup main'; do
    rg -F -qx -- "$expected" "$log" || fail "missing policy operation: $expected"
done
! rg -q '203\.0\.113\.(12|99).*lookup 51821' "$log" \
    || fail "excluded address was routed into the protected table"

cat >"$rules4" <<'EOF'
5188:	from all to 203.0.113.10 lookup 51821
5188:	from all to 203.0.113.11 lookup 51821
5194:	from all lookup 52
5195:	from all to 192.200.0.0/24 lookup main
5195:	from all to 203.0.113.13 lookup main
5196:	from all fwmark 0x5252/0xffff lookup 51821
EOF
cat >"$rules6" <<'EOF'
5188:	from all to 2001:db8:10::1 lookup 51821
5194:	from all lookup 52
5195:	from all to 2001:db8:13::/64 lookup main
5195:	from all to 2606:b740::/32 lookup main
5196:	from all fwmark 0x5252/0xffff lookup 51821
EOF
printf 'unreachable default metric 42760\n' >"$routes4"
printf 'unreachable default metric 42760\n' >"$routes6"
: >"$log"
run_policy assert
! rg -q -- '(route replace|rule (add|del))' "$log" \
    || fail "an already matching policy churns routes or routing rules"

printf '5197:\tfrom all fwmark 0x80000/0xff0000 lookup 51821\n' >>"$rules4"
: >"$log"
run_policy assert
rg -F -qx -- '-4 rule del pref 5197 fwmark 0x80000/0xff0000 lookup 51821' "$log" \
    || fail "a live retired tailscale-mark rule was not reconciled away"
sed -i '/5197/d' "$rules4"

sed -i 's/203\.0\.113\.10/203.0.113.77/' "$rules4"
: >"$log"
run_policy assert
add_line=$(rg -n -F -- '-4 rule add pref 5188 to 203.0.113.10/32 lookup 51821' "$log" \
    | cut -d: -f1 || true)
del_line=$(rg -n -F -- '-4 rule del pref 5188 to 203.0.113.77 lookup 51821' "$log" \
    | cut -d: -f1 || true)
test -n "$add_line" && test -n "$del_line" && test "$add_line" -lt "$del_line" \
    || fail "destination reconciliation is not add-before-delete and selector-exact"

printf '5205:\tfrom all fwmark 0x80000/0xff0000 lookup 51820\n5206:\tfrom all lookup 52\n' >"$rules4"
printf '5205:\tfrom all fwmark 0x80000/0xff0000 lookup 51820\n5206:\tfrom all lookup 52\n' >"$rules6"
: >"$log"
run_policy assert
for family in -4 -6; do
    rg -F -qx -- "$family rule del pref 5205 fwmark 0x80000/0xff0000 lookup 51820" "$log" \
        || fail "$family legacy tailnet rule is not retired"
    ! rg -F -q -- "$family rule add pref 5197" "$log" \
        || fail "$family retired tailscale-mark steering was reinstalled"
    add_line=$(rg -n -F -- "$family rule add pref 5194 lookup 52" "$log" \
        | cut -d: -f1 || true)
    del_line=$(rg -n -F -- "$family rule del pref 5206 lookup 52" "$log" \
        | cut -d: -f1 || true)
    test -n "$add_line" && test -n "$del_line" && test "$add_line" -lt "$del_line" \
        || fail "$family duplicate tailnet lookup is not retired after preference 5194 ownership"
done
: >"$rules4"
: >"$rules6"

: >"$log"
RG_FAKE_HOUSTON_UP=1 RG_FAKE_HOUSTON_V6_UP=1 run_policy houston-up
rg -F -qx -- '-4 route replace default dev rg-us-egress-wg metric 10 table 51821' "$log" \
    || fail "Houston-up does not install the protected IPv4 live default"
rg -F -qx -- '-6 route replace default dev rg-us-egress-wg metric 10 table 51821' "$log" \
    || fail "Houston-up does not install the protected IPv6 live default"

: >"$log"
run_policy houston-down
rg -F -qx -- '-4 route del default dev rg-us-egress-wg table 51821' "$log" \
    || fail "Houston-down does not remove only the IPv4 live default"
rg -F -qx -- '-6 route del default dev rg-us-egress-wg table 51821' "$log" \
    || fail "Houston-down does not remove only the IPv6 live default"
! rg -q 'flush table 51821|del unreachable' "$log" \
    || fail "Houston-down removes the permanent fail-closed route"

: >"$log"
printf '5196:\tfrom all lookup 9999\n' >"$rules4"
if run_policy assert >/dev/null 2>&1; then
    fail "policy accepted a foreign rule at an owned preference"
fi
! rg -q 'route replace|rule add|rule del' "$log" \
    || fail "policy mutated routes before rejecting a preference collision"
: >"$rules4"

protected_slice='user.slice/user-1001.slice/user@1001.service/rg.slice/rg-houston.slice/rg-houston-protected.slice'
nft_render=$(run_policy --render-nft "$protected_slice")
printf '%s\n' "$nft_render" | rg -F -q "socket cgroupv2 level 6 \"$protected_slice\" meta mark set 0x5252" \
    || fail "nft policy does not mark the stable protected slice"

: >"$nft_log"
run_policy register-cgroup "$protected_slice"
rg -F -q "socket cgroupv2 level 6 \"$protected_slice\" meta mark set 0x5252" "$nft_log" \
    || fail "protected slice registration loses nft cgroup-path quoting"

: >"$nft_log"
run_policy assert
rg -F -q "socket cgroupv2 level 6 \"$protected_slice\" meta mark set 0x5252" "$nft_log" \
    || fail "policy reconciliation does not restore a registered slice after firewall reload"

: >"$log"
: >"$nft_log"
run_policy status >/dev/null
! rg -q '(^| )(add|replace|del|delete|flush)( |$)' "$log" "$nft_log" \
    || fail "status operation mutates policy state"

rg -q 'systemd-run --user --scope' "$launcher" \
    || fail "protected launcher does not create a user scope"
rg -q -- '--slice=rg-houston-protected.slice' "$launcher" \
    || fail "protected launcher does not enter the protected slice"
rg -q 'register-pid' "$launcher" \
    || fail "protected launcher does not register its exact cgroup before exec"
rg -q '^Before=shutdown.target$' "$slice" \
    || fail "protected slice lacks a stable user-manager lifecycle"

printf 'ok\n'
