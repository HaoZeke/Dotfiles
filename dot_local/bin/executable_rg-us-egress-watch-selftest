#!/usr/bin/env bash
# Selftest for rg-us-egress-watch: drives watch_loop with mocked events, a
# mocked clock, and a mocked guard, asserting that bursts collapse to one guard
# run per cooldown.
set -uo pipefail

fail() { printf 'FAIL: %s\n' "$1" >&2; exit 1; }

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
WATCH="$SCRIPT_DIR/rg-us-egress-watch"
if [ ! -f "$WATCH" ]; then
    watch_template="$SCRIPT_DIR/executable_rg-us-egress-watch.tmpl"
    [ -f "$watch_template" ] || watch_template="$SCRIPT_DIR/../bin/executable_rg-us-egress-watch.tmpl"
    [ -f "$watch_template" ] || fail "rg-us-egress-watch template not found"
    WATCH="$tmp/rg-us-egress-watch"
    chezmoi execute-template <"$watch_template" >"$WATCH"
fi

# Mock guard: append a byte per call.
cat >"$tmp/guard.sh" <<'G'
#!/usr/bin/env bash
printf 'x' >>"$RG_TEST_COUNT"
G
chmod +x "$tmp/guard.sh"

# Mock clock: pop successive values from RG_TEST_NOWFILE.
cat >"$tmp/now.sh" <<'NOW'
#!/usr/bin/env bash
f="$RG_TEST_NOWFILE"
read -r v <"$f"
tail -n +2 "$f" >"$f.rest" && mv "$f.rest" "$f"
printf '%s\n' "$v"
NOW
chmod +x "$tmp/now.sh"

count="$tmp/count"
nowfile="$tmp/now"

run_case() {
    : >"$count"
    printf '%s\n' "$1" >"$nowfile"
    RG_US_EGRESS_WATCH_LIB=1 \
        RG_US_EGRESS_WATCH_COOLDOWN=5 \
        RG_US_EGRESS_GUARD="$tmp/guard.sh" \
        RG_US_EGRESS_NOW_CMD="$tmp/now.sh" \
        RG_TEST_COUNT="$count" \
        RG_TEST_NOWFILE="$nowfile" \
        bash -c 'source "$0"; watch_loop' "$WATCH"
    wc -c <"$count" | tr -d ' '
}

# Three events at t=100,100,110 with a 5s cooldown -> guard runs at 100 and 110.
n=$(printf 'evt1\nevt2\nevt3\n' | run_case "100
100
110")
[ "$n" = "2" ] || fail "watch_loop must debounce a burst to one run per cooldown (expected 2, got $n)"

# A single event always runs the guard.
n=$(printf 'evt\n' | run_case "100")
[ "$n" = "1" ] || fail "watch_loop must run the guard on an event (got $n)"

printf 'ok\n'
