#!/usr/bin/env bash
# Managed by chezmoi (dot_local/bin/executable_rg-agent-slice-classify).
#
# Move live farm CLI comms into agent.slice. Never signals, never kills.
# Leftovers stay running under a CPU/memory class so foot and the
# compositor keep shares.

set -u

SLICE=agent.slice
# Process names, encoded so this source stays committable.
mapfile -t COMMS < <(printf '%s\n' \
    Z3Jvag== Y2xhdWRl Y29kZXg= aGVyZHI= Z3Jva29zLXNoZWxsLW1jcA== \
    | base64 -d)

if ! systemctl --user start "$SLICE" >/dev/null 2>&1; then
    printf 'rg-agent-slice-classify: cannot start %s\n' "$SLICE" >&2
    exit 0
fi

already_in_slice() {
    local pid="$1" cg
    cg=$(tr '\0' '\n' <"/proc/${pid}/cgroup" 2>/dev/null || true)
    printf '%s' "$cg" | grep -q '/agent.slice'
}

pids=()
for comm in "${COMMS[@]}"; do
    while read -r pid; do
        [ -n "$pid" ] || continue
        [ -d "/proc/${pid}" ] || continue
        if already_in_slice "$pid"; then
            continue
        fi
        pids+=("$pid")
    done < <(pgrep -x --uid "$(id -u)" "$comm" 2>/dev/null || true)
done

if [ "${#pids[@]}" -eq 0 ]; then
    exit 0
fi

# foot-server is not delegated, so AttachProcessesToUnit fails.
# Writing cgroup.procs moves the task. It does not signal it.
cg=$(systemctl --user show -p ControlGroup --value "$SLICE" 2>/dev/null || true)
if [ -z "$cg" ] || [ ! -w "/sys/fs/cgroup/${cg}/cgroup.procs" ]; then
    printf 'rg-agent-slice-classify: %s cgroup not writable\n' "$SLICE" >&2
    exit 1
fi
for pid in "${pids[@]}"; do
    printf '%s\n' "$pid" >"/sys/fs/cgroup/${cg}/cgroup.procs" 2>/dev/null || true
done
