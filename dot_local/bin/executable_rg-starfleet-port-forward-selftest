#!/usr/bin/env python3
"""Behavior checks for rg-starfleet-port-forward."""

from __future__ import annotations

import json
import os
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.request


def free_port() -> int:
    sock = socket.socket()
    sock.bind(("127.0.0.1", 0))
    port = sock.getsockname()[1]
    sock.close()
    return int(port)


def request(base_url: str, path: str) -> tuple[int, bytes]:
    try:
        with urllib.request.urlopen(base_url + path, timeout=2) as response:
            return response.status, response.read()
    except urllib.error.HTTPError as exc:
        return exc.code, exc.read()


def wait_for_server(proc: subprocess.Popen[str], base_url: str) -> None:
    deadline = time.time() + 10
    while time.time() < deadline:
        if proc.poll() is not None:
            raise AssertionError(f"server exited early: {proc.returncode}")
        try:
            status, body = request(base_url, "/health")
            if status == 200 and json.loads(body) == {"status": "ok"}:
                return
        except Exception:
            pass
        time.sleep(0.1)
    raise AssertionError("server did not become healthy")


def main() -> int:
    script = sys.argv[1] if len(sys.argv) > 1 else os.path.join(os.path.dirname(__file__), "rg-starfleet-port-forward")
    port = free_port()
    base_url = f"http://127.0.0.1:{port}"
    env = os.environ.copy()
    env["RG_STARFLEET_FORWARD_PORT"] = str(port)

    proc = subprocess.Popen(
        [sys.executable, script],
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        env=env,
    )
    try:
        wait_for_server(proc, base_url)
        status, body = request(
            base_url,
            "/port-forward-via-proxy"
            "?proxy=https%3A%2F%2F127.0.0.1%3A65535"
            f"&port={port}",
        )
        assert status == 200, body

        failures = []
        for _ in range(30):
            status, body = request(base_url, "/health")
            if status != 200 or json.loads(body) != {"status": "ok"}:
                failures.append((status, body[:80]))
        if failures:
            raise AssertionError(f"control endpoint was hijacked: {failures[:3]}")

        status, body = request(base_url, "/port-forward/list")
        forwards = json.loads(body)["forwards"]
        assert forwards[str(port)] == "https://127.0.0.1:65535", forwards
    finally:
        proc.terminate()
        try:
            proc.wait(timeout=3)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait(timeout=3)

    print("ok")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
