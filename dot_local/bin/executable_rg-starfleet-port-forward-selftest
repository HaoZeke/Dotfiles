#!/usr/bin/env bash
# Behavior checks for rg-starfleet-port-forward.

set -eu

script="${1:-$(dirname -- "$0")/rg-starfleet-port-forward}"
tmp_home="$(mktemp -d)"
trap 'rm -rf "$tmp_home"' EXIT

source_script="$tmp_home/source.py"
cache_script="$tmp_home/cache/local_port_forward.py"
fake_curl="$tmp_home/curl"

write_source() {
    cat >"$source_script" <<EOF
#!/usr/bin/env python3
import sys
print("${1}", " ".join(sys.argv[1:]))
EOF
    chmod +x "$source_script"
}

assert_eq() {
    actual="$1"
    expected="$2"
    label="$3"
    if [ "$actual" != "$expected" ]; then
        echo "FAIL: $label" >&2
        echo "expected: $expected" >&2
        echo "actual:   $actual" >&2
        exit 1
    fi
}

out="$("$script" --print-cache-path)"
case "$out" in
    */rg-starfleet/local_port_forward.py) ;;
    *)
        echo "FAIL: unexpected cache path: $out" >&2
        exit 1
        ;;
esac

write_source v1
out="$(
    XDG_DATA_HOME="$tmp_home/data" \
    RG_STARFLEET_FORWARD_URL="$source_script" \
    RG_STARFLEET_FORWARD_CACHE="$cache_script" \
    "$script" -- alpha beta
)"
assert_eq "$out" "v1 alpha beta" "initial cached helper run"

write_source v2
out="$(
    XDG_DATA_HOME="$tmp_home/data" \
    RG_STARFLEET_FORWARD_URL="$source_script" \
    RG_STARFLEET_FORWARD_CACHE="$cache_script" \
    "$script" -- gamma
)"
assert_eq "$out" "v1 gamma" "cached helper reused without refresh"

out="$(
    XDG_DATA_HOME="$tmp_home/data" \
    RG_STARFLEET_FORWARD_URL="$source_script" \
    RG_STARFLEET_FORWARD_CACHE="$cache_script" \
    "$script" --refresh -- delta
)"
assert_eq "$out" "v2 delta" "cached helper refreshed when requested"

cat >"$fake_curl" <<'EOF'
#!/usr/bin/env bash
if [ "$*" = "-fsS http://alive.test/health -o /dev/null" ]; then
    exit 0
fi
echo "unexpected curl: $*" >&2
exit 9
EOF
chmod +x "$fake_curl"

write_source v3
out="$(
    XDG_DATA_HOME="$tmp_home/data" \
    RG_STARFLEET_FORWARD_URL="$source_script" \
    RG_STARFLEET_FORWARD_CACHE="$cache_script" \
    RG_STARFLEET_FORWARD_HEALTH_URL="http://alive.test/health" \
    RG_STARFLEET_CURL="$fake_curl" \
    "$script"
)"
assert_eq "$out" "Serving on port 58234 (already running)" "healthy forwarder reused by default"

out="$(
    XDG_DATA_HOME="$tmp_home/data" \
    RG_STARFLEET_FORWARD_URL="$source_script" \
    RG_STARFLEET_FORWARD_CACHE="$cache_script" \
    RG_STARFLEET_FORWARD_HEALTH_URL="http://alive.test/health" \
    RG_STARFLEET_CURL="$fake_curl" \
    "$script" --replace epsilon
)"
assert_eq "$out" "v2 --replace epsilon" "explicit replace restarts helper"

echo "ok"
