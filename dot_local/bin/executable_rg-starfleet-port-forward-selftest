#!/usr/bin/env python3
"""Behavior checks for rg-starfleet-port-forward."""

from __future__ import annotations

import json
import os
import http.server
import socket
import socketserver
import subprocess
import sys
import threading
import time
import urllib.error
import urllib.request


def free_port() -> int:
    sock = socket.socket()
    sock.bind(("127.0.0.1", 0))
    port = sock.getsockname()[1]
    sock.close()
    return int(port)


def request(base_url: str, path: str) -> tuple[int, bytes]:
    try:
        with urllib.request.urlopen(base_url + path, timeout=2) as response:
            return response.status, response.read()
    except urllib.error.HTTPError as exc:
        return exc.code, exc.read()


def wait_for_server(proc: subprocess.Popen[str], base_url: str) -> None:
    deadline = time.time() + 10
    while time.time() < deadline:
        if proc.poll() is not None:
            raise AssertionError(f"server exited early: {proc.returncode}")
        try:
            status, body = request(base_url, "/health")
            if status == 200 and json.loads(body) == {"status": "ok"}:
                return
        except Exception:
            pass
        time.sleep(0.1)
    raise AssertionError("server did not become healthy")


class EmptyPortsHandler(http.server.BaseHTTPRequestHandler):
    def do_GET(self) -> None:
        if self.path == "/starfleet/list-ports":
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(b'{"ports": []}')
            return
        self.send_response(502)
        self.end_headers()

    def log_message(self, fmt: str, *args) -> None:
        pass


def main() -> int:
    script = sys.argv[1] if len(sys.argv) > 1 else os.path.join(os.path.dirname(__file__), "rg-starfleet-port-forward")
    port = free_port()
    base_url = f"http://127.0.0.1:{port}"
    env = os.environ.copy()
    env["RG_STARFLEET_FORWARD_PORT"] = str(port)
    empty_ports_server = socketserver.ThreadingTCPServer(("127.0.0.1", 0), EmptyPortsHandler)
    empty_ports_thread = threading.Thread(target=empty_ports_server.serve_forever, daemon=True)
    empty_ports_thread.start()
    empty_ports_port = empty_ports_server.server_address[1]

    proc = subprocess.Popen(
        [sys.executable, script],
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        text=True,
        env=env,
    )
    try:
        wait_for_server(proc, base_url)
        status, body = request(
            base_url,
            "/port-forward-via-proxy"
            "?proxy=https%3A%2F%2F127.0.0.1%3A65535"
            f"&port={port}",
        )
        assert status == 200, body

        failures = []
        for _ in range(30):
            status, body = request(base_url, "/health")
            if status != 200 or json.loads(body) != {"status": "ok"}:
                failures.append((status, body[:80]))
        if failures:
            raise AssertionError(f"control endpoint was hijacked: {failures[:3]}")

        status, body = request(base_url, "/port-forward/list")
        forwards = json.loads(body)["forwards"]
        assert forwards[str(port)] == "https://127.0.0.1:65535", forwards

        status, body = request(base_url, "/port-forward/stop" f"?port={port}")
        assert status == 200, body

        status, body = request(
            base_url,
            "/port-forward-via-proxy"
            f"?proxy=http%3A%2F%2F127.0.0.1%3A{empty_ports_port}"
            f"&port={port}",
        )
        if status != 424:
            raise AssertionError(f"missing remote port should return 424, got {status}: {body!r}")
        data = json.loads(body)
        assert data["error"] == "remote_port_missing", data
    finally:
        proc.terminate()
        try:
            proc.wait(timeout=3)
        except subprocess.TimeoutExpired:
            proc.kill()
            proc.wait(timeout=3)
        empty_ports_server.shutdown()
        empty_ports_server.server_close()

    print("ok")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
