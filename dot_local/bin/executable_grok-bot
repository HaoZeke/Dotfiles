#!/usr/bin/env bash
# Managed by chezmoi (dot_local/bin/executable_grok-bot).
#
# `grok-bot` on Livingston hosts: every launch goes through rg-grok-bot
# and so through the Houston door. There is no direct Electron fallback.
set -euo pipefail
launcher="$HOME/.local/bin/rg-grok-bot"
if [ ! -x "$launcher" ]; then
    echo "grok-bot: refusing to start without ${launcher}" >&2
    exit 2
fi
exec "$launcher" "$@"
