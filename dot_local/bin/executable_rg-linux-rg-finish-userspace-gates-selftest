#!/usr/bin/env bash
# Managed by chezmoi (dot_local/bin/executable_rg-linux-rg-finish-userspace-gates-selftest).

set -euo pipefail

repo=${1:-"$HOME/.local/share/chezmoi"}
script="$repo/dot_local/bin/executable_rg-linux-rg-finish-userspace-gates"

fail() {
    printf 'FAIL: %s\n' "$*" >&2
    exit 1
}

test -x "$script" || fail "missing finish helper"

tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT

fake_home="$tmpdir/home"
fake_root="$tmpdir/root"
fake_bin="$tmpdir/bin"
fake_linux_rg="$tmpdir/linux-rg"
bad_linux_rg="$tmpdir/bad-linux-rg"
fake_chezmoi="$tmpdir/chezmoi"
log="$tmpdir/commands.log"

mkdir -p \
    "$fake_home/.local/bin" \
    "$fake_root/boot/EFI/refind/icons" \
    "$fake_root/usr/share/linux-rg/refind" \
    "$fake_bin" \
    "$fake_linux_rg" \
    "$bad_linux_rg" \
    "$fake_chezmoi/dot_local/bin"

base64 -d >"$fake_linux_rg/os_linux_rg.png" <<'EOF'

EOF

base64 -d >"$bad_linux_rg/os_linux_rg.png" <<'EOF'
iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAAC0lEQVR4nGP4DwQACfsD/fteaysAAAAASUVORK5CYII=
EOF

cat >"$fake_linux_rg/rgx1gen11-live-check" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
printf 'rgx1gen11-live-check %s\n' "$*" >>"${RG_TEST_LOG:?}"
SH
chmod +x "$fake_linux_rg/rgx1gen11-live-check"
cp "$fake_linux_rg/rgx1gen11-live-check" "$bad_linux_rg/rgx1gen11-live-check"

for helper in \
    executable_rg-linux-rg-userspace-root-setup \
    executable_rg-memory-sysctl-check \
    executable_rg-pipewire-rt-check \
    executable_rg-oomd-policy-check \
    executable_rg-ksm-policy \
    executable_rg-storage-trim-check \
    executable_rg-zswap-tune \
    executable_rg-thermal-stack-check \
    executable_rg-x1gen11-profile \
    executable_rg-sched-ladder \
    executable_rg-scx-loader \
    executable_rg-damon-reclaim \
    executable_rg-psi-snapshot \
    executable_rg-psi-top \
    executable_rg-hfi-status \
    executable_rg-linux-rg-postboot-check \
    executable_rg-bench-matrix; do
    cat >"$fake_chezmoi/dot_local/bin/$helper" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
printf '%s %s\n' "$(basename "$0")" "$*" >>"${RG_TEST_LOG:?}"
case "$(basename "$0")" in
rg-bench-matrix|executable_rg-bench-matrix)
    case "${1:-}" in
    --quick)
        shift
        ;;
    esac
    case "${1:-}" in
    new)
        run="${RG_BENCH_DIR:?}/fake-run"
        mkdir -p "$run"
        cat >"$run/manifest.env" <<EOF
RUN_ID='fake-run'
RUN_DIR='$run'
HOSTNAME='rgx1gen11'
KERNEL='7.0.12-arch1-1-rg'
UNAME='Linux rgx1gen11 fake'
CREATED_UTC='20260621T000000Z'
QUICK='1'
EOF
        printf '%s\n' "$run"
        ;;
    run)
        printf 'ran gates\n' >"${3:?}/gates.out"
        printf 'ts\tgate-oomd\tPASS\tfake\n' >"${3:?}/results.tsv"
        ;;
    report)
        printf 'report %s\n' "${2:-}" >>"${RG_TEST_LOG:?}"
        ;;
    esac
    ;;
esac
SH
    chmod +x "$fake_chezmoi/dot_local/bin/$helper"
done

cat >"$fake_bin/pacman" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
printf 'linux-rg 1\nlinux-rg-headers 1\nlinux 1\nlinux-headers 1\nmkinitcpio 1\nrefind 1\n'
SH
chmod +x "$fake_bin/pacman"

cat >"$fake_bin/uname" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
printf 'Linux rgx1gen11 7.0.12-arch1-1-rg\n'
SH
chmod +x "$fake_bin/uname"

cat >"$fake_bin/getent" <<SH
#!/usr/bin/env bash
set -euo pipefail
printf 'rgoswami:x:1000:1000::%s:/bin/bash\n' "$fake_home"
SH
chmod +x "$fake_bin/getent"

cat >"$fake_bin/id" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
case "$*" in
"-gn rgoswami")
    printf 'rgoswami\n'
    ;;
*)
    /usr/bin/id "$@"
    ;;
esac
SH
chmod +x "$fake_bin/id"

cat >"$fake_bin/sudo" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
if [ "${1:-}" = "-u" ]; then
    shift 2
fi
while [[ ${1:-} == *=* ]]; do
    export "$1"
    shift
done
exec "$@"
SH
chmod +x "$fake_bin/sudo"

cat >"$fake_bin/sync" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
:
SH
chmod +x "$fake_bin/sync"

cat >"$fake_bin/identify" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
exit 1
SH
chmod +x "$fake_bin/identify"

PATH="$fake_bin:$PATH" \
RG_TEST_LOG="$log" \
RG_FINISH_USER=rgoswami \
RG_FINISH_USER_HOME="$fake_home" \
RG_FINISH_ROOT="$fake_root" \
RG_FINISH_REPO="$fake_linux_rg" \
RG_FINISH_CHEZMOI="$fake_chezmoi" \
RG_FINISH_EUID=0 \
    "$script" >"$tmpdir/out" 2>&1 || {
    sed -n '1,220p' "$tmpdir/out" >&2
    fail "finish helper should pass under fake root"
}

test -x "$fake_home/.local/bin/rg-linux-rg-userspace-root-setup" \
    || fail "finish helper must install root setup into user bin"
test -x "$fake_home/.local/bin/rgx1gen11-live-check" \
    || fail "finish helper must install live-check into user bin"
test -x "$fake_home/.local/bin/rg-memory-sysctl-check" \
    || fail "finish helper must install memory checker into user bin"
test -x "$fake_home/.local/bin/rg-pipewire-rt-check" \
    || fail "finish helper must install PipeWire RT checker into user bin"
test -x "$fake_home/.local/bin/rg-oomd-policy-check" \
    || fail "finish helper must install OOMD checker into user bin"
test -x "$fake_home/.local/bin/rg-ksm-policy" \
    || fail "finish helper must install KSM checker into user bin"
test -x "$fake_home/.local/bin/rg-storage-trim-check" \
    || fail "finish helper must install storage trim checker into user bin"
test -x "$fake_home/.local/bin/rg-zswap-tune" \
    || fail "finish helper must install zswap checker into user bin"
test -x "$fake_home/.local/bin/rg-thermal-stack-check" \
    || fail "finish helper must install thermal checker into user bin"
test -x "$fake_home/.local/bin/rg-x1gen11-profile" \
    || fail "finish helper must install profile helper into user bin"
test -x "$fake_home/.local/bin/rg-sched-ladder" \
    || fail "finish helper must install sched ladder into user bin"
test -x "$fake_home/.local/bin/rg-scx-loader" \
    || fail "finish helper must install scx loader into user bin"
test -x "$fake_home/.local/bin/rg-damon-reclaim" \
    || fail "finish helper must install DAMON reclaim helper into user bin"
test -x "$fake_home/.local/bin/rg-psi-snapshot" \
    || fail "finish helper must install PSI snapshot helper into user bin"
test -x "$fake_home/.local/bin/rg-psi-top" \
    || fail "finish helper must install PSI top helper into user bin"
test -x "$fake_home/.local/bin/rg-hfi-status" \
    || fail "finish helper must install HFI status helper into user bin"
test -x "$fake_home/.local/bin/rg-linux-rg-postboot-check" \
    || fail "finish helper must install postboot checker into user bin"
test -x "$fake_home/.local/bin/rg-bench-matrix" \
    || fail "finish helper must install bench matrix into user bin"
test -r "$fake_root/boot/EFI/refind/icons/os_linux_rg.png" \
    || fail "finish helper must install the rEFInd icon under the fake root"
test -r "$fake_root/usr/share/linux-rg/refind/os_linux_rg.png" \
    || fail "finish helper must install the packaged rEFInd icon under the fake root"
rg -q '^rg-linux-rg-userspace-root-setup ' "$log" \
    || fail "finish helper must run root setup"
rg -q '^rg-linux-rg-postboot-check ' "$log" \
    || fail "finish helper must run postboot check"
rg -q '^rg-bench-matrix .*run gates' "$log" \
    || fail "finish helper must run the gates bench"
rg -q '^report ' "$log" \
    || fail "finish helper must report the gates bench"

if PATH="$fake_bin:$PATH" \
    RG_TEST_LOG="$log" \
    RG_FINISH_USER=rgoswami \
    RG_FINISH_USER_HOME="$fake_home" \
    RG_FINISH_ROOT="$fake_root" \
    RG_FINISH_REPO="$bad_linux_rg" \
    RG_FINISH_CHEZMOI="$fake_chezmoi" \
    RG_FINISH_EUID=0 \
    "$script" >"$tmpdir/bad-icon.out" 2>&1; then
    fail "finish helper must reject an opaque RGBA rEFInd icon without identify"
fi
rg -q 'corner is not transparent' "$tmpdir/bad-icon.out" \
    || fail "opaque RGBA rejection should name the transparent-corner failure"

printf 'ok\n'
