#!/usr/bin/env bash
# Managed by chezmoi (dot_local/bin/executable_rg-oomd-policy-check-selftest).

set -euo pipefail

script_dir=$(cd "$(dirname "$0")" && pwd)
repo=${1:-$(git -C "$script_dir" rev-parse --show-toplevel 2>/dev/null || true)}
[ -n "$repo" ] || fail "missing source repo (pass as arg1)"
script="$repo/dot_local/bin/executable_rg-oomd-policy-check"
profile="$repo/dot_config/oomd/oomd-rgx1gen11.json"

fail() {
    printf 'FAIL: %s\n' "$*" >&2
    exit 1
}

test -x "$script" || fail "missing OOMD policy checker"
test -r "$profile" || fail "missing rgx1gen11 OOMD profile"

tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT
fake_root="$tmpdir/root"
fake_bin="$tmpdir/bin"

mkdir -p \
    "$fake_bin" \
    "$fake_root/proc/pressure" \
    "$fake_root/sys/fs/cgroup" \
    "$fake_root/etc/oomd" \
    "$fake_root/etc/systemd/system.conf.d" \
    "$fake_root/etc/systemd/system/hostcritical.slice.d" \
    "$fake_root/etc/systemd/system/oomd.service.d"

cp "$profile" "$fake_root/etc/oomd/oomd.json"
printf 'some avg10=0.00 avg60=0.00 avg300=0.00 total=0\nfull avg10=0.00 avg60=0.00 avg300=0.00 total=0\n' \
    >"$fake_root/proc/pressure/memory"
printf 'cpuset cpu io memory pids\n' >"$fake_root/sys/fs/cgroup/cgroup.controllers"

cat >"$fake_root/etc/systemd/system.conf.d/20-rg-resource-accounting.conf" <<'EOF'
[Manager]
DefaultCPUAccounting=true
DefaultIOAccounting=true
DefaultMemoryAccounting=true
DefaultTasksAccounting=true
EOF

cat >"$fake_root/etc/systemd/system/hostcritical.slice.d/10-rg-reserve.conf" <<'EOF'
[Slice]
MemoryMin=256M
MemoryLow=256M
CPUWeight=200
IOWeight=200
EOF

cat >"$fake_root/etc/systemd/system/oomd.service.d/10-rg-protection.conf" <<'EOF'
[Service]
Slice=hostcritical.slice
MemoryMin=64M
MemoryLow=64M
CPUWeight=200
IOWeight=200
EOF

cat >"$fake_bin/systemctl" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
case "$*" in
"is-active systemd-oomd.service"|"is-active systemd-oomd")
    printf 'active\n'
    ;;
"is-enabled systemd-oomd.service"|"is-enabled systemd-oomd")
    printf 'enabled\n'
    ;;
"is-active oomd.service"|"is-active oomd")
    printf 'active\n'
    ;;
"is-enabled oomd.service"|"is-enabled oomd")
    printf 'enabled\n'
    ;;
*)
    printf 'unexpected systemctl command: %s\n' "$*" >&2
    exit 2
    ;;
esac
SH
chmod +x "$fake_bin/systemctl"

cat >"$fake_bin/oomd" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
printf 'fake oomd\n'
SH
chmod +x "$fake_bin/oomd"

RG_OOMD_CHECK_ROOT="$fake_root" \
PATH="$fake_bin:$PATH" \
    "$script" --check >"$tmpdir/ok.out" 2>&1 || {
    sed -n '1,220p' "$tmpdir/ok.out" >&2
    fail "complete OOMD policy fixture should pass"
}

rg -q 'ok: PSI memory pressure readable' "$tmpdir/ok.out" \
    || fail "checker must verify PSI memory pressure"
rg -q 'ok: unified cgroup v2 memory/io controllers available' "$tmpdir/ok.out" \
    || fail "checker must verify cgroup v2 controllers"
rg -q 'ok: systemd-oomd.service active' "$tmpdir/ok.out" \
    || fail "checker must verify systemd-oomd is active"
rg -q 'ok: facebook oomd profile installed' "$tmpdir/ok.out" \
    || fail "checker must verify the installed facebook oomd profile"
rg -q 'ok: facebook oomd.service active' "$tmpdir/ok.out" \
    || fail "checker must verify facebook oomd service when binary exists"
rg -q 'ok: oomd binary present' "$tmpdir/ok.out" \
    || fail "checker must report the oomd binary when present"

rm -f "$fake_root/etc/oomd/oomd.json"
if RG_OOMD_CHECK_ROOT="$fake_root" PATH="$fake_bin:$PATH" "$script" --check >"$tmpdir/missing.out" 2>&1; then
    fail "missing facebook oomd profile should fail"
fi
rg -q 'fail: missing /etc/oomd/oomd.json' "$tmpdir/missing.out" \
    || fail "checker must report a missing facebook oomd profile"

# Missing binary is a hard fail (no soft skip). Build a PATH that has
# tools but not the host /usr/bin/oomd (which may be installed on this machine).
rm -f "$fake_bin/oomd"
nobin_path=$tmpdir/nobin-path
mkdir -p "$nobin_path"
# Prefer fake systemctl; expose real coreutils/rg without shipping /usr/bin wholesale.
for tool in bash env rg cat tr printf; do
    if [ -x "/usr/bin/$tool" ]; then
        ln -sfn "/usr/bin/$tool" "$nobin_path/$tool"
    fi
done
ln -sfn "$fake_bin/systemctl" "$nobin_path/systemctl"
cp "$profile" "$fake_root/etc/oomd/oomd.json"
if RG_OOMD_CHECK_ROOT="$fake_root" PATH="$nobin_path" "$script" --check >"$tmpdir/nobin.out" 2>&1; then
    fail "missing oomd binary should fail closed"
fi
rg -q 'fail: oomd binary missing' "$tmpdir/nobin.out" \
    || {
        sed -n '1,120p' "$tmpdir/nobin.out" >&2
        fail "checker must hard-fail when the Meta oomd binary is absent"
    }

# Install helper must refuse optional skip wording / fail without binary
install_helper="$repo/dot_local/bin/executable_rg-oomd-profile-install"
rg -q 'exit 1' "$install_helper" \
    || fail "profile install must exit non-zero without oomd binary"
! rg -q 'is not installed. Build facebookincubator' "$install_helper" \
    || fail "profile install must not soft-skip when binary is missing"

onchange="$repo/.chezmoiscripts/run_onchange_linux_rgx1gen11_oomd.sh.tmpl"
test -r "$onchange" || fail "missing rgx1gen11 Meta oomd onchange script"
rg -F '.chezmoi.hostname "rgx1gen11"' "$onchange" \
    || fail "oomd onchange must be gated to rgx1gen11"
rg -q 'rg-oomd-install-from-stage' "$onchange" \
    || fail "oomd onchange must install from terra stage when binary missing"
rg -q 'systemd-oomd.service must stay active' "$onchange" \
    || fail "oomd onchange must keep systemd-oomd as complementary path"

stage_helper="$repo/dot_local/bin/executable_rg-oomd-install-from-stage"
test -r "$stage_helper" || fail "missing rg-oomd-install-from-stage helper"
rg -q 'oomd --check-config' "$stage_helper" \
    || fail "stage install must validate config before enable"

# Profile must not ship reap_memory (unknown to Meta oomd 0.5.0)
! rg -q 'reap_memory' "$profile" \
    || fail "oomd-rgx1gen11.json must not use reap_memory (invalid on v0.5.0)"

# Seat protection: zram+swappiness=100 fills swap by design. swap_free then
# kill_by_swap_usage on user.slice/* destroys session-*.scope (sway+herdr).
rg -q 'user.slice/\*/user@\*.service/\*' "$profile" \
    || fail "oomd-rgx1gen11.json must target user@*.service, not the seat"
! rg -q '"cgroup": "user.slice/\*"' "$profile" \
    || fail "oomd-rgx1gen11.json must not kill unrestricted user.slice/*"
! rg -q '"name": "swap_free"' "$profile" \
    || fail "oomd-rgx1gen11.json must not use swap_free on zram"
! rg -q '"name": "kill_by_swap_usage"' "$profile" \
    || fail "oomd-rgx1gen11.json must not use kill_by_swap_usage"

printf 'ok\n'
