#!/usr/bin/env bash
# Managed by chezmoi (dot_local/bin/executable_rust-analyzer).
#
# PATH shim. Resolves the real rust-analyzer binary and launches it inside
# a transient systemd scope attached to rust-analyzer.slice, so cgroup
# limits from ~/.config/systemd/user/rust-analyzer.slice apply without
# any editor-side configuration.

set -u

# Resolve real binary, avoiding recursion into this shim.
REAL=""
if command -v rustup >/dev/null 2>&1; then
    REAL=$(rustup which rust-analyzer 2>/dev/null || true)
fi
if [ -z "$REAL" ] || [ ! -x "$REAL" ]; then
    if [ -x /usr/bin/rust-analyzer ]; then
        REAL=/usr/bin/rust-analyzer
    else
        SELF_DIR=$(dirname "$(readlink -f "$0")")
        REAL=$(PATH=$(printf '%s' "$PATH" | tr ':' '\n' | grep -vFx "$SELF_DIR" | paste -sd:) command -v rust-analyzer || true)
    fi
fi
if [ -z "$REAL" ] || [ ! -x "$REAL" ]; then
    echo "rust-analyzer shim: cannot locate real rust-analyzer binary" >&2
    exit 127
fi

# If the user systemd manager is unavailable (e.g. inside a container or
# over a degraded session), fall through to the real binary unwrapped
# rather than failing the editor launch.
if ! systemctl --user is-system-running >/dev/null 2>&1 \
   && ! systemctl --user is-active default.target >/dev/null 2>&1; then
    exec "$REAL" "$@"
fi

exec systemd-run --user --scope --quiet \
    --slice=rust-analyzer.slice \
    --unit="rust-analyzer-$$" \
    -- "$REAL" "$@"
