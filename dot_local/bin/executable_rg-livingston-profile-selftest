#!/usr/bin/env bash
# Managed by chezmoi (dot_local/bin/executable_rg-livingston-profile-selftest).
#
# Behavior checks for the Livingston location profile launcher.

set -eu

if [ $# -gt 1 ]; then
    echo "usage: executable_rg-livingston-profile-selftest [/path/to/executable_rg-livingston-profile]" >&2
    exit 2
fi

SCRIPT="${1:-}"
if [ -z "$SCRIPT" ]; then
    here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
    case "$(basename -- "$0")" in
        executable_*) SCRIPT="$here/executable_rg-livingston-profile" ;;
        *) SCRIPT="$here/rg-livingston-profile" ;;
    esac
fi

assert_contains() {
    local haystack="$1" needle="$2" label="$3"
    case "$haystack" in
        *"$needle"*) ;;
        *)
            echo "FAIL: missing ${label}: ${needle}" >&2
            echo "$haystack" >&2
            exit 1
            ;;
    esac
}

tmp_home=$(mktemp -d)
trap 'rm -rf "$tmp_home"' EXIT

out=$(
    HOME="$tmp_home" \
    XDG_DATA_HOME="$tmp_home/.local/share" \
    XDG_STATE_HOME="$tmp_home/.local/state" \
    "$SCRIPT" --dry-run env
)
assert_contains "$out" "TZ=America/Chicago" "timezone"
assert_contains "$out" "LANG=en_US.UTF-8" "locale"
assert_contains "$out" "RG_LOCATION_LAT=30.7110" "latitude"
assert_contains "$out" "RG_LOCATION_LON=-94.9327" "longitude"

out=$(
    HOME="$tmp_home" \
    XDG_DATA_HOME="$tmp_home/.local/share" \
    XDG_STATE_HOME="$tmp_home/.local/state" \
    "$SCRIPT" --dry-run chromium https://example.com
)
assert_contains "$out" "env TZ=America/Chicago" "browser env"
assert_contains "$out" "--user-data-dir=$tmp_home/.local/state/rg-location-profiles/livingston/chromium" "profile dir"
assert_contains "$out" "--load-extension=$tmp_home/.local/share/rg-location-profiles/livingston/chromium-geolocation" "extension"
assert_contains "$out" "--lang=en-US" "browser language"
assert_contains "$out" "https://example.com" "browser url"

out=$(
    HOME="$tmp_home" \
    XDG_DATA_HOME="$tmp_home/.local/share" \
    XDG_STATE_HOME="$tmp_home/.local/state" \
    "$SCRIPT" --dry-run chromium --headless=new --dump-dom https://example.com
)
assert_contains "$out" "--headless=new" "browser passthrough flag"
assert_contains "$out" "--dump-dom" "browser passthrough flag"
assert_contains "$out" "https://example.com" "browser url after flags"

out=$(
    HOME="$tmp_home" \
    XDG_DATA_HOME="$tmp_home/.local/share" \
    XDG_STATE_HOME="$tmp_home/.local/state" \
    "$SCRIPT" --dry-run --proxy socks5://127.0.0.1:9050 chromium
)
assert_contains "$out" "--proxy-server=socks5://127.0.0.1:9050" "proxy flag"

out=$(
    HOME="$tmp_home" \
    XDG_DATA_HOME="$tmp_home/.local/share" \
    XDG_STATE_HOME="$tmp_home/.local/state" \
    "$SCRIPT" --dry-run run date
)
assert_contains "$out" "env TZ=America/Chicago" "generic env"
assert_contains "$out" "date" "generic command"

echo "ok"
