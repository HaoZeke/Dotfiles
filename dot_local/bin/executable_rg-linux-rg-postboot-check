#!/usr/bin/env bash
set -euo pipefail

expected=${1:-7.0.12-arch1-1-rg}
user_home=${RG_USER_HOME:-/home/rgoswami}
root=${RG_LINUX_RG_POSTBOOT_ROOT:-}
allow_nonroot=${RG_LINUX_RG_POSTBOOT_ALLOW_NONROOT:-0}
command_path=${RG_LINUX_RG_POSTBOOT_COMMAND_PATH:-/usr/bin:/usr/local/bin:"$user_home/.local/bin":$PATH}
failures=0

if (( EUID != 0 )) && [[ $allow_nonroot != 1 ]]; then
  printf 'error: run as root\n' >&2
  exit 1
fi

host_path() {
  local path=$1
  if [[ -n $root && $path == /* ]]; then
    printf '%s%s\n' "$root" "$path"
  else
    printf '%s\n' "$path"
  fi
}

record_failure() {
  printf 'fail: %s\n' "$*" >&2
  failures=$((failures + 1))
}

check() {
  local label=$1
  shift
  printf '\n== %s ==\n' "$label"
  if ! "$@"; then
    record_failure "$label failed"
  fi
}

required_stat() {
  local path mapped meta
  for path in "$@"; do
    mapped=$(host_path "$path")
    if [[ ! -e $mapped ]]; then
      record_failure "missing $path"
      continue
    fi
    meta=$(stat -c '%U:%G %a %s' "$mapped") || {
      record_failure "stat failed for $path"
      continue
    }
    printf '%s %s\n' "$meta" "$path"
  done
}

show_required_exports() {
  local module_symvers mapped pattern
  module_symvers="/usr/lib/modules/$expected/build/Module.symvers"
  mapped=$(host_path "$module_symvers")
  pattern='cfg80211_del_sta_sinfo|cfg80211_ch_switch_notify|video_ioctl2|v4l2_fh_exit'
  if [[ ! -r $mapped ]]; then
    record_failure "missing $module_symvers"
    return
  fi
  if ! rg -n "$pattern" "$mapped"; then
    record_failure "missing required Module.symvers exports"
  fi
}

show_modinfo() {
  local module=$1
  local out
  out=$(mktemp)
  if modinfo -k "$expected" "$module" >"$out" 2>&1; then
    sed -n '1,18p' "$out"
  else
    sed -n '1,18p' "$out" >&2
    record_failure "modinfo failed for $module on $expected"
  fi
  rm -f "$out"
}

printf '== kernel identity ==\n'
uname -a
if [[ $(uname -r) != "$expected" ]]; then
  printf 'fail: running kernel is %s, expected %s\n' "$(uname -r)" "$expected" >&2
  failures=$((failures + 1))
fi

printf '\n== disk ==\n'
df -h / /boot /tmp || true

printf '\n== ownership sample ==\n'
required_stat \
  /usr/bin/rgx1gen11-boot-check \
  /usr/bin/rgx1gen11-dkms-overlay-apply \
  /usr/bin/linux-rg-module-symvers \
  "/usr/lib/modules/$expected/build/Module.symvers" \
  /boot/vmlinuz-linux-rg \
  /boot/initramfs-linux-rg.img

printf '\n== symvers required exports ==\n'
show_required_exports

printf '\n== module probes ==\n'
show_modinfo v4l2loopback
show_modinfo 88XXau

printf '\n== dkms status ==\n'
dkms status -k "$expected" || true
for spec in \
  'ddcci/0.4.5' \
  'evdi/1.14.7' \
  'rtl88xxau/r1298.b44d288' \
  'vboxhost/7.2.8_OSE' \
  'acpi_call/1.2.2'; do
  if ! dkms status -m "${spec%/*}" -v "${spec#*/}" -k "$expected" | rg -q 'installed'; then
    record_failure "DKMS module not installed for $expected: $spec"
  fi
done

printf '\n== in-tree v4l2loopback ==\n'
if ! modinfo -k "$expected" v4l2loopback | rg -q '^intree:[[:space:]]+Y$'; then
  record_failure "v4l2loopback is not the in-tree linux-rg module"
fi

check 'installed boot contract' rgx1gen11-boot-check --installed
check 'live boot contract' rgx1gen11-boot-check --live --require-boot-log
check 'live bundle' env PATH="$command_path" HOME=$user_home XDG_CONFIG_HOME=$user_home/.config rgx1gen11-live-check --with-userspace
check 'memory sysctl policy' env PATH="$command_path" HOME=$user_home XDG_CONFIG_HOME=$user_home/.config rg-memory-sysctl-check
check 'thermal stack policy' env PATH="$command_path" HOME=$user_home XDG_CONFIG_HOME=$user_home/.config rg-thermal-stack-check --check
check 'PipeWire RT policy' env PATH="$command_path" HOME=$user_home XDG_CONFIG_HOME=$user_home/.config rg-pipewire-rt-check --check
check 'KSM madvise policy' env PATH="$command_path" HOME=$user_home XDG_CONFIG_HOME=$user_home/.config rg-ksm-policy --check
check 'storage trim policy' env PATH="$command_path" HOME=$user_home XDG_CONFIG_HOME=$user_home/.config rg-storage-trim-check --check
check 'zswap zram policy' env PATH="$command_path" HOME=$user_home XDG_CONFIG_HOME=$user_home/.config rg-zswap-tune check

printf '\n== scheduler and power userspace ==\n'
command -v scx_loader || true
command -v scx_p2dq || true
command -v scx_rusty || true
check 'profile policy' env PATH="$command_path" HOME=$user_home XDG_CONFIG_HOME=$user_home/.config rg-x1gen11-profile doctor --check

printf '\n== thermal snapshot ==\n'
thermal_root=$(host_path /sys/class/thermal)
for path in "$thermal_root"/thermal_zone*/temp; do
  [[ -r $path ]] || continue
  zone=${path%/temp}
  type=$(cat "$zone/type" 2>/dev/null || printf unknown)
  temp=$(cat "$path" 2>/dev/null || printf 0)
  printf '%s %s.%03d C\n' "$type" "$((temp / 1000))" "$((temp % 1000))"
done

if (( failures > 0 )); then
  printf '\nlinux-rg postboot check failed: %d issue(s)\n' "$failures" >&2
  exit 1
fi

printf '\nlinux-rg postboot check passed for %s\n' "$expected"
