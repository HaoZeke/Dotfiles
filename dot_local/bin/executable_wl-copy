#!/usr/bin/env bash
# Managed by chezmoi (dot_local/bin/executable_wl-copy).
#
# Browser text fields commonly require a text/plain clipboard offer.
# wl-copy only offers one inferred MIME type, so textual stdin gets an
# explicit type while binary payloads and explicit --type calls keep the
# upstream behavior.

set -euo pipefail

real_wl_copy="${RG_WL_COPY_REAL:-/usr/bin/wl-copy}"
text_mime="${RG_WL_COPY_TEXT_MIME:-text/plain;charset=utf-8}"

has_explicit_type=0
pass_through=0
has_text_arg=0
end_options=0
args=("$@")

for ((i = 0; i < ${#args[@]}; i++)); do
    arg="${args[$i]}"

    if [ "$end_options" -eq 1 ]; then
        has_text_arg=1
        continue
    fi

    case "$arg" in
        --)
            end_options=1
            ;;
        -t | --type)
            has_explicit_type=1
            i=$((i + 1))
            ;;
        --type=* | -t?*)
            has_explicit_type=1
            ;;
        -c | --clear | -h | --help | -v | --version)
            pass_through=1
            ;;
        --*)
            ;;
        -*)
            ;;
        *)
            has_text_arg=1
            ;;
    esac
done

if [ "$has_explicit_type" -eq 1 ] || [ "$pass_through" -eq 1 ]; then
    exec "$real_wl_copy" "$@"
fi

if [ "$has_text_arg" -eq 1 ]; then
    exec "$real_wl_copy" --type "$text_mime" "$@"
fi

if [ -t 0 ]; then
    exec "$real_wl_copy" "$@"
fi

tmp="$(mktemp)"
cleanup() {
    rm -f "$tmp"
}
trap cleanup EXIT HUP INT TERM

cat >"$tmp"

is_text_payload() {
    local mime

    command -v file >/dev/null 2>&1 || return 0
    mime="$(file --brief --mime "$tmp" 2>/dev/null || true)"
    case "$mime" in
        *charset=binary*) return 1 ;;
        *) return 0 ;;
    esac
}

if is_text_payload; then
    "$real_wl_copy" --type "$text_mime" "$@" <"$tmp"
else
    "$real_wl_copy" "$@" <"$tmp"
fi
