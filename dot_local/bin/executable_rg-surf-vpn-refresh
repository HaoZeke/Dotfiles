#!/usr/bin/env bash
# Refresh the SURF split profile silently and request browser authorization when needed.
set -uo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
EXPORTER="${RG_SURF_EXPORTER:-$script_dir/rg-surf-vpn-export}"
STATUS_FILE="${RG_SURF_STATUS_FILE:-/var/lib/rg-surf-vpn/status.json}"
UNIT="${RG_SURF_OPENVPN_UNIT:-openvpn-client@surf-split.service}"
CANARY_HOST="${RG_SURF_CANARY_HOST:-servicedesk.surf.nl}"
THRESHOLD="${RG_SURF_RENEW_THRESHOLD:-129600}"
NOTIFY_COOLDOWN="${RG_SURF_NOTIFY_COOLDOWN:-21600}"
NOTIFY_TIMEOUT="${RG_SURF_NOTIFY_TIMEOUT:-240}"
NOW="${RG_SURF_NOW:-$(date +%s)}"

SYSTEMCTL="${RG_SURF_SYSTEMCTL:-systemctl}"
IP="${RG_SURF_IP:-ip}"
GETENT="${RG_SURF_GETENT:-getent}"
NOTIFY_SEND="${RG_SURF_NOTIFY_SEND:-notify-send}"
TIMEOUT="${RG_SURF_TIMEOUT:-timeout}"

state_home="${XDG_STATE_HOME:-$HOME/.local/state}"
state_dir="$state_home/rg-surf-vpn"
notification_state="$state_dir/auth-notified-at"

log() {
    printf 'rg-surf-vpn-refresh: %s\n' "$*"
}

usage() {
    printf 'usage: rg-surf-vpn-refresh --timer|--interactive\n' >&2
}

tunnel_healthy() {
    local address route
    "$SYSTEMCTL" is-active --quiet "$UNIT" || return 1
    "$IP" link show tun0 >/dev/null 2>&1 || return 1
    address="$("$GETENT" ahostsv4 "$CANARY_HOST" 2>/dev/null | awk '{print $1; exit}')"
    [ -n "$address" ] || return 1
    route="$("$IP" route get "$address" 2>/dev/null | head -1)"
    printf '%s\n' "$route" | grep -q ' dev tun0 '
}

renewal_needed() {
    local result expiry
    [ -r "$STATUS_FILE" ] || return 0
    result="$(jq -r '.result // empty' "$STATUS_FILE" 2>/dev/null)"
    expiry="$(jq -r '.not_after_epoch // empty' "$STATUS_FILE" 2>/dev/null)"
    [ "$result" = active ] || return 0
    case "$expiry" in ''|*[!0-9]*) return 0 ;; esac
    [ "$expiry" -gt $((NOW + THRESHOLD)) ] || return 0
    tunnel_healthy || return 0
    return 1
}

record_notification() {
    local temporary
    install -d -m 0700 "$state_dir"
    temporary="${notification_state}.new"
    printf '%s\n' "$NOW" >"$temporary"
    chmod 0600 "$temporary"
    mv -f "$temporary" "$notification_state"
}

notification_allowed() {
    local last=0
    if [ -r "$notification_state" ]; then
        read -r last <"$notification_state" || last=0
    fi
    case "$last" in ''|*[!0-9]*) last=0 ;; esac
    [ "$NOW" -ge $((last + NOTIFY_COOLDOWN)) ]
}

prompt_for_authorization() {
    local action
    if ! notification_allowed; then
        log "browser authorization is required; notification is throttled"
        return 0
    fi
    record_notification
    action="$(
        "$TIMEOUT" "$NOTIFY_TIMEOUT" "$NOTIFY_SEND" \
            -u critical \
            -a rg-surf-vpn \
            -A authenticate=Authenticate \
            -A later=Later \
            --wait \
            'SURF eduVPN authorization required' \
            'Authenticate to renew medewerkers-split, or run: rg-net surf-renew' \
            2>/dev/null
    )" || action=""
    if [ "$action" = authenticate ]; then
        "$EXPORTER" --interactive
        return $?
    fi
    log "browser authorization is required; run: rg-net surf-renew"
    return 0
}

[ -x "$EXPORTER" ] || { log "exporter not executable: $EXPORTER" >&2; exit 1; }

case "${1:-}" in
    --interactive)
        exec "$EXPORTER" --interactive
        ;;
    --timer)
        if ! renewal_needed; then
            log "installed profile and tunnel are healthy"
            exit 0
        fi
        "$EXPORTER" --noninteractive
        rc=$?
        case "$rc" in
            0) log "fresh profile placed in the installer spool"; exit 0 ;;
            42) prompt_for_authorization; exit $? ;;
            *)
                "$NOTIFY_SEND" -u critical -a rg-surf-vpn \
                    'SURF eduVPN renewal failed' \
                    'Inspect: journalctl --user -u rg-surf-vpn-refresh.service' \
                    >/dev/null 2>&1 || true
                log "silent export failed with status $rc" >&2
                exit "$rc"
                ;;
        esac
        ;;
    *) usage; exit 2 ;;
esac
