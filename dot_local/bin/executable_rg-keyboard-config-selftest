#!/usr/bin/env bash
set -euo pipefail

repo=${1:-"$HOME/.local/share/chezmoi"}

fail() {
    printf 'FAIL: %s\n' "$*" >&2
    exit 1
}

sway_config="$repo/dot_config/sway/config.tmpl"
power_script="$repo/.chezmoiscripts/run_onchange_linux_laptop_power.sh.tmpl"
kanata_config="$repo/dot_config/kanata/config.kbd.tmpl"
kanata_unit="$repo/dot_config/systemd/user/kanata.service"
kanshi_unit="$repo/dot_config/systemd/user/kanshi.service"

test -r "$sway_config" || fail "missing $sway_config"
test -r "$power_script" || fail "missing $power_script"
test -r "$kanata_config" || fail "missing $kanata_config"
test -r "$kanata_unit" || fail "missing $kanata_unit"
test -r "$kanshi_unit" || fail "missing $kanshi_unit"

rg -q 'linux-dev-names-include \(' "$kanata_config" \
    || fail "kanata does not select keyboards by device name"
rg -q '"AT Translated Set 2 keyboard"' "$kanata_config" \
    || fail "kanata does not include the built-in keyboard"
rg -q '"Dell KB216 Wired Keyboard"' "$kanata_config" \
    || fail "kanata does not include the supported external keyboard"
rg -q '"Lab31 - Keyboard"' "$kanata_config" \
    || fail "kanata does not include the detected external keyboard"
rg -q 'hostname "rgSURFLat"' "$kanata_config" \
    || fail "rgSURFLat keyboard differences must be hostname-gated"
rg -q 'ConditionEnvironment=WAYLAND_DISPLAY' "$kanata_unit" \
    || fail "kanata.service must not start before Wayland (greeter double-Colemak)"
rg -q 'ConditionEnvironment=WAYLAND_DISPLAY' "$kanshi_unit" \
    || fail "kanshi.service must not bind sway-session before Wayland"
rg -q 'WantedBy=sway-session.target' "$kanshi_unit" \
    || fail "kanshi.service must be wanted by sway-session.target, not default.target"
! rg -q 'input "1:1:AT_Translated_Set_2_keyboard"' "$sway_config" \
    || fail "sway disables the raw built-in keyboard instead of leaving it as a fallback"
! rg -q 'AT_Translated_Set_2_keyboard.*events disabled|events disabled.*AT_Translated_Set_2_keyboard' "$power_script" \
    || fail "resume hook disables the raw built-in keyboard fallback"

printf 'ok\n'
