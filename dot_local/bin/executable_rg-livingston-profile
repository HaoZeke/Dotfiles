#!/usr/bin/env bash
# Managed by chezmoi (dot_local/bin/executable_rg-livingston-profile).
#
# Launch commands and Chromium-family browsers with a Livingston, Texas
# process profile.

set -euo pipefail

PROFILE_NAME="livingston"
TZ_NAME="America/Chicago"
LANG_NAME="en_US.UTF-8"
BROWSER_LANG="en-US"
LOCATION_LAT="30.7110"
LOCATION_LON="-94.9327"
LOCATION_ACCURACY="35"
LOCATION_ALTITUDE="40.0"
GEOCLUE_OVERRIDE="/etc/geoclue/conf.d/99-rg-livingston.conf"
GEOLOCATION_FILE="/etc/geolocation"
GEOLOCATION_BACKUP="/etc/geolocation.rg-livingston-backup"
GEOLOCATION_DISABLED="/etc/geolocation.rg-livingston-disabled"
STARFLEET_URL="https://starfleet.teachx.ai/home"
STARFLEET_FORWARD_UNIT="rg-starfleet-port-forward"

usage() {
    cat <<'USAGE'
usage: rg-livingston-profile [--dry-run] [--proxy URL] COMMAND [ARGS...]

Commands:
  env                 Print the Livingston environment values.
  run -- CMD ...      Run a command with the Livingston process environment.
  doctor              Print profile, system, browser, and egress diagnostics.
  starfleet [BROWSER] Launch Starfleet with Tailscale routes and local forwarder.
  system COMMAND ...  Set the system timezone for COMMAND, then restore it.
  chromium [URL]      Launch Chromium with an isolated Livingston profile.
  chrome [URL]        Launch Google Chrome with an isolated Livingston profile.
  vivaldi [URL]       Launch Vivaldi with an isolated Livingston profile.

Options:
  --proxy URL      Pass URL to Chromium as --proxy-server=URL.
                  Also read from RG_LIVINGSTON_PROXY when set.
  --dry-run        Print the command without executing it.
  -h, --help       Show this help.

Environment:
  RG_LIVINGSTON_SKIP_EGRESS_CHECK=1  Do not warn when public IP is not Texas.
USAGE
}

die() {
    echo "rg-livingston-profile: $*" >&2
    exit 2
}

quote_cmd() {
    printf '%q' "$1"
    shift
    for arg in "$@"; do
        printf ' %q' "$arg"
    done
    printf '\n'
}

x_home() {
    local var_name="$1" fallback="$2"
    local value="${!var_name:-}"
    if [ -n "$value" ]; then
        printf '%s\n' "$value"
    else
        printf '%s\n' "$HOME/$fallback"
    fi
}

dry_run=0
proxy="${RG_LIVINGSTON_PROXY:-}"
replace_process=1
timedatectl_bin="${RG_LIVINGSTON_TIMEDATECTL:-timedatectl}"
sudo_bin="${RG_LIVINGSTON_SUDO:-sudo}"
systemctl_bin="${RG_LIVINGSTON_SYSTEMCTL:-systemctl}"
install_bin="${RG_LIVINGSTON_INSTALL:-install}"
cp_bin="${RG_LIVINGSTON_CP:-cp}"
mv_bin="${RG_LIVINGSTON_MV:-mv}"
test_bin="${RG_LIVINGSTON_TEST:-test}"
curl_bin="${RG_LIVINGSTON_CURL:-curl}"
jq_bin="${RG_LIVINGSTON_JQ:-jq}"
pgrep_bin="${RG_LIVINGSTON_PGREP:-pgrep}"
tailscale_bin="${RG_LIVINGSTON_TAILSCALE:-tailscale}"
systemd_run_bin="${RG_LIVINGSTON_SYSTEMD_RUN:-systemd-run}"
starfleet_forward_bin="${RG_STARFLEET_PORT_FORWARD_BIN:-$HOME/.local/bin/rg-starfleet-port-forward}"

while [ $# -gt 0 ]; do
    case "$1" in
        --dry-run)
            dry_run=1
            shift
            ;;
        --proxy)
            [ $# -ge 2 ] || die "--proxy requires an argument"
            proxy="$2"
            shift 2
            ;;
        -h | --help)
            usage
            exit 0
            ;;
        --)
            shift
            break
            ;;
        *)
            break
            ;;
    esac
done

cmd="${1:-chromium}"
if [ $# -gt 0 ]; then
    shift
fi

data_home="$(x_home XDG_DATA_HOME .local/share)"
state_home="$(x_home XDG_STATE_HOME .local/state)"
extension_dir="$data_home/rg-location-profiles/$PROFILE_NAME/chromium-geolocation"
profile_root="$state_home/rg-location-profiles/$PROFILE_NAME"

profile_env=(
    "TZ=$TZ_NAME"
    "LANG=$LANG_NAME"
    "LC_ALL=$LANG_NAME"
    "LC_TIME=$LANG_NAME"
    "LC_MONETARY=$LANG_NAME"
    "LANGUAGE=en_US:en"
    "RG_LOCATION_NAME=Livingston, Texas"
    "RG_LOCATION_TIMEZONE=$TZ_NAME"
    "RG_LOCATION_LAT=$LOCATION_LAT"
    "RG_LOCATION_LON=$LOCATION_LON"
    "RG_LOCATION_ACCURACY=$LOCATION_ACCURACY"
)

print_env() {
    local entry
    for entry in "${profile_env[@]}"; do
        printf '%s\n' "$entry"
    done
}

as_root() {
    if [ "${EUID:-$(id -u)}" -eq 0 ]; then
        "$@"
    else
        "$sudo_bin" "$@"
    fi
}

quote_root_cmd() {
    if [ "${EUID:-$(id -u)}" -eq 0 ]; then
        quote_cmd "$@"
    else
        quote_cmd "$sudo_bin" "$@"
    fi
}

json_field() {
    local json="$1" key="$2"
    if command -v "$jq_bin" >/dev/null 2>&1; then
        printf '%s\n' "$json" | "$jq_bin" -r --arg key "$key" '.[$key] // empty' 2>/dev/null || true
    else
        printf '%s\n' "$json" | sed -n "s/.*\"$key\"[[:space:]]*:[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p" | head -n 1
    fi
}

fetch_egress_json() {
    command -v "$curl_bin" >/dev/null 2>&1 || return 1
    "$curl_bin" -fsS --max-time 4 https://ipinfo.io/json 2>/dev/null
}

print_egress_info() {
    local json ip city region country timezone org loc
    json="$(fetch_egress_json || true)"
    if [ -z "$json" ]; then
        printf 'egress_status=unavailable\n'
        return 1
    fi

    ip="$(json_field "$json" ip)"
    city="$(json_field "$json" city)"
    region="$(json_field "$json" region)"
    country="$(json_field "$json" country)"
    timezone="$(json_field "$json" timezone)"
    org="$(json_field "$json" org)"
    loc="$(json_field "$json" loc)"

    printf 'egress_status=ok\n'
    printf 'egress_ip=%s\n' "${ip:-unknown}"
    printf 'egress_city=%s\n' "${city:-unknown}"
    printf 'egress_region=%s\n' "${region:-unknown}"
    printf 'egress_country=%s\n' "${country:-unknown}"
    printf 'egress_timezone=%s\n' "${timezone:-unknown}"
    printf 'egress_loc=%s\n' "${loc:-unknown}"
    printf 'egress_org=%s\n' "${org:-unknown}"
}

warn_egress_location() {
    local json ip city region country timezone
    [ "${RG_LIVINGSTON_SKIP_EGRESS_CHECK:-}" != "1" ] || return 0

    json="$(fetch_egress_json || true)"
    if [ -z "$json" ]; then
        echo "rg-livingston-profile: warning: public egress location could not be checked" >&2
        return 0
    fi

    ip="$(json_field "$json" ip)"
    city="$(json_field "$json" city)"
    region="$(json_field "$json" region)"
    country="$(json_field "$json" country)"
    timezone="$(json_field "$json" timezone)"

    if [ "$country" != "US" ] || [ "$region" != "Texas" ]; then
        echo "rg-livingston-profile: warning: public egress appears as ${city:-unknown}, ${region:-unknown}, ${country:-unknown} (${timezone:-unknown}, ${ip:-unknown})" >&2
        echo "rg-livingston-profile: server-side sites can still show that location until traffic exits through Texas" >&2
    fi
}

ensure_starfleet_routes() {
    local prefs route_all

    if [ "$dry_run" -eq 1 ]; then
        printf 'would run: '
        quote_cmd "$tailscale_bin" set --accept-routes=true
        return 0
    fi

    command -v "$tailscale_bin" >/dev/null 2>&1 || die "cannot locate tailscale"
    prefs="$("$tailscale_bin" debug prefs 2>/dev/null || true)"
    route_all="$(json_field "$prefs" RouteAll)"
    if [ "$route_all" != "true" ]; then
        "$tailscale_bin" set --accept-routes=true
    fi
}

ensure_starfleet_forwarder() {
    local main_pid cmdline forward_cache

    if [ "$dry_run" -eq 1 ]; then
        printf 'would run: '
        quote_cmd "$systemd_run_bin" --user "--unit=$STARFLEET_FORWARD_UNIT" --collect "$starfleet_forward_bin" --replace
        return 0
    fi

    [ -x "$starfleet_forward_bin" ] || die "missing executable: $starfleet_forward_bin"
    forward_cache="$("$starfleet_forward_bin" --print-cache-path 2>/dev/null || true)"
    if "$systemctl_bin" --user is-active --quiet "$STARFLEET_FORWARD_UNIT.service" 2>/dev/null; then
        main_pid="$("$systemctl_bin" --user show -p MainPID --value "$STARFLEET_FORWARD_UNIT.service" 2>/dev/null || true)"
        if [ -n "$main_pid" ] && [ "$main_pid" != "0" ] && [ -r "/proc/$main_pid/cmdline" ]; then
            cmdline="$(tr '\0' ' ' <"/proc/$main_pid/cmdline")"
            case "$cmdline" in
                *"$starfleet_forward_bin"*) return 0 ;;
            esac
            if [ -n "$forward_cache" ]; then
                case "$cmdline" in
                    *"$forward_cache"*) return 0 ;;
                esac
            fi
        fi
        "$systemctl_bin" --user stop "$STARFLEET_FORWARD_UNIT.service" >/dev/null 2>&1 || true
    fi
    "$systemd_run_bin" --user "--unit=$STARFLEET_FORWARD_UNIT" --collect "$starfleet_forward_bin" --replace >/dev/null
}

run_cmd() {
    if [ "$dry_run" -eq 1 ]; then
        quote_cmd env "${profile_env[@]}" "$@"
    elif [ "$replace_process" -eq 1 ]; then
        exec env "${profile_env[@]}" "$@"
    else
        env "${profile_env[@]}" "$@"
    fi
}

resolve_browser() {
    local name="$1" self_dir filtered_path resolved

    case "$name" in
        chromium)
            for resolved in /usr/bin/chromium /usr/lib/chromium/chromium; do
                [ -x "$resolved" ] && printf '%s\n' "$resolved" && return 0
            done
            ;;
        chrome)
            for resolved in /usr/bin/google-chrome-stable /usr/bin/google-chrome; do
                [ -x "$resolved" ] && printf '%s\n' "$resolved" && return 0
            done
            ;;
        vivaldi)
            for resolved in /usr/bin/vivaldi-stable /usr/bin/vivaldi; do
                [ -x "$resolved" ] && printf '%s\n' "$resolved" && return 0
            done
            ;;
    esac

    self_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
    filtered_path="$(printf '%s' "$PATH" | tr ':' '\n' | grep -vFx "$self_dir" | paste -sd:)"
    case "$name" in
        chromium) resolved="$(PATH="$filtered_path" command -v chromium 2>/dev/null || true)" ;;
        chrome) resolved="$(PATH="$filtered_path" command -v google-chrome-stable 2>/dev/null || PATH="$filtered_path" command -v google-chrome 2>/dev/null || true)" ;;
        vivaldi) resolved="$(PATH="$filtered_path" command -v vivaldi-stable 2>/dev/null || PATH="$filtered_path" command -v vivaldi 2>/dev/null || true)" ;;
        *) resolved="" ;;
    esac

    [ -n "$resolved" ] || return 1
    printf '%s\n' "$resolved"
}

seed_chromium_preferences() {
    local profile_dir="$1" prefs_dir prefs_file
    prefs_dir="$profile_dir/Default"
    prefs_file="$prefs_dir/Preferences"
    mkdir -p "$prefs_dir"
    if [ ! -e "$prefs_file" ]; then
        cat >"$prefs_file" <<'JSON'
{
  "intl": {
    "accept_languages": "en-US,en"
  },
  "profile": {
    "default_content_setting_values": {
      "geolocation": 1
    }
  }
}
JSON
    fi
}

run_browser() {
    local browser_name="$1" browser_bin profile_dir url
    local -a browser_args extra_browser_args
    shift

    browser_bin="$(resolve_browser "$browser_name")" || die "cannot locate $browser_name"
    profile_dir="$profile_root/$browser_name"
    url="about:blank"
    extra_browser_args=()

    while [ $# -gt 0 ]; do
        case "$1" in
            --)
                shift
                extra_browser_args+=("$@")
                set --
                ;;
            --*)
                extra_browser_args+=("$1")
                shift
                ;;
            *)
                url="$1"
                shift
                break
                ;;
        esac
    done

    if [ "$dry_run" -eq 0 ]; then
        [ -d "$extension_dir" ] || die "missing extension directory: $extension_dir"
        [ -f "$extension_dir/manifest.json" ] || die "missing extension manifest: $extension_dir/manifest.json"
        [ -f "$extension_dir/content.js" ] || die "missing extension script: $extension_dir/content.js"
        seed_chromium_preferences "$profile_dir"
    fi

    browser_args=(
        "$browser_bin"
        "--user-data-dir=$profile_dir"
        "--lang=$BROWSER_LANG"
        "--no-first-run"
        "--no-default-browser-check"
        "--enable-features=UseOzonePlatform,WaylandWindowDecorations"
        "--ozone-platform=wayland"
        "--ozone-platform-hint=auto"
        "--force-webrtc-ip-handling-policy=disable_non_proxied_udp"
        "--disable-extensions-except=$extension_dir"
        "--load-extension=$extension_dir"
    )

    if [ -n "$proxy" ]; then
        browser_args+=("--proxy-server=$proxy")
    fi

    browser_args+=("${extra_browser_args[@]}")
    browser_args+=("$url" "$@")
    if [ "$dry_run" -eq 0 ]; then
        warn_egress_location
    fi
    run_cmd "${browser_args[@]}"
}

current_timezone() {
    "$timedatectl_bin" show -p Timezone --value
}

timezone_set_cmd() {
    quote_root_cmd "$timedatectl_bin" set-timezone "$1"
}

set_system_timezone() {
    as_root "$timedatectl_bin" set-timezone "$1"
}

write_temp_file() {
    local target="$1" mode="$2" tmp
    tmp="$(mktemp)"
    cat >"$tmp"
    as_root "$install_bin" -D -m "$mode" "$tmp" "$target"
    rm -f "$tmp"
}

write_geoclue_active_config() {
    write_temp_file "$GEOCLUE_OVERRIDE" 0644 <<EOF
# Managed by rg-livingston-profile while the system profile is active.

[ip]
enable=false

[network-nmea]
enable=false

[3g]
enable=false

[cdma]
enable=false

[modem-gps]
enable=false

[wifi]
enable=false

[compass]
enable=false

[static-source]
enable=true

[chromium]
allowed=true
system=false
users=

[google-chrome]
allowed=true
system=false
users=

[google-chrome-stable]
allowed=true
system=false
users=

[vivaldi]
allowed=true
system=false
users=

[vivaldi-stable]
allowed=true
system=false
users=
EOF
}

write_geoclue_inactive_config() {
    write_temp_file "$GEOCLUE_OVERRIDE" 0644 <<'EOF'
# Managed by rg-livingston-profile.
# Inactive: no GeoClue source overrides are applied.
EOF
}

write_static_geolocation() {
    write_temp_file "$GEOLOCATION_FILE" 0644 <<EOF
$LOCATION_LAT
$LOCATION_LON
$LOCATION_ALTITUDE
$LOCATION_ACCURACY
EOF
}

geoclue_active_state() {
    "$systemctl_bin" is-active geoclue.service >/dev/null 2>&1 && printf 'active\n' || printf 'inactive\n'
}

reload_geoclue_for_state() {
    local prior_state="$1"
    if [ "$prior_state" = "active" ]; then
        as_root "$systemctl_bin" restart geoclue.service
    else
        as_root "$systemctl_bin" stop geoclue.service >/dev/null 2>&1 || true
    fi
}

activate_system_location() {
    local prior_state="$1"

    if "$test_bin" -e "$GEOLOCATION_FILE"; then
        as_root "$cp_bin" -a "$GEOLOCATION_FILE" "$GEOLOCATION_BACKUP"
    elif "$test_bin" -e "$GEOLOCATION_BACKUP"; then
        as_root "$mv_bin" -f "$GEOLOCATION_BACKUP" "$GEOLOCATION_DISABLED"
    fi

    write_static_geolocation
    write_geoclue_active_config
    reload_geoclue_for_state "$prior_state"
}

restore_system_location() {
    local prior_state="$1"

    if "$test_bin" -e "$GEOLOCATION_BACKUP"; then
        as_root "$mv_bin" -f "$GEOLOCATION_BACKUP" "$GEOLOCATION_FILE"
    elif "$test_bin" -e "$GEOLOCATION_FILE"; then
        as_root "$mv_bin" -f "$GEOLOCATION_FILE" "$GEOLOCATION_DISABLED"
    fi

    write_geoclue_inactive_config
    reload_geoclue_for_state "$prior_state"
}

print_system_location_dry_run() {
    printf 'would write: %s with Livingston static coordinates\n' "$GEOLOCATION_FILE"
    printf 'would write: %s disabling GeoClue IP/Wi-Fi/GPS sources and enabling static-source\n' "$GEOCLUE_OVERRIDE"
    printf 'would restore: previous %s and inactive %s after command exit\n' "$GEOLOCATION_FILE" "$GEOCLUE_OVERRIDE"
}

print_doctor() {
    local system_tz geolocation_values geoclue_override processes prefs route_all forwarder_state
    printf 'profile=%s\n' "$PROFILE_NAME"
    printf 'profile_timezone=%s\n' "$TZ_NAME"
    printf 'profile_locale=%s\n' "$LANG_NAME"
    printf 'profile_location=%s,%s accuracy=%sm\n' "$LOCATION_LAT" "$LOCATION_LON" "$LOCATION_ACCURACY"

    system_tz="$(current_timezone 2>/dev/null || true)"
    printf 'system_timezone=%s\n' "${system_tz:-unknown}"

    if [ -r "$GEOLOCATION_FILE" ]; then
        geolocation_values="$(tr '\n' ',' <"$GEOLOCATION_FILE" | sed 's/,$//')"
        printf 'geolocation_file=%s\n' "$geolocation_values"
    else
        printf 'geolocation_file=missing\n'
    fi

    if [ -r "$GEOCLUE_OVERRIDE" ]; then
        if grep -q '^\[static-source\]' "$GEOCLUE_OVERRIDE" && grep -q '^enable=true' "$GEOCLUE_OVERRIDE"; then
            geoclue_override="active"
        else
            geoclue_override="inactive"
        fi
        printf 'geoclue_override=%s\n' "$geoclue_override"
    else
        printf 'geoclue_override=missing\n'
    fi

    print_egress_info || true

    if command -v "$tailscale_bin" >/dev/null 2>&1; then
        prefs="$("$tailscale_bin" debug prefs 2>/dev/null || true)"
        route_all="$(json_field "$prefs" RouteAll)"
        printf 'tailscale_accept_routes=%s\n' "${route_all:-unknown}"
    else
        printf 'tailscale_accept_routes=unavailable\n'
    fi

    forwarder_state="$("$systemctl_bin" --user is-active "$STARFLEET_FORWARD_UNIT.service" 2>/dev/null || true)"
    printf 'starfleet_forwarder=%s\n' "${forwarder_state:-unknown}"

    if command -v "$pgrep_bin" >/dev/null 2>&1; then
        processes="$("$pgrep_bin" -af "$profile_root" 2>/dev/null || true)"
        if [ -n "$processes" ]; then
            printf 'profile_processes=\n%s\n' "$processes"
        else
            printf 'profile_processes=none\n'
        fi
    fi
}

run_starfleet_profile() {
    if [ $# -eq 0 ]; then
        set -- vivaldi "$STARFLEET_URL"
    else
        case "$1" in
            chromium | chrome | google-chrome | google-chrome-stable | vivaldi | vivaldi-stable) ;;
            *) set -- vivaldi "$@" ;;
        esac
        if [ $# -eq 1 ]; then
            set -- "$1" "$STARFLEET_URL"
        fi
    fi

    ensure_starfleet_routes
    ensure_starfleet_forwarder
    run_system_profile "$@"
}

run_system_profile() {
    local old_tz geoclue_state rc
    [ $# -gt 0 ] || die "system requires a command"

    old_tz="${RG_LIVINGSTON_PREVIOUS_TZ:-}"
    if [ -z "$old_tz" ] && [ "$dry_run" -eq 0 ]; then
        old_tz="$(current_timezone)"
    elif [ -z "$old_tz" ]; then
        old_tz="CURRENT"
    fi

    replace_process=0

    if [ "$dry_run" -eq 1 ]; then
        printf 'would run: '
        timezone_set_cmd "$TZ_NAME"
        print_system_location_dry_run
        dispatch_command "$@"
        printf 'would run: '
        timezone_set_cmd "$old_tz"
        return 0
    fi

    geoclue_state="$(geoclue_active_state)"

    restore_timezone() {
        trap - EXIT HUP INT TERM
        restore_system_location "$geoclue_state"
        set_system_timezone "$old_tz"
    }

    trap restore_timezone EXIT HUP INT TERM
    set_system_timezone "$TZ_NAME"
    activate_system_location "$geoclue_state"
    dispatch_command "$@"
    rc=$?
    restore_timezone
    return "$rc"
}

dispatch_command() {
    local dispatch_cmd="${1:-chromium}"
    if [ $# -gt 0 ]; then
        shift
    fi

    case "$dispatch_cmd" in
    env)
        print_env
        ;;
    run)
        [ "${1:-}" != "--" ] || shift
        [ $# -gt 0 ] || die "run requires a command"
        run_cmd "$@"
        ;;
    doctor)
        print_doctor
        ;;
    starfleet)
        run_starfleet_profile "$@"
        ;;
    system)
        run_system_profile "$@"
        ;;
    chromium)
        run_browser chromium "$@"
        ;;
    chrome | google-chrome | google-chrome-stable)
        run_browser chrome "$@"
        ;;
    vivaldi | vivaldi-stable)
        run_browser vivaldi "$@"
        ;;
    *)
        die "unknown command: $dispatch_cmd"
        ;;
    esac
}

dispatch_command "$cmd" "$@"
