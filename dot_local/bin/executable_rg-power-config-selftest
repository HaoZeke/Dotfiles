#!/usr/bin/env bash
set -euo pipefail

repo=${1:-"$HOME/.local/share/chezmoi"}

fail() {
    printf 'FAIL: %s\n' "$*" >&2
    exit 1
}

plymouth_script="$repo/.chezmoiscripts/run_onchange_linux_plymouth_resume.sh.tmpl"
laptop_script="$repo/.chezmoiscripts/run_onchange_linux_laptop_power.sh.tmpl"
swayidle_service="$repo/dot_config/systemd/user/swayidle.service"

test -r "$plymouth_script" || fail "missing $plymouth_script"
test -r "$laptop_script" || fail "missing $laptop_script"
test -r "$swayidle_service" || fail "missing $swayidle_service"

python - "$plymouth_script" <<'PY'
import sys

path = sys.argv[1]
text = open(path, encoding="utf-8").read()
if "RESUME_BEFORE_FILESYSTEMS" not in text:
    raise SystemExit("FAIL: mkinitcpio resume hook ordering helper is missing")
if "stop_hooks=(filesystems fsck)" not in text:
    raise SystemExit("FAIL: mkinitcpio resume ordering stops are missing")
PY

rg -q '99-persistent-storage.conf' "$laptop_script" \
    || fail "managed journald persistent drop-in is missing"
rg -q 'Storage=persistent' "$laptop_script" \
    || fail "journald persistent storage is not managed"
rg -Fq 'Storage[[:space:]]*=[[:space:]]*volatile' "$laptop_script" \
    || fail "journald volatile storage conflict detector is missing"
rg -q '/tmp/rg-journald-storage-fix.sh' "$laptop_script" \
    || fail "journald storage conflict fix script is missing"
rg -q 'trash-put' "$laptop_script" \
    || fail "journald storage conflict fix must use trash-put"
rg -q '99-wlan0-unmanaged.conf' "$laptop_script" \
    || fail "NetworkManager wlan0 unmanaged drop-in is missing"
rg -q 'unmanaged-devices=interface-name:wlan0' "$laptop_script" \
    || fail "NetworkManager is not configured to leave wlan0 to iwd"
rg -q '70-rg-uvc-autosuspend.rules' "$laptop_script" \
    || fail "UVC autosuspend udev rule is missing"
rg -q '04f2' "$laptop_script" \
    || fail "UVC autosuspend rule must target the Chicony vendor id"
rg -q 'b751' "$laptop_script" \
    || fail "UVC autosuspend rule must target the integrated camera product id"
rg -q 'power/control' "$laptop_script" \
    || fail "UVC autosuspend rule must set USB runtime PM"
rg -q 'CPU_ENERGY_PERF_POLICY_ON_AC=power' "$laptop_script" \
    || fail "TLP AC EPP must match the cool undocked-mixed baseline"
rg -q 'CPU_ENERGY_PERF_POLICY_ON_BAT=power' "$laptop_script" \
    || fail "TLP battery EPP must match the undocked-mixed profile"
rg -q 'CPU_MAX_PERF_ON_AC=70' "$laptop_script" \
    || fail "TLP AC max_perf_pct must cap daily heat (70)"
rg -q 'CPU_MAX_PERF_ON_BAT=60' "$laptop_script" \
    || fail "TLP battery max_perf_pct must cap daily heat (60)"
rg -q 'CPU_SCALING_MAX_FREQ_ON_AC=1200000' "$laptop_script" \
    || fail "TLP AC scaling_max_freq must hard-cap daily heat (1.2 GHz)"
rg -q 'CPU_SCALING_MAX_FREQ_ON_BAT=1000000' "$laptop_script" \
    || fail "TLP battery scaling_max_freq must hard-cap daily heat (1.0 GHz)"
rg -q 'CPU_BOOST_ON_AC=0' "$laptop_script" \
    || fail "TLP AC turbo boost must stay off for the undocked-mixed baseline"
rg -q 'CPU_HWP_DYN_BOOST_ON_AC=0' "$laptop_script" \
    || fail "TLP AC HWP dynamic boost must stay off for the undocked-mixed baseline"
rg -q 'disabling thermald' "$laptop_script" \
    || fail "laptop power script must disable unsupported thermald on DYTC"
rg -q '/usr/local/sbin/rg-x1gen11-profile-root focus' "$laptop_script" \
    || fail "focus profile must be allowed through the exact root-helper sudoers rule"
rg -q 'PLATFORM_PROFILE_ON_AC=low-power' "$laptop_script" \
    || fail "TLP AC platform profile must match the undocked-mixed profile"
rg -q 'PLATFORM_PROFILE_ON_BAT=low-power' "$laptop_script" \
    || fail "TLP battery platform profile must match the undocked-mixed profile"
rg -q 'START_CHARGE_THRESH_BAT0=90' "$laptop_script" \
    || fail "battery charge start threshold must favor useful runtime"
rg -q 'STOP_CHARGE_THRESH_BAT0=98' "$laptop_script" \
    || fail "battery charge stop threshold must allow near-full runtime"
rg -q 'RUNTIME_PM_DENYLIST="00:15.0 00:15.1"' "$laptop_script" \
    || fail "TLP must denylist both LPSS I2C controllers for the touchpad"
rg -q '99-rg-touchpad-no-runtime-pm.rules' "$laptop_script" \
    || fail "touchpad I2C power/control=on rule must sort last (99-)"
rg -q '65-rg-pci-pm-critical.rules' "$laptop_script" \
    || fail "managed PCI critical-on rules must replace unowned pci_pm.rules"
rg -q 'retire_conflicting_dropin /etc/udev/rules.d/pci_pm.rules' "$laptop_script" \
    || fail "laptop power must retire blanket pci_pm.rules"
rg -q 'retire_conflicting_dropin /etc/tlp.d/01-touchpad-no-suspend.conf' "$laptop_script" \
    || fail "laptop power must retire TLP denylist clobber drop-in"
rg -q 'retire_conflicting_dropin /etc/udev/rules.d/51-android.rules' "$laptop_script" \
    || fail "laptop power must retire android udev rules that claim the UVC camera"
! rg -q 'SUBSYSTEM=="pci", ATTR\{power/control\}="auto"' "$laptop_script" \
    || fail "managed PCI rules must not ship a blanket power/control=auto"
rg -q 'HandleLidSwitch=suspend' "$laptop_script" \
    || fail "lid close must use fast suspend"
rg -q 'HandleLidSwitchExternalPower=suspend' "$laptop_script" \
    || fail "lid close on AC must use fast suspend"
rg -q 'HandlePowerKey=suspend' "$laptop_script" \
    || fail "power key must use fast suspend"
rg -q 'AllowSuspend=yes' "$laptop_script" \
    || fail "plain suspend must be enabled"
! rg -q 'AllowSuspend=no' "$laptop_script" \
    || fail "plain suspend must not be disabled"
rg -q 'HibernateDelaySec=180min' "$laptop_script" \
    || fail "suspend-then-hibernate must keep a long fast-wake window"
rg -q 'iwd.service' "$laptop_script" \
    || fail "iwd service is not managed"
rg -q 'disable --now NetworkManager.service NetworkManager-dispatcher.service' "$laptop_script" \
    || fail "NetworkManager services are not disabled for iwd-owned Wi-Fi"
! rg -q 'for unit in tlp.service NetworkManager-dispatcher.service' "$laptop_script" \
    || fail "NetworkManager dispatcher is still enabled"
rg -q '/usr/bin/timeout 2s /usr/bin/sudo -n' "$laptop_script" \
    || fail "resume hook swaymsg calls are not timeout-bounded"
rg -q '/usr/bin/swaymsg -s "\$sock"' "$laptop_script" \
    || fail "resume hook swaymsg calls do not use the discovered socket"
rg -q 'for cls in pointer touchpad touch keyboard' "$laptop_script" \
    || fail "resume hook does not re-arm every interactive input class"
rg -q 'fullscreen disable' "$laptop_script" \
    || fail "resume hook does not clear stale fullscreen grabs"
rg -q "after-resume '%h/.local/bin/rg-sway-input-rearm --dpms'" "$swayidle_service" \
    || fail "swayidle does not re-arm input after resume"
rg -q '^RestartPreventExitStatus=SIGKILL$' "$swayidle_service" \
    || fail "swayidle SIGKILL escape hatch is missing"

if [ -r /etc/mkinitcpio.conf ]; then
    python - /etc/mkinitcpio.conf <<'PY'
import re
import sys

path = sys.argv[1]
text = open(path, encoding="utf-8").read()
match = re.search(r"^HOOKS=\(([^)]*)\)", text, re.M)
if not match:
    raise SystemExit("FAIL: /etc/mkinitcpio.conf has no HOOKS line")
hooks = match.group(1).split()
if "resume" not in hooks:
    raise SystemExit("FAIL: /etc/mkinitcpio.conf is missing the resume hook")
resume_index = hooks.index("resume")
for stop in ("filesystems", "fsck"):
    if stop in hooks and resume_index > hooks.index(stop):
        raise SystemExit(
            "FAIL: /etc/mkinitcpio.conf puts resume after " + stop
        )
PY
fi

refind_conf=/boot/EFI/refind/refind.conf
if [ -r "$refind_conf" ]; then
    python - "$refind_conf" <<'PY'
import sys

path = sys.argv[1]
lines = open(path, encoding="utf-8").read().splitlines()
inside = False
for line in lines:
    stripped = line.strip()
    if stripped == 'menuentry "Arch Linux" {':
        inside = True
        continue
    if inside and stripped == "}":
        inside = False
    if inside and stripped.startswith('submenuentry "Boot using fallback initramfs"'):
        if not stripped.endswith("{"):
            raise SystemExit(
                "FAIL: rEFInd fallback submenu is missing its opening brace"
            )
PY
fi

printf 'ok\n'
