#!/usr/bin/env bash
set -euo pipefail

kver=${1:-7.0.12-arch1-1-rg}
repo=${RG_LINUX_RG_REPO:-/home/rgoswami/Git/Github/Tools/linux-rg}
user_home=${RG_USER_HOME:-/home/rgoswami}
user_name=${RG_USER_NAME:-$(basename "$user_home")}
jobs=${RG_DKMS_JOBS:-}
profile_root_helper=/usr/local/sbin/rg-x1gen11-profile-root
oomd_profile=${RG_OOMD_PROFILE:-$user_home/.config/oomd/oomd-rgx1gen11.json}
target_root=${RG_LINUX_RG_ROOT_SETUP_ROOT:-}
allow_nonroot=${RG_LINUX_RG_ROOT_SETUP_ALLOW_NONROOT:-0}

if (( EUID != 0 )) && [[ $allow_nonroot != 1 ]]; then
  printf 'error: run as root\n' >&2
  exit 1
fi

if [[ -z $jobs ]]; then
  jobs=$(nproc)
  jobs=$((jobs * 80 / 100))
  (( jobs >= 1 )) || jobs=1
fi

require_file() {
  local path=$1
  [[ -e $path ]] || {
    printf 'error: missing %s\n' "$path" >&2
    exit 1
  }
}

target_path() {
  local path=$1
  if [[ -n $target_root && $path = /* ]]; then
    printf '%s%s\n' "$target_root" "$path"
  else
    printf '%s\n' "$path"
  fi
}

install_exec() {
  local src=$1 dst=$2 target
  require_file "$src"
  target=$(target_path "$dst")
  if (( EUID == 0 )); then
    install -D -o root -g root -m 0755 "$src" "$target"
  else
    install -D -m 0755 "$src" "$target"
  fi
  printf 'installed: %s\n' "$dst"
}

install_data() {
  local src=$1 dst=$2 target
  require_file "$src"
  target=$(target_path "$dst")
  if (( EUID == 0 )); then
    install -D -o root -g root -m 0644 "$src" "$target"
  else
    install -D -m 0644 "$src" "$target"
  fi
  printf 'installed: %s\n' "$dst"
}

install_content() {
  local dst=$1 mode=$2 content=$3 target tmp
  tmp=$(mktemp)
  printf '%s\n' "$content" >"$tmp"
  target=$(target_path "$dst")
  if (( EUID == 0 )); then
    install -D -o root -g root -m "$mode" "$tmp" "$target"
  else
    install -D -m "$mode" "$tmp" "$target"
  fi
  rm -f "$tmp"
  printf 'installed: %s\n' "$dst"
}

run_target_exec() {
  local path=$1
  shift
  "$(target_path "$path")" "$@"
}

find_profile_bin() {
  local candidate=${RG_X1GEN11_PROFILE_BIN:-$user_home/.local/bin/rg-x1gen11-profile}
  if [[ -x $candidate ]]; then
    printf '%s\n' "$candidate"
    return 0
  fi
  command -v rg-x1gen11-profile
}

sync_profile_root_helper() {
  local profile_bin=$1 tmp
  tmp=$(mktemp)
  HOME=$user_home XDG_CONFIG_HOME=$user_home/.config \
    "$profile_bin" root-helper-script "$tmp" >/dev/null
  bash -n "$tmp"
  install_exec "$tmp" "$profile_root_helper"
  rm -f "$tmp"
}

install_ksm_policy() {
  install_content /usr/local/sbin/rg-ksm-madvise-root 0755 "$(cat <<'ROOT'
#!/usr/bin/env bash
set -euo pipefail

ksm=/sys/kernel/mm/ksm
if [ ! -d "$ksm" ]; then
    printf "KSM sysfs missing: %s\n" "$ksm" >&2
    exit 0
fi

write_if_present() {
    local file=$1 value=$2 path
    path="$ksm/$file"
    if [ -e "$path" ]; then
        printf "%s\n" "$value" >"$path"
    fi
}

if [ -e "$ksm/advisor_mode" ] && grep -qw scan-time "$ksm/advisor_mode"; then
    printf "%s\n" scan-time >"$ksm/advisor_mode"
fi

write_if_present smart_scan 1
write_if_present use_zero_pages 0
printf '%s\n' 1 > /sys/kernel/mm/ksm/run

printf "KSM madvise policy applied\n"
ROOT
)"

  install_content /etc/systemd/system/rg-ksm-madvise.service 0644 "$(cat <<'SERVICE'
[Unit]
Description=Apply rgx1gen11 KSM madvise policy
ConditionPathExists=/sys/kernel/mm/ksm/run

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/rg-ksm-madvise-root
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
SERVICE
)"
}

install_damon_reclaim_unit() {
  local damon_bin tmp
  damon_bin=$user_home/.local/bin/rg-damon-reclaim
  if [[ ! -x $damon_bin ]]; then
    printf 'warning: rg-damon-reclaim missing; skip DAMON reclaim unit install\n' >&2
    return 0
  fi
  tmp=$(mktemp)
  HOME=$user_home XDG_CONFIG_HOME=$user_home/.config \
    "$damon_bin" systemd-unit memory-pressure "$tmp" >/dev/null
  bash -n "$tmp"
  install_data "$tmp" /etc/systemd/system/rg-damon-reclaim-memory-pressure.service
  rm -f "$tmp"
}

install_pipewire_rt_policy() {
  install_content /etc/security/limits.d/95-rg-audio-rt.conf 0644 "$(cat <<'LIMITS'
# Managed by chezmoi (dot_local/bin/executable_rg-linux-rg-userspace-root-setup)
@audio - rtprio 95
@audio - memlock unlimited
@audio - nice -11
LIMITS
)"

  install_content /etc/sysctl.d/98-rg-realtime.conf 0644 "$(cat <<'SYSCTL'
# Managed by chezmoi (dot_local/bin/executable_rg-linux-rg-userspace-root-setup)
# Keep global realtime CPU bandwidth throttling enabled so a runaway RT
# workload cannot monopolize the laptop.
kernel.sched_rt_runtime_us = 950000
SYSCTL
)"

  if [[ -z $target_root ]]; then
    if ! getent group audio >/dev/null 2>&1; then
      groupadd -r audio
    fi
    if id "$user_name" >/dev/null 2>&1 && ! id -nG "$user_name" | grep -qw audio; then
      usermod -aG audio "$user_name"
      printf 'added %s to audio; start a new login session for PAM limits to apply\n' "$user_name"
    fi
  fi

  sysctl -p "$(target_path /etc/sysctl.d/98-rg-realtime.conf)"
}

install_tlp_profile_baseline() {
  # Keep aligned with run_onchange_linux_laptop_power.sh.tmpl TLP_CONTENT.
  install_content /etc/tlp.d/00-base.conf 0644 "$(cat <<'TLP'
# Managed by chezmoi (dot_local/bin/executable_rg-linux-rg-userspace-root-setup)
# Aligned with run_onchange_linux_laptop_power.sh.tmpl (canonical TLP baseline).
# Daily rgx1gen11 baseline. Explicit focus/build profiles raise policy through
# rg-x1gen11-profile instead of keeping AC power in a hot default lane.
CPU_SCALING_GOVERNOR_ON_AC=powersave
CPU_SCALING_GOVERNOR_ON_BAT=powersave
CPU_ENERGY_PERF_POLICY_ON_AC=power
CPU_ENERGY_PERF_POLICY_ON_BAT=power
CPU_MAX_PERF_ON_AC=70
CPU_MAX_PERF_ON_BAT=60
CPU_SCALING_MAX_FREQ_ON_AC=1200000
CPU_SCALING_MAX_FREQ_ON_BAT=1000000
CPU_BOOST_ON_AC=0
CPU_BOOST_ON_BAT=0
CPU_HWP_DYN_BOOST_ON_AC=0
CPU_HWP_DYN_BOOST_ON_BAT=0
PLATFORM_PROFILE_ON_AC=low-power
PLATFORM_PROFILE_ON_BAT=low-power
RUNTIME_PM_ON_AC=auto
RUNTIME_PM_ON_BAT=auto
RUNTIME_PM_DENYLIST="00:15.0 00:15.1"
PCIE_ASPM_ON_AC=default
PCIE_ASPM_ON_BAT=powersupersave
WIFI_PWR_ON_AC=off
WIFI_PWR_ON_BAT=on
DISK_IDLE_SECS_ON_AC=0
DISK_IDLE_SECS_ON_BAT=2
SATA_LINKPWR_ON_AC=med_power_with_dipm
SATA_LINKPWR_ON_BAT=min_power
USB_AUTOSUSPEND=1
START_CHARGE_THRESH_BAT0=90
STOP_CHARGE_THRESH_BAT0=98
RESTORE_THRESHOLDS_ON_BAT=1
TLP
)"

  systemctl restart tlp.service 2>/dev/null || systemctl start tlp.service 2>/dev/null || true
}

install_facebook_oomd_policy() {
  install_data "$oomd_profile" /etc/oomd/oomd.json

  install_content /etc/systemd/system.conf.d/20-rg-resource-accounting.conf 0644 "$(cat <<'ACCOUNTING'
[Manager]
DefaultCPUAccounting=true
DefaultIOAccounting=true
DefaultMemoryAccounting=true
DefaultTasksAccounting=true
ACCOUNTING
)"

  install_content /etc/systemd/system/hostcritical.slice.d/10-rg-reserve.conf 0644 "$(cat <<'RESERVE'
[Slice]
MemoryMin=256M
MemoryLow=256M
CPUWeight=200
IOWeight=200
RESERVE
)"

  install_content /etc/systemd/system/oomd.service.d/10-rg-protection.conf 0644 "$(cat <<'PROTECTION'
[Service]
Slice=hostcritical.slice
MemoryMin=64M
MemoryLow=64M
CPUWeight=200
IOWeight=200
PROTECTION
)"
}

printf '== sync linux-rg helpers ==\n'
install_exec "$repo/rgx1gen11-dkms-overlay-apply" /usr/bin/rgx1gen11-dkms-overlay-apply
install_exec "$repo/linux-rg-module-symvers" /usr/bin/linux-rg-module-symvers
install_exec "$repo/rgx1gen11-boot-check" /usr/bin/rgx1gen11-boot-check
install_exec "$repo/rgx1gen11-live-check" /usr/bin/rgx1gen11-live-check
install_exec "$repo/rgx1gen11-sof-check" /usr/bin/rgx1gen11-sof-check
install_exec "$repo/rgx1gen11-memory-check" /usr/bin/rgx1gen11-memory-check
install_exec "$repo/rgx1gen11-nvme-check" /usr/bin/rgx1gen11-nvme-check
install_exec "$repo/rgx1gen11-idle-check" /usr/bin/rgx1gen11-idle-check
install_exec "$repo/rgx1gen11-s0ix-preflight" /usr/bin/rgx1gen11-s0ix-preflight
install_exec "$repo/rgx1gen11-hibernate-check" /usr/bin/rgx1gen11-hibernate-check
install_exec "$repo/rgx1gen11-hibernate-image-size" /usr/bin/rgx1gen11-hibernate-image-size
install_data "$repo/rgx1gen11-hibernate-image-size.service" /usr/lib/systemd/system/rgx1gen11-hibernate-image-size.service
install_data "$repo/69-linux-rg-dkms-overlays.hook" /usr/share/libalpm/hooks/69-linux-rg-dkms-overlays.hook
install_data "$repo/dkms-overlays/ddcci-0.4.5-linux-7.0.patch" /usr/share/linux-rg/dkms-overlays/ddcci-0.4.5-linux-7.0.patch
install_data "$repo/dkms-overlays/evdi-1.14.7-linux-7.0.patch" /usr/share/linux-rg/dkms-overlays/evdi-1.14.7-linux-7.0.patch
install_data "$repo/dkms-overlays/rtl88xxau-r1298-linux-7.0.patch" /usr/share/linux-rg/dkms-overlays/rtl88xxau-r1298-linux-7.0.patch

printf '\n== before dkms repair ==\n'
dkms status -k "$kver" || true
printf '\nModule.symvers required exports before repair:\n'
rg -n 'cfg80211_del_sta_sinfo|cfg80211_ch_switch_notify|video_ioctl2|v4l2_fh_exit' \
  "$(target_path "/usr/lib/modules/$kver/build/Module.symvers")" || true

printf '\n== repair dkms overlays ==\n'
RG_DKMS_JOBS=$jobs run_target_exec /usr/bin/rgx1gen11-dkms-overlay-apply "$kver"

printf '\n== module probes ==\n'
modinfo -k "$kver" v4l2loopback | sed -n '1,16p'
modinfo -k "$kver" 88XXau | sed -n '1,16p'

printf '\n== userspace policy ==\n'
install_tlp_profile_baseline
install_pipewire_rt_policy
install_ksm_policy
install_damon_reclaim_unit
install_facebook_oomd_policy
systemctl daemon-reload
systemctl enable --now rgx1gen11-hibernate-image-size.service
systemctl enable --now systemd-oomd.service
if ! command -v oomd >/dev/null 2>&1; then
  printf 'error: Meta oomd binary missing on rgx1gen11; install via rg-oomd-install-from-stage then re-run\n' >&2
  exit 1
fi
systemctl enable --now oomd.service
systemctl enable --now rg-ksm-madvise.service
systemctl disable rg-damon-reclaim-memory-pressure.service 2>/dev/null || true
systemctl disable --now fstrim.timer 2>/dev/null || true
sysctl --system | rg -n '98-rg-realtime|99-memory|dirty|sched_rt_runtime|swappiness|watermark|workingset|page-cluster|vfs_cache_pressure' || true
PATH=/usr/bin:/usr/local/bin:$user_home/.local/bin:$PATH \
  HOME=$user_home XDG_CONFIG_HOME=$user_home/.config \
  rg-zswap-tune laptop

if profile_bin=$(find_profile_bin); then
  sync_profile_root_helper "$profile_bin"
  HOME=$user_home XDG_CONFIG_HOME=$user_home/.config "$profile_bin" apply undocked-mixed
  HOME=$user_home XDG_CONFIG_HOME=$user_home/.config "$profile_bin" doctor --check
fi

printf '\n== rebuild initramfs ==\n'
mkinitcpio -p linux-rg

printf '\n== live checks ==\n'
PATH=/usr/bin:/usr/local/bin:$user_home/.local/bin:$PATH \
  HOME=$user_home XDG_CONFIG_HOME=$user_home/.config \
  run_target_exec /usr/bin/rgx1gen11-live-check --with-userspace

printf '\n== final dkms status ==\n'
dkms status -k "$kver" || true
