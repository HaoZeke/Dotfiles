#!/usr/bin/env bash
# Live audit of the multi-path stack on rgx1gen11:
#   wlan + SURF OpenVPN (tun0) + system tailscale (x.ai) + US WG full tunnel
#   + haozeke userspace tailscale SOCKS :1055 (rg.terra path).
set -uo pipefail

HZ_SOCK="${RG_HZ_TS_SOCK:-/run/user/1001/tailscale-haozeke/tailscaled.sock}"
SYSTEM_SOCKET="${RG_SYSTEM_TS_SOCK:-/var/run/tailscale/tailscaled.sock}"
HZ_MARK="${RG_HZ_MARK:-0x5151}"
HZ_TABLE="${RG_HZ_TABLE:-5151}"
HZ_DERP_TARGETS="${RG_HZ_DERP_TARGETS:-$HOME/.local/bin/rg-haozeke-derp-targets}"
TERRA_IP="${RG_TERRA_IP:-100.119.130.84}"
SOCKS="${RG_HZ_SOCKS:-127.0.0.1:1055}"
SURF_STATUS="${RG_SURF_STATUS_FILE:-/var/lib/rg-surf-vpn/status.json}"
SURF_CANARY="${RG_SURF_CANARY_HOST:-servicedesk.surf.nl}"
pass=0; fail=0; warn=0

ok(){ printf '  OK  %s\n' "$*"; pass=$((pass+1)); }
bad(){ printf '  BAD %s\n' "$*"; fail=$((fail+1)); }
wrn(){ printf '  WRN %s\n' "$*"; warn=$((warn+1)); }

printf '== host ==\n'
printf '  %s  %s\n' "$(hostname)" "$(date -Is)"

printf '== uplinks ==\n'
ip -br addr show wlan0 tailscale0 rg-us-egress-wg tun0 2>/dev/null || true
printf '  default(main): %s\n' "$(ip -4 route show default | head -1)"
printf '  1.1.1.1 via:   %s\n' "$(ip route get 1.1.1.1 2>/dev/null | head -1)"

printf '== system tailscale (x.ai) ==\n'
if systemctl is-active --quiet tailscaled.service; then
  ok "tailscaled.service active ($(tailscale --socket="$SYSTEM_SOCKET" status --self 2>/dev/null | awk '{print $1,$2}' | head -1))"
else
  bad "tailscaled.service not active"
fi

printf '== haozeke userspace (terra path) ==\n'
if systemctl --user is-active --quiet tailscale-haozeke.service; then
  ok "tailscale-haozeke.service active"
else
  bad "tailscale-haozeke.service not active — systemctl --user start tailscale-haozeke"
fi
if ss -ltn sport = :1055 2>/dev/null | grep -q LISTEN; then
  ok "SOCKS listening on ${SOCKS}"
else
  bad "SOCKS not listening on ${SOCKS}"
fi
if [ -S "$HZ_SOCK" ]; then
  ok "control socket $HZ_SOCK"
  # Peer map can lag a few seconds after restart.
  st=""
  for _ in 1 2 3 4 5 6 7 8; do
    st=$(tailscale --socket="$HZ_SOCK" status 2>/dev/null | grep -E "rgam5terra|${TERRA_IP}" | head -1) && [ -n "$st" ] && break
    sleep 1
  done
  if [ -n "$st" ]; then
    case "$st" in
      *active*|*direct*|*idle*|*relay*) ok "peer terra: $st" ;;
      *offline*) bad "peer terra offline: $st" ;;
      *) wrn "peer terra: $st" ;;
    esac
  else
    bad "rgam5terra not in haozeke status (wrong tailnet or still starting)"
  fi
else
  bad "missing $HZ_SOCK"
fi

printf '== tailnet versions and daemon health ==\n'
client_ts_version=$(tailscale version --json 2>/dev/null \
  | jq -r '.majorMinorPatch // empty' 2>/dev/null || true)
system_ts_version=$(tailscale --socket="$SYSTEM_SOCKET" version --daemon --json 2>/dev/null \
  | jq -r '.daemonLong // empty' 2>/dev/null \
  | sed -E 's/^v?([0-9]+\.[0-9]+\.[0-9]+).*/\1/' || true)
personal_ts_version=$(tailscale --socket="$HZ_SOCK" version --daemon --json 2>/dev/null \
  | jq -r '.daemonLong // empty' 2>/dev/null \
  | sed -E 's/^v?([0-9]+\.[0-9]+\.[0-9]+).*/\1/' || true)
if [ -n "$client_ts_version" ] && [ "$system_ts_version" = "$client_ts_version" ]; then
  ok "system daemon matches client $client_ts_version"
else
  bad "system daemon/client version drift: daemon=${system_ts_version:-unknown} client=${client_ts_version:-unknown}"
fi
if [ -n "$client_ts_version" ] && [ "$personal_ts_version" = "$client_ts_version" ]; then
  ok "personal daemon matches client $client_ts_version"
else
  bad "personal daemon/client version drift: daemon=${personal_ts_version:-unknown} client=${client_ts_version:-unknown}"
fi

system_health_count=$(tailscale --socket="$SYSTEM_SOCKET" status --json 2>/dev/null \
  | jq -r '(.Health // []) | length' 2>/dev/null || true)
personal_health_count=$(tailscale --socket="$HZ_SOCK" status --json 2>/dev/null \
  | jq -r '(.Health // []) | length' 2>/dev/null || true)
case "$system_health_count" in
  0) ok "system daemon Health is empty" ;;
  ''|*[!0-9]*) bad "system daemon Health is unreadable" ;;
  *) bad "system daemon reports $system_health_count Health finding(s)" ;;
esac
case "$personal_health_count" in
  0) ok "personal daemon Health is empty" ;;
  ''|*[!0-9]*) bad "personal daemon Health is unreadable" ;;
  *) bad "personal daemon reports $personal_health_count Health finding(s)" ;;
esac

printf '== tailnet ingress ownership ==\n'
ingress_status=$(sudo -n /usr/local/sbin/rg-network-ingress-status 2>/dev/null)
ingress_rc=$?
if [ "$ingress_rc" -ne 0 ]; then
  bad "privileged ingress verdict failed"
fi
for ingress_check in \
  'firewall_service=ok' \
  'input_policy=drop' \
  'forward_policy=drop' \
  'tailnet_input=accept' \
  'tailnet_interface=present' \
  'ssh_listener=present'; do
  if printf '%s\n' "$ingress_status" | grep -qx "$ingress_check"; then
    ok "$ingress_check"
  else
    bad "missing ingress invariant $ingress_check"
  fi
done

system_serve_json=$(tailscale --socket="$SYSTEM_SOCKET" serve status --json 2>/dev/null || true)
personal_serve_json=$(tailscale --socket="$HZ_SOCK" serve status --json 2>/dev/null || true)
system_funnel_json=$(tailscale --socket="$SYSTEM_SOCKET" funnel status --json 2>/dev/null || true)
personal_funnel_json=$(tailscale --socket="$HZ_SOCK" funnel status --json 2>/dev/null || true)
system_prefs_json=$(tailscale --socket="$SYSTEM_SOCKET" debug prefs 2>/dev/null || true)
personal_prefs_json=$(tailscale --socket="$HZ_SOCK" debug prefs 2>/dev/null || true)

if printf '%s\n' "$system_serve_json" | jq -e 'type == "object" and length == 0' >/dev/null 2>&1 \
   && printf '%s\n' "$system_funnel_json" | jq -e 'type == "object" and length == 0' >/dev/null 2>&1; then
  ok "system tailnet has no Serve or Funnel exposure"
else
  bad "system tailnet has an undocumented Serve or Funnel exposure"
fi
if printf '%s\n' "$personal_serve_json" | jq -e 'type == "object" and length == 0' >/dev/null 2>&1 \
   && printf '%s\n' "$personal_funnel_json" | jq -e 'type == "object" and length == 0' >/dev/null 2>&1; then
  ok "personal userspace tailnet is egress-only"
else
  bad "personal userspace tailnet has an undocumented Serve or Funnel exposure"
fi
if printf '%s\n' "$system_prefs_json" | jq -e '.RunSSH == false and .ShieldsUp == false' >/dev/null 2>&1; then
  ok "system tailnet ingress is owned by kernel SSH and the host firewall"
else
  bad "system tailnet SSH or shields-up ownership differs from the documented contract"
fi
if printf '%s\n' "$personal_prefs_json" | jq -e '.RunSSH == false' >/dev/null 2>&1; then
  ok "personal userspace tailnet does not own SSH ingress"
else
  bad "personal userspace tailnet unexpectedly owns SSH ingress"
fi

printf '== haozeke carve-out (bypass US full-tunnel for daemon UDP) ==\n'
rule=$(ip rule show 2>/dev/null | grep "fwmark $HZ_MARK" || true)
tab=$(ip route show table "$HZ_TABLE" 2>/dev/null | grep '^default ' || true)
nft_ok=0
nft list table inet rg_hz_carveout >/dev/null 2>&1 && nft_ok=1
tunnel_up=0
ip link show rg-us-egress-wg >/dev/null 2>&1 && tunnel_up=1
if [ "$tunnel_up" -eq 0 ]; then
  # Without the 0/0 tunnel there is nothing to carve around; absence is normal.
  ok "carve-out not required (US egress down); rule=$([ -n "$rule" ] && echo present || echo absent)"
else
  if [ -n "$rule" ]; then ok "ip rule: $rule"; else bad "ip rule for fwmark $HZ_MARK missing"; fi
  if [ -n "$tab" ]; then ok "table $HZ_TABLE: $tab"; else bad "table $HZ_TABLE has no default (stale carve-out)"; fi
  if [ "$nft_ok" -eq 1 ]; then
    ok "nft table inet rg_hz_carveout present"
  elif [ -s /run/rg-hz-carveout.endpoints ]; then
    wrn "nft cgroup mark unavailable on this kernel; /32 peer backstops active ($(wc -l </run/rg-hz-carveout.endpoints) pinned)"
  else
    wrn "nft and direct-peer /32 backstops absent; active DERP routes audited below"
  fi
fi

# Direct peers require a residential endpoint route; relay peers use the
# source-correct active DERP routes audited below.
terra_ep=$(tailscale --socket="$HZ_SOCK" status 2>/dev/null \
  | grep -E "rgam5terra|${TERRA_IP}" | grep -oE 'direct [0-9.]+:' \
  | grep -oE '[0-9.]+' | head -1 || true)
if [ -z "$terra_ep" ]; then
  ok "terra peer uses DERP; active DERP routes audited below"
else
  ep_route=$(ip route get "$terra_ep" 2>/dev/null | head -1 || true)
  if echo "$ep_route" | grep -q 'rg-us-egress-wg'; then
    bad "terra public endpoint routes via US WG: $ep_route"
  elif echo "$ep_route" | grep -qE 'wlan0|dev eth'; then
    ok "terra public endpoint on LAN uplink: $ep_route"
  else
    bad "terra endpoint lacks a residential route: $ep_route"
  fi
fi

printf '== haozeke DERP source routes ==\n'
lan_default=$(ip -4 route show table main default 2>/dev/null | head -1 || true)
lan_dev=$(printf '%s\n' "$lan_default" | awk '{for (i=1; i<=NF; i++) if ($i == "dev") {print $(i+1); exit}}')
lan_src=""
if [ -n "$lan_dev" ]; then
  lan_src=$(ip -4 -o addr show dev "$lan_dev" scope global 2>/dev/null \
    | awk '{split($4, addr, "/"); print addr[1]; exit}')
fi
if [ ! -S "$HZ_SOCK" ]; then
  bad "cannot audit DERP routes without $HZ_SOCK"
elif [ ! -x "$HZ_DERP_TARGETS" ]; then
  bad "missing active-DERP selector $HZ_DERP_TARGETS"
else
  hz_status_json=$(tailscale --socket="$HZ_SOCK" status --json 2>/dev/null || true)
  hz_derp_map_json=$(tailscale --socket="$HZ_SOCK" debug derp-map 2>/dev/null || true)
  hz_derp_ips=""
  if [ -n "$hz_status_json" ] && [ -n "$hz_derp_map_json" ]; then
    hz_derp_ips=$("$HZ_DERP_TARGETS" \
      <(printf '%s\n' "$hz_status_json") \
      <(printf '%s\n' "$hz_derp_map_json") 2>/dev/null || true)
  fi
  if [ -z "$hz_derp_ips" ]; then
    bad "active haozeke DERP nodes unavailable"
  else
    while read -r derp_ip; do
      [ -n "$derp_ip" ] || continue
      derp_route=$(ip route get "$derp_ip" 2>/dev/null | head -1 || true)
      if [ -n "$lan_dev" ] && [ -n "$lan_src" ] \
        && printf '%s\n' "$derp_route" | grep -q " dev $lan_dev " \
        && printf '%s\n' "$derp_route" | grep -q " src $lan_src"; then
        ok "DERP $derp_ip uses residential source $lan_src on $lan_dev"
      else
        bad "DERP $derp_ip lacks a source-correct residential route: ${derp_route:-no route}"
      fi
    done <<<"$hz_derp_ips"
  fi
fi

printf '== SOCKS reachability to terra:22 ==\n'
socks_host="${SOCKS%:*}"
socks_port="${SOCKS##*:}"
banner=$(timeout 15 bash -c "echo | /usr/bin/nc -w 10 -X 5 -x ${socks_host}:${socks_port} ${TERRA_IP} 22" 2>/dev/null | tr -d '\r' | head -1 || true)
case "$banner" in
  SSH-*) ok "SOCKS ${SOCKS} -> ${TERRA_IP}:22 ($banner)" ;;
  *)
    # Fall back to a real ssh BatchMode probe (same path as agents use).
    if timeout 20 ssh -o BatchMode=yes -o ConnectTimeout=12 -o ControlPath=none rg.terra.ts true 2>/dev/null; then
      ok "SOCKS path ok via ssh rg.terra.ts (banner probe empty: ${banner:-none})"
    else
      bad "cannot reach ${TERRA_IP}:22 via SOCKS (banner=${banner:-none})"
    fi
    ;;
esac

printf '== ssh rg.terra.ts fallback ==\n'
if timeout 20 ssh -o BatchMode=yes -o ConnectTimeout=12 -o ControlPath=none rg.terra.ts true 2>/dev/null; then
  ok "ssh rg.terra.ts BatchMode true"
else
  bad "ssh rg.terra.ts failed"
fi

printf '== ssh rg.terra ==\n'
if timeout 20 ssh -o BatchMode=yes -o ConnectTimeout=12 -o ControlPath=none rg.terra true 2>/dev/null; then
  ok "ssh rg.terra BatchMode true"
else
  bad "ssh rg.terra failed"
fi

printf '== OLT residential egress / failover ==\n'
olt_count=0
while read -r olt_ip; do
  [ -n "$olt_ip" ] || continue
  olt_count=$((olt_count+1))
  olt_route=$(ip route get "$olt_ip" 2>/dev/null | head -1 || true)
  olt_code=$(curl -4 --noproxy '*' \
    --connect-timeout "${RG_OLT_DOCTOR_CONNECT_TIMEOUT:-8}" \
    --max-time "${RG_OLT_DOCTOR_MAX_TIME:-20}" \
    --resolve "www.olt.com:443:$olt_ip" \
    -sS -L -o /dev/null -w '%{http_code}' https://www.olt.com/ 2>/dev/null)
  olt_probe_rc=$?
  if [ "$olt_probe_rc" -eq 0 ] && [ "$olt_code" != 000 ]; then
    if [ -n "$lan_dev" ] && [ -n "$lan_src" ] \
      && printf '%s\n' "$olt_route" | grep -q " dev $lan_dev " \
      && printf '%s\n' "$olt_route" | grep -q " src $lan_src"; then
      ok "www.olt.com $olt_ip reachable via residential source $lan_src on $lan_dev (HTTP $olt_code)"
    elif printf '%s\n' "$olt_route" | grep -q ' dev rg-us-egress-wg '; then
      wrn "www.olt.com $olt_ip reachable via US egress fallback (HTTP $olt_code; residential path unavailable)"
    else
      wrn "www.olt.com $olt_ip reachable via selected route (HTTP $olt_code): $olt_route"
    fi
  elif ! systemctl is-active --quiet wg-quick@rg-us-egress-wg 2>/dev/null; then
    # OLT falls back to the US egress when the residential path cannot reach it.
    # With the tunnel deliberately down there is no fallback left, so a failure
    # here is the expected consequence of that choice rather than a regression
    # in the stack. Calling it BAD fires a critical alert for a state the user
    # created on purpose, which is how this check became noise worth ignoring.
    wrn "www.olt.com $olt_ip unreachable and the US egress is down (curl $olt_probe_rc, HTTP ${olt_code:-000}); expected until the tunnel is back"
  else
    bad "OLT HTTPS probe failed for www.olt.com $olt_ip (curl $olt_probe_rc, HTTP ${olt_code:-000}): ${olt_route:-no route}"
  fi
done < <(getent ahostsv4 www.olt.com 2>/dev/null | awk '{print $1}' | sort -u)
if [ "$olt_count" -eq 0 ]; then
  bad "www.olt.com has no IPv4 answer"
fi

printf '== DNS chain ==\n'
if systemctl is-active --quiet unbound.service; then ok "unbound active"; else wrn "unbound inactive"; fi
if systemctl is-active --quiet systemd-resolved.service; then ok "resolved active"; else bad "resolved inactive"; fi
if systemctl is-active --quiet ctrld.service; then
  wrn "ctrld active on :5354 (Control D) — upstream timeouts common on full-tunnel; not on main resolved path if DNS=127.0.0.1/unbound"
fi
# Retry before condemning the resolver. A single 2s timeout is routine while an
# upstream is briefly slow, and raising a critical desktop alert for it trains
# the alert to be ignored -- the resolver recovers on its own before anyone has
# read the notification. Three misses in a row is a resolver that is actually
# down.
dns_local_ok=0
for _ in 1 2 3; do
    if dig +time=2 +tries=1 +short google.com @127.0.0.1 >/dev/null 2>&1; then
        dns_local_ok=1
        break
    fi
    sleep 1
done
if [ "$dns_local_ok" -eq 1 ]; then ok "dig @127.0.0.1 ok"; else bad "dig @127.0.0.1 failed 3x"; fi

printf '== SURF OpenVPN ==\n'
if [ -r "$SURF_STATUS" ]; then
  surf_result=$(jq -r '.result // empty' "$SURF_STATUS" 2>/dev/null)
  surf_expiry=$(jq -r '.not_after_epoch // empty' "$SURF_STATUS" 2>/dev/null)
  surf_fingerprint=$(jq -r '.cert_sha256 // empty' "$SURF_STATUS" 2>/dev/null)
  if [ "$surf_result" = active ]; then
    ok "validated profile metadata active (${surf_fingerprint:-no fingerprint})"
  else
    bad "latest SURF install result is ${surf_result:-missing}"
  fi
  case "$surf_expiry" in
    ''|*[!0-9]*) bad "validated profile metadata has no certificate expiry" ;;
    *)
      if [ "$surf_expiry" -gt "$(date +%s)" ]; then
        ok "SURF client certificate unexpired until $(date -d "@$surf_expiry" --iso-8601=seconds)"
      else
        bad "SURF client certificate expired at $(date -d "@$surf_expiry" --iso-8601=seconds)"
      fi
      ;;
  esac
else
  bad "missing validated SURF metadata $SURF_STATUS"
fi
if systemctl is-active --quiet 'openvpn-client@surf-split.service'; then
  ok "openvpn-client@surf-split active"
else
  bad "openvpn-client@surf-split inactive"
fi
if ip link show tun0 >/dev/null 2>&1; then
  surf_address=$(ip -4 -br addr show tun0 2>/dev/null | awk '{print $3; exit}')
  if [ -n "$surf_address" ]; then
    ok "tun0 has IPv4 address $surf_address"
  else
    bad "tun0 has no IPv4 address"
  fi
else
  bad "tun0 missing"
fi
surf_canary_ip=$(getent ahostsv4 "$SURF_CANARY" 2>/dev/null | awk '{print $1; exit}')
if [ -n "$surf_canary_ip" ]; then
  surf_route=$(ip route get "$surf_canary_ip" 2>/dev/null | head -1 || true)
  if printf '%s\n' "$surf_route" | grep -q ' dev tun0 '; then
    ok "$SURF_CANARY $surf_canary_ip route uses dev tun0"
  else
    bad "$SURF_CANARY $surf_canary_ip route bypasses tun0: ${surf_route:-no route}"
  fi
else
  bad "$SURF_CANARY has no IPv4 answer"
fi

printf '== US egress WG ==\n'
if systemctl is-active --quiet 'wg-quick@rg-us-egress-wg.service'; then
  ok "wg-quick@rg-us-egress-wg active (full-tunnel table 51820)"
  if systemctl is-active --quiet rg-us-egress-guard.timer 2>/dev/null || systemctl is-enabled --quiet rg-us-egress-guard.timer 2>/dev/null; then
    ok "rg-us-egress-guard timer present"
  else
    wrn "rg-us-egress-guard.timer not enabled — carve-out may rot after networkd restart"
  fi

  printf '== x.ai visibility (tailnet must exit via Houston) ==\n'
  if ip rule show 2>/dev/null | grep -q '5197:.*fwmark 0x80000.*lookup 51821'; then
    ok "pref-5197 tailscale mark enters protected table 51821"
  else
    bad "pref-5197 tailscale protected rule missing"
  fi
  marked=$(ip route get 8.8.8.8 mark 0x80000 2>/dev/null | head -1 || true)
  if echo "$marked" | grep -q 'rg-us-egress-wg'; then
    ok "tailscale-marked traffic exits via the tunnel"
  else
    bad "tailscale-marked traffic on LAN: ${marked:-no route}"
  fi

  printf '== Grok configuration/catalog ==\n'
  # Catalog visibility confirms the configured name, not inference access.
  # Deployment acceptance runs a bounded grok-4.6 xhigh inference separately.
  if command -v grok >/dev/null 2>&1 && [ -r "$HOME/.grok/auth.json" ]; then
    # `grok models` aborts on its own often enough to matter (SIGABRT, a dozen
    # cores a day). A listing that never printed says nothing about the
    # catalog, so retry once and report a crash as a crash: piping a dead
    # command into grep reads as "model missing" and alarms on a config
    # regression that did not happen.
    grok_catalog=""
    grok_rc=1
    for _ in 1 2; do
      grok_catalog=$(timeout 20 grok models 2>/dev/null)
      grok_rc=$?
      [ "$grok_rc" -eq 0 ] && [ -n "$grok_catalog" ] && break
    done
    if [ "$grok_rc" -ne 0 ] || [ -z "$grok_catalog" ]; then
      wrn "grok models did not complete (exit ${grok_rc}); catalog unverified"
    elif printf '%s\n' "$grok_catalog" | grep -q 'grok-4.6'; then
      ok "grok-4.6 visible in grok models (catalog only)"
    else
      bad "grok-4.6 not visible in grok models (catalog/config check)"
    fi
  else
    wrn "grok CLI or auth missing; model-visibility gate skipped"
  fi

  printf '== x.ai API pin health ==\n'
  pin=$(awk '$1 ~ /^[0-9.]+$/ && $2 == "api.x.ai" {print $1; exit}' /etc/hosts 2>/dev/null)
  if [ -n "$pin" ]; then
    code=$(curl -4 -sS -o /dev/null --connect-timeout 4 --max-time 8 \
      --resolve "api.x.ai:443:$pin" -w '%{http_code}' https://api.x.ai/v1/models 2>/dev/null || echo 000)
    case "$code" in
      [23][0-9][0-9]|401|403) ok "api.x.ai pin $pin answers (http $code)" ;;
      *) bad "api.x.ai pin $pin dead (http $code) — rg-net-heal rotates it within ~2min" ;;
    esac
  else
    wrn "no api.x.ai pin in /etc/hosts (rg-net-heal asserts it)"
  fi

  printf '== egress exit geography ==\n'
  geo=$(curl -4 -sS --connect-timeout 5 --max-time 10 https://ipinfo.io/json 2>/dev/null \
    | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d.get("country","?"), d.get("city","?"), d.get("ip","?"))' 2>/dev/null || true)
  case "$geo" in
    US*) ok "default egress exits in $geo" ;;
    '') wrn "egress geography probe failed" ;;
    *) bad "default egress exits in $geo (expected US with the tunnel up)" ;;
  esac
else
  wrn "US egress WG not active; protected traffic must remain closed"
fi

printf '== protected Houston policy ==\n'
policy_state="${RG_POLICY_STATE_DIR:-/var/lib/rg-us-egress-policy}"
houston_live=0
if ip link show "${RG_US_EGRESS_IFACE:-rg-us-egress-wg}" >/dev/null 2>&1 \
   && ip -4 route show table 51820 2>/dev/null | grep -q '^default'; then
  houston_live=1
fi
if systemctl is-active --quiet rg-us-egress-policy.service 2>/dev/null; then
  ok "rg-us-egress-policy.service active"
else
  bad "rg-us-egress-policy.service inactive"
fi

for family in -4 -6; do
  protected_routes=$(ip "$family" route show table 51821 2>/dev/null || true)
  if printf '%s\n' "$protected_routes" | grep -q '^unreachable default'; then
    ok "$family table 51821 has permanent unreachable default"
  else
    bad "$family table 51821 lacks permanent unreachable default"
  fi
  live_expected=0
  if [ "$houston_live" -eq 1 ] \
     && ip "$family" route show table 51820 2>/dev/null | grep -q '^default'; then
    live_expected=1
  fi
  if [ "$live_expected" -eq 1 ]; then
    if printf '%s\n' "$protected_routes" | grep -q '^default dev rg-us-egress-wg'; then
      ok "$family protected default uses Houston"
    else
      bad "$family protected table lacks its live Houston default"
    fi
  elif printf '%s\n' "$protected_routes" | grep -q '^default dev rg-us-egress-wg'; then
    bad "$family protected table retains a live route without Houston"
  else
    ok "$family protected table is closed without a live Houston route"
  fi

  for owned in \
    '5194:.*lookup 52' \
    '5196:.*fwmark 0x5252.*lookup 51821' \
    '5197:.*fwmark 0x80000.*lookup 51821'; do
    if ip "$family" rule show 2>/dev/null | grep -q "$owned"; then
      ok "$family owned rule ${owned%%:*} present"
    else
      bad "$family owned rule ${owned%%:*} missing"
    fi
  done
done

for family_state in v4 v6; do
  bits=32
  flag=-4
  [ "$family_state" = v4 ] || { bits=128; flag=-6; }
  addresses="$policy_state/xai-$family_state"
  if [ -r "$addresses" ]; then
    while IFS= read -r address; do
      [ -n "$address" ] || continue
      if ip "$flag" rule show 2>/dev/null \
          | grep -q "5188:.*to $address/$bits.*lookup 51821"; then
        ok "$family_state protected destination $address owned by table 51821"
      else
        bad "$family_state protected destination $address lacks its owned rule"
      fi
    done <"$addresses"
  else
    bad "protected destination state $addresses is unreadable"
  fi
  collision_file="$policy_state/collisions-$family_state"
  if [ -s "$collision_file" ]; then
    collision_list=$(tr '\n' ' ' <"$collision_file")
    bad "$family_state protected/recovery address collision: ${collision_list% }"
  else
    ok "$family_state protected/recovery address set is disjoint"
  fi
done

marked_policy=$(ip route get 8.8.8.8 mark 0x80000 2>&1 | head -1 || true)
if [ "$houston_live" -eq 1 ]; then
  if printf '%s\n' "$marked_policy" | grep -q 'rg-us-egress-wg'; then
    ok "tailscale-marked policy result uses Houston"
  else
    bad "tailscale-marked policy result bypasses Houston: ${marked_policy:-no route}"
  fi
elif [ -z "$marked_policy" ] \
  || printf '%s\n' "$marked_policy" | grep -qiE 'unreachable|network is unreachable'; then
  ok "tailscale-marked policy is closed without Houston"
else
  bad "tailscale-marked policy leaks without Houston: $marked_policy"
fi

printf '\n== summary: %d ok, %d warn, %d bad ==\n' "$pass" "$warn" "$fail"
if [ "$fail" -gt 0 ]; then
  printf 'Fix order:\n'
  printf '  1) systemctl --user start rg-tailscale-refresh.service\n'
  printf '  2) sudo rg-haozeke-tunnel-carveout up\n'
  printf '  3) sudo systemctl restart rg-us-egress-guard.timer  # if unit exists\n'
  exit 1
fi
exit 0
