#!/usr/bin/env bash
# Managed by chezmoi (dot_local/bin/executable_rg-dotfiles-selftest).

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

if [ $# -gt 1 ]; then
    printf 'usage: rg-dotfiles-selftest [chezmoi-source]\n' >&2
    exit 2
fi

if [ $# -eq 1 ]; then
    REPO="$1"
elif [ -r "$SCRIPT_DIR/../../.chezmoi.toml.tmpl" ]; then
    REPO="$(cd -- "$SCRIPT_DIR/../.." && pwd)"
else
    REPO="${CHEZMOI_SOURCE_DIR:-$HOME/.local/share/chezmoi}"
fi

fail() {
    printf 'FAIL: %s\n' "$*" >&2
    exit 1
}

run() {
    printf '==> %s\n' "$*"
    "$@"
}

test -r "$REPO/.chezmoi.toml.tmpl" || fail "missing chezmoi source at $REPO"
test -r "$REPO/.project-ctx.toml" || fail "missing source-checkout project context"
rg -q '^name = "chezmoi"$' "$REPO/.project-ctx.toml" \
    || fail "project context does not declare the chezmoi project name"
rg -q '^vault_issue_project = "chezmoi"$' "$REPO/.project-ctx.toml" \
    || fail "project context does not declare the chezmoi vault issue slug"
rg -q '^\.project-ctx\.toml$' "$REPO/.chezmoiignore" \
    || fail "project context is not excluded from chezmoi target application"

tmp_dir=$(mktemp -d)
trap 'rm -rf "$tmp_dir"' EXIT

run "$REPO/dot_local/bin/executable_rg-keyboard-config-selftest" "$REPO"
run "$REPO/dot_local/bin/executable_rg-power-config-selftest" "$REPO"
run "$REPO/dot_local/bin/executable_rg-network-config-selftest" "$REPO"
run "$REPO/dot_local/bin/executable_rg-haozeke-derp-targets-selftest" \
    "$REPO/dot_local/bin/executable_rg-haozeke-derp-targets"
run "$REPO/dot_local/bin/executable_rg-rgsurflat-system-selftest" "$REPO"
run "$REPO/dot_local/bin/executable_rg-kernel-build-selftest" "$REPO"
run "$REPO/dot_local/bin/executable_rg-sway-config-selftest" "$REPO"
run "$REPO/dot_local/bin/executable_rg-sway-launcher-selftest" "$REPO"
run "$REPO/dot_local/bin/executable_rg-power-menu-selftest" "$REPO"
run "$REPO/dot_local/bin/executable_rg-desktop-help-selftest" "$REPO"
run "$REPO/dot_local/bin/executable_rg-document-workflow-selftest" "$REPO"
run "$REPO/dot_local/bin/executable_rg-sway-input-rearm-selftest" "$REPO/dot_local/bin/executable_rg-sway-input-rearm"
run "$REPO/dot_local/bin/executable_rg-lockscreen-selftest"
run "$REPO/dot_local/bin/executable_wl-copy-selftest" "$REPO/dot_local/bin/executable_wl-copy"
run "$REPO/dot_local/bin/executable_vault-tools-selftest" "$REPO/dot_local/bin/executable_vault-tools"
run "$REPO/dot_local/bin/executable_rg-vissue-selftest" "$REPO/dot_local/bin/executable_vissue"
run "$REPO/dot_local/bin/executable_rg-vale-project-vocab-selftest" "$REPO"

(
    cd "$REPO"
    shopt -s nullglob
    templates=(
        .chezmoiscripts/*.tmpl
        dot_bashrc.tmpl
        dot_shellrc.tmpl
        dot_config/shellrc/bash.d/*.tmpl
        dot_config/shellrc/posix.d/*.tmpl
    )

    for template in "${templates[@]}"; do
        out="$tmp_dir/render-$(basename "$template").sh"
        chezmoi --source "$REPO" --no-tty --refresh-externals=never execute-template < "$template" > "$out"
        bash -n "$out"
    done
)

if command -v foot >/dev/null 2>&1; then
    run foot --check-config --config="$REPO/dot_config/foot/foot.ini"
fi

if rg -n '^\[colors\]$' "$REPO/dot_config/foot" "$REPO/.chezmoiscripts/run_onchange_rg-theme-1-palettes.sh.tmpl"; then
    fail "foot theme snippets must use [colors-dark], not deprecated [colors]"
fi

if rg -n '^fade-in=' "$REPO/dot_config/swaylock" "$REPO/.chezmoiscripts/run_onchange_rg-theme-1-palettes.sh.tmpl"; then
    fail "swaylock fade-in uses screencopy and can show stale desktop frames"
fi

sway_launcher="$REPO/.chezmoiscripts/run_onchange_linux_sway_launcher.sh.tmpl"
rg -q 'for group in render video' "$sway_launcher" \
    || fail "sway launcher installer does not ensure GPU access groups"

if command -v shellcheck >/dev/null 2>&1; then
    run shellcheck -x -S warning \
        "$REPO/dot_local/bin/executable_brightness_sync.sh" \
        "$REPO/dot_local/bin/executable_changeUser.sh" \
        "$REPO/dot_local/bin/executable_cliphist-rofi-img" \
        "$REPO/dot_local/bin/executable_get_patched_font.sh" \
        "$REPO/dot_local/bin/executable_ghcoauthby" \
        "$REPO/dot_local/bin/executable_rg-lockscreen" \
        "$REPO/dot_local/bin/executable_rg-power-menu" \
        "$REPO/dot_local/bin/executable_rg-vale-project-vocab" \
        "$REPO/dot_local/bin/executable_rg-vale-project-vocab-selftest" \
        "$REPO/dot_local/bin/executable_vault-tools" \
        "$REPO/dot_local/bin/executable_vault-tools-selftest" \
        "$REPO/dot_local/bin/executable_wl-copy" \
        "$REPO/dot_local/bin/executable_turtleback-push"
fi

printf 'ok\n'
