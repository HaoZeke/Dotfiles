#!/usr/bin/env bash
# Managed by chezmoi (dot_local/bin/executable_rg-linux-rg-userspace-root-setup-selftest).

set -euo pipefail

repo=${1:-"$HOME/.local/share/chezmoi"}
script="$repo/dot_local/bin/executable_rg-linux-rg-userspace-root-setup"
kver=7.0.12-arch1-1-rg

fail() {
    printf 'FAIL: %s\n' "$*" >&2
    exit 1
}

test -x "$script" || fail "missing userspace root setup helper"

tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT
fake_root="$tmpdir/root"
fake_repo="$tmpdir/linux-rg"
fake_home="$tmpdir/home"
fake_bin="$tmpdir/bin"

mkdir -p "$fake_root" "$fake_repo/dkms-overlays" "$fake_home/.local/bin" "$fake_bin"
mkdir -p "$fake_home/.config/oomd"

for helper in \
    rgx1gen11-dkms-overlay-apply \
    linux-rg-module-symvers \
    rgx1gen11-boot-check \
    rgx1gen11-live-check \
    rgx1gen11-sof-check \
    rgx1gen11-memory-check \
    rgx1gen11-nvme-check \
    rgx1gen11-idle-check \
    rgx1gen11-s0ix-preflight \
    rgx1gen11-hibernate-check \
    rgx1gen11-hibernate-image-size; do
    cat >"$fake_repo/$helper" <<SH
#!/usr/bin/env bash
set -euo pipefail
printf '%s %s\n' "$helper" "\$*" >>"$fake_root/commands.log"
SH
    chmod +x "$fake_repo/$helper"
done

touch \
    "$fake_repo/rgx1gen11-hibernate-image-size.service" \
    "$fake_repo/69-linux-rg-dkms-overlays.hook" \
    "$fake_repo/dkms-overlays/ddcci-0.4.5-linux-7.0.patch" \
    "$fake_repo/dkms-overlays/evdi-1.14.7-linux-7.0.patch" \
    "$fake_repo/dkms-overlays/rtl88xxau-r1298-linux-7.0.patch"

cat >"$fake_home/.config/oomd/oomd-rgx1gen11.json" <<'JSON'
{
  "rulesets": [
    {
      "name": "desktop memory pressure guard",
      "detectors": [[
        "user slices and host memory are under pressure",
        {"name": "pressure_rising_beyond", "args": {"cgroup": "user.slice", "resource": "memory", "threshold": "8", "duration": "20"}}
      ]],
      "actions": [
        {"name": "kill_by_memory_size_or_growth", "args": {"cgroup": "user.slice/*", "recursive": "true"}}
      ]
    }
  ]
}
JSON

cat >"$fake_home/.local/bin/rg-x1gen11-profile" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
log=${RG_TEST_LOG:?}
case "${1:-}" in
root-helper-script)
    out=${2:?}
    cat >"$out" <<'ROOT'
#!/usr/bin/env bash
set -euo pipefail
PROFILES_JSON="${RG_X1GEN11_PROFILES:-/home/rgoswami/.config/rg-x1gen11/profiles.json}"
python3 - <<'PY'
import json
PY
printf 'root profile applied: %s\n' "${1:-}"
ROOT
    chmod +x "$out"
    printf 'profile root-helper-script %s\n' "$out" >>"$log"
    ;;
apply)
    printf 'profile apply %s\n' "${2:-}" >>"$log"
    ;;
doctor)
    printf 'profile doctor %s\n' "${2:-}" >>"$log"
    ;;
*)
    printf 'unexpected profile command: %s\n' "$*" >&2
    exit 2
    ;;
esac
SH
chmod +x "$fake_home/.local/bin/rg-x1gen11-profile"

cat >"$fake_home/.local/bin/rg-damon-reclaim" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
case "${1:-}" in
systemd-unit)
    profile=${2:?}
    out=${3:?}
    cat >"$out" <<SERVICE
[Unit]
Description=Apply rgx1gen11 DAMON reclaim profile $profile
Documentation=https://docs.kernel.org/admin-guide/mm/damon/reclaim.html
ConditionPathExists=/sys/module/damon_reclaim/parameters/enabled

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=RG_DAMON_SUDO=
ExecStart=/home/rgoswami/.local/bin/rg-damon-reclaim enable $profile
ExecStop=/home/rgoswami/.local/bin/rg-damon-reclaim disable

[Install]
WantedBy=multi-user.target
SERVICE
    printf 'damon systemd-unit %s %s\n' "$profile" "$out" >>"${RG_TEST_LOG:?}"
    ;;
*)
    printf 'unexpected damon command: %s\n' "$*" >&2
    exit 2
    ;;
esac
SH
chmod +x "$fake_home/.local/bin/rg-damon-reclaim"

cat >"$fake_bin/dkms" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
printf 'dkms %s\n' "$*" >>"${RG_TEST_LOG:?}"
SH
chmod +x "$fake_bin/dkms"

cat >"$fake_bin/rg" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
if [[ ${1:-} == -n ]]; then
    exit 1
fi
exec /usr/bin/rg "$@"
SH
chmod +x "$fake_bin/rg"

for cmd in modinfo systemctl sysctl mkinitcpio; do
    cat >"$fake_bin/$cmd" <<SH
#!/usr/bin/env bash
set -euo pipefail
printf '$cmd %s\n' "\$*" >>"\${RG_TEST_LOG:?}"
if [[ '$cmd' == modinfo ]]; then
  printf 'filename: fake.ko.zst\n'
fi
SH
    chmod +x "$fake_bin/$cmd"
done

cat >"$fake_bin/rg-zswap-tune" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
printf 'rg-zswap-tune %s\n' "$*" >>"${RG_TEST_LOG:?}"
SH
chmod +x "$fake_bin/rg-zswap-tune"

cat >"$fake_bin/oomd" <<'SH'
#!/usr/bin/env bash
set -euo pipefail
printf 'oomd %s\n' "$*" >>"${RG_TEST_LOG:?}"
SH
chmod +x "$fake_bin/oomd"

cat >"$fake_bin/sed" <<'SH'
#!/usr/bin/env bash
exec /usr/bin/sed "$@"
SH
chmod +x "$fake_bin/sed"

RG_LINUX_RG_ROOT_SETUP_ALLOW_NONROOT=1 \
RG_LINUX_RG_ROOT_SETUP_ROOT="$fake_root" \
RG_LINUX_RG_REPO="$fake_repo" \
RG_USER_HOME="$fake_home" \
RG_TEST_LOG="$fake_root/commands.log" \
PATH="$fake_bin:$PATH" \
    "$script" "$kver" >"$tmpdir/setup.out" 2>&1 || {
    sed -n '1,240p' "$tmpdir/setup.out" >&2
    fail "fake-root userspace setup should pass"
}

test -x "$fake_root/usr/local/sbin/rg-x1gen11-profile-root" \
    || fail "setup must install the generated profile root helper under the fake root"
test -x "$fake_root/usr/local/sbin/rg-ksm-madvise-root" \
    || fail "setup must install the KSM madvise root helper under the fake root"
test -r "$fake_root/etc/systemd/system/rg-ksm-madvise.service" \
    || fail "setup must install the KSM madvise service under the fake root"
test -r "$fake_root/etc/systemd/system/rg-damon-reclaim-memory-pressure.service" \
    || fail "setup must install the bounded DAMON reclaim service under the fake root"
test -r "$fake_root/etc/security/limits.d/95-rg-audio-rt.conf" \
    || fail "setup must install PipeWire realtime limits under the fake root"
test -r "$fake_root/etc/sysctl.d/98-rg-realtime.conf" \
    || fail "setup must install bounded realtime sysctl under the fake root"
rg -q '@audio - rtprio 95' "$fake_root/etc/security/limits.d/95-rg-audio-rt.conf" \
    || fail "setup must grant bounded rtprio to the audio group"
rg -q 'kernel.sched_rt_runtime_us = 950000' "$fake_root/etc/sysctl.d/98-rg-realtime.conf" \
    || fail "setup must keep global RT throttling enabled"
test -r "$fake_root/etc/oomd/oomd.json" \
    || fail "setup must install the facebook oomd profile under the fake root"
test -r "$fake_root/etc/systemd/system.conf.d/20-rg-resource-accounting.conf" \
    || fail "setup must install systemd resource accounting defaults"
test -r "$fake_root/etc/systemd/system/hostcritical.slice.d/10-rg-reserve.conf" \
    || fail "setup must install the hostcritical reserve slice"
test -r "$fake_root/etc/systemd/system/oomd.service.d/10-rg-protection.conf" \
    || fail "setup must install oomd service protection"
rg -q '"pressure_rising_beyond"' "$fake_root/etc/oomd/oomd.json" \
    || fail "setup must preserve the PSI oomd detector"
rg -q "systemctl enable --now rg-ksm-madvise.service" "$fake_root/commands.log" \
    || fail "setup must enable the KSM madvise service"
if rg -q "systemctl enable --now rg-damon-reclaim-memory-pressure.service" "$fake_root/commands.log"; then
    fail "setup must not enable DAMON reclaim by default"
fi
rg -q "systemctl disable rg-damon-reclaim-memory-pressure.service" "$fake_root/commands.log" \
    || fail "setup must keep the DAMON reclaim service disabled until explicit use"
rg -q "systemctl disable --now fstrim.timer" "$fake_root/commands.log" \
    || fail "setup must disable periodic fstrim for btrfs discard=async"
rg -q "systemctl enable --now oomd.service" "$fake_root/commands.log" \
    || fail "setup must enable facebook oomd when the binary exists"
rg -q 'sysctl -p .*98-rg-realtime.conf' "$fake_root/commands.log" \
    || fail "setup must apply the realtime sysctl directly"
rg -q 'PROFILES_JSON=' "$fake_root/usr/local/sbin/rg-x1gen11-profile-root" \
    || fail "installed profile root helper must load profile JSON"
rg -q 'json' "$fake_root/usr/local/sbin/rg-x1gen11-profile-root" \
    || fail "installed profile root helper must retain JSON parsing"
test -x "$fake_root/usr/bin/rgx1gen11-boot-check" \
    || fail "setup must install linux-rg package helpers under the fake root"
test -r "$fake_root/usr/share/linux-rg/dkms-overlays/ddcci-0.4.5-linux-7.0.patch" \
    || fail "setup must install DKMS overlay patches under the fake root"
rg -q 'profile apply undocked-mixed' "$fake_root/commands.log" \
    || fail "setup must apply the daily laptop profile"
rg -q 'profile doctor --check' "$fake_root/commands.log" \
    || fail "setup must verify the applied profile"
rg -q "rgx1gen11-dkms-overlay-apply $kver" "$fake_root/commands.log" \
    || fail "setup must run the DKMS overlay repair helper"
rg -q "damon systemd-unit memory-pressure" "$fake_root/commands.log" \
    || fail "setup must generate the memory-pressure DAMON unit"
rg -q 'mkinitcpio -p linux-rg' "$fake_root/commands.log" \
    || fail "setup must rebuild the linux-rg initramfs"
rg -q 'rg-zswap-tune laptop' "$fake_root/commands.log" \
    || fail "setup must apply the laptop zswap policy"
test -r "$fake_root/etc/tlp.d/00-base.conf" \
    || fail "setup must install the managed TLP profile baseline"
rg -q '^PLATFORM_PROFILE_ON_AC=low-power$' "$fake_root/etc/tlp.d/00-base.conf" \
    || fail "setup must keep the TLP AC platform profile aligned with undocked-mixed"
rg -q '^PLATFORM_PROFILE_ON_BAT=low-power$' "$fake_root/etc/tlp.d/00-base.conf" \
    || fail "setup must keep the TLP battery platform profile aligned with undocked-mixed"
rg -q '^RUNTIME_PM_ON_AC=auto$' "$fake_root/etc/tlp.d/00-base.conf" \
    || fail "setup must enable PCIe runtime PM on AC"
rg -q '^RUNTIME_PM_ON_BAT=auto$' "$fake_root/etc/tlp.d/00-base.conf" \
    || fail "setup must enable PCIe runtime PM on battery"
rg -q '^PCIE_ASPM_ON_BAT=powersupersave$' "$fake_root/etc/tlp.d/00-base.conf" \
    || fail "setup must keep aggressive PCIe ASPM on battery"
rg -q '^WIFI_PWR_ON_BAT=on$' "$fake_root/etc/tlp.d/00-base.conf" \
    || fail "setup must keep Wi-Fi power save on battery"
rg -q '^DISK_IDLE_SECS_ON_BAT=2$' "$fake_root/etc/tlp.d/00-base.conf" \
    || fail "setup must keep the laptop disk idle battery policy"
rg -q '^USB_AUTOSUSPEND=1$' "$fake_root/etc/tlp.d/00-base.conf" \
    || fail "setup must keep USB autosuspend enabled"
rg -q '^START_CHARGE_THRESH_BAT0=90$' "$fake_root/etc/tlp.d/00-base.conf" \
    || fail "setup must keep ThinkPad BAT0 start threshold (90)"
rg -q '^STOP_CHARGE_THRESH_BAT0=98$' "$fake_root/etc/tlp.d/00-base.conf" \
    || fail "setup must keep ThinkPad BAT0 stop threshold (98)"
rg -q 'RUNTIME_PM_DENYLIST="00:15.0 00:15.1"' "$fake_root/etc/tlp.d/00-base.conf" \
    || fail "setup must denylist touchpad I2C controllers in TLP"
rg -q '^CPU_BOOST_ON_AC=0$' "$fake_root/etc/tlp.d/00-base.conf" \
    || fail "setup must disable AC turbo boost in the daily TLP baseline"
rg -q '^CPU_HWP_DYN_BOOST_ON_AC=0$' "$fake_root/etc/tlp.d/00-base.conf" \
    || fail "setup must disable AC HWP dynamic boost in the daily TLP baseline"
rg -q '^ConditionPathExists=/sys/module/damon_reclaim/parameters/enabled$' \
    "$fake_root/etc/systemd/system/rg-damon-reclaim-memory-pressure.service" \
    || fail "DAMON unit must guard on reclaim sysfs"
rg -q '^ExecStop=/home/rgoswami/.local/bin/rg-damon-reclaim disable$' \
    "$fake_root/etc/systemd/system/rg-damon-reclaim-memory-pressure.service" \
    || fail "DAMON unit stop must disable reclaim"

printf 'ok\n'
