#!/usr/bin/env bash
# Managed by chezmoi (dot_local/bin/executable_rg-x1gen11-profile).
#
# Workload profile switcher for ThinkPad X1 Carbon Gen 11 (rgx1gen11).
# Applies industry-style userspace policy: ACPI platform_profile, intel_pstate
# governor, iwlwifi power_save, zram-generator sizing, DAMON reclaim, and
# per-slice MemoryHigh caps. Pairs with Meta facebookincubator/oomd,
# systemd-oomd PSI kills, browser.slice, and build.slice.

set -euo pipefail

STATE_DIR="${RG_X1GEN11_STATE_DIR:-$HOME/.config/rg-x1gen11}"
STATE_FILE="$STATE_DIR/active-profile"
PROFILES_JSON="${RG_X1GEN11_PROFILES:-$HOME/.config/rg-x1gen11/profiles.json}"
CHEZMOI_PROFILES="$HOME/.local/share/chezmoi/dot_config/rg-x1gen11/profiles.json"
SUDO="${RG_X1GEN11_SUDO:-sudo}"
ROOT_HELPER="${RG_X1GEN11_ROOT_HELPER:-/usr/local/sbin/rg-x1gen11-profile-root}"
SYSFS_ROOT="${RG_X1GEN11_SYSFS_ROOT:-/sys}"
PROC_ROOT="${RG_X1GEN11_PROC_ROOT:-/proc}"

if [ ! -r "$PROFILES_JSON" ] && [ -r "$CHEZMOI_PROFILES" ]; then
    PROFILES_JSON="$CHEZMOI_PROFILES"
fi

usage() {
    cat <<'USAGE'
usage: rg-x1gen11-profile COMMAND [ARGS...]

Commands:
  list                 List profile names and descriptions.
  show [PROFILE]       Print resolved knobs for PROFILE or the active profile.
  apply PROFILE        Apply PROFILE (root for sysfs/zram; user for slices).
  apply-user PROFILE   Apply user-manager slice caps and sched_ext policy only.
  root-script PROFILE [OUT]
                       Write an inspectable root script for PROFILE.
  root-helper-script [OUT]
                       Write the generic privileged profile helper.
  current              Print the active profile name.
  doctor               Print live sysfs, PSI, and OOMD stack status.
  -h, --help           Show this help.

Profiles are defined in ~/.config/rg-x1gen11/profiles.json.
USAGE
}

die() {
    printf 'rg-x1gen11-profile: %s\n' "$*" >&2
    exit 2
}

sys_path() {
    printf '%s%s\n' "$SYSFS_ROOT" "$1"
}

proc_path() {
    printf '%s%s\n' "$PROC_ROOT" "$1"
}

require_python() {
    command -v python3 >/dev/null 2>&1 || die "python3 is required"
}

profile_field() {
    local profile="$1" field="$2"
    require_python
    python3 - "$PROFILES_JSON" "$profile" "$field" <<'PY'
import json
import sys

path, profile, field = sys.argv[1:4]
data = json.load(open(path, encoding="utf-8"))
profiles = data["profiles"]
if profile not in profiles:
    raise SystemExit(f"unknown profile: {profile}")
spec = profiles[profile]
if field == "damon_profile" and field not in spec:
    value = "memory-pressure" if spec.get("damon_reclaim") else "off"
elif field == "energy_performance_preference" and field not in spec:
    value = "performance" if spec.get("scaling_governor") == "performance" else "balance_power"
elif field == "hwp_dynamic_boost" and field not in spec:
    value = "1" if spec.get("scaling_governor") == "performance" else "0"
else:
    value = spec[field]
if isinstance(value, bool):
    print("true" if value else "false")
else:
    print(value)
PY
}

list_profiles() {
    require_python
    python3 - "$PROFILES_JSON" <<'PY'
import json
import sys

data = json.load(open(sys.argv[1], encoding="utf-8"))
default = data.get("default", "")
for name, spec in data["profiles"].items():
    marker = " (default)" if name == default else ""
    print(f"{name}{marker}\t{spec.get('description', '')}")
PY
}

platform_profile_path() {
    for path in \
        "$(sys_path /firmware/acpi/platform_profile)" \
        "$(sys_path /devices/platform/thinkpad_acpi/platform_profile)"; do
        if [ -r "$path" ]; then
            printf '%s\n' "$path"
            return 0
        fi
    done
    return 1
}

write_scaling_governor() {
    local governor="$1"
    local cpu path avail
    for cpu in /sys/devices/system/cpu/cpu[0-9]*; do
        [ -d "$cpu" ] || continue
        path="$cpu/cpufreq/scaling_governor"
        avail="$cpu/cpufreq/scaling_available_governors"
        [ -e "$path" ] || continue
        if [ -r "$avail" ] && ! grep -qw "$governor" "$avail"; then
            printf 'skip %s: governor %s unavailable\n' "$path" "$governor" >&2
            continue
        fi
        echo "$governor" | $SUDO tee "$path" >/dev/null
    done
}

write_energy_performance_preference() {
    local epp="$1"
    local cpu path avail
    for cpu in /sys/devices/system/cpu/cpu[0-9]*; do
        [ -d "$cpu" ] || continue
        path="$cpu/cpufreq/energy_performance_preference"
        avail="$cpu/cpufreq/energy_performance_available_preferences"
        [ -e "$path" ] || continue
        if [ -r "$avail" ] && ! grep -qw "$epp" "$avail"; then
            printf 'skip %s: EPP %s unavailable\n' "$path" "$epp" >&2
            continue
        fi
        echo "$epp" | $SUDO tee "$path" >/dev/null
    done
}

write_hwp_dynamic_boost() {
    local value="$1"
    local path
    path=$(sys_path /devices/system/cpu/intel_pstate/hwp_dynamic_boost)
    if [ ! -e "$path" ]; then
        printf 'hwp_dynamic_boost sysfs missing; skip\n' >&2
        return 0
    fi
    echo "$value" | $SUDO tee "$path" >/dev/null
}

write_platform_profile() {
    local profile="$1"
    local path choices
    path=$(platform_profile_path) || {
        printf 'platform_profile sysfs missing; skip\n' >&2
        return 0
    }
    choices="${path}_choices"
    if [ -r "$choices" ] && ! grep -qw "$profile" "$choices"; then
        die "platform profile $profile not in $choices"
    fi
    echo "$profile" | $SUDO tee "$path" >/dev/null
}

write_iwl_power_save() {
    local value="$1"
    local path=/sys/module/iwlwifi/parameters/power_save
    if [ ! -e "$path" ]; then
        printf 'iwlwifi power_save sysfs missing; skip\n' >&2
        return 0
    fi
    if [ ! -w "$path" ]; then
        printf 'iwlwifi power_save sysfs read-only; skip\n' >&2
        return 0
    fi
    if ! echo "$value" | $SUDO tee "$path" >/dev/null; then
        printf 'iwlwifi power_save write rejected; skip\n' >&2
    fi
}

write_zram_size() {
    local expr="$1"
    local drop_in_dir=/etc/systemd/zram-generator.conf.d
    local drop_in="$drop_in_dir/10-rg-profile.conf"
    local content
    content="# Managed by rg-x1gen11-profile
[zram0]
zram-size = ${expr}
compression-algorithm = zstd
swap-priority = 100
fs-type = swap
"
    $SUDO mkdir -p "$drop_in_dir"
    printf '%s' "$content" | $SUDO tee "$drop_in" >/dev/null
    $SUDO systemctl daemon-reload
    $SUDO systemctl restart systemd-zram-setup@zram0.service 2>/dev/null || true
}

zram_content() {
    local expr="$1"
    cat <<EOF
# Managed by rg-x1gen11-profile
[zram0]
zram-size = ${expr}
compression-algorithm = zstd
swap-priority = 100
fs-type = swap
EOF
}

apply_slice_caps() {
    local browser_high="$1" build_high="$2"
    systemctl --user set-property browser.slice "MemoryHigh=$browser_high" \
        >/dev/null 2>&1 || true
    systemctl --user set-property build.slice "MemoryHigh=$build_high" \
        >/dev/null 2>&1 || true
}

apply_damon() {
    local enabled="$1" profile="${2:-laptop}"
    if [ -x "$HOME/.local/bin/rg-damon-reclaim" ]; then
        if [ "$enabled" = "true" ]; then
            "$HOME/.local/bin/rg-damon-reclaim" enable "$profile"
        else
            "$HOME/.local/bin/rg-damon-reclaim" disable
        fi
        return 0
    fi
    local path=/sys/module/damon_reclaim/parameters/enabled
    if [ ! -f "$path" ]; then
        printf 'damon_reclaim module missing; skip\n' >&2
        return 0
    fi
    if [ "$enabled" = "true" ]; then
        echo Y | $SUDO tee "$path" >/dev/null
    else
        echo N | $SUDO tee "$path" >/dev/null
    fi
}

apply_scx_mode() {
    local mode="$1"
    if [ -x "$HOME/.local/bin/rg-sched-ladder" ]; then
        "$HOME/.local/bin/rg-sched-ladder" switch "$mode" >/dev/null 2>&1 \
            || printf 'rg-sched-ladder: could not switch to %s (boot linux-rg?)\n' "$mode" >&2
        return 0
    fi
    if [ -x "$HOME/.local/bin/rg-scx-loader" ]; then
        if [ "$mode" = "off" ]; then
            "$HOME/.local/bin/rg-scx-loader" unload >/dev/null 2>&1 || true
        else
            "$HOME/.local/bin/rg-scx-loader" switch "$mode" >/dev/null 2>&1 || true
        fi
    else
        printf 'rg-sched-ladder missing; skip scx mode %s\n' "$mode" >&2
    fi
}

apply_root_helper() {
    local profile="$1"
    [ -x "$ROOT_HELPER" ] || return 1
    "$SUDO" -n "$ROOT_HELPER" "$profile" >/dev/null 2>&1
}

apply_profile() {
    local profile="$1"
    local platform governor epp hwp iwl zram damon damon_profile scx browser_high build_high

    platform=$(profile_field "$profile" platform_profile)
    governor=$(profile_field "$profile" scaling_governor)
    epp=$(profile_field "$profile" energy_performance_preference)
    hwp=$(profile_field "$profile" hwp_dynamic_boost)
    iwl=$(profile_field "$profile" iwlwifi_power_save)
    zram=$(profile_field "$profile" zram_size)
    damon=$(profile_field "$profile" damon_reclaim)
    damon_profile=$(profile_field "$profile" damon_profile)
    scx=$(profile_field "$profile" scx_mode)
    browser_high=$(profile_field "$profile" browser_memory_high)
    build_high=$(profile_field "$profile" build_memory_high)

    mkdir -p "$STATE_DIR"
    if apply_root_helper "$profile"; then
        if ! profile_policy_check "$profile"; then
            write_platform_profile "$platform"
            write_scaling_governor "$governor"
            write_energy_performance_preference "$epp"
            write_hwp_dynamic_boost "$hwp"
            write_iwl_power_save "$iwl"
            write_zram_size "$zram"
            apply_damon "$damon" "$damon_profile"
        fi
    else
        write_platform_profile "$platform"
        write_scaling_governor "$governor"
        write_energy_performance_preference "$epp"
        write_hwp_dynamic_boost "$hwp"
        write_iwl_power_save "$iwl"
        write_zram_size "$zram"
        apply_damon "$damon" "$damon_profile"
    fi
    apply_slice_caps "$browser_high" "$build_high"
    apply_scx_mode "$scx"
    printf '%s\n' "$profile" >"$STATE_FILE"
    printf 'applied profile: %s\n' "$profile"
}

apply_user_profile() {
    local profile="$1"
    local scx browser_high build_high
    scx=$(profile_field "$profile" scx_mode)
    browser_high=$(profile_field "$profile" browser_memory_high)
    build_high=$(profile_field "$profile" build_memory_high)
    mkdir -p "$STATE_DIR"
    apply_slice_caps "$browser_high" "$build_high"
    apply_scx_mode "$scx"
    printf '%s\n' "$profile" >"$STATE_FILE"
    printf 'applied user profile: %s\n' "$profile"
}

write_root_script() {
    local profile="$1" out="${2:-/tmp/rg-x1gen11-profile-root.sh}"
    local platform governor epp hwp iwl zram damon damon_profile
    platform=$(profile_field "$profile" platform_profile)
    governor=$(profile_field "$profile" scaling_governor)
    epp=$(profile_field "$profile" energy_performance_preference)
    hwp=$(profile_field "$profile" hwp_dynamic_boost)
    iwl=$(profile_field "$profile" iwlwifi_power_save)
    zram=$(profile_field "$profile" zram_size)
    damon=$(profile_field "$profile" damon_reclaim)
    damon_profile=$(profile_field "$profile" damon_profile)

    cat >"$out" <<ROOT
#!/usr/bin/env bash
set -euo pipefail

if [ "\$(id -u)" -ne 0 ]; then
    printf 'run as root: sudo bash %s\n' "\$0" >&2
    exit 2
fi

write_if_path() {
    local path=\$1 value=\$2 label=\$3
    if [ ! -e "\$path" ]; then
        printf '%s: missing; skip\n' "\$label" >&2
        return 0
    fi
    if ! sh -c 'printf "%s\n" "\$1" >"\$2"' sh "\$value" "\$path" 2>/dev/null; then
        printf '%s: write rejected; skip\n' "\$label" >&2
    fi
}

write_scaling_governor() {
    local governor=\$1 cpu path avail
    for cpu in /sys/devices/system/cpu/cpu[0-9]*; do
        [ -d "\$cpu" ] || continue
        path="\$cpu/cpufreq/scaling_governor"
        avail="\$cpu/cpufreq/scaling_available_governors"
        [ -e "\$path" ] || continue
        if [ -r "\$avail" ] && ! grep -qw "\$governor" "\$avail"; then
            printf 'skip %s: governor %s unavailable\n' "\$path" "\$governor" >&2
            continue
        fi
        if ! sh -c 'printf "%s\n" "\$1" >"\$2"' sh "\$governor" "\$path" 2>/dev/null; then
            printf 'skip %s: write rejected\n' "\$path" >&2
        fi
    done
}

write_energy_performance_preference() {
    local epp=\$1 cpu path avail
    for cpu in /sys/devices/system/cpu/cpu[0-9]*; do
        [ -d "\$cpu" ] || continue
        path="\$cpu/cpufreq/energy_performance_preference"
        avail="\$cpu/cpufreq/energy_performance_available_preferences"
        [ -e "\$path" ] || continue
        if [ -r "\$avail" ] && ! grep -qw "\$epp" "\$avail"; then
            printf 'skip %s: EPP %s unavailable\n' "\$path" "\$epp" >&2
            continue
        fi
        if ! sh -c 'printf "%s\n" "\$1" >"\$2"' sh "\$epp" "\$path" 2>/dev/null; then
            printf 'skip %s: write rejected\n' "\$path" >&2
        fi
    done
}

platform_path=
for path in /sys/firmware/acpi/platform_profile /sys/devices/platform/thinkpad_acpi/platform_profile; do
    if [ -e "\$path" ]; then
        platform_path=\$path
        break
    fi
done
if [ -n "\$platform_path" ]; then
    choices="\${platform_path}_choices"
    if [ -r "\$choices" ] && ! grep -qw ${platform@Q} "\$choices"; then
        printf 'platform profile %s unavailable in %s\n' ${platform@Q} "\$choices" >&2
        exit 1
    fi
    if ! sh -c 'printf "%s\n" "\$1" >"\$2"' sh ${platform@Q} "\$platform_path" 2>/dev/null; then
        printf 'platform profile %s write rejected; skip\n' ${platform@Q} >&2
    fi
else
    printf 'platform_profile sysfs missing; skip\n' >&2
fi

write_scaling_governor ${governor@Q}
write_energy_performance_preference ${epp@Q}
write_if_path /sys/devices/system/cpu/intel_pstate/hwp_dynamic_boost ${hwp@Q} hwp_dynamic_boost
write_if_path /sys/module/iwlwifi/parameters/power_save ${iwl@Q} iwlwifi_power_save

install -d -m0755 /etc/systemd/zram-generator.conf.d
cat >/etc/systemd/zram-generator.conf.d/10-rg-profile.conf <<'ZRAM'
$(zram_content "$zram")
ZRAM
systemctl daemon-reload
systemctl restart systemd-zram-setup@zram0.service 2>/dev/null || true

damon_enabled=${damon@Q}
damon_policy=${damon_profile@Q}
damon_helper="$HOME/.local/bin/rg-damon-reclaim"
profile_name=${profile@Q}
if [ "\$damon_enabled" = true ] && [ -x "\$damon_helper" ]; then
    "\$damon_helper" enable "\$damon_policy"
elif [ "\$damon_enabled" = true ]; then
    printf 'rg-damon-reclaim missing; skip DAMON profile %s\n' "\$damon_policy" >&2
elif [ -x "\$damon_helper" ]; then
    "\$damon_helper" disable
fi

printf 'root profile applied: %s\n' "\$profile_name"
printf 'run user side: rg-x1gen11-profile apply-user %s\n' "\$profile_name"
ROOT
    chmod 0755 "$out"
    printf 'wrote %s\n' "$out"
    printf 'run: sudo bash %s\n' "$out"
    printf 'then: rg-x1gen11-profile apply-user %s\n' "$profile"
}

write_root_helper_script() {
    local out="${1:-/tmp/rg-x1gen11-profile-root}"
    cat >"$out" <<'ROOT'
#!/usr/bin/env bash
set -euo pipefail

profile="${1:-}"
PROFILES_JSON="${RG_X1GEN11_PROFILES:-/home/rgoswami/.config/rg-x1gen11/profiles.json}"
CHEZMOI_PROFILES=/home/rgoswami/.local/share/chezmoi/dot_config/rg-x1gen11/profiles.json

if [ ! -r "$PROFILES_JSON" ] && [ -r "$CHEZMOI_PROFILES" ]; then
    PROFILES_JSON="$CHEZMOI_PROFILES"
fi

profile_data=$(python3 - "$PROFILES_JSON" "$profile" <<'PY'
import json
import shlex
import sys

path, profile = sys.argv[1:3]
data = json.load(open(path, encoding="utf-8"))
profiles = data["profiles"]
if profile not in profiles:
    choices = "|".join(profiles)
    print(f"usage: {sys.argv[0]} {{{choices}}}", file=sys.stderr)
    raise SystemExit(2)

spec = profiles[profile]
values = {
    "platform": spec["platform_profile"],
    "governor": spec["scaling_governor"],
    "epp": spec["energy_performance_preference"],
    "hwp": spec.get(
        "hwp_dynamic_boost",
        "1" if spec.get("scaling_governor") == "performance" else "0",
    ),
    "iwl": spec["iwlwifi_power_save"],
    "zram_expr": spec["zram_size"],
    "damon": "Y" if spec["damon_reclaim"] else "N",
}
for key, value in values.items():
    print(f"{key}={shlex.quote(str(value))}")
PY
)
eval "$profile_data"

write_sysfs_value() {
    local path="$1" value="$2"
    printf "%s\n" "$value" >"$path" 2>/dev/null
}

write_platform_profile() {
    local path choices
    for path in /sys/firmware/acpi/platform_profile /sys/devices/platform/thinkpad_acpi/platform_profile; do
        [ -e "$path" ] || continue
        choices="${path}_choices"
        if [ -r "$choices" ] && ! grep -qw "$platform" "$choices"; then
            printf "platform profile %s unavailable in %s\n" "$platform" "$choices" >&2
            exit 1
        fi
        if ! write_sysfs_value "$path" "$platform"; then
            printf "platform profile %s write rejected; skip\n" "$platform" >&2
        fi
        return 0
    done
    printf "platform_profile sysfs missing; skip\n" >&2
}

write_cpufreq_value() {
    local name="$1" value="$2" avail_name="$3"
    local cpu path avail
    for cpu in /sys/devices/system/cpu/cpu[0-9]*; do
        [ -d "$cpu" ] || continue
        path="$cpu/cpufreq/$name"
        avail="$cpu/cpufreq/$avail_name"
        [ -e "$path" ] || continue
        if [ -r "$avail" ] && ! grep -qw "$value" "$avail"; then
            printf "skip %s: %s unavailable\n" "$path" "$value" >&2
            continue
        fi
        if ! write_sysfs_value "$path" "$value"; then
            printf "skip %s: write rejected\n" "$path" >&2
        fi
    done
}

write_if_path() {
    local path="$1" value="$2" label="$3"
    if [ ! -e "$path" ]; then
        printf "%s: missing; skip\n" "$label" >&2
        return 0
    fi
    if [ ! -w "$path" ]; then
        printf "%s: read-only; skip\n" "$label" >&2
        return 0
    fi
    if ! write_sysfs_value "$path" "$value"; then
        printf "%s: write rejected; skip\n" "$label" >&2
    fi
}

write_zram() {
    install -d -m0755 /etc/systemd/zram-generator.conf.d
    cat >/etc/systemd/zram-generator.conf.d/10-rg-profile.conf <<ZRAM
# Managed by rg-x1gen11-profile-root
[zram0]
zram-size = $zram_expr
compression-algorithm = zstd
swap-priority = 100
fs-type = swap
ZRAM
    systemctl daemon-reload
    systemctl restart systemd-zram-setup@zram0.service 2>/dev/null || true
}

write_damon() {
    local path=/sys/module/damon_reclaim/parameters/enabled
    [ -e "$path" ] || return 0
    printf "%s\n" "$damon" >"$path"
}

write_platform_profile
write_cpufreq_value scaling_governor "$governor" scaling_available_governors
write_cpufreq_value energy_performance_preference "$epp" energy_performance_available_preferences
write_if_path /sys/devices/system/cpu/intel_pstate/hwp_dynamic_boost "$hwp" hwp_dynamic_boost
write_if_path /sys/module/iwlwifi/parameters/power_save "$iwl" iwlwifi_power_save
write_zram
write_damon

printf "root profile applied: %s\n" "$profile"
ROOT
    chmod 0755 "$out"
    printf 'wrote %s\n' "$out"
}

show_profile() {
    local profile="$1"
    printf 'profile: %s\n' "$profile"
    printf '  description: %s\n' "$(profile_field "$profile" description)"
    printf '  platform_profile: %s\n' "$(profile_field "$profile" platform_profile)"
    printf '  scaling_governor: %s\n' "$(profile_field "$profile" scaling_governor)"
    printf '  energy_performance_preference: %s\n' "$(profile_field "$profile" energy_performance_preference)"
    printf '  hwp_dynamic_boost: %s\n' "$(profile_field "$profile" hwp_dynamic_boost)"
    printf '  iwlwifi_power_save: %s\n' "$(profile_field "$profile" iwlwifi_power_save)"
    printf '  zram_size: %s\n' "$(profile_field "$profile" zram_size)"
    printf '  damon_reclaim: %s\n' "$(profile_field "$profile" damon_reclaim)"
    printf '  damon_profile: %s\n' "$(profile_field "$profile" damon_profile)"
    printf '  scx_mode: %s\n' "$(profile_field "$profile" scx_mode)"
    printf '  browser_memory_high: %s\n' "$(profile_field "$profile" browser_memory_high)"
    printf '  build_memory_high: %s\n' "$(profile_field "$profile" build_memory_high)"
}

active_profile() {
    if [ -f "$STATE_FILE" ]; then
        cat "$STATE_FILE"
    else
        require_python
        python3 - "$PROFILES_JSON" <<'PY'
import json, sys
print(json.load(open(sys.argv[1], encoding="utf-8")).get("default", "undocked-mixed"))
PY
    fi
}

read_trimmed() {
    local path="$1"
    if [ ! -r "$path" ]; then
        return 1
    fi
    tr -d '\n' <"$path"
}

profile_policy_check() {
    local profile="$1" failures=0
    local expected live path

    compare_value() {
        local label="$1" value="$2" want="$3"
        if [ "$value" != "$want" ]; then
            printf 'profile drift: %s live=%s expected=%s\n' "$label" "$value" "$want" >&2
            failures=$((failures + 1))
        fi
    }

    expected=$(profile_field "$profile" platform_profile)
    if path=$(platform_profile_path 2>/dev/null) && live=$(read_trimmed "$path"); then
        compare_value platform_profile "$live" "$expected"
    else
        printf 'profile drift: platform_profile live=unavailable expected=%s\n' "$expected" >&2
        failures=$((failures + 1))
    fi

    expected=$(profile_field "$profile" scaling_governor)
    path=$(sys_path /devices/system/cpu/cpu0/cpufreq/scaling_governor)
    if live=$(read_trimmed "$path"); then
        compare_value scaling_governor "$live" "$expected"
    else
        printf 'profile drift: scaling_governor live=unavailable expected=%s\n' "$expected" >&2
        failures=$((failures + 1))
    fi

    expected=$(profile_field "$profile" energy_performance_preference)
    path=$(sys_path /devices/system/cpu/cpu0/cpufreq/energy_performance_preference)
    if live=$(read_trimmed "$path"); then
        compare_value energy_performance_preference "$live" "$expected"
    else
        printf 'profile drift: energy_performance_preference live=unavailable expected=%s\n' "$expected" >&2
        failures=$((failures + 1))
    fi

    expected=$(profile_field "$profile" hwp_dynamic_boost)
    path=$(sys_path /devices/system/cpu/intel_pstate/hwp_dynamic_boost)
    if live=$(read_trimmed "$path"); then
        compare_value hwp_dynamic_boost "$live" "$expected"
    else
        printf 'profile drift: hwp_dynamic_boost live=unavailable expected=%s\n' "$expected" >&2
        failures=$((failures + 1))
    fi

    expected=$(profile_field "$profile" iwlwifi_power_save)
    path=$(sys_path /module/iwlwifi/parameters/power_save)
    if live=$(read_trimmed "$path"); then
        compare_value iwlwifi_power_save "$live" "$expected"
    else
        printf 'profile drift: iwlwifi_power_save live=unavailable expected=%s\n' "$expected" >&2
        failures=$((failures + 1))
    fi

    expected=$(profile_field "$profile" scx_mode)
    path="$HOME/.local/bin/rg-sched-ladder"
    if [ -x "$path" ] && live=$("$path" current 2>/dev/null); then
        compare_value scx_mode "$live" "$expected"
    else
        printf 'profile drift: scx_mode live=unavailable expected=%s\n' "$expected" >&2
        failures=$((failures + 1))
    fi

    if (( failures > 0 )); then
        return 1
    fi
    printf 'profile policy: ok\n'
}

doctor() {
    local check_policy="${1:-}" path unit_state profile

    unit_state() {
        local unit="$1" label="$2" inactive_note="${3:-inactive}" state
        if state=$(systemctl is-active "$unit" 2>&1); then
            printf '%s: active\n' "$label"
        elif printf '%s\n' "$state" | grep -Eq 'Operation not permitted|Failed to connect'; then
            printf '%s: unknown (%s)\n' "$label" "$state"
        else
            printf '%s: %s\n' "$label" "$inactive_note"
        fi
    }

    printf '== workload profile ==\n'
    profile=$(active_profile)
    printf 'active: %s\n' "$profile"

    printf '\n== platform / cpufreq ==\n'
    if path=$(platform_profile_path 2>/dev/null); then
        printf 'platform_profile: %s\n' "$(cat "$path")"
        [ -r "${path}_choices" ] && printf 'choices: %s\n' "$(tr '\n' ' ' <"${path}_choices")"
    else
        printf 'platform_profile: unavailable\n'
    fi
    path=$(sys_path /devices/system/cpu/cpu0/cpufreq/scaling_governor)
    if [ -r "$path" ]; then
        printf 'cpu0 governor: %s\n' "$(cat "$path")"
    fi
    path=$(sys_path /devices/system/cpu/cpu0/cpufreq/energy_performance_preference)
    if [ -r "$path" ]; then
        printf 'cpu0 EPP: %s\n' "$(cat "$path")"
    fi

    printf '\n== iwlwifi ==\n'
    path=$(sys_path /module/iwlwifi/parameters/power_save)
    if [ -r "$path" ]; then
        printf 'power_save: %s\n' "$(cat "$path")"
    else
        printf 'power_save: unavailable\n'
    fi

    printf '\n== zram ==\n'
    path=$(sys_path /block/zram0/disksize)
    if [ -r "$path" ]; then
        printf 'zram0 size: %s bytes\n' "$(cat "$path")"
        path=$(sys_path /block/zram0/mm_stat)
        if [ -r "$path" ]; then
            awk '
                {
                    printf "zram0 mm_stat: orig=%s compr=%s mem=%s same=%s pages=%s\n", $1, $2, $3, $4, $6
                }
            ' "$path"
        fi
    elif [ -b /dev/zram0 ]; then
        printf 'zram0 size: %s bytes\n' "$(blockdev --getsize64 /dev/zram0 2>/dev/null || echo unknown)"
    else
        printf 'zram0: not present\n'
    fi

    printf '\n== PSI (some avg10) ==\n'
    path=$(proc_path /pressure/memory)
    if [ -r "$path" ] && [ -x "$HOME/.local/bin/rg-psi-snapshot" ]; then
        "$HOME/.local/bin/rg-psi-snapshot" once 2>/dev/null || true
    elif [ ! -r "$path" ]; then
        printf 'PSI: unavailable\n'
    fi

    printf '\n== OOMD stack ==\n'
    unit_state systemd-oomd systemd-oomd inactive
    unit_state oomd "facebook oomd" "inactive (install via rg-oomd-profile-install)"

    printf '\n== scheduler ladder ==\n'
    if [ -x "$HOME/.local/bin/rg-sched-ladder" ]; then
        printf 'active id: %s\n' "$("$HOME/.local/bin/rg-sched-ladder" current 2>/dev/null || echo unknown)"
    fi
    path=$(sys_path /kernel/sched_ext)
    if [ -d "$path" ]; then
        if [ -r "$path/current" ]; then
            printf 'sched_ext current: %s\n' "$(cat "$path/current" 2>/dev/null || echo none)"
        fi
        if [ -d "$path/asa" ]; then
            printf 'ASA enabled: %s\n' "$(cat "$path/asa/enabled" 2>/dev/null || echo n/a)"
            printf 'ASA recommended: %s\n' "$(cat "$path/asa/recommended_scheduler" 2>/dev/null || echo n/a)"
        fi
    else
        printf 'sched_ext: sysfs missing — EEVDF+BORE only (stock kernel?)\n'
    fi

    printf '\n== DAMON reclaim ==\n'
    path=$(sys_path /module/damon_reclaim/parameters/enabled)
    if [ -r "$path" ]; then
        printf 'damon_reclaim: %s\n' "$(cat "$path")"
    elif [ -e "$path" ]; then
        printf 'damon_reclaim: present (root-readable)\n'
    else
        printf 'damon_reclaim: module missing\n'
    fi

    if [ -x "$HOME/.local/bin/rg-hfi-status" ]; then
        printf '\n'
        "$HOME/.local/bin/rg-hfi-status"
    fi

    if [ "$check_policy" = "--check" ]; then
        printf '\n== profile policy check ==\n'
        profile_policy_check "$profile"
    elif [ -n "$check_policy" ]; then
        die "unknown doctor argument: $check_policy"
    fi
}

main() {
    local cmd=${1:-}
    case "$cmd" in
    list) list_profiles ;;
    show)
        local profile=${2:-}
        if [ -z "$profile" ]; then
            if [ -f "$STATE_FILE" ]; then
                profile=$(cat "$STATE_FILE")
            else
                require_python
                profile=$(python3 - "$PROFILES_JSON" <<'PY'
import json, sys
print(json.load(open(sys.argv[1], encoding="utf-8")).get("default", "undocked-mixed"))
PY
)
            fi
        fi
        show_profile "$profile"
        ;;
    apply)
        [ -n "${2:-}" ] || die "apply requires PROFILE"
        apply_profile "$2"
        ;;
    apply-user)
        [ -n "${2:-}" ] || die "apply-user requires PROFILE"
        apply_user_profile "$2"
        ;;
    root-script)
        [ -n "${2:-}" ] || die "root-script requires PROFILE"
        write_root_script "$2" "${3:-/tmp/rg-x1gen11-profile-root.sh}"
        ;;
    root-helper-script)
        write_root_helper_script "${2:-/tmp/rg-x1gen11-profile-root}"
        ;;
    current)
        if [ -f "$STATE_FILE" ]; then
            cat "$STATE_FILE"
        else
            require_python
            python3 - "$PROFILES_JSON" <<'PY'
import json, sys
print(json.load(open(sys.argv[1], encoding="utf-8")).get("default", "undocked-mixed"))
PY
        fi
        ;;
    doctor) doctor "${2:-}" ;;
    -h | --help | "") usage ;;
    *) die "unknown command: $cmd" ;;
    esac
}

main "$@"
