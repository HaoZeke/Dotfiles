#!/usr/bin/env bash
# Managed by chezmoi (dot_local/bin/executable_rg-damon-reclaim).
#
# Toggle upstream DAMON_RECLAIM for memory-pressure profile work. The linux-rg
# kernel enables CONFIG_DAMON_RECLAIM; policy stays off until this helper or
# rg-x1gen11-profile memory-pressure mode turns it on.

set -euo pipefail

PARAM_DIR=${RG_DAMON_PARAM_DIR:-/sys/module/damon_reclaim/parameters}
ENABLED_PATH=${RG_DAMON_ENABLED_PATH:-$PARAM_DIR/enabled}
if [ -n "${RG_DAMON_SUDO+x}" ]; then
    SUDO="$RG_DAMON_SUDO"
elif [ "${EUID:-$(id -u)}" -eq 0 ]; then
    SUDO=
else
    SUDO=sudo
fi
ROOT_SCRIPT=${RG_DAMON_ROOT_SCRIPT:-/tmp/rg-damon-reclaim-root.sh}
HELPER_PATH=${RG_DAMON_HELPER_PATH:-$HOME/.local/bin/rg-damon-reclaim}
UNIT_SCRIPT=${RG_DAMON_UNIT_SCRIPT:-/tmp/rg-damon-reclaim-memory-pressure.service}

usage() {
    cat <<'USAGE'
usage: rg-damon-reclaim COMMAND

Commands:
  status                  Print DAMON reclaim state and policy parameters.
  enable [PROFILE]        Apply PROFILE and turn DAMON reclaim on.
  disable                 Turn DAMON reclaim off.
  root-script PROFILE [OUT]
                          Write an inspectable root script for PROFILE.
  systemd-unit PROFILE [OUT]
                          Write a root systemd unit for a bounded profile.
  -h, --help

Profiles:
  laptop           Conservative bounded reclaim profile.
  memory-pressure  Stronger bounded profile for browser + VM + build pressure.
USAGE
}

die() {
    printf 'rg-damon-reclaim: %s\n' "$*" >&2
    exit 2
}

require_enabled_file() {
    if [ ! -f "$ENABLED_PATH" ]; then
        die "DAMON_RECLAIM not available ($ENABLED_PATH missing)"
    fi
}

param_path() {
    local name="$1"
    if [ "$name" = enabled ]; then
        printf '%s\n' "$ENABLED_PATH"
    else
        printf '%s/%s\n' "$PARAM_DIR" "$name"
    fi
}

read_param() {
    local name="$1" path
    path=$(param_path "$name")
    if [ ! -e "$path" ]; then
        printf 'missing'
    elif [ -r "$path" ]; then
        cat "$path"
    else
        printf 'permission-denied'
    fi
}

write_param() {
    local name="$1" value="$2" path
    path=$(param_path "$name")
    if [ ! -e "$path" ]; then
        printf 'skip missing parameter: %s\n' "$name" >&2
        return 0
    fi
    echo "$value" | $SUDO tee "$path" >/dev/null
}

profile_params() {
    local profile="$1"
    case "$profile" in
    laptop)
        cat <<'EOF'
quota_ms=10
quota_sz=134217728
quota_reset_interval_ms=1000
wmarks_high=500
wmarks_mid=350
wmarks_low=200
wmarks_interval=5000000
min_age=120000000
sample_interval=5000
aggr_interval=100000
min_nr_regions=10
max_nr_regions=1000
skip_anon=N
quota_mem_pressure_us=0
quota_autotune_feedback=0
EOF
        ;;
    memory-pressure)
        cat <<'EOF'
quota_ms=20
quota_sz=536870912
quota_reset_interval_ms=1000
wmarks_high=600
wmarks_mid=450
wmarks_low=250
wmarks_interval=5000000
min_age=60000000
sample_interval=5000
aggr_interval=100000
min_nr_regions=10
max_nr_regions=2000
skip_anon=N
quota_mem_pressure_us=0
quota_autotune_feedback=0
EOF
        ;;
    off)
        ;;
    *) die "unknown profile: $profile" ;;
    esac
}

apply_profile_params() {
    local profile="$1" line name value wrote=0
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        name=${line%%=*}
        value=${line#*=}
        write_param "$name" "$value"
        wrote=1
    done < <(profile_params "$profile")
    if [ "$wrote" = 1 ] && [ -e "$(param_path commit_inputs)" ]; then
        write_param commit_inputs Y
    fi
}

cmd_enable() {
    local profile=${1:-laptop}
    require_enabled_file
    write_param enabled N
    apply_profile_params "$profile"
    write_param enabled Y
    cmd_status
}

cmd_disable() {
    if [ ! -f "$ENABLED_PATH" ]; then
        cmd_status
        return 0
    fi
    write_param enabled N
    cmd_status
}

cmd_status() {
    if [ ! -f "$ENABLED_PATH" ]; then
        printf 'damon_reclaim: unavailable\n'
        return 0
    fi
    local name kdamond_count
    for name in \
        enabled quota_ms quota_sz quota_reset_interval_ms \
        wmarks_high wmarks_mid wmarks_low wmarks_interval \
        min_age sample_interval aggr_interval min_nr_regions max_nr_regions \
        skip_anon quota_mem_pressure_us quota_autotune_feedback \
        kdamond_pid nr_reclaim_tried_regions bytes_reclaim_tried_regions \
        nr_reclaimed_regions bytes_reclaimed_regions nr_quota_exceeds; do
        printf '%s: %s\n' "$name" "$(read_param "$name")"
    done
    kdamond_count=$(pgrep -c kdamond 2>/dev/null || true)
    printf 'kdamond processes: %s\n' "${kdamond_count:-0}"
}

cmd_root_script() {
    local profile=${1:-}
    local out=${2:-$ROOT_SCRIPT}
    [ -n "$profile" ] || die "root-script requires PROFILE"
    profile_params "$profile" >/dev/null
    cat >"$out" <<ROOT
#!/usr/bin/env bash
set -euo pipefail

if [ "\$(id -u)" -ne 0 ]; then
    printf 'run as root: sudo bash %s\n' "\$0" >&2
    exit 2
fi

param_dir=${PARAM_DIR}
enabled_path=${ENABLED_PATH}

param_path() {
    local name=\$1
    if [ "\$name" = enabled ]; then
        printf '%s\n' "\$enabled_path"
    else
        printf '%s/%s\n' "\$param_dir" "\$name"
    fi
}

write_param() {
    local name=\$1 value=\$2 path
    path=\$(param_path "\$name")
    if [ ! -e "\$path" ]; then
        printf 'skip missing parameter: %s\n' "\$name" >&2
        return 0
    fi
    printf '%s\n' "\$value" >"\$path"
}

if [ ! -e "\$enabled_path" ]; then
    printf 'DAMON_RECLAIM not available: %s\n' "\$enabled_path" >&2
    exit 1
fi

write_param enabled N
ROOT
    while IFS= read -r line; do
        [ -n "$line" ] || continue
        printf 'write_param %q %q\n' "${line%%=*}" "${line#*=}" >>"$out"
    done < <(profile_params "$profile")
    cat >>"$out" <<'ROOT'
if [ -e "$(param_path commit_inputs)" ]; then
    write_param commit_inputs Y
fi
write_param enabled Y

printf 'DAMON_RECLAIM profile applied\n'
for name in enabled quota_ms quota_sz quota_reset_interval_ms wmarks_high wmarks_mid wmarks_low min_age skip_anon; do
    path=$(param_path "$name")
    if [ -r "$path" ]; then
        printf '%s: %s\n' "$name" "$(cat "$path")"
    fi
done
ROOT
    chmod 0755 "$out"
    printf 'wrote %s\n' "$out"
    printf 'run: sudo bash %s\n' "$out"
}

cmd_systemd_unit() {
    local profile=${1:-}
    local out=${2:-$UNIT_SCRIPT}
    [ -n "$profile" ] || die "systemd-unit requires PROFILE"
    case "$profile" in
    laptop | memory-pressure)
        ;;
    off)
        die "profile off has no systemd unit; use disable or stop a bounded unit"
        ;;
    *)
        profile_params "$profile" >/dev/null
        ;;
    esac
    cat >"$out" <<UNIT
[Unit]
Description=Apply rgx1gen11 DAMON reclaim profile $profile
Documentation=https://docs.kernel.org/admin-guide/mm/damon/reclaim.html
ConditionPathExists=$ENABLED_PATH

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=RG_DAMON_SUDO=
ExecStart=$HELPER_PATH enable $profile
ExecStop=$HELPER_PATH disable

[Install]
WantedBy=multi-user.target
UNIT
    chmod 0644 "$out"
    printf 'wrote %s\n' "$out"
    printf 'install: sudo install -Dm644 %s /etc/systemd/system/rg-damon-reclaim-%s.service\n' "$out" "$profile"
}

main() {
    local cmd=${1:-}
    case "$cmd" in
    status) cmd_status ;;
    enable) cmd_enable "${2:-laptop}" ;;
    disable) cmd_disable ;;
    root-script) cmd_root_script "${2:-}" "${3:-$ROOT_SCRIPT}" ;;
    systemd-unit) cmd_systemd_unit "${2:-}" "${3:-$UNIT_SCRIPT}" ;;
    -h | --help | "") usage ;;
    *) die "unknown command: $cmd" ;;
    esac
}

main "$@"
