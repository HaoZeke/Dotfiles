#!/usr/bin/env bash
# Managed by chezmoi (dot_local/bin/executable_rg-grok-purge-vault-sessions).
#
# Purges all Grok CLI sessions, subagents, and prompt histories linked
# to private sync repositories specified in ~/.config/ttech/sync-repos.
# Invokes `rg-grok sessions delete <id>` with repository CWD to trigger
# remote backend x.ai/session/delete RPCs, then purges local session directories.
#
# A session directory is the URL-encoded working directory; it matches when
# that path is a configured repository or lies inside one, never by substring.
# A session whose remote delete fails is kept locally, so the purge can be run
# again, and the script exits non-zero naming how many remain.
set -euo pipefail

python3 -I - <<'EOF'
import os
import shutil
import subprocess
import sys
import urllib.parse

base = os.path.expanduser("~/.grok/sessions")
if not os.path.isdir(base):
    print(f"No sessions directory found at {base}. Nothing to do.")
    sys.exit(0)

sync_repos = os.path.expanduser("~/.config/ttech/sync-repos")
targets = []
if os.path.exists(sync_repos):
    with open(sync_repos, "r") as f:
        for line in f:
            line = line.strip()
            if line and not line.startswith("#"):
                targets.append(os.path.normpath(os.path.expanduser(line)))

if not targets:
    print("No repositories configured in ~/.config/ttech/sync-repos.")
    sys.exit(0)


def in_target(encoded):
    path = os.path.normpath(urllib.parse.unquote(encoded))
    return any(path == t or path.startswith(t + os.sep) for t in targets)


dirs = [
    d for d in os.listdir(base)
    if in_target(d) and os.path.isdir(os.path.join(base, d))
]

if not dirs:
    print("No matching vault session directories found in ~/.grok/sessions/.")
    sys.exit(0)

print(f"Found {len(dirs)} target vault directories in ~/.grok/sessions/.")
failed = []

for d in dirs:
    full_path = os.path.join(base, d)
    real_cwd = urllib.parse.unquote(d)
    effective_cwd = real_cwd if os.path.isdir(real_cwd) else os.path.expanduser("~")
    
    sessions = [
        s for s in os.listdir(full_path)
        if os.path.isdir(os.path.join(full_path, s))
    ]
    print(f"\nProcessing {d} ({len(sessions)} sessions)...")

    for s in sessions:
        s_path = os.path.join(full_path, s)
        try:
            res = subprocess.run(
                ["rg-grok", "sessions", "delete", s],
                cwd=effective_cwd,
                capture_output=True,
                text=True,
                timeout=12
            )
            out = (res.stdout + res.stderr).strip()
            deleted = res.returncode == 0
        except Exception as e:
            out = f"delete error: {e}"
            deleted = False

        if not deleted:
            # Keep the local copy: it is the only record of the id to retry.
            failed.append(s)
            print(f"  [{s}] remote delete failed, kept locally: {out}")
            continue
        if os.path.exists(s_path):
            shutil.rmtree(s_path)
        print(f"  [{s}] {out}")

    prompt_history = os.path.join(full_path, "prompt_history.jsonl")
    if any(os.path.isdir(os.path.join(full_path, s)) for s in sessions if s in failed):
        print(f"  Kept prompt_history.jsonl for {d}: sessions there still exist remotely")
    elif os.path.exists(prompt_history):
        os.remove(prompt_history)
        print(f"  Removed prompt_history.jsonl for {d}")

    remaining = os.listdir(full_path)
    if not remaining:
        os.rmdir(full_path)
        print(f"  Removed empty directory: {d}")
    else:
        print(f"  Remaining in {d}: {remaining}")

if failed:
    print(f"\n{len(failed)} session(s) could not be deleted remotely and were kept: {' '.join(failed)}")
    sys.exit(1)
print("\nVault session purge completed.")
EOF
