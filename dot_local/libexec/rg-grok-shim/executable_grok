#!/usr/bin/env bash
# `grok` on the Livingston hosts: every launch, including herdr's
# `grok --resume`, goes through rg-grok and so through the Houston door.
# Without rg-grok the launch is refused rather than run unwrapped.
set -euo pipefail
if [ -x "$HOME/.local/bin/rg-grok" ]; then
    exec "$HOME/.local/bin/rg-grok" "$@"
fi
echo "grok: rg-grok is missing; refusing to run the CLI outside the Houston door" >&2
exit 2
