#!/usr/bin/env bash
# Managed by chezmoi (dot_local/libexec/rg-grok-bot-shim/executable_gio).
#
# Route gio open web requests from Grok Bot to the Livingston Vivaldi profile.
set -euo pipefail

if [ "${1:-}" = "open" ] && [[ "${2:-}" =~ ^https?:// ]]; then
    profile="${RG_GROK_PROFILE:-$HOME/.local/bin/rg-livingston-profile}"
    if [ -x "$profile" ]; then
        exec "$profile" vivaldi "${@:2}"
    fi
fi

exec /usr/bin/gio "$@"
