#!/usr/bin/env bash
# Managed by chezmoi (dot_local/libexec/rg-grok-bot-shim/executable_vivaldi-stable).
#
# Route vivaldi-stable launches from Grok Bot to the Livingston Vivaldi profile. Without
# the profile the launch is refused: the plain browser would load the page
# from the local address.
set -euo pipefail

profile="${RG_GROK_PROFILE:-$HOME/.local/bin/rg-livingston-profile}"
if [ -x "$profile" ]; then
    exec "$profile" vivaldi "$@"
fi
echo "vivaldi-stable (grok-bot shim): rg-livingston-profile is missing; refusing to open outside the Houston door" >&2
exit 2
