if [[ ! -o interactive ]]; then
  # non-interactive, return
  return
fi

export shellHome=$HOME/.config/shellrc

# Load all files from the posix.d directory
if [ -d $shellHome/posix.d ]; then
  for file in $shellHome/posix.d/*.sh; do
    source $file
  done
fi

# Load all files from the zsh.d directory
if [ -d $shellHome/zsh.d ]; then
  for file in $shellHome/zsh.d/*.zsh; do
    source $file
  done
fi

# Environment helpers
{{ if eq .setup_mamba "yes" }}
eval "$(micromamba shell hook --shell=zsh)"
{{ end }}


{{ if eq .use_rust "yes" -}}
# Cache the generated init rather than regenerating it per shell. `starship
# init zsh` costs 5.2 ms and the eval of what it returns another 10.8 ms, most
# of that one PROMPT2 assignment; zoxide adds 4.6 ms between the two. Sourcing
# a file that is already on disk costs neither.
#
# Rebuilt when the binary is newer than the cache, which is a builtin test, so
# an upgrade picks itself up and a normal shell forks nothing.
() {
    local dir="${XDG_CACHE_HOME:-$HOME/.cache}/shell-init" prog bin cache
    for prog in starship zoxide; do
        bin=${commands[$prog]} || continue
        [[ -n $bin ]] || continue
        cache="$dir/$prog.zsh"
        if [[ ! -s $cache || $bin -nt $cache ]]; then
            [[ -d $dir ]] || mkdir -p "$dir"
            case $prog in
                starship) "$bin" init zsh --print-full-init >|"$cache" ;;
                zoxide) "$bin" init zsh --cmd Z >|"$cache" ;;
            esac
        fi
        source "$cache"
    done
}
{{ end }}

# Common Zsh #
if [ ! -f ~/.zshrc.zwc -o ~/.zshrc -nt ~/.zshrc.zwc ]; then
  zcompile ~/.zshrc
fi

# Platform
#############

if [ -f ~/.zshPlatform ]; then
  . ~/.zshPlatform
fi


# Specifics
#############

if [ -f ~/.zshSpecifics ]; then
  . ~/.zshSpecifics
fi

# HPC
#######
if [ -f ~/.zshlmod ]; then
  . ~/.zshlmod
fi

# Emacs Stuff (cross platform)
# Local Variables:
# mode: shell-script
# End:

# nimvault local install
[ -f "$HOME/.config/nimvault/env.sh" ] && . "$HOME/.config/nimvault/env.sh"
